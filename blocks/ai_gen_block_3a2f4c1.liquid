{% doc %}
  @prompt
    Design a split-layout “Ideal Applications” section for a professional cleaning equipment webpage.
    
    LEFT SIDE:
    Create a clean icon-based list of ideal industries and applications. Display them as two columns with 3 rows, showing a total of six. 
    
    Use small modern image-based line icons beside each item. I want to be able to add my own icons.
    
    RIGHT SIDE:
    Large addable image.
    
    
    Style:
    - Spacious modern layout
    - White background
    - Minimalist styling
    - Commercial B2B aesthetic
    - Strong typography hierarchy
    - Slightly industrial feel
    - Responsive design with image stacking on mobile
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-ideal-applications-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    background-color: {{ block.settings.background_color }};
    padding: {{ block.settings.section_padding_top }}px {{ block.settings.section_padding_horizontal }}px {{ block.settings.section_padding_bottom }}px;
  }

  .ai-ideal-applications-container-{{ ai_gen_id }} {
    max-width: {{ block.settings.max_width }}px;
    margin: 0 auto;
  }

  .ai-ideal-applications-heading-{{ ai_gen_id }} {
    font-size: {{ block.settings.heading_size }}px;
    font-weight: {{ block.settings.heading_weight }};
    color: {{ block.settings.heading_color }};
    margin: 0 0 {{ block.settings.heading_margin_bottom }}px;
    text-transform: {{ block.settings.heading_transform }};
    letter-spacing: {{ block.settings.heading_letter_spacing }};
  }

  .ai-ideal-applications-layout-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: {{ block.settings.layout_gap }}px;
    align-items: center;
  }

  .ai-ideal-applications-list-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: {{ block.settings.list_gap_vertical }}px {{ block.settings.list_gap_horizontal }}px;
  }

  .ai-ideal-applications-item-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    gap: {{ block.settings.icon_text_gap }}px;
  }

  .ai-ideal-applications-icon-{{ ai_gen_id }} {
    flex-shrink: 0;
    width: {{ block.settings.icon_size }}px;
    height: {{ block.settings.icon_size }}px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-ideal-applications-icon-{{ ai_gen_id }} img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .ai-ideal-applications-icon-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    background-color: {{ block.settings.icon_placeholder_bg }};
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-ideal-applications-icon-placeholder-{{ ai_gen_id }} svg {
    width: 60%;
    height: 60%;
    opacity: 0.3;
  }

  .ai-ideal-applications-text-{{ ai_gen_id }} {
    font-size: {{ block.settings.text_size }}px;
    font-weight: {{ block.settings.text_weight }};
    color: {{ block.settings.text_color }};
    line-height: 1.4;
  }

  .ai-ideal-applications-image-wrapper-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    overflow: hidden;
    border-radius: {{ block.settings.image_border_radius }}px;
  }

  .ai-ideal-applications-image-{{ ai_gen_id }} {
    width: 100%;
    height: auto;
    display: block;
  }

  .ai-ideal-applications-image-placeholder-{{ ai_gen_id }} {
    width: 100%;
    aspect-ratio: {{ block.settings.image_aspect_ratio }};
    background-color: {{ block.settings.image_placeholder_bg }};
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
  }

  .ai-ideal-applications-image-placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    max-width: 300px;
    max-height: 300px;
    opacity: 0.2;
  }

  .ai-ideal-applications-empty-state-{{ ai_gen_id }} {
    position: absolute;
    bottom: 30px;
    left: 50%;
    transform: translateX(-50%);
    padding: 12px 24px;
    background-color: rgba(255, 255, 255, 0.9);
    border-radius: 4px;
    font-size: 14px;
    color: #666;
    text-align: center;
    pointer-events: none;
  }

  @media screen and (max-width: 989px) {
    .ai-ideal-applications-layout-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
      gap: {{ block.settings.mobile_layout_gap }}px;
    }

    .ai-ideal-applications-heading-{{ ai_gen_id }} {
      font-size: {{ block.settings.heading_size | times: 0.85 }}px;
    }

    .ai-ideal-applications-list-{{ ai_gen_id }} {
      order: 2;
    }

    .ai-ideal-applications-image-wrapper-{{ ai_gen_id }} {
      order: 1;
    }
  }

  @media screen and (max-width: 749px) {
    .ai-ideal-applications-{{ ai_gen_id }} {
      padding: {{ block.settings.section_padding_top | times: 0.7 }}px {{ block.settings.section_padding_horizontal | times: 0.6 }}px {{ block.settings.section_padding_bottom | times: 0.7 }}px;
    }

    .ai-ideal-applications-list-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
      gap: {{ block.settings.list_gap_vertical | times: 0.8 }}px;
    }

    .ai-ideal-applications-icon-{{ ai_gen_id }} {
      width: {{ block.settings.icon_size | times: 0.85 }}px;
      height: {{ block.settings.icon_size | times: 0.85 }}px;
    }

    .ai-ideal-applications-text-{{ ai_gen_id }} {
      font-size: {{ block.settings.text_size | times: 0.9 }}px;
    }
  }
{% endstyle %}

<ideal-applications-{{ ai_gen_id }} class="ai-ideal-applications-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-ideal-applications-container-{{ ai_gen_id }}">
    {% if block.settings.heading != blank %}
      <h2 class="ai-ideal-applications-heading-{{ ai_gen_id }}">{{ block.settings.heading }}</h2>
    {% endif %}

    <div class="ai-ideal-applications-layout-{{ ai_gen_id }}">
      <div class="ai-ideal-applications-list-{{ ai_gen_id }}">
        {% for i in (1..6) %}
          {% liquid
            assign text_key = 'application_' | append: i | append: '_text'
            assign icon_key = 'application_' | append: i | append: '_icon'
            assign text_value = block.settings[text_key]
            assign icon_value = block.settings[icon_key]
          %}

          {% if text_value != blank %}
            <div class="ai-ideal-applications-item-{{ ai_gen_id }}">
              <div class="ai-ideal-applications-icon-{{ ai_gen_id }}">
                {% if icon_value != blank %}
                  <img
                    src="{{ icon_value | image_url: width: 100 }}"
                    alt="{{ text_value | escape }}"
                    width="100"
                    height="100"
                    loading="lazy"
                  >
                {% else %}
                  <div class="ai-ideal-applications-icon-placeholder-{{ ai_gen_id }}">
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                      <circle cx="12" cy="12" r="10"></circle>
                      <path d="M12 6v6l4 2"></path>
                    </svg>
                  </div>
                {% endif %}
              </div>
              <div class="ai-ideal-applications-text-{{ ai_gen_id }}">{{ text_value }}</div>
            </div>
          {% endif %}
        {% endfor %}
      </div>

      <div class="ai-ideal-applications-image-wrapper-{{ ai_gen_id }}">
        {% if block.settings.main_image != blank %}
          <img
            src="{{ block.settings.main_image | image_url: width: 1200 }}"
            alt="{{ block.settings.main_image.alt | escape }}"
            class="ai-ideal-applications-image-{{ ai_gen_id }}"
            width="{{ block.settings.main_image.width }}"
            height="{{ block.settings.main_image.height }}"
            loading="lazy"
          >
        {% else %}
          <div class="ai-ideal-applications-image-placeholder-{{ ai_gen_id }}">
            {{ 'image' | placeholder_svg_tag }}
            <div class="ai-ideal-applications-empty-state-{{ ai_gen_id }}">
              Add an image to showcase your applications
            </div>
          </div>
        {% endif %}
      </div>
    </div>
  </div>
</ideal-applications-{{ ai_gen_id }}>

<script>
  (function() {
    class IdealApplications{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.style.display = 'block';
      }
    }

    customElements.define('ideal-applications-{{ ai_gen_id }}', IdealApplications{{ ai_gen_id }});
  })();
</script>

