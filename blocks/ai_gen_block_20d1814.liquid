{% doc %}
  @prompt
    Create a premium content section for a professional cleaning machine webpage.
    
    Start with a heading. Then divide the space below horizontally into three features blocks. The first two blocks  should have an image to the left and a heading, text, and button to the right. The third block should just be a heading, text, and a button inside a grey box. All blocks must fit horizontally across the page without stacking on desktop. 
    
    Design requirements:
    - Premium industrial aesthetic
    - Minimalist typography
    - Modern commercial styling
    - White space between sections
    - Responsive stacking on mobile, For feature 3, can you align the text to the centre?, For feature 3, can you centre align the button?
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-premium-content-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    margin: 0 auto;
    padding: {{ block.settings.section_padding }}px 20px;
  }

  .ai-premium-content__heading-{{ ai_gen_id }} {
    text-align: {{ block.settings.heading_alignment }};
    font-size: {{ block.settings.heading_size }}px;
    font-weight: {{ block.settings.heading_weight }};
    color: {{ block.settings.heading_color }};
    margin: 0 0 {{ block.settings.heading_margin_bottom }}px 0;
    text-transform: {{ block.settings.heading_transform }};
    letter-spacing: {{ block.settings.heading_letter_spacing }};
  }

  .ai-premium-content__features-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: {{ block.settings.features_gap }}px;
    margin-top: {{ block.settings.features_margin_top }}px;
  }

  .ai-premium-content__feature-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
  }

  .ai-premium-content__feature--with-image-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: {{ block.settings.image_text_gap }}px;
    align-items: center;
  }

  .ai-premium-content__feature--grey-box-{{ ai_gen_id }} {
    background-color: {{ block.settings.grey_box_bg }};
    padding: {{ block.settings.grey_box_padding }}px;
    border-radius: {{ block.settings.grey_box_radius }}px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    text-align: center;
    height: 100%;
  }

  .ai-premium-content__image-wrapper-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    overflow: hidden;
    border-radius: {{ block.settings.image_radius }}px;
  }

  .ai-premium-content__image-{{ ai_gen_id }} {
    width: 100%;
    height: auto;
    display: block;
    object-fit: cover;
  }

  .ai-premium-content__image-placeholder-{{ ai_gen_id }} {
    width: 100%;
    aspect-ratio: 1 / 1;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: {{ block.settings.image_radius }}px;
  }

  .ai-premium-content__image-placeholder-{{ ai_gen_id }} svg {
    width: 60%;
    height: 60%;
    opacity: 0.3;
  }

  .ai-premium-content__text-content-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: {{ block.settings.content_gap }}px;
  }

  .ai-premium-content__feature-heading-{{ ai_gen_id }} {
    font-size: {{ block.settings.feature_heading_size }}px;
    font-weight: {{ block.settings.feature_heading_weight }};
    color: {{ block.settings.feature_heading_color }};
    margin: 0;
    line-height: 1.3;
    letter-spacing: 0.02em;
  }

  .ai-premium-content__feature-text-{{ ai_gen_id }} {
    font-size: {{ block.settings.feature_text_size }}px;
    color: {{ block.settings.feature_text_color }};
    line-height: 1.6;
    margin: 0;
  }

  .ai-premium-content__button-{{ ai_gen_id }} {
    display: inline-block;
    padding: {{ block.settings.button_padding_vertical }}px {{ block.settings.button_padding_horizontal }}px;
    background-color: {{ block.settings.button_bg }};
    color: {{ block.settings.button_text_color }};
    text-decoration: none;
    border-radius: {{ block.settings.button_radius }}px;
    font-size: {{ block.settings.button_font_size }}px;
    font-weight: {{ block.settings.button_font_weight }};
    text-transform: {{ block.settings.button_text_transform }};
    letter-spacing: 0.05em;
    transition: all 0.3s ease;
    border: {{ block.settings.button_border_width }}px solid {{ block.settings.button_border_color }};
    text-align: center;
    width: fit-content;
  }

  .ai-premium-content__button-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_bg_hover }};
    color: {{ block.settings.button_text_color_hover }};
    border-color: {{ block.settings.button_border_color_hover }};
  }

  .ai-premium-content__text-content--centered-{{ ai_gen_id }} {
    align-items: center;
  }

  @media screen and (max-width: 989px) {
    .ai-premium-content__features-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
      gap: {{ block.settings.mobile_gap }}px;
    }

    .ai-premium-content__feature--with-image-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
    }

    .ai-premium-content__heading-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.heading_size }}px * 0.8);
    }

    .ai-premium-content__feature-heading-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.feature_heading_size }}px * 0.9);
    }
  }
{% endstyle %}

<premium-content-{{ ai_gen_id }} class="ai-premium-content-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  {% if block.settings.main_heading != blank %}
    <h2 class="ai-premium-content__heading-{{ ai_gen_id }}">
      {{ block.settings.main_heading }}
    </h2>
  {% endif %}

  <div class="ai-premium-content__features-{{ ai_gen_id }}">
    <div class="ai-premium-content__feature-{{ ai_gen_id }} ai-premium-content__feature--with-image-{{ ai_gen_id }}">
      <div class="ai-premium-content__image-wrapper-{{ ai_gen_id }}">
        {% if block.settings.feature_1_image %}
          <img
            src="{{ block.settings.feature_1_image | image_url: width: 800 }}"
            alt="{{ block.settings.feature_1_image.alt | escape }}"
            loading="lazy"
            width="{{ block.settings.feature_1_image.width }}"
            height="{{ block.settings.feature_1_image.height }}"
            class="ai-premium-content__image-{{ ai_gen_id }}"
          >
        {% else %}
          <div class="ai-premium-content__image-placeholder-{{ ai_gen_id }}">
            {{ 'product-1' | placeholder_svg_tag }}
          </div>
        {% endif %}
      </div>

      <div class="ai-premium-content__text-content-{{ ai_gen_id }}">
        {% if block.settings.feature_1_heading != blank %}
          <h3 class="ai-premium-content__feature-heading-{{ ai_gen_id }}">
            {{ block.settings.feature_1_heading }}
          </h3>
        {% endif %}

        {% if block.settings.feature_1_text != blank %}
          <div class="ai-premium-content__feature-text-{{ ai_gen_id }}">
            {{ block.settings.feature_1_text }}
          </div>
        {% endif %}

        {% if block.settings.feature_1_button_text != blank %}
          <a
            href="{{ block.settings.feature_1_button_link }}"
            class="ai-premium-content__button-{{ ai_gen_id }}"
          >
            {{ block.settings.feature_1_button_text }}
          </a>
        {% endif %}
      </div>
    </div>

    <div class="ai-premium-content__feature-{{ ai_gen_id }} ai-premium-content__feature--with-image-{{ ai_gen_id }}">
      <div class="ai-premium-content__image-wrapper-{{ ai_gen_id }}">
        {% if block.settings.feature_2_image %}
          <img
            src="{{ block.settings.feature_2_image | image_url: width: 800 }}"
            alt="{{ block.settings.feature_2_image.alt | escape }}"
            loading="lazy"
            width="{{ block.settings.feature_2_image.width }}"
            height="{{ block.settings.feature_2_image.height }}"
            class="ai-premium-content__image-{{ ai_gen_id }}"
          >
        {% else %}
          <div class="ai-premium-content__image-placeholder-{{ ai_gen_id }}">
            {{ 'product-2' | placeholder_svg_tag }}
          </div>
        {% endif %}
      </div>

      <div class="ai-premium-content__text-content-{{ ai_gen_id }}">
        {% if block.settings.feature_2_heading != blank %}
          <h3 class="ai-premium-content__feature-heading-{{ ai_gen_id }}">
            {{ block.settings.feature_2_heading }}
          </h3>
        {% endif %}

        {% if block.settings.feature_2_text != blank %}
          <div class="ai-premium-content__feature-text-{{ ai_gen_id }}">
            {{ block.settings.feature_2_text }}
          </div>
        {% endif %}

        {% if block.settings.feature_2_button_text != blank %}
          <a
            href="{{ block.settings.feature_2_button_link }}"
            class="ai-premium-content__button-{{ ai_gen_id }}"
          >
            {{ block.settings.feature_2_button_text }}
          </a>
        {% endif %}
      </div>
    </div>

    <div class="ai-premium-content__feature-{{ ai_gen_id }} ai-premium-content__feature--grey-box-{{ ai_gen_id }}">
      <div class="ai-premium-content__text-content-{{ ai_gen_id }} ai-premium-content__text-content--centered-{{ ai_gen_id }}">
        {% if block.settings.feature_3_heading != blank %}
          <h3 class="ai-premium-content__feature-heading-{{ ai_gen_id }}">
            {{ block.settings.feature_3_heading }}
          </h3>
        {% endif %}

        {% if block.settings.feature_3_text != blank %}
          <div class="ai-premium-content__feature-text-{{ ai_gen_id }}">
            {{ block.settings.feature_3_text }}
          </div>
        {% endif %}

        {% if block.settings.feature_3_button_text != blank %}
          <a
            href="{{ block.settings.feature_3_button_link }}"
            class="ai-premium-content__button-{{ ai_gen_id }}"
          >
            {{ block.settings.feature_3_button_text }}
          </a>
        {% endif %}
      </div>
    </div>
  </div>
</premium-content-{{ ai_gen_id }}>

<script>
  (function() {
    class PremiumContent{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.init();
      }

      init() {
        const buttons = this.querySelectorAll('.ai-premium-content__button-{{ ai_gen_id }}');
        buttons.forEach(button => {
          button.addEventListener('click', (e) => {
            if (!button.getAttribute('href') || button.getAttribute('href') === '#') {
              e.preventDefault();
            }
          });
        });
      }
    }

    customElements.define('premium-content-{{ ai_gen_id }}', PremiumContent{{ ai_gen_id }});
  })();
</script>

