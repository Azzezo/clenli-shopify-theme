{% doc %}
  @prompt
    Design a split-layout “Ideal Applications” section for a professional cleaning equipment webpage. Add a layer of text below the heading.
    
    LEFT SIDE:
    Create a clean icon-based list of ideal industries and applications. Use small, changeable line icons beside each item that I can choose. Display them as 2 columns, with 4 rows.
    
    RIGHT SIDE:
    Large changeable image.
    
    
    Style:
    - Spacious modern layout
    - White background
    - Minimalist styling
    - Commercial B2B aesthetic
    - Strong typography hierarchy
    - Slightly industrial feel
    - Responsive design with image stacking on mobile
    
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-ideal-applications-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    background-color: {{ block.settings.background_color }};
    padding: {{ block.settings.section_padding_top }}px 0 {{ block.settings.section_padding_bottom }}px;
  }

  .ai-ideal-applications-container-{{ ai_gen_id }} {
    max-width: {{ block.settings.container_width }}px;
    margin: 0 auto;
    padding: 0 20px;
  }

  .ai-ideal-applications-content-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: {{ block.settings.column_gap }}px;
    align-items: center;
  }

  .ai-ideal-applications-left-{{ ai_gen_id }} {
    padding-right: 40px;
  }

  .ai-ideal-applications-header-{{ ai_gen_id }} {
    margin-bottom: {{ block.settings.header_margin_bottom }}px;
  }

  .ai-ideal-applications-heading-{{ ai_gen_id }} {
    font-size: {{ block.settings.heading_size }}px;
    font-weight: {{ block.settings.heading_weight }};
    color: {{ block.settings.heading_color }};
    margin: 0 0 {{ block.settings.heading_margin_bottom }}px 0;
    line-height: 1.2;
    letter-spacing: -0.02em;
  }

  .ai-ideal-applications-subtext-{{ ai_gen_id }} {
    font-size: {{ block.settings.subtext_size }}px;
    color: {{ block.settings.subtext_color }};
    line-height: 1.6;
    margin: 0;
  }

  .ai-ideal-applications-list-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: {{ block.settings.list_gap }}px;
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .ai-ideal-applications-item-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    gap: {{ block.settings.icon_text_gap }}px;
  }

  .ai-ideal-applications-icon-{{ ai_gen_id }} {
    flex-shrink: 0;
    width: {{ block.settings.icon_size }}px;
    height: {{ block.settings.icon_size }}px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-ideal-applications-icon-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    stroke: {{ block.settings.icon_color }};
    fill: none;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .ai-ideal-applications-text-{{ ai_gen_id }} {
    font-size: {{ block.settings.item_text_size }}px;
    font-weight: {{ block.settings.item_text_weight }};
    color: {{ block.settings.item_text_color }};
    line-height: 1.4;
  }

  .ai-ideal-applications-right-{{ ai_gen_id }} {
    position: relative;
  }

  .ai-ideal-applications-image-wrapper-{{ ai_gen_id }} {
    width: 100%;
    overflow: hidden;
    border-radius: {{ block.settings.image_border_radius }}px;
  }

  .ai-ideal-applications-image-{{ ai_gen_id }} {
    width: 100%;
    height: auto;
    display: block;
  }

  .ai-ideal-applications-image-placeholder-{{ ai_gen_id }} {
    width: 100%;
    aspect-ratio: 4 / 3;
    background-color: #f5f5f5;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: {{ block.settings.image_border_radius }}px;
  }

  .ai-ideal-applications-image-placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    max-width: 300px;
    max-height: 300px;
    opacity: 0.3;
  }

  @media screen and (max-width: 989px) {
    .ai-ideal-applications-content-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
      gap: 40px;
    }

    .ai-ideal-applications-left-{{ ai_gen_id }} {
      padding-right: 0;
      order: 2;
    }

    .ai-ideal-applications-right-{{ ai_gen_id }} {
      order: 1;
    }

    .ai-ideal-applications-heading-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.heading_size }}px * 0.8);
    }

    .ai-ideal-applications-list-{{ ai_gen_id }} {
      gap: {{ block.settings.list_gap | times: 0.8 }}px;
    }
  }

  @media screen and (max-width: 749px) {
    .ai-ideal-applications-{{ ai_gen_id }} {
      padding: {{ block.settings.section_padding_top | times: 0.7 }}px 0 {{ block.settings.section_padding_bottom | times: 0.7 }}px;
    }

    .ai-ideal-applications-list-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
    }

    .ai-ideal-applications-heading-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.heading_size }}px * 0.7);
    }
  }
{% endstyle %}

<ideal-applications-{{ ai_gen_id }} class="ai-ideal-applications-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-ideal-applications-container-{{ ai_gen_id }}">
    <div class="ai-ideal-applications-content-{{ ai_gen_id }}">
      <div class="ai-ideal-applications-left-{{ ai_gen_id }}">
        <div class="ai-ideal-applications-header-{{ ai_gen_id }}">
          {% if block.settings.heading != blank %}
            <h2 class="ai-ideal-applications-heading-{{ ai_gen_id }}">{{ block.settings.heading }}</h2>
          {% endif %}
          {% if block.settings.subtext != blank %}
            <div class="ai-ideal-applications-subtext-{{ ai_gen_id }}">{{ block.settings.subtext }}</div>
          {% endif %}
        </div>

        <ul class="ai-ideal-applications-list-{{ ai_gen_id }}">
          {% for i in (1..8) %}
            {% liquid
              assign item_text_key = 'item_' | append: i | append: '_text'
              assign item_icon_key = 'item_' | append: i | append: '_icon'
              assign item_text = block.settings[item_text_key]
              assign item_icon = block.settings[item_icon_key]
            %}
            {% if item_text != blank %}
              <li class="ai-ideal-applications-item-{{ ai_gen_id }}">
                <div class="ai-ideal-applications-icon-{{ ai_gen_id }}">
                  {% if item_icon == 'check' %}
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"></polyline></svg>
                  {% elsif item_icon == 'building' %}
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"><rect x="4" y="2" width="16" height="20" rx="2" ry="2"></rect><path d="M9 22v-4h6v4"></path><path d="M8 6h.01"></path><path d="M16 6h.01"></path><path d="M12 6h.01"></path><path d="M12 10h.01"></path><path d="M12 14h.01"></path><path d="M16 10h.01"></path><path d="M16 14h.01"></path><path d="M8 10h.01"></path><path d="M8 14h.01"></path></svg>
                  {% elsif item_icon == 'home' %}
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path><polyline points="9 22 9 12 15 12 15 22"></polyline></svg>
                  {% elsif item_icon == 'briefcase' %}
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"><rect x="2" y="7" width="20" height="14" rx="2" ry="2"></rect><path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"></path></svg>
                  {% elsif item_icon == 'shopping-cart' %}
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"><circle cx="9" cy="21" r="1"></circle><circle cx="20" cy="21" r="1"></circle><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path></svg>
                  {% elsif item_icon == 'truck' %}
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"><rect x="1" y="3" width="15" height="13"></rect><polygon points="16 8 20 8 23 11 23 16 16 16 16 8"></polygon><circle cx="5.5" cy="18.5" r="2.5"></circle><circle cx="18.5" cy="18.5" r="2.5"></circle></svg>
                  {% elsif item_icon == 'droplet' %}
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"><path d="M12 2.69l5.66 5.66a8 8 0 1 1-11.31 0z"></path></svg>
                  {% elsif item_icon == 'package' %}
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"><line x1="16.5" y1="9.4" x2="7.5" y2="4.21"></line><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"></path><polyline points="3.27 6.96 12 12.01 20.73 6.96"></polyline><line x1="12" y1="22.08" x2="12" y2="12"></line></svg>
                  {% elsif item_icon == 'users' %}
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><path d="M23 21v-2a4 4 0 0 0-3-3.87"></path><path d="M16 3.13a4 4 0 0 1 0 7.75"></path></svg>
                  {% elsif item_icon == 'star' %}
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon></svg>
                  {% elsif item_icon == 'shield' %}
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path></svg>
                  {% elsif item_icon == 'zap' %}
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon></svg>
                  {% elsif item_icon == 'award' %}
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"><circle cx="12" cy="8" r="7"></circle><polyline points="8.21 13.89 7 23 12 20 17 23 15.79 13.88"></polyline></svg>
                  {% elsif item_icon == 'tool' %}
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"><path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"></path></svg>
                  {% else %}
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"></polyline></svg>
                  {% endif %}
                </div>
                <span class="ai-ideal-applications-text-{{ ai_gen_id }}">{{ item_text }}</span>
              </li>
            {% endif %}
          {% endfor %}
        </ul>
      </div>

      <div class="ai-ideal-applications-right-{{ ai_gen_id }}">
        <div class="ai-ideal-applications-image-wrapper-{{ ai_gen_id }}">
          {% if block.settings.image %}
            <img
              src="{{ block.settings.image | image_url: width: 1200 }}"
              alt="{{ block.settings.image.alt | escape }}"
              loading="lazy"
              width="{{ block.settings.image.width }}"
              height="{{ block.settings.image.height }}"
              class="ai-ideal-applications-image-{{ ai_gen_id }}"
            >
          {% else %}
            <div class="ai-ideal-applications-image-placeholder-{{ ai_gen_id }}">
              {{ 'product-apparel-1' | placeholder_svg_tag }}
            </div>
          {% endif %}
        </div>
      </div>
    </div>
  </div>
</ideal-applications-{{ ai_gen_id }}>

<script>
  (function() {
    class IdealApplications{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }
    }
    customElements.define('ideal-applications-{{ ai_gen_id }}', IdealApplications{{ ai_gen_id }});
  })();
</script>

