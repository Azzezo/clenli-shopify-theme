{% doc %}
  @prompt
    Create a premium content section for a professional cleaning machine webpage.
    
    Start with a heading. Then divide the space below horizontally into three blocks, with each of the three blocks to have a place to input text or html. All blocks must fit horizontally across the page without stacking on desktop. 
    
    
    Design requirements:
    - Premium industrial aesthetic
    - Minimalist typography
    - Modern commercial styling
    - White space between sections
    - Responsive stacking on mobile
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-premium-content-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    margin: 0 auto;
    padding: {{ block.settings.section_padding_top }}px 20px {{ block.settings.section_padding_bottom }}px;
  }

  .ai-premium-content__heading-{{ ai_gen_id }} {
    text-align: {{ block.settings.heading_alignment }};
    margin: 0 0 {{ block.settings.heading_spacing }}px;
    font-size: {{ block.settings.heading_size }}px;
    font-weight: {{ block.settings.heading_weight }};
    color: {{ block.settings.heading_color }};
    text-transform: {{ block.settings.heading_transform }};
    letter-spacing: {{ block.settings.heading_letter_spacing }};
  }

  .ai-premium-content__grid-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: {{ block.settings.column_gap }}px;
    margin: 0;
  }

  .ai-premium-content__column-{{ ai_gen_id }} {
    background-color: {{ block.settings.column_bg_color }};
    padding: {{ block.settings.column_padding }}px;
    border: {{ block.settings.border_width }}px solid {{ block.settings.border_color }};
    border-radius: {{ block.settings.border_radius }}px;
  }

  .ai-premium-content__column-content-{{ ai_gen_id }} {
    color: {{ block.settings.text_color }};
    font-size: {{ block.settings.text_size }}px;
    line-height: {{ block.settings.text_line_height }};
  }

  .ai-premium-content__column-content-{{ ai_gen_id }} p {
    margin: 0 0 1em;
  }

  .ai-premium-content__column-content-{{ ai_gen_id }} p:last-child {
    margin-bottom: 0;
  }

  .ai-premium-content__column-content-{{ ai_gen_id }} h1,
  .ai-premium-content__column-content-{{ ai_gen_id }} h2,
  .ai-premium-content__column-content-{{ ai_gen_id }} h3,
  .ai-premium-content__column-content-{{ ai_gen_id }} h4,
  .ai-premium-content__column-content-{{ ai_gen_id }} h5,
  .ai-premium-content__column-content-{{ ai_gen_id }} h6 {
    margin: 0 0 0.5em;
    color: {{ block.settings.text_color }};
  }

  .ai-premium-content__column-content-{{ ai_gen_id }} ul,
  .ai-premium-content__column-content-{{ ai_gen_id }} ol {
    margin: 0 0 1em;
    padding-left: 1.5em;
  }

  @media screen and (max-width: 989px) {
    .ai-premium-content__grid-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
      gap: {{ block.settings.mobile_column_gap }}px;
    }

    .ai-premium-content__heading-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.heading_size }}px * 0.8);
    }

    .ai-premium-content__column-content-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.text_size }}px * 0.95);
    }
  }
{% endstyle %}

<div class="ai-premium-content-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  {% if block.settings.heading != blank %}
    <h2 class="ai-premium-content__heading-{{ ai_gen_id }}">
      {{ block.settings.heading }}
    </h2>
  {% endif %}

  <div class="ai-premium-content__grid-{{ ai_gen_id }}">
    <div class="ai-premium-content__column-{{ ai_gen_id }}">
      <div class="ai-premium-content__column-content-{{ ai_gen_id }}">
        {% if block.settings.column_1_content != blank %}
          {{ block.settings.column_1_content }}
        {% else %}
          <p>Add content for column 1</p>
        {% endif %}
      </div>
    </div>

    <div class="ai-premium-content__column-{{ ai_gen_id }}">
      <div class="ai-premium-content__column-content-{{ ai_gen_id }}">
        {% if block.settings.column_2_content != blank %}
          {{ block.settings.column_2_content }}
        {% else %}
          <p>Add content for column 2</p>
        {% endif %}
      </div>
    </div>

    <div class="ai-premium-content__column-{{ ai_gen_id }}">
      <div class="ai-premium-content__column-content-{{ ai_gen_id }}">
        {% if block.settings.column_3_content != blank %}
          {{ block.settings.column_3_content }}
        {% else %}
          <p>Add content for column 3</p>
        {% endif %}
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Premium content",
  "settings": [
    {
      "type": "header",
      "content": "Heading"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "default": "Professional cleaning solutions"
    },
    {
      "type": "select",
      "id": "heading_alignment",
      "label": "Alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "center"
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Size",
      "min": 16,
      "max": 72,
      "step": 2,
      "unit": "px",
      "default": 32
    },
    {
      "type": "select",
      "id": "heading_weight",
      "label": "Weight",
      "options": [
        {
          "value": "400",
          "label": "Normal"
        },
        {
          "value": "500",
          "label": "Medium"
        },
        {
          "value": "600",
          "label": "Semi-bold"
        },
        {
          "value": "700",
          "label": "Bold"
        }
      ],
      "default": "600"
    },
    {
      "type": "select",
      "id": "heading_transform",
      "label": "Text transform",
      "options": [
        {
          "value": "none",
          "label": "None"
        },
        {
          "value": "uppercase",
          "label": "Uppercase"
        },
        {
          "value": "lowercase",
          "label": "Lowercase"
        },
        {
          "value": "capitalize",
          "label": "Capitalize"
        }
      ],
      "default": "none"
    },
    {
      "type": "text",
      "id": "heading_letter_spacing",
      "label": "Letter spacing",
      "default": "0em"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Color",
      "default": "#1a1a1a"
    },
    {
      "type": "range",
      "id": "heading_spacing",
      "label": "Bottom spacing",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "default": 40
    },
    {
      "type": "header",
      "content": "Column 1"
    },
    {
      "type": "html",
      "id": "column_1_content",
      "label": "Content"
    },
    {
      "type": "header",
      "content": "Column 2"
    },
    {
      "type": "html",
      "id": "column_2_content",
      "label": "Content"
    },
    {
      "type": "header",
      "content": "Column 3"
    },
    {
      "type": "html",
      "id": "column_3_content",
      "label": "Content"
    },
    {
      "type": "header",
      "content": "Column style"
    },
    {
      "type": "color",
      "id": "column_bg_color",
      "label": "Background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#4a4a4a"
    },
    {
      "type": "range",
      "id": "text_size",
      "label": "Text size",
      "min": 12,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 15
    },
    {
      "type": "range",
      "id": "text_line_height",
      "label": "Line height",
      "min": 1,
