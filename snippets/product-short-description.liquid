{%- liquid
    assign desc = blank
    assign fontsize_text = block.settings.fontsize_text
    assign color_text = block.settings.color_text
-%}
{% if product.metafields.c_f.short_description != blank %}
    {%- liquid
        assign desc = product.metafields.c_f.short_description
    -%}
{% elsif product.metafields.custom.short_description != blank %}
    {%- liquid
        assign desc = product.metafields.custom.short_description
    -%}
{% endif %}
<div class="productView-desc halo-text-format" data-product-short-desc="{{ product.id }}"
    style="--color-text: {{ color_text }};
    --fontsize-text: {{ fontsize_text | append: 'px' }}"
>   
    {%- if desc != blank -%}
        {{ desc }}
    {%- endif -%}
</div>