{%- comment -%}
  Product Rating Stars - Displays star rating below product title
  Similar to Magento 2 site layout

  Parameters:
    - product: The product object
    - show_add_review: Boolean to show "Add Your Review" link (default: true)
{%- endcomment -%}

{%- liquid
  assign rating = product.metafields.reviews.rating.value.rating | default: 5
  assign rating_rounded = rating | round
  assign scale_max = product.metafields.reviews.rating.value.scale_max | default: 5
  assign review_count = product.metafields.reviews.rating_count | default: 0
  assign show_add_review = show_add_review | default: true
-%}

<div class="product-rating-stars-wrapper">
  <div class="product-rating-stars">
    {%- for i in (1..5) -%}
      {%- if i <= rating_rounded -%}
        <svg class="star star-filled" width="18" height="18" viewBox="0 0 24 24" fill="#f7a41f" xmlns="http://www.w3.org/2000/svg">
          <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/>
        </svg>
      {%- else -%}
        <svg class="star star-empty" width="18" height="18" viewBox="0 0 24 24" fill="#ddd" xmlns="http://www.w3.org/2000/svg">
          <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/>
        </svg>
      {%- endif -%}
    {%- endfor -%}
  </div>

  <a href="#tab-content-reviews_tab" class="product-review-count" data-scroll-to-reviews>
    {{ review_count }} {% if review_count == 1 %}Review{% else %}Reviews{% endif %}
  </a>

  {%- if show_add_review -%}
    <a href="#tab-content-reviews_tab" class="product-add-review" data-scroll-to-reviews>
      Add Your Review
    </a>
  {%- endif -%}
</div>

<style>
  .product-rating-stars-wrapper {
    display: flex;
    align-items: center;
    gap: 10px;
    flex-wrap: wrap;
    margin-top: 8px;
    margin-bottom: 15px;
  }

  .product-rating-stars {
    display: flex;
    align-items: center;
    gap: 2px;
  }

  .product-rating-stars .star {
    display: inline-block;
    vertical-align: middle;
  }

  .product-rating-stars .star-filled {
    fill: #f7a41f; /* Orange/Gold color like Magento */
  }

  .product-rating-stars .star-empty {
    fill: #e0e0e0;
  }

  .product-review-count {
    font-size: 13px;
    color: #6fb31a;
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .product-review-count:hover {
    color: #23527c;
    text-decoration: underline;
  }

  .product-add-review {
    font-size: 13px;
    color: #6fb31a;
    text-decoration: none;
    padding-left: 10px;
    border-left: 1px solid #ccc;
    transition: color 0.2s ease;
  }

  .product-add-review:hover {
    color: #23527c;
    text-decoration: underline;
  }

  /* Mobile responsive */
  @media (max-width: 767px) {
    .product-rating-stars-wrapper {
      gap: 8px;
    }

    .product-rating-stars .star {
      width: 14px;
      height: 14px;
    }

    .product-review-count,
    .product-add-review {
      font-size: 12px;
    }
  }
</style>

<script>
  /* Smooth scroll to reviews tab when clicking review links */
  document.addEventListener('DOMContentLoaded', function() {
    var reviewLinks = document.querySelectorAll('[data-scroll-to-reviews]');
    reviewLinks.forEach(function(link) {
      link.addEventListener('click', function(e) {
        e.preventDefault();
        var targetId = this.getAttribute('href').substring(1);
        var targetElement = document.getElementById(targetId);
        
        /* If there's a tab system, try to activate the reviews tab */
        var reviewsTabTrigger = document.querySelector('[data-tab-trigger="reviews_tab"]');
        if (reviewsTabTrigger) {
          reviewsTabTrigger.click();
        }
        
        /* Also try accordion trigger for mobile */
        var reviewsAccordionTrigger = document.querySelector('[data-accordion-trigger="reviews_tab"]');
        if (reviewsAccordionTrigger && !reviewsAccordionTrigger.classList.contains('is-open')) {
          reviewsAccordionTrigger.click();
        }

        /* Scroll to the reviews section */
        if (targetElement) {
          setTimeout(function() {
            targetElement.scrollIntoView({ behavior: 'smooth', block: 'start' });
          }, 100);
        } else {
          /* Fallback: try to find any element with reviews in it */
          var reviewsSection = document.querySelector('.moreItem-reviews-tab, [id*="reviews"], [class*="reviews-tab"]');
          if (reviewsSection) {
            setTimeout(function() {
              reviewsSection.scrollIntoView({ behavior: 'smooth', block: 'start' });
            }, 100);
          }
        }
      });
    });
  });
</script>

