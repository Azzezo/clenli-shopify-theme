{% doc %}
  @prompt
    Design a modern embedded product video section for a professional machinery webpage.
    
    Include:
    - Large embedded video player placeholder
    - Play button overlay
    - Supporting text beside or below the video
    
    The section should visually communicate:
    - Product performance
    - Ease of use
    - Commercial cleaning capability
    - Professional operation
    - Compact portability
    
    Style:
    - Premium product showcase aesthetic
    - Dark/light balanced layout
    - Minimalist styling
    - Spacious padding
    - Commercial industrial feel
    - Large visual focus on the video
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-product-video-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    background-color: {{ block.settings.background_color }};
    padding: {{ block.settings.section_padding_top }}px {{ block.settings.section_padding_horizontal }}px {{ block.settings.section_padding_bottom }}px;
  }

  .ai-product-video-container-{{ ai_gen_id }} {
    max-width: {{ block.settings.container_max_width }}px;
    margin: 0 auto;
    display: flex;
    flex-direction: {{ block.settings.layout }};
    gap: {{ block.settings.content_gap }}px;
    align-items: center;
  }

  .ai-product-video-player-wrapper-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    flex: 1;
    background-color: {{ block.settings.video_background_color }};
    border-radius: {{ block.settings.video_border_radius }}px;
    overflow: hidden;
  }

  .ai-product-video-aspect-ratio-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    padding-bottom: 56.25%;
  }

  .ai-product-video-placeholder-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    background: linear-gradient(135deg, {{ block.settings.placeholder_gradient_start }} 0%, {{ block.settings.placeholder_gradient_end }} 100%);
  }

  .ai-product-video-placeholder-{{ ai_gen_id }} svg {
    width: 120px;
    height: 120px;
    opacity: 0.3;
  }

  .ai-product-video-iframe-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    border: none;
  }

  .ai-product-video-play-overlay-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: rgba(0, 0, 0, {{ block.settings.overlay_opacity }});
    cursor: pointer;
    transition: background-color 0.3s ease;
    z-index: 2;
  }

  .ai-product-video-play-overlay-{{ ai_gen_id }}:hover {
    background-color: rgba(0, 0, 0, {{ block.settings.overlay_opacity | plus: 0.1 }});
  }

  .ai-product-video-play-button-{{ ai_gen_id }} {
    width: {{ block.settings.play_button_size }}px;
    height: {{ block.settings.play_button_size }}px;
    border-radius: 50%;
    background-color: {{ block.settings.play_button_color }};
    display: flex;
    align-items: center;
    justify-content: center;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.3);
  }

  .ai-product-video-play-overlay-{{ ai_gen_id }}:hover .ai-product-video-play-button-{{ ai_gen_id }} {
    transform: scale(1.1);
    box-shadow: 0 6px 30px rgba(0, 0, 0, 0.4);
  }

  .ai-product-video-play-icon-{{ ai_gen_id }} {
    width: calc({{ block.settings.play_button_size }}px * 0.4);
    height: calc({{ block.settings.play_button_size }}px * 0.4);
    margin-left: calc({{ block.settings.play_button_size }}px * 0.05);
    fill: {{ block.settings.play_icon_color }};
  }

  .ai-product-video-content-{{ ai_gen_id }} {
    flex: 0 0 {{ block.settings.content_width }}%;
    display: flex;
    flex-direction: column;
    gap: {{ block.settings.text_spacing }}px;
  }

  .ai-product-video-heading-{{ ai_gen_id }} {
    font-size: {{ block.settings.heading_size }}px;
    font-weight: {{ block.settings.heading_weight }};
    color: {{ block.settings.heading_color }};
    margin: 0;
    line-height: 1.2;
    text-transform: {{ block.settings.heading_transform }};
  }

  .ai-product-video-description-{{ ai_gen_id }} {
    font-size: {{ block.settings.description_size }}px;
    color: {{ block.settings.description_color }};
    line-height: 1.6;
    margin: 0;
  }

  .ai-product-video-features-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: {{ block.settings.feature_spacing }}px;
    margin-top: {{ block.settings.features_margin_top }}px;
  }

  .ai-product-video-feature-{{ ai_gen_id }} {
    display: flex;
    align-items: flex-start;
    gap: 12px;
  }

  .ai-product-video-feature-icon-{{ ai_gen_id }} {
    width: {{ block.settings.feature_icon_size }}px;
    height: {{ block.settings.feature_icon_size }}px;
    flex-shrink: 0;
    fill: {{ block.settings.feature_icon_color }};
    margin-top: 2px;
  }

  .ai-product-video-feature-text-{{ ai_gen_id }} {
    font-size: {{ block.settings.feature_text_size }}px;
    color: {{ block.settings.feature_text_color }};
    line-height: 1.5;
    margin: 0;
  }

  .ai-product-video-empty-state-{{ ai_gen_id }} {
    position: absolute;
    bottom: 20px;
    left: 50%;
    transform: translateX(-50%);
    padding: 12px 24px;
    background-color: rgba(255, 255, 255, 0.9);
    border-radius: 4px;
    font-size: 14px;
    color: #666;
    text-align: center;
    pointer-events: none;
    z-index: 1;
  }

  @media screen and (max-width: 989px) {
    .ai-product-video-container-{{ ai_gen_id }} {
      flex-direction: column;
    }

    .ai-product-video-content-{{ ai_gen_id }} {
      flex: 1;
      width: 100%;
    }

    .ai-product-video-heading-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.heading_size }}px * 0.8);
    }

    .ai-product-video-{{ ai_gen_id }} {
      padding: {{ block.settings.section_padding_top | times: 0.6 }}px {{ block.settings.section_padding_horizontal | times: 0.6 }}px {{ block.settings.section_padding_bottom | times: 0.6 }}px;
    }
  }

  @media screen and (max-width: 749px) {
    .ai-product-video-play-button-{{ ai_gen_id }} {
      width: calc({{ block.settings.play_button_size }}px * 0.8);
      height: calc({{ block.settings.play_button_size }}px * 0.8);
    }

    .ai-product-video-play-icon-{{ ai_gen_id }} {
      width: calc({{ block.settings.play_button_size }}px * 0.32);
      height: calc({{ block.settings.play_button_size }}px * 0.32);
    }
  }
{% endstyle %}

<product-video-{{ ai_gen_id }} class="ai-product-video-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-product-video-container-{{ ai_gen_id }}">
    <div class="ai-product-video-player-wrapper-{{ ai_gen_id }}">
      <div class="ai-product-video-aspect-ratio-{{ ai_gen_id }}">
        {% if block.settings.video_url != blank %}
          <iframe
            class="ai-product-video-iframe-{{ ai_gen_id }}"
            data-video-url="{{ block.settings.video_url }}"
            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
            allowfullscreen
          ></iframe>
          {% if block.settings.show_play_button %}
            <div class="ai-product-video-play-overlay-{{ ai_gen_id }}" data-play-overlay>
              <div class="ai-product-video-play-button-{{ ai_gen_id }}">
                <svg class="ai-product-video-play-icon-{{ ai_gen_id }}" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                  <path d="M8 5v14l11-7z"/>
                </svg>
              </div>
            </div>
          {% endif %}
        {% else %}
          <div class="ai-product-video-placeholder-{{ ai_gen_id }}">
            <svg viewBox="0 0 24 24" fill="currentColor" xmlns="http://www.w3.org/2000/svg">
              <path d="M17 10.5V7c0-.55-.45-1-1-1H4c-.55 0-1 .45-1 1v10c0 .55.45 1 1 1h12c.55 0 1-.45 1-1v-3.5l4 4v-11l-4 4z"/>
            </svg>
            <div class="ai-product-video-empty-state-{{ ai_gen_id }}">
              Add a video URL to get started
            </div>
          </div>
        {% endif %}
      </div>
    </div>

    <div class="ai-product-video-content-{{ ai_gen_id }}">
      {% if block.settings.heading != blank %}
        <h2 class="ai-product-video-heading-{{ ai_gen_id }}">{{ block.settings.heading }}</h2>
      {% endif %}

      {% if block.settings.description != blank %}
        <div class="ai-product-video-description-{{ ai_gen_id }}">
          {{ block.settings.description }}
        </div>
      {% endif %}

      {% if block.settings.show_features %}
        <div class="ai-product-video-features-{{ ai_gen_id }}">
          {% if block.settings.feature_1 != blank %}
            <div class="ai-product-video-feature-{{ ai_gen_id }}">
              <svg class="ai-product-video-feature-icon-{{ ai_gen_id }}" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                <path d="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z"/>
              </svg>
              <p class="ai-product-video-feature-text-{{ ai_gen_id }}">{{ block.settings.feature_1 }}</p>
            </div>
          {% endif %}

          {% if block.settings.feature_2 != blank %}
            <div class="ai-product-video-feature-{{ ai_gen_id }}">
              <svg class="ai-product-video-feature-icon-{{ ai_gen_id }}" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                <path d="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z"/>
              </svg>
              <p class="ai-product-video-feature-text-{{ ai_gen_id }}">{{ block.settings.feature_2 }}</p>
            </div>
          {% endif %}

          {% if block.settings.feature_3 != blank %}
            <div class="ai-product-video-feature-{{ ai_gen_id }}">
              <svg class="ai-product-video-feature-icon-{{ ai_gen_id }}" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                <path d="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z"/>
              </svg>
              <p class="ai-product-video-feature-text-{{ ai_gen_id }}">{{ block.settings.feature_3 }}</p>
            </div>
          {% endif %}

          {% if block.settings.feature_4 != blank %}
            <div class="ai-product-video-feature-{{ ai_gen_id }}">
              <svg class="ai-product-video-feature-icon-{{ ai_gen_id }}" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                <path d="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z"/>
              </svg>
              <p class="ai-product-video-feature-text-{{ ai_gen_id }}">{{ block.settings.feature_4 }}</p>
            </div>
          {% endif %}

          {% if block.settings.feature_5 != blank %}
            <div class="ai-product-video-feature-{{ ai_gen_id }}">
              <svg class="ai-product-video-feature-icon-{{ ai_gen_id }}" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                <path d="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z"/>
              </svg>
              <p class="ai-product-video-feature-text-{{ ai_gen_id }}">{{ block.settings.feature_5 }}</p>
            </div>
          {% endif %}
        </div>
      {% endif %}
    </div>
  </div>
</product-video-{{ ai_gen_id }}>

<script>
  (function() {
    class ProductVideo{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.iframe = this.querySelector('.ai-product-video-iframe-{{ ai_gen_id }}');
        this.playOverlay = this.querySelector('[data-play-overlay]');
        
        if (this.iframe && this.playOverlay) {
          this.setupVideo();
        }
      }

      setupVideo() {
        const videoUrl = this.iframe.dataset.videoUrl;
        
        if (!videoUrl) return;

        const embedUrl = this.getEmbedUrl(videoUrl);
        
        this.playOverlay.addEventListener('click', () => {
          this.iframe.src = embedUrl + '&autoplay=1';
          this.playOverlay.style.display = 'none';
        });
      }

      getEmbedUrl(url) {
        if (url.includes('youtube.com') || url.includes('youtu.be')) {
          let videoId = '';
          
          if (url.includes('youtu.be/')) {
            videoId = url.split('youtu.be/')[1].split('?')[0];
          } else if (url.includes('youtube.com/watch')) {
            const urlParams = new URLSearchParams(url.split('?')[1]);
            videoId = urlParams.get('v');
          } else if (url.includes('youtube.com/embed/')) {
            videoId = url.split('embed/')[1].split('?')[0];
          }
          
          return `https://www.youtube.com/embed/${videoId}?rel=0`;
        } else if (url.includes('vimeo.com')) {
          const videoId = url.split('vimeo.com/')[1].split('?')[0];
          return `https://player.vimeo.com/video/${videoId}`;
        }
        
        return url;
      }
    }

    customElements.define('product-video-{{ ai_gen_id }}', ProductVideo{{ ai_gen_id }});
  })();
</script>

