{% doc %}
  @prompt
    Create a clean modern technical specifications section for a professional machinery product page.
    
    Design:
    - Responsive specification table
    - Modern industrial appearance
    - High readability
    - Minimal borders
    - Alternating subtle row colours
    
    The layout should support:
    - Technical specifications
    - Dimensions
    - Motor details
    - Tank capacities
    - Power supply information
    - Weight and measurements
    - Cleaning performance data
    
    Style:
    - Professional B2B layout
    - Simple typography
    - White/light grey theme
    - Minimal clutter
    - Mobile responsive accordion/table adaptation
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-tech-specs-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    padding: {{ block.settings.section_padding }}px 0;
  }

  .ai-tech-specs-container-{{ ai_gen_id }} {
    background-color: {{ block.settings.background_color }};
    border-radius: {{ block.settings.border_radius }}px;
    padding: {{ block.settings.container_padding }}px;
  }

  .ai-tech-specs-heading-{{ ai_gen_id }} {
    margin: 0 0 {{ block.settings.heading_margin_bottom }}px;
    font-size: {{ block.settings.heading_size }}px;
    font-weight: {{ block.settings.heading_weight }};
    color: {{ block.settings.heading_color }};
    text-transform: {{ block.settings.heading_transform }};
  }

  .ai-tech-specs-table-{{ ai_gen_id }} {
    width: 100%;
    border-collapse: collapse;
    font-size: {{ block.settings.text_size }}px;
  }

  .ai-tech-specs-row-{{ ai_gen_id }} {
    border-bottom: {{ block.settings.row_border_width }}px solid {{ block.settings.row_border_color }};
  }

  .ai-tech-specs-row-{{ ai_gen_id }}:last-child {
    border-bottom: none;
  }

  .ai-tech-specs-row-{{ ai_gen_id }}:nth-child(even) {
    background-color: {{ block.settings.row_alternate_color }};
  }

  .ai-tech-specs-label-{{ ai_gen_id }} {
    padding: {{ block.settings.cell_padding }}px;
    font-weight: {{ block.settings.label_weight }};
    color: {{ block.settings.label_color }};
    width: {{ block.settings.label_width }}%;
    vertical-align: top;
  }

  .ai-tech-specs-value-{{ ai_gen_id }} {
    padding: {{ block.settings.cell_padding }}px;
    color: {{ block.settings.value_color }};
    vertical-align: top;
  }

  @media screen and (max-width: 749px) {
    .ai-tech-specs-{{ ai_gen_id }} {
      width: 100%;
    }

    .ai-tech-specs-container-{{ ai_gen_id }} {
      padding: {{ block.settings.container_padding | times: 0.6 }}px;
    }

    .ai-tech-specs-heading-{{ ai_gen_id }} {
      font-size: {{ block.settings.heading_size | times: 0.8 }}px;
    }

    .ai-tech-specs-table-{{ ai_gen_id }} {
      font-size: {{ block.settings.text_size | times: 0.9 }}px;
    }

    {% if block.settings.mobile_layout == 'accordion' %}
      .ai-tech-specs-table-{{ ai_gen_id }} {
        display: block;
      }

      .ai-tech-specs-row-{{ ai_gen_id }} {
        display: block;
        margin-bottom: 8px;
        border: {{ block.settings.row_border_width }}px solid {{ block.settings.row_border_color }};
        border-radius: 4px;
        overflow: hidden;
      }

      .ai-tech-specs-row-{{ ai_gen_id }}:nth-child(even) {
        background-color: transparent;
      }

      .ai-tech-specs-label-{{ ai_gen_id }} {
        display: block;
        width: 100%;
        background-color: {{ block.settings.row_alternate_color }};
        padding: 12px;
        cursor: pointer;
        position: relative;
      }

      .ai-tech-specs-label-{{ ai_gen_id }}::after {
        content: '+';
        position: absolute;
        right: 12px;
        top: 50%;
        transform: translateY(-50%);
        font-size: 20px;
        transition: transform 0.3s ease;
      }

      .ai-tech-specs-label-{{ ai_gen_id }}.active::after {
        content: '−';
      }

      .ai-tech-specs-value-{{ ai_gen_id }} {
        display: none;
        width: 100%;
        padding: 12px;
        background-color: {{ block.settings.background_color }};
      }

      .ai-tech-specs-value-{{ ai_gen_id }}.active {
        display: block;
      }
    {% else %}
      .ai-tech-specs-label-{{ ai_gen_id }},
      .ai-tech-specs-value-{{ ai_gen_id }} {
        display: block;
        width: 100%;
        padding: {{ block.settings.cell_padding | times: 0.7 }}px;
      }

      .ai-tech-specs-label-{{ ai_gen_id }} {
        padding-bottom: 4px;
      }

      .ai-tech-specs-value-{{ ai_gen_id }} {
        padding-top: 0;
      }
    {% endif %}
  }
{% endstyle %}

<tech-specs-{{ ai_gen_id }} class="ai-tech-specs-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
