<script>
  (function() {
    class TechSpecs{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        if (window.innerWidth <= 749) {
          this.setupMobileAccordion();
        }

        window.addEventListener('resize', () => {
          if (window.innerWidth <= 749) {
            this.setupMobileAccordion();
          }
        });
      }

      setupMobileAccordion() {
        const labels = this.querySelectorAll('.ai-tech-specs-label-{{ ai_gen_id }}');
        
        labels.forEach((label) => {
          const row = label.closest('.ai-tech-specs-row-{{ ai_gen_id }}');
          const value = row.querySelector('.ai-tech-specs-value-{{ ai_gen_id }}');
          
          if (!label.hasAttribute('data-accordion-initialized')) {
            label.setAttribute('data-accordion-initialized', 'true');
            
            label.addEventListener('click', () => {
              const isActive = label.classList.contains('active');
              
              labels.forEach((l) => {
                l.classList.remove('active');
                const v = l.closest('.ai-tech-specs-row-{{ ai_gen_id }}').querySelector('.ai-tech-specs-value-{{ ai_gen_id }}');
                if (v) {
                  v.classList.remove('active');
                }
              });
              
              if (!isActive) {
                label.classList.add('active');
                if (value) {
                  value.classList.add('active');
                }
              }
            });
          }
        });
      }
    }

    customElements.define('tech-specs-{{ ai_gen_id }}', TechSpecs{{ ai_gen_id }});
  })();
</script>

