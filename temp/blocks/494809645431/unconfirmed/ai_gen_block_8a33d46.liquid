{% doc %}
  @prompt
    Create a premium alternating content section for a professional cleaning machine webpage.
    
    Start with a heading, followed by three alternating content sections (left-right layouts with image and text combinations) that all fit in one line horizontally on a desktop view.
    
    Each feature block should contain:
    - Large clean supporting image
    - Bold feature heading
    - Short explanatory paragraph
    - Optional supporting bullet points
    
    Feature topics should include:
    - Ergonomic operation
    - High extraction performance
    - Durable commercial construction
    - Ease of maintenance
    - Professional usability
    
    Design requirements:
    - Large clean imagery
    - Alternating image/text layout
    - Premium industrial aesthetic
    - Minimalist typography
    - Soft grey backgrounds
    - Modern commercial styling
    - White space between sections
    - Responsive stacking on mobile
    
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-alternating-content-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    margin: 0 auto;
    padding: {{ block.settings.section_padding_top }}px 20px {{ block.settings.section_padding_bottom }}px;
  }

  .ai-alternating-content__heading-{{ ai_gen_id }} {
    text-align: {{ block.settings.heading_alignment }};
    margin: 0 0 {{ block.settings.heading_margin_bottom }}px;
    font-size: {{ block.settings.heading_font_size }}px;
    font-weight: {{ block.settings.heading_font_weight }};
    color: {{ block.settings.heading_color }};
    line-height: 1.2;
  }

  .ai-alternating-content__features-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: {{ block.settings.feature_spacing }}px;
  }

  .ai-alternating-content__feature-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    gap: {{ block.settings.content_gap }}px;
    background-color: {{ block.settings.feature_background }};
    padding: {{ block.settings.feature_padding }}px;
    border-radius: {{ block.settings.border_radius }}px;
  }

  .ai-alternating-content__feature-{{ ai_gen_id }}--reverse {
    flex-direction: row-reverse;
  }

  .ai-alternating-content__image-wrapper-{{ ai_gen_id }} {
    flex: 0 0 {{ block.settings.image_width }}%;
    max-width: {{ block.settings.image_width }}%;
  }

  .ai-alternating-content__image-{{ ai_gen_id }} {
    width: 100%;
    height: auto;
    display: block;
    border-radius: {{ block.settings.image_border_radius }}px;
    object-fit: cover;
  }

  .ai-alternating-content__image-placeholder-{{ ai_gen_id }} {
    width: 100%;
    aspect-ratio: 16 / 9;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: {{ block.settings.image_border_radius }}px;
    position: relative;
  }

  .ai-alternating-content__image-placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-alternating-content__text-wrapper-{{ ai_gen_id }} {
    flex: 1;
    min-width: 0;
  }

  .ai-alternating-content__feature-heading-{{ ai_gen_id }} {
    font-size: {{ block.settings.feature_heading_size }}px;
    font-weight: {{ block.settings.feature_heading_weight }};
    color: {{ block.settings.feature_heading_color }};
    margin: 0 0 {{ block.settings.feature_heading_margin }}px;
    line-height: 1.3;
  }

  .ai-alternating-content__description-{{ ai_gen_id }} {
    font-size: {{ block.settings.description_size }}px;
    color: {{ block.settings.description_color }};
    line-height: 1.6;
    margin: 0 0 {{ block.settings.description_margin }}px;
  }

  .ai-alternating-content__bullets-{{ ai_gen_id }} {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .ai-alternating-content__bullet-{{ ai_gen_id }} {
    font-size: {{ block.settings.bullet_size }}px;
    color: {{ block.settings.bullet_color }};
    line-height: 1.6;
    padding-left: 24px;
    position: relative;
    margin-bottom: 8px;
  }

  .ai-alternating-content__bullet-{{ ai_gen_id }}:last-child {
    margin-bottom: 0;
  }

  .ai-alternating-content__bullet-{{ ai_gen_id }}::before {
    content: '';
    position: absolute;
    left: 0;
    top: 10px;
    width: 6px;
    height: 6px;
    background-color: {{ block.settings.bullet_point_color }};
    border-radius: 50%;
  }

  @media screen and (max-width: 768px) {
    .ai-alternating-content__feature-{{ ai_gen_id }},
    .ai-alternating-content__feature-{{ ai_gen_id }}--reverse {
      flex-direction: column;
      gap: {{ block.settings.mobile_content_gap }}px;
    }

    .ai-alternating-content__image-wrapper-{{ ai_gen_id }} {
      flex: 0 0 100%;
      max-width: 100%;
    }

    .ai-alternating-content__heading-{{ ai_gen_id }} {
      font-size: {{ block.settings.heading_font_size | times: 0.8 }}px;
    }

    .ai-alternating-content__feature-heading-{{ ai_gen_id }} {
      font-size: {{ block.settings.feature_heading_size | times: 0.85 }}px;
    }
  }
{% endstyle %}

<div class="ai-alternating-content-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  {% if block.settings.main_heading != blank %}
    <h2 class="ai-alternating-content__heading-{{ ai_gen_id }}">
      {{ block.settings.main_heading }}
    </h2>
  {% endif %}

  <div class="ai-alternating-content__features-{{ ai_gen_id }}">
    {% for i in (1..3) %}
      {% liquid
        assign feature_enabled_key = 'feature_' | append: i | append: '_enabled'
        assign feature_image_key = 'feature_' | append: i | append: '_image'
        assign feature_heading_key = 'feature_' | append: i | append: '_heading'
        assign feature_description_key = 'feature_' | append: i | append: '_description'
        assign feature_bullet_1_key = 'feature_' | append: i | append: '_bullet_1'
        assign feature_bullet_2_key = 'feature_' | append: i | append: '_bullet_2'
        assign feature_bullet_3_key = 'feature_' | append: i | append: '_bullet_3'

        assign feature_enabled = block.settings[feature_enabled_key]
        assign feature_image = block.settings[feature_image_key]
        assign feature_heading = block.settings[feature_heading_key]
        assign feature_description = block.settings[feature_description_key]
        assign feature_bullet_1 = block.settings[feature_bullet_1_key]
        assign feature_bullet_2 = block.settings[feature_bullet_2_key]
        assign feature_bullet_3 = block.settings[feature_bullet_3_key]

        assign is_reverse = false
        if i == 2
          assign is_reverse = true
        endif
      %}

      {% if feature_enabled %}
        <div class="ai-alternating-content__feature-{{ ai_gen_id }} {% if is_reverse %}ai-alternating-content__feature-{{ ai_gen_id }}--reverse{% endif %}">
          <div class="ai-alternating-content__image-wrapper-{{ ai_gen_id }}">
            {% if feature_image %}
              <img
                src="{{ feature_image | image_url: width: 1200 }}"
                alt="{{ feature_image.alt | escape }}"
                loading="lazy"
                width="{{ feature_image.width }}"
                height="{{ feature_image.height }}"
                class="ai-alternating-content__image-{{ ai_gen_id }}"
              >
            {% else %}
              <div class="ai-alternating-content__image-placeholder-{{ ai_gen_id }}">
                {{ 'product-1' | placeholder_svg_tag }}
              </div>
            {% endif %}
          </div>

          <div class="ai-alternating-content__text-wrapper-{{ ai_gen_id }}">
            {% if feature_heading != blank %}
              <h3 class="ai-alternating-content__feature-heading-{{ ai_gen_id }}">
                {{ feature_heading }}
              </h3>
            {% endif %}

            {% if feature_description != blank %}
              <div class="ai-alternating-content__description-{{ ai_gen_id }}">
                {{ feature_description }}
              </div>
            {% endif %}

            {% if feature_bullet_1 != blank or feature_bullet_2 != blank or feature_bullet_3 != blank %}
              <ul class="ai-alternating-content__bullets-{{ ai_gen_id }}">
                {% if feature_bullet_1 != blank %}
                  <li class="ai-alternating-content__bullet-{{ ai_gen_id }}">
                    {{ feature_bullet_1 }}
                  </li>
                {% endif %}
                {% if feature_bullet_2 != blank %}
                  <li class="ai-alternating-content__bullet-{{ ai_gen_id }}">
                    {{ feature_bullet_2 }}
                  </li>
                {% endif %}
                {% if feature_bullet_3 != blank %}
                  <li class="ai-alternating-content__bullet-{{ ai_gen_id }}">
                    {{ feature_bullet_3 }}
                  </li>
                {% endif %}
              </ul>
            {% endif %}
          </div>
        </div>
      {% endif %}
    {% endfor %}
  </div>
</div>

