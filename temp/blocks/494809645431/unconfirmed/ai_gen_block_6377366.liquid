{% doc %}
  @prompt
    Create a premium content section for a professional cleaning machine webpage.
    
    Start with a heading. Then divide the space below horizontally into three features blocks, with each of the three feature blocks to have an image to the left and a heading and text to the right. All blocks must fit horizontally across the page without stacking on desktop. 
    
    
    Each feature block should contain:
    - Large clean supporting image
    - Bold feature heading
    - Short explanatory paragraph
    - Optional supporting bullet points
    
    Feature topics should include:
    - Ergonomic operation
    - High extraction performance
    - Durable commercial construction
    - Ease of maintenance
    - Professional usability
    
    Design requirements:
    - Large clean imagery
    - Alternating image/text layout
    - Premium industrial aesthetic
    - Minimalist typography
    - Soft grey backgrounds
    - Modern commercial styling
    - White space between sections
    - Responsive stacking on mobile
    
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-premium-features-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    margin: 0 auto;
    padding: {{ block.settings.section_padding_top }}px 20px {{ block.settings.section_padding_bottom }}px;
    background-color: {{ block.settings.background_color }};
  }

  .ai-premium-features__heading-{{ ai_gen_id }} {
    text-align: {{ block.settings.heading_alignment }};
    font-size: {{ block.settings.heading_size }}px;
    font-weight: {{ block.settings.heading_weight }};
    color: {{ block.settings.heading_color }};
    margin: 0 0 {{ block.settings.heading_margin_bottom }}px;
    text-transform: {{ block.settings.heading_transform }};
    letter-spacing: 0.02em;
  }

  .ai-premium-features__grid-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: {{ block.settings.grid_gap }}px;
    margin-top: {{ block.settings.grid_margin_top }}px;
  }

  .ai-premium-features__feature-{{ ai_gen_id }} {
    display: flex;
    flex-direction: row;
    align-items: flex-start;
    gap: {{ block.settings.feature_gap }}px;
    background-color: {{ block.settings.feature_background }};
    padding: {{ block.settings.feature_padding }}px;
    border-radius: {{ block.settings.feature_border_radius }}px;
  }

  .ai-premium-features__image-wrapper-{{ ai_gen_id }} {
    flex-shrink: 0;
    width: {{ block.settings.image_width }}px;
    height: {{ block.settings.image_height }}px;
    overflow: hidden;
    border-radius: {{ block.settings.image_border_radius }}px;
  }

  .ai-premium-features__image-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-premium-features__image-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-premium-features__image-placeholder-{{ ai_gen_id }} svg {
    width: 60%;
    height: 60%;
    opacity: 0.3;
  }

  .ai-premium-features__content-{{ ai_gen_id }} {
    flex: 1;
    min-width: 0;
  }

  .ai-premium-features__feature-heading-{{ ai_gen_id }} {
    font-size: {{ block.settings.feature_heading_size }}px;
    font-weight: {{ block.settings.feature_heading_weight }};
    color: {{ block.settings.feature_heading_color }};
    margin: 0 0 {{ block.settings.feature_heading_margin }}px;
    line-height: 1.3;
  }

  .ai-premium-features__text-{{ ai_gen_id }} {
    font-size: {{ block.settings.feature_text_size }}px;
    color: {{ block.settings.feature_text_color }};
    line-height: 1.6;
    margin: 0 0 {{ block.settings.feature_text_margin }}px;
  }

  .ai-premium-features__text-{{ ai_gen_id }} p {
    margin: 0;
  }

  .ai-premium-features__bullets-{{ ai_gen_id }} {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .ai-premium-features__bullets-{{ ai_gen_id }} li {
    font-size: {{ block.settings.bullet_text_size }}px;
    color: {{ block.settings.bullet_text_color }};
    line-height: 1.6;
    padding-left: 20px;
    position: relative;
    margin-bottom: 8px;
  }

  .ai-premium-features__bullets-{{ ai_gen_id }} li:last-child {
    margin-bottom: 0;
  }

  .ai-premium-features__bullets-{{ ai_gen_id }} li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 10px;
    width: 6px;
    height: 6px;
    background-color: {{ block.settings.bullet_color }};
    border-radius: 50%;
  }

  @media screen and (max-width: 989px) {
    .ai-premium-features__grid-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
      gap: {{ block.settings.mobile_gap }}px;
    }

    .ai-premium-features__heading-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.heading_size }}px * 0.8);
    }

    .ai-premium-features__feature-{{ ai_gen_id }} {
      flex-direction: column;
    }

    .ai-premium-features__image-wrapper-{{ ai_gen_id }} {
      width: 100%;
      height: 200px;
    }
  }
{% endstyle %}

<premium-features-{{ ai_gen_id }} class="ai-premium-features-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  {% if block.settings.main_heading != blank %}
    <h2 class="ai-premium-features__heading-{{ ai_gen_id }}">
      {{ block.settings.main_heading }}
    </h2>
  {% endif %}

  <div class="ai-premium-features__grid-{{ ai_gen_id }}">
    {% for i in (1..3) %}
      {% liquid
        assign feature_enabled_key = 'feature_' | append: i | append: '_enabled'
        assign feature_image_key = 'feature_' | append: i | append: '_image'
        assign feature_heading_key = 'feature_' | append: i | append: '_heading'
        assign feature_text_key = 'feature_' | append: i | append: '_text'
        assign feature_bullets_key = 'feature_' | append: i | append: '_bullets'

        assign feature_enabled = block.settings[feature_enabled_key]
        assign feature_image = block.settings[feature_image_key]
        assign feature_heading = block.settings[feature_heading_key]
        assign feature_text = block.settings[feature_text_key]
        assign feature_bullets = block.settings[feature_bullets_key]
      %}

      {% if feature_enabled %}
        <div class="ai-premium-features__feature-{{ ai_gen_id }}">
          <div class="ai-premium-features__image-wrapper-{{ ai_gen_id }}">
            {% if feature_image %}
              <img
                src="{{ feature_image | image_url: width: 400 }}"
                alt="{{ feature_image.alt | escape }}"
                class="ai-premium-features__image-{{ ai_gen_id }}"
                loading="lazy"
                width="400"
                height="400"
              >
            {% else %}
              <div class="ai-premium-features__image-placeholder-{{ ai_gen_id }}">
                {{ 'product-1' | placeholder_svg_tag }}
              </div>
            {% endif %}
          </div>

          <div class="ai-premium-features__content-{{ ai_gen_id }}">
            {% if feature_heading != blank %}
              <h3 class="ai-premium-features__feature-heading-{{ ai_gen_id }}">
                {{ feature_heading }}
              </h3>
            {% endif %}

            {% if feature_text != blank %}
              <div class="ai-premium-features__text-{{ ai_gen_id }}">
                {{ feature_text }}
              </div>
            {% endif %}

            {% if feature_bullets != blank %}
              <ul class="ai-premium-features__bullets-{{ ai_gen_id }}">
                {% assign bullet_lines = feature_bullets | newline_to_br | split: '<br />' %}
                {% for bullet in bullet_lines %}
                  {% assign trimmed_bullet = bullet | strip %}
                  {% if trimmed_bullet != blank %}
                    <li>{{ trimmed_bullet }}</li>
                  {% endif %}
                {% endfor %}
              </ul>
            {% endif %}
          </div>
        </div>
      {% endif %}
    {% endfor %}
  </div>
</premium-features-{{ ai_gen_id }}>

<script>
  (function() {
    class PremiumFeatures{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
      }
    }

    customElements.define('premium-features-{{ ai_gen_id }}', PremiumFeatures{{ ai_gen_id }});
  })();
</script>

