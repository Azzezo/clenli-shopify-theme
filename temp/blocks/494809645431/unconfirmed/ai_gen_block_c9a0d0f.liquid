{% doc %}
  @prompt
    Start with a heading. Then divide the space below horizontally into three blocks where I can input custom cssAll blocks must fit horizontally across the page without stacking on desktop. I need the blocks to responsively stack on mobile
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-custom-css-container-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    padding: 40px 20px;
  }

  .ai-custom-css-heading-{{ ai_gen_id }} {
    margin: 0 0 30px 0;
    font-size: {{ block.settings.heading_size }}px;
    color: {{ block.settings.heading_color }};
    text-align: {{ block.settings.heading_alignment }};
  }

  .ai-custom-css-blocks-wrapper-{{ ai_gen_id }} {
    display: flex;
    gap: {{ block.settings.gap_size }}px;
    width: 100%;
  }

  .ai-custom-css-block-{{ ai_gen_id }} {
    flex: 1;
    min-width: 0;
  }

  .ai-custom-css-label-{{ ai_gen_id }} {
    display: block;
    margin-bottom: 8px;
    font-size: 14px;
    font-weight: 600;
    color: {{ block.settings.label_color }};
  }

  .ai-custom-css-textarea-{{ ai_gen_id }} {
    width: 100%;
    min-height: {{ block.settings.textarea_height }}px;
    padding: 12px;
    border: 1px solid {{ block.settings.border_color }};
    border-radius: {{ block.settings.border_radius }}px;
    font-family: 'Courier New', monospace;
    font-size: 14px;
    line-height: 1.5;
    resize: vertical;
    background-color: {{ block.settings.textarea_bg_color }};
    color: {{ block.settings.textarea_text_color }};
  }

  .ai-custom-css-textarea-{{ ai_gen_id }}:focus {
    outline: 2px solid {{ block.settings.focus_color }};
    outline-offset: 2px;
  }

  @media screen and (max-width: 749px) {
    .ai-custom-css-blocks-wrapper-{{ ai_gen_id }} {
      flex-direction: column;
    }

    .ai-custom-css-heading-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.heading_size }}px * 0.8);
    }
  }
{% endstyle %}

<custom-css-blocks-{{ ai_gen_id }}
  class="ai-custom-css-container-{{ ai_gen_id }}"
  {{ block.shopify_attributes }}
>
  {% if block.settings.heading != blank %}
    <h2 class="ai-custom-css-heading-{{ ai_gen_id }}">{{ block.settings.heading }}</h2>
  {% endif %}

  <div class="ai-custom-css-blocks-wrapper-{{ ai_gen_id }}">
    <div class="ai-custom-css-block-{{ ai_gen_id }}">
      {% if block.settings.label_1 != blank %}
        <label class="ai-custom-css-label-{{ ai_gen_id }}" for="css-input-1-{{ ai_gen_id }}">
          {{ block.settings.label_1 }}
        </label>
      {% endif %}
      <textarea
        id="css-input-1-{{ ai_gen_id }}"
        class="ai-custom-css-textarea-{{ ai_gen_id }}"
        placeholder="{{ block.settings.placeholder_1 }}"
        aria-label="{% if block.settings.label_1 != blank %}{{ block.settings.label_1 }}{% else %}CSS input 1{% endif %}"
      >{{ block.settings.css_content_1 }}</textarea>
    </div>

    <div class="ai-custom-css-block-{{ ai_gen_id }}">
      {% if block.settings.label_2 != blank %}
        <label class="ai-custom-css-label-{{ ai_gen_id }}" for="css-input-2-{{ ai_gen_id }}">
          {{ block.settings.label_2 }}
        </label>
      {% endif %}
      <textarea
        id="css-input-2-{{ ai_gen_id }}"
        class="ai-custom-css-textarea-{{ ai_gen_id }}"
        placeholder="{{ block.settings.placeholder_2 }}"
        aria-label="{% if block.settings.label_2 != blank %}{{ block.settings.label_2 }}{% else %}CSS input 2{% endif %}"
      >{{ block.settings.css_content_2 }}</textarea>
    </div>

    <div class="ai-custom-css-block-{{ ai_gen_id }}">
      {% if block.settings.label_3 != blank %}
        <label class="ai-custom-css-label-{{ ai_gen_id }}" for="css-input-3-{{ ai_gen_id }}">
          {{ block.settings.label_3 }}
        </label>
      {% endif %}
      <textarea
        id="css-input-3-{{ ai_gen_id }}"
        class="ai-custom-css-textarea-{{ ai_gen_id }}"
        placeholder="{{ block.settings.placeholder_3 }}"
        aria-label="{% if block.settings.label_3 != blank %}{{ block.settings.label_3 }}{% else %}CSS input 3{% endif %}"
      >{{ block.settings.css_content_3 }}</textarea>
    </div>
  </div>
</custom-css-blocks-{{ ai_gen_id }}>

<script>
  (function() {
    class CustomCssBlocks{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.textareas = this.querySelectorAll('.ai-custom-css-textarea-{{ ai_gen_id }}');
        this.setupEventListeners();
      }

      setupEventListeners() {
        this.textareas.forEach((textarea) => {
          textarea.addEventListener('input', function() {
            this.style.height = 'auto';
            this.style.height = this.scrollHeight + 'px';
          });

          textarea.dispatchEvent(new Event('input'));
        });
      }
    }

    customElements.define('custom-css-blocks-{{ ai_gen_id }}', CustomCssBlocks{{ ai_gen_id }});
  })();
</script>

{% schema %}
{
  "name": "Custom CSS blocks",
  "tag": null,
  "settings": [
    {
      "type": "header",
      "content": "Heading"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading text",
      "default": "Custom CSS Editor"
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Heading size",
      "min": 16,
      "max": 48,
      "step": 2,
      "unit": "px",
      "default": 32
    },
    {
      "type": "select",
      "id": "heading_alignment",
      "label": "Heading alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "left"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "default": "#000000"
    },
    {
      "type": "header",
      "content": "CSS block 1"
    },
    {
      "type": "text",
      "id": "label_1",
      "label": "Label",
      "default": "CSS Block 1"
    },
    {
      "type": "text",
      "id": "placeholder_1",
      "label": "Placeholder text",
      "default": "Enter your CSS here..."
    },
    {
      "type": "textarea",
      "id": "css_content_1",
      "label": "CSS content"
    },
    {
      "type": "header",
      "content": "CSS block 2"
    },
    {
      "type": "text",
      "id": "label_2",
      "label": "Label",
      "default": "CSS Block 2"
    },
    {
      "type": "text",
      "id": "placeholder_2",
      "label": "Placeholder text",
      "default": "Enter your CSS here..."
    },
    {
      "type": "textarea",
      "id": "css_content_2",
      "label": "CSS content"
    },
    {
      "type": "header",
      "content": "CSS block 3"
    },
    {
      "type": "text",
      "id": "label_3",
      "label": "Label",
      "default": "CSS Block 3"
    },
    {
      "type": "text",
      "id": "placeholder_3",
      "label": "Placeholder text",
      "default": "Enter your CSS here..."
    },
    {
      "type": "textarea",
      "id": "css_content_3",
      "label": "CSS content"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "Desktop width",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "range",
      "id": "gap_size",
      "label": "Gap between blocks",
      "min": 10,
      "max": 50,
      "step": 5,
      "unit": "px",
      "default": 20
    },
    {
      "type": "range",
      "id": "textarea_height",
      "label": "Textarea minimum height",
      "min": 100,
      "max": 500,
      "step": 50,
      "unit": "px",
      "default": 200
    },
    {
      "type": "header",
      "content": "Style"
    },
    {
      "type": "color",
      "id": "label_color",
      "label": "Label color",
      "default": "#333333"
    },
    {
      "type": "color",
      "id": "textarea_bg_color",
      "label": "Textarea background",
      "default": "#f9f9f9"
    },
    {
      "type": "color",
      "id": "textarea_text_color",
      "label": "Textarea text color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Border color",
      "default": "#cccccc"
    },
    {
      "type": "color",
      "id": "focus_color",
      "label": "Focus outline color",
      "default": "#000f9f"
    },
    {
      "type": "range",
      "id": "border_radius",
      "label": "Border radius",
      "min": 0,
      "max": 20,
      "step": 2,
      "unit": "px",
      "default": 4
    }
  ],
  "presets": [
    {
      "name": "Custom CSS blocks"
    }
  ]
}
{% endschema %}