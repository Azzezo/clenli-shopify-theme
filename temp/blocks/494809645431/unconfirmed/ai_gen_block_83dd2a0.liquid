{% doc %}
  @prompt
    Create a premium performance highlight section for a professional cleaning machine webpage.
    
    Design a row of modern statistic cards displaying key machine performance metrics.
    
    Each card should contain:
    - Large bold numerical statistic
    - Short supporting label
    - Optional small supporting sentence
    
    The section should visually communicate:
    - Powerful extraction performance
    - Fast drying capability
    - Tank capacity
    - Motor power
    - Cleaning width
    - Productivity/output
    
    Design style:
    - Modern premium statistics layout
    - Large bold typography
    - Minimal supporting text
    - White/light grey cards
    - Industrial premium appearance
    - Similar to automotive spec displays
    - Strong spacing and alignment
    - Responsive layout
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-performance-stats-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    padding: {{ block.settings.section_padding_top }}px {{ block.settings.section_padding_horizontal }}px {{ block.settings.section_padding_bottom }}px;
    background-color: {{ block.settings.background_color }};
  }

  .ai-performance-stats__container-{{ ai_gen_id }} {
    max-width: {{ block.settings.container_max_width }}px;
    margin: 0 auto;
  }

  .ai-performance-stats__heading-{{ ai_gen_id }} {
    text-align: {{ block.settings.heading_alignment }};
    margin: 0 0 {{ block.settings.heading_margin_bottom }}px;
    color: {{ block.settings.heading_color }};
    font-size: {{ block.settings.heading_font_size }}px;
    font-weight: {{ block.settings.heading_font_weight }};
    line-height: 1.2;
  }

  .ai-performance-stats__grid-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat({{ block.settings.columns_desktop }}, 1fr);
    gap: {{ block.settings.card_gap }}px;
  }

  .ai-performance-stats__card-{{ ai_gen_id }} {
    background-color: {{ block.settings.card_background }};
    border-radius: {{ block.settings.card_border_radius }}px;
    padding: {{ block.settings.card_padding_vertical }}px {{ block.settings.card_padding_horizontal }}px;
    text-align: {{ block.settings.card_text_alignment }};
    box-shadow: {{ block.settings.card_shadow_horizontal }}px {{ block.settings.card_shadow_vertical }}px {{ block.settings.card_shadow_blur }}px {{ block.settings.card_shadow_color }};
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }

  {% if block.settings.enable_card_hover %}
    .ai-performance-stats__card-{{ ai_gen_id }}:hover {
      transform: translateY(-{{ block.settings.card_hover_lift }}px);
      box-shadow: {{ block.settings.card_shadow_horizontal }}px {{ block.settings.card_shadow_vertical | plus: 4 }}px {{ block.settings.card_shadow_blur | plus: 8 }}px {{ block.settings.card_shadow_color }};
    }
  {% endif %}

  .ai-performance-stats__value-{{ ai_gen_id }} {
    font-size: {{ block.settings.value_font_size }}px;
    font-weight: {{ block.settings.value_font_weight }};
    color: {{ block.settings.value_color }};
    line-height: 1;
    margin: 0 0 {{ block.settings.value_margin_bottom }}px;
    display: block;
  }

  .ai-performance-stats__label-{{ ai_gen_id }} {
    font-size: {{ block.settings.label_font_size }}px;
    font-weight: {{ block.settings.label_font_weight }};
    color: {{ block.settings.label_color }};
    line-height: 1.3;
    margin: 0 0 {{ block.settings.label_margin_bottom }}px;
    display: block;
  }

  .ai-performance-stats__description-{{ ai_gen_id }} {
    font-size: {{ block.settings.description_font_size }}px;
    color: {{ block.settings.description_color }};
    line-height: 1.4;
    margin: 0;
  }

  @media screen and (max-width: 989px) {
    .ai-performance-stats__grid-{{ ai_gen_id }} {
      grid-template-columns: repeat({{ block.settings.columns_tablet }}, 1fr);
    }

    .ai-performance-stats__value-{{ ai_gen_id }} {
      font-size: {{ block.settings.value_font_size | times: 0.8 }}px;
    }

    .ai-performance-stats__heading-{{ ai_gen_id }} {
      font-size: {{ block.settings.heading_font_size | times: 0.85 }}px;
    }
  }

  @media screen and (max-width: 749px) {
    .ai-performance-stats__grid-{{ ai_gen_id }} {
      grid-template-columns: repeat({{ block.settings.columns_mobile }}, 1fr);
    }

    .ai-performance-stats-{{ ai_gen_id }} {
      padding: {{ block.settings.section_padding_top | times: 0.7 }}px {{ block.settings.section_padding_horizontal | times: 0.7 }}px {{ block.settings.section_padding_bottom | times: 0.7 }}px;
    }

    .ai-performance-stats__card-{{ ai_gen_id }} {
      padding: {{ block.settings.card_padding_vertical | times: 0.8 }}px {{ block.settings.card_padding_horizontal | times: 0.8 }}px;
    }

    .ai-performance-stats__value-{{ ai_gen_id }} {
      font-size: {{ block.settings.value_font_size | times: 0.7 }}px;
    }

    .ai-performance-stats__heading-{{ ai_gen_id }} {
      font-size: {{ block.settings.heading_font_size | times: 0.75 }}px;
    }
  }
{% endstyle %}

<div class="ai-performance-stats-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-performance-stats__container-{{ ai_gen_id }}">
    {% if block.settings.heading != blank %}
      <h2 class="ai-performance-stats__heading-{{ ai_gen_id }}">{{ block.settings.heading }}</h2>
    {% endif %}

    <div class="ai-performance-stats__grid-{{ ai_gen_id }}">
      {% if block.settings.stat_1_value != blank %}
        <div class="ai-performance-stats__card-{{ ai_gen_id }}">
          <span class="ai-performance-stats__value-{{ ai_gen_id }}">{{ block.settings.stat_1_value }}</span>
          {% if block.settings.stat_1_label != blank %}
            <span class="ai-performance-stats__label-{{ ai_gen_id }}">{{ block.settings.stat_1_label }}</span>
          {% endif %}
          {% if block.settings.stat_1_description != blank %}
            <p class="ai-performance-stats__description-{{ ai_gen_id }}">{{ block.settings.stat_1_description }}</p>
          {% endif %}
        </div>
      {% endif %}

      {% if block.settings.stat_2_value != blank %}
        <div class="ai-performance-stats__card-{{ ai_gen_id }}">
