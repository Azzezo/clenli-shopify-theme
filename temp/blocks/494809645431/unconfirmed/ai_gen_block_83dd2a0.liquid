          {% if block.settings.stat_2_label != blank %}
            <span class="ai-performance-stats__label-{{ ai_gen_id }}">{{ block.settings.stat_2_label }}</span>
          {% endif %}
          {% if block.settings.stat_2_description != blank %}
            <p class="ai-performance-stats__description-{{ ai_gen_id }}">{{ block.settings.stat_2_description }}</p>
          {% endif %}
        </div>
      {% endif %}

      {% if block.settings.stat_3_value != blank %}
        <div class="ai-performance-stats__card-{{ ai_gen_id }}">
          <span class="ai-performance-stats__value-{{ ai_gen_id }}">{{ block.settings.stat_3_value }}</span>
          {% if block.settings.stat_3_label != blank %}
            <span class="ai-performance-stats__label-{{ ai_gen_id }}">{{ block.settings.stat_3_label }}</span>
          {% endif %}
          {% if block.settings.stat_3_description != blank %}
            <p class="ai-performance-stats__description-{{ ai_gen_id }}">{{ block.settings.stat_3_description }}</p>
          {% endif %}
        </div>
      {% endif %}

      {% if block.settings.stat_4_value != blank %}
        <div class="ai-performance-stats__card-{{ ai_gen_id }}">
          <span class="ai-performance-stats__value-{{ ai_gen_id }}">{{ block.settings.stat_4_value }}</span>
