          {% endif %}
        </div>
      {% endif %}

      {% if block.settings.stat_6_value != blank %}
        <div class="ai-performance-stats__card-{{ ai_gen_id }}">
          <span class="ai-performance-stats__value-{{ ai_gen_id }}">{{ block.settings.stat_6_value }}</span>
          {% if block.settings.stat_6_label != blank %}
