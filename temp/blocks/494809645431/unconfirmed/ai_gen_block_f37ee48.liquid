        {
          "value": "700",
          "label": "Bold"
        }
      ],
      "default": "700"
    },
    {
      "type": "range",
      "id": "heading_margin_bottom",
      "label": "Heading spacing",
      "min": 20,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "header",
      "content": "Feature 1 - Portability"
    },
    {
      "type": "inline_richtext",
      "id": "feature_1_title",
      "label": "Title",
      "default": "Portable design"
    },
    {
      "type": "textarea",
      "id": "feature_1_description",
      "label": "Description",
      "default": "Compact and lightweight construction allows easy transport between job sites. Built-in wheels and ergonomic handles ensure effortless mobility."
    },
    {
      "type": "header",
      "content": "Feature 2 - Fast drying"
    },
    {
      "type": "inline_richtext",
      "id": "feature_2_title",
      "label": "Title",
      "default": "Rapid drying time"
    },
    {
      "type": "textarea",
      "id": "feature_2_description",
      "label": "Description",
      "default": "Advanced extraction technology removes up to 95% of moisture, reducing drying time to under 2 hours. Get back to business faster."
    },
    {
      "type": "header",
      "content": "Feature 3 - Multi-surface"
