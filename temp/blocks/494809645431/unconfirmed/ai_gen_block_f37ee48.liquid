      "id": "feature_3_description",
      "label": "Description",
      "default": "Versatile performance on carpets, hard floors, upholstery, and tile. One machine handles all your commercial cleaning needs."
    },
    {
      "type": "header",
      "content": "Feature 4 - Commercial power"
    },
    {
      "type": "inline_richtext",
      "id": "feature_4_title",
      "label": "Title",
      "default": "Commercial-grade power"
    },
    {
      "type": "textarea",
      "id": "feature_4_description",
      "label": "Description",
