      "type": "inline_richtext",
      "id": "feature_5_title",
      "label": "Title",
      "default": "Simple maintenance"
    },
    {
      "type": "textarea",
      "id": "feature_5_description",
      "label": "Description",
      "default": "Tool-free access to all serviceable parts. Quick-release tanks and filters make routine cleaning and maintenance effortless."
    },
    {
      "type": "header",
      "content": "Feature 6 - Durability"
    },
    {
      "type": "inline_richtext",
      "id": "feature_6_title",
      "label": "Title",
      "default": "Built to last"
    },
    {
      "type": "textarea",
      "id": "feature_6_description",
      "label": "Description",
      "default": "Heavy-duty construction with premium components ensures years of reliable service. Backed by comprehensive warranty coverage."
    },
    {
      "type": "header",
