{% doc %}
  @prompt
    Tabbed Images that become full screen with more information and a button when clicked
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-tabbed-images-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
  }

  .ai-tabbed-images-container-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .ai-tabbed-images-tabs-{{ ai_gen_id }} {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
  }

  .ai-tabbed-images-tab-{{ ai_gen_id }} {
    padding: 12px 24px;
    background-color: {{ block.settings.tab_bg_color }};
    color: {{ block.settings.tab_text_color }};
    border: 2px solid {{ block.settings.tab_border_color }};
    border-radius: {{ block.settings.tab_border_radius }}px;
    cursor: pointer;
    font-size: {{ block.settings.tab_font_size }}px;
    font-weight: 500;
    transition: all 0.3s ease;
  }

  .ai-tabbed-images-tab-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.tab_hover_bg_color }};
    color: {{ block.settings.tab_hover_text_color }};
    border-color: {{ block.settings.tab_hover_border_color }};
  }

  .ai-tabbed-images-tab-{{ ai_gen_id }}.active {
    background-color: {{ block.settings.tab_active_bg_color }};
    color: {{ block.settings.tab_active_text_color }};
    border-color: {{ block.settings.tab_active_border_color }};
  }

  .ai-tabbed-images-content-{{ ai_gen_id }} {
    position: relative;
  }

  .ai-tabbed-images-item-{{ ai_gen_id }} {
    display: none;
    cursor: pointer;
    position: relative;
    overflow: hidden;
    border-radius: {{ block.settings.image_border_radius }}px;
  }

  .ai-tabbed-images-item-{{ ai_gen_id }}.active {
    display: block;
  }

  .ai-tabbed-images-image-{{ ai_gen_id }} {
    width: 100%;
    height: auto;
    display: block;
    transition: transform 0.3s ease;
  }

  .ai-tabbed-images-item-{{ ai_gen_id }}:hover .ai-tabbed-images-image-{{ ai_gen_id }} {
    transform: scale(1.05);
  }

  .ai-tabbed-images-placeholder-{{ ai_gen_id }} {
    width: 100%;
    aspect-ratio: 16 / 9;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: {{ block.settings.image_border_radius }}px;
  }

  .ai-tabbed-images-placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    max-width: 400px;
    max-height: 400px;
  }

  .ai-tabbed-images-modal-{{ ai_gen_id }} {
    display: none;
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: {{ block.settings.modal_overlay_color }};
    z-index: 9999;
    overflow-y: auto;
    padding: 20px;
  }

  .ai-tabbed-images-modal-{{ ai_gen_id }}.active {
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-tabbed-images-modal-content-{{ ai_gen_id }} {
    position: relative;
    background-color: {{ block.settings.modal_bg_color }};
    border-radius: {{ block.settings.modal_border_radius }}px;
    max-width: 1200px;
    width: 100%;
    max-height: 90vh;
    overflow-y: auto;
    padding: 40px;
  }

  .ai-tabbed-images-modal-close-{{ ai_gen_id }} {
    position: absolute;
    top: 20px;
    right: 20px;
    background: {{ block.settings.close_button_bg }};
    color: {{ block.settings.close_button_color }};
    border: none;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 24px;
    transition: all 0.3s ease;
    z-index: 10;
  }

  .ai-tabbed-images-modal-close-{{ ai_gen_id }}:hover {
    background: {{ block.settings.close_button_hover_bg }};
    transform: rotate(90deg);
  }

  .ai-tabbed-images-modal-image-{{ ai_gen_id }} {
    width: 100%;
    height: auto;
    border-radius: {{ block.settings.image_border_radius }}px;
    margin-bottom: 30px;
  }

  .ai-tabbed-images-modal-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.modal_title_size }}px;
    font-weight: 700;
    color: {{ block.settings.modal_text_color }};
    margin: 0 0 15px;
  }

  .ai-tabbed-images-modal-description-{{ ai_gen_id }} {
    font-size: {{ block.settings.modal_description_size }}px;
    color: {{ block.settings.modal_text_color }};
    line-height: 1.6;
    margin-bottom: 25px;
  }

  .ai-tabbed-images-modal-button-{{ ai_gen_id }} {
    display: inline-block;
    padding: 14px 32px;
    background-color: {{ block.settings.button_bg_color }};
    color: {{ block.settings.button_text_color }};
    text-decoration: none;
    border-radius: {{ block.settings.button_border_radius }}px;
    font-size: {{ block.settings.button_font_size }}px;
    font-weight: 600;
    transition: all 0.3s ease;
    border: none;
    cursor: pointer;
  }

  .ai-tabbed-images-modal-button-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_hover_bg_color }};
    color: {{ block.settings.button_hover_text_color }};
  }

  @media screen and (max-width: 749px) {
    .ai-tabbed-images-modal-content-{{ ai_gen_id }} {
      padding: 30px 20px;
    }

    .ai-tabbed-images-tabs-{{ ai_gen_id }} {
      gap: 8px;
    }

    .ai-tabbed-images-tab-{{ ai_gen_id }} {
      padding: 10px 16px;
      font-size: calc({{ block.settings.tab_font_size }}px * 0.9);
    }
  }
{% endstyle %}

<tabbed-images-{{ ai_gen_id }} class="ai-tabbed-images-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-tabbed-images-container-{{ ai_gen_id }}">
    <div class="ai-tabbed-images-tabs-{{ ai_gen_id }}">
      {% for i in (1..4) %}
        {% liquid
          assign tab_enabled_key = 'tab_' | append: i | append: '_enabled'
          assign tab_label_key = 'tab_' | append: i | append: '_label'
          assign tab_enabled = block.settings[tab_enabled_key]
          assign tab_label = block.settings[tab_label_key]
        %}
        {% if tab_enabled %}
          <button
            class="ai-tabbed-images-tab-{{ ai_gen_id }} {% if forloop.first %}active{% endif %}"
            data-tab="{{ i }}"
            aria-label="View {{ tab_label }}"
          >
            {{ tab_label }}
          </button>
        {% endif %}
      {% endfor %}
    </div>

    <div class="ai-tabbed-images-content-{{ ai_gen_id }}">
      {% for i in (1..4) %}
        {% liquid
          assign tab_enabled_key = 'tab_' | append: i | append: '_enabled'
          assign image_key = 'tab_' | append: i | append: '_image'
          assign tab_enabled = block.settings[tab_enabled_key]
          assign image = block.settings[image_key]
        %}
        {% if tab_enabled %}
          <div
            class="ai-tabbed-images-item-{{ ai_gen_id }} {% if forloop.first %}active{% endif %}"
            data-content="{{ i }}"
          >
            {% if image %}
              <img
                src="{{ image | image_url: width: 1400 }}"
                alt="{{ image.alt | escape }}"
                class="ai-tabbed-images-image-{{ ai_gen_id }}"
                loading="lazy"
                width="{{ image.width }}"
                height="{{ image.height }}"
              >
            {% else %}
              <div class="ai-tabbed-images-placeholder-{{ ai_gen_id }}">
                {{ 'image' | placeholder_svg_tag }}
              </div>
            {% endif %}
          </div>
        {% endif %}
      {% endfor %}
    </div>
  </div>

  <div class="ai-tabbed-images-modal-{{ ai_gen_id }}">
    <div class="ai-tabbed-images-modal-content-{{ ai_gen_id }}">
      <button class="ai-tabbed-images-modal-close-{{ ai_gen_id }}" aria-label="Close modal">
        ×
      </button>
      <div class="ai-tabbed-images-modal-body-{{ ai_gen_id }}"></div>
    </div>
  </div>
</tabbed-images-{{ ai_gen_id }}>

<script>
  (function() {
    class TabbedImages{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.tabs = this.querySelectorAll('.ai-tabbed-images-tab-{{ ai_gen_id }}');
        this.contents = this.querySelectorAll('.ai-tabbed-images-item-{{ ai_gen_id }}');
        this.modal = this.querySelector('.ai-tabbed-images-modal-{{ ai_gen_id }}');
        this.modalBody = this.querySelector('.ai-tabbed-images-modal-body-{{ ai_gen_id }}');
        this.closeButton = this.querySelector('.ai-tabbed-images-modal-close-{{ ai_gen_id }}');
        this.currentTab = 1;
      }

      connectedCallback() {
        this.setupTabs();
        this.setupModal();
      }

      setupTabs() {
        this.tabs.forEach((tab) => {
          tab.addEventListener('click', () => {
            const tabNumber = tab.getAttribute('data-tab');
            this.switchTab(tabNumber);
          });
        });
      }

      switchTab(tabNumber) {
        this.currentTab = tabNumber;

        this.tabs.forEach((tab) => {
          if (tab.getAttribute('data-tab') === tabNumber) {
            tab.classList.add('active');
          } else {
            tab.classList.remove('active');
          }
        });

        this.contents.forEach((content) => {
          if (content.getAttribute('data-content') === tabNumber) {
            content.classList.add('active');
          } else {
            content.classList.remove('active');
          }
        });
      }

      setupModal() {
        this.contents.forEach((content) => {
          content.addEventListener('click', () => {
            const tabNumber = content.getAttribute('data-content');
            this.openModal(tabNumber);
          });
        });

        this.closeButton.addEventListener('click', () => {
          this.closeModal();
        });

        this.modal.addEventListener('click', (e) => {
          if (e.target === this.modal) {
            this.closeModal();
          }
        });

        document.addEventListener('keydown', (e) => {
          if (e.key === 'Escape' && this.modal.classList.contains('active')) {
            this.closeModal();
          }
        });
      }

      openModal(tabNumber) {
        const modalData = this.getModalData(tabNumber);
        this.renderModal(modalData);
        this.modal.classList.add('active');
        document.body.style.overflow = 'hidden';
      }

      closeModal() {
        this.modal.classList.remove('active');
        document.body.style.overflow = '';
      }

      getModalData(tabNumber) {
        const data = {
          {% for i in (1..4) %}
            {% liquid
              assign tab_enabled_key = 'tab_' | append: i | append: '_enabled'
              assign image_key = 'tab_' | append: i | append: '_image'
              assign title_key = 'tab_' | append: i | append: '_modal_title'
              assign description_key = 'tab_' | append: i | append: '_modal_description'
              assign button_text_key = 'tab_' | append: i | append: '_button_text'
              assign button_link_key = 'tab_' | append: i | append: '_button_link'
              assign tab_enabled = block.settings[tab_enabled_key]
              assign image = block.settings[image_key]
              assign title = block.settings[title_key]
              assign description = block.settings[description_key]
              assign button_text = block.settings[button_text_key]
              assign button_link = block.settings[button_link_key]
            %}
            {% if tab_enabled %}
              '{{ i }}': {
                image: {% if image %}'{{ image | image_url: width: 1400 }}'{% else %}null{% endif %},
                imageAlt: {% if image %}'{{ image.alt | escape }}'{% else %}''{% endif %},
                title: '{{ title | escape }}',
                description: `{{ description }}`,
                buttonText: '{{ button_text | escape }}',
                buttonLink: '{{ button_link }}'
              }{% unless forloop.last %},{% endunless %}
            {% endif %}
          {% endfor %}
        };
        return data[tabNumber];
      }

      renderModal(data) {
        let html = '';

        if (data.image) {
          html += `<img src="${data.image}" alt="${data.imageAlt}" class="ai-tabbed-images-modal-image-{{ ai_gen_id }}" loading="lazy">`;
        }

        if (data.title) {
          html += `<h2 class="ai-tabbed-images-modal-title-{{ ai_gen_id }}">${data.title}</h2>`;
        }

        if (data.description) {
          html += `<div class="ai-tabbed-images-modal-description-{{ ai_gen_id }}">${data.description}</div>`;
        }

        if (data.buttonText && data.buttonLink) {
          html += `<a href="${data.buttonLink}" class="ai-tabbed-images-modal-button-{{ ai_gen_id }}">${data.buttonText}</a>`;
        }

        this.modalBody.innerHTML = html;
      }
    }

    customElements.define('tabbed-images-{{ ai_gen_id }}', TabbedImages{{ ai_gen_id }});
  })();
</script>

