    "sachet_system_1_eJpEfG": {
      "type": "sachet-system-1",
      "blocks": {
        "row_4Dp68G": {
          "type": "row",
          "settings": {
            "image": "shopify://shop_images/Tersano_iClean_Mini_in_Cafe.png",
            "label": "",
            "heading": "What is the Tersano?",
            "text": "<p>Tersano is an innovative solution that converts ordinary tap water into a powerful cleaning and sanitising solution. This Stabilised Aqueous Ozone (SAO) is completely chemical free, and is made using only oxygen and water.</p>",
            "button_text": "",
            "button_link": ""
          }
        },
        "row_bkiqFw": {
          "type": "row",
          "settings": {
            "image": "shopify://shop_images/How_Tersano_is_Produced.png",
            "label": "",
            "heading": "Expert Support & Training",
            "text": "<p>Aqueous Ozone (AO) is a powerful, naturally occurring solution that develops in our environment. Tersano has created the first unit in history that extends the life-cycle of AO to produce Stabilised Aqueous Ozone (SAO).</p><p> </p><p><strong>Step 1: </strong>Oxygen from the air is safely turned to O3, then infused into ordinary tap water.</p><p><strong>Step 2: </strong>When sprayed on surfaces, SAO is attracted to germs, soils, and bacteria and quickly eliminates contaminants.</p><p><strong>Step 3: </strong>SAO cleans for days before it safely reverts back to water and O2.</p>",
            "button_text": "",
            "button_link": ""
          }
        },
        "row_cUrz6z": {
          "type": "row",
          "settings": {
            "image": "shopify://shop_images/Tersano_Where_to_Use.png",
            "label": "",
            "heading": "Where to Use Tersano",
            "text": "<p>Tersano replaces all of the most common everyday cleaning agents such as multi surface cleaners, glass and stainless steel cleaners, degreasers, and bathroom cleaners. And unlike many common cleaning agents, Tersano is a disinfectant!</p><p> </p><p>Tersano is safe and effective on almost all surfaces including stone, marble, glass, ceramic, glass, stainless steel, hardwood, vinyl, chrome, and much more!</p>",
            "button_text": "",
            "button_link": ""
          }
        }
      },
      "block_order": [
        "row_4Dp68G",
        "row_bkiqFw",
        "row_cUrz6z"
      ],
