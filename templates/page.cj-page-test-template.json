        "text_aqywfP": {
          "type": "text",
          "settings": {
            "text": "<table width=\"100%\" style=\"width: 100%%; color: #555555; border-collapse: collapse;\" cellpadding=\"10\">\n<tbody>\n<tr style=\"color: #ffffff; background-color: #6fb31a;\">\n<td style=\"width: 50%;\"><strong> Specification</strong></td>\n<td style=\"width: 50%; text-align: center;\"><strong>Measurement</strong></td>\n</tr>\n<tr>\n<td style=\"width: 50%;\">Maximum Run Time</td>\n<td style=\"width: 50%; text-align: center;\">4 hours 20 mins</td>\n</tr>\n<tr style=\"background-color: #E8E8E8;\">\n<td style=\"width: 50%;\">Charge Time</td>\n<td style=\"width: 50%; text-align: center;\">3.5 hours</td>\n</tr>\n<tr>\n<td style=\"width: 50%;\">Maximum Cleaning Speed</td>\n<td style=\"width: 50%; text-align: center;\">Up to 1.1 m/sec</td>\n</tr>\n<tr style=\"background-color: #E8E8E8;\">\n<td style=\"width: 50%;\">Cleaning Pressure</td>\n<td style=\"width: 50%; text-align: center;\">34 g/cm<span class=\"a_GcMg font-feature-liga-off font-feature-clig-off font-feature-calt-off text-decoration-none text-strikethrough-none\">²</span>\n</td>\n</tr>\n<tr>\n<td style=\"width: 50%;\">Performance</td>\n<td style=\"width: 50%; text-align: center;\"><span class=\"a_GcMg font-feature-liga-off font-feature-clig-off font-feature-calt-off text-decoration-none text-strikethrough-none\">Up to 2059 m²/h</span></td>\n</tr>\n<tr style=\"background-color: #E8E8E8;\">\n<td style=\"width: 50%;\">Debris Filter</td>\n<td style=\"width: 50%; text-align: center;\"><span class=\"a_GcMg font-feature-liga-off font-feature-clig-off font-feature-calt-off text-decoration-none text-strikethrough-none\">1.25 L</span></td>\n</tr>\n<tr>\n<td style=\"width: 50%;\">Recovery Tank</td>\n<td style=\"width: 50%; text-align: center;\">42 L</td>\n</tr>\n<tr style=\"background-color: #E8E8E8;\">\n<td style=\"width: 50%;\">Solution Tank</td>\n<td style=\"width: 50%; text-align: center;\">50 L</td>\n</tr>\n<tr>\n<td style=\"width: 50%;\">Average Sound Level</td>\n<td style=\"width: 50%; text-align: center;\">70 dB</td>\n</tr>\n<tr style=\"background-color: #E8E8E8;\">\n<td style=\"width: 50%;\">Cleaning Width</td>\n<td style=\"width: 50%; text-align: center;\">530 mm</td>\n</tr>\n<tr>\n<td style=\"width: 50%;\">Weight</td>\n<td style=\"width: 50%; text-align: center;\">200 kg</td>\n</tr>\n<tr style=\"background-color: #E8E8E8;\">\n<td style=\"width: 50%;\">Dimensions (mm)</td>\n<td style=\"width: 50%; text-align: center;\"><span class=\"a_GcMg font-feature-liga-off font-feature-clig-off font-feature-calt-off text-decoration-none text-strikethrough-none\">690 x 690 x 1125</span></td>\n</tr>\n<tr>\n<td style=\"width: 50%;\">Manufacturer</td>\n<td style=\"width: 50%; text-align: center;\">LionsBot</td>\n</tr>\n</tbody>\n</table>",
            "text_size": 16,
            "text_size_mb": 12,
            "text_font_weight": "400",
            "text_line_height": 1.5,
            "margin_top_text": 20,
