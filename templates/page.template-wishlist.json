    "page_addax_sectors_HxW3y8": {
      "type": "page-addax-sectors",
      "blocks": {
        "sector_section_PKpEYL": {
          "type": "sector_section",
          "disabled": true,
          "settings": {
            "title": "Cities & Towns",
            "description": "Addax electric utility vehicles combine compact design with exceptional agility, making them the ideal solution for maintaining clean and orderly cities and towns. Boasting an impressive loading capacity of up to 6 m³, these vehicles are versatile enough to handle a wide range of tasks. Whether you require an open loading platform for collecting recyclable waste or a closed platform for transporting equipment to the local sports club, there’s an electric Addax vehicle to suit your needs. Enhance the quality of life for residents with cleaner air, all at an affordable cost.",
            "card_1_image": "shopify://shop_images/Addax_Cities_Municipalities_2e6f1142-5720-4a93-b9c9-6661e879d90d.png",
            "card_1_title": "City Management & Maintenance",
            "card_1_text": "Efficient waste management is essential for maintaining a healthy and thriving city. Addax all-electric utility vehicles are designed to meet your city's unique needs. Their compact size allows them to navigate areas inaccessible to traditional waste trucks, making them ideal for small cities. Retrofitted with tipping containers, they simplify waste collection, while also offering versatile solutions for maintaining roads and parks—all in an eco-friendly way.",
            "card_2_image": "shopify://shop_images/Addax_Last_Mile_Delivery_4f4f0e95-360a-42fe-b03b-5c6898c13677.png",
            "card_2_title": "Parks & Playground Management",
            "card_2_text": "Addax electric vehicles are perfect for managing parks and playgrounds. When customized as cargo vans, they’re ideal for transporting toys, tools, and equipment, ensuring a well-maintained recreational space. Plus, with their zero-emission operation, Addax vehicles create a cleaner, child-friendly environment, giving kids the joy of fresh air as they play.",
            "card_3_image": "shopify://shop_images/City333_db3c1183-8108-4ed5-ad87-c7ae31098e17.png",
            "card_3_title": "Road Construction & Maintenance",
            "card_3_text": "For road construction and maintenance, Addax electric vehicles are a top choice. Their impressive loading capacity makes transporting materials efficient and hassle-free. Retrofitted options like tippers for raw materials or flatbeds for signage ensure they handle a range of tasks, all while supporting sustainable, local infrastructure projects."
          }
        },
        "sector_section_gFdcrU": {
          "type": "sector_section",
          "disabled": true,
          "settings": {
            "title": "Industrial & Facilities Management",
            "description": "Built with a focus on sustainability, innovation, and reliability, Addax electric utility vehicles offer unmatched performance and efficiency. Perfectly suited for both indoor and outdoor applications, these zero-emission vehicles help businesses stay ahead of the competition while significantly reducing operating costs. In addition to their cost-effectiveness compared to fuel-powered alternatives, Addax vehicles come with a comprehensive service package, ensuring peace of mind and seamless operation.",
            "card_1_image": "shopify://shop_images/Addax_Industrial_Facilities_f1cc2c9a-1f13-49f8-91f3-c7c5da0818eb.png",
            "card_1_title": "Environmentally Friendly",
            "card_1_text": "Addax electric vehicles enhance efficiency while promoting sustainability. Powered by fully recyclable lithium-iron-phosphate batteries, they offer a safer, greener alternative. Choosing our 100% electric vehicles boosts your company’s eco-conscious image and commitment to corporate social responsibility.",
            "card_2_image": "shopify://shop_images/Industrial222_4bd8bf2e-b1fb-465c-a910-2067445b8c69.png",
            "card_2_title": "Designed for Intralogistics",
            "card_2_text": "Addax lightweight vehicles are tailored to meet your logistics and transportation needs, seamlessly integrating into your workflow. With zero emissions, they’re ideal for indoor environments, and their industry-leading safety features—like a panoramic cabin view and dual independent brakes—ensure top-tier performance.",
            "card_3_image": "shopify://shop_images/Industrial333_4c489163-0291-43cc-a506-e4cd80d5aa16.png",
            "card_3_title": "Amusement & Holiday Parks",
            "card_3_text": "Addax electric vehicles are perfect for amusement and holiday parks, blending functionality with eco-friendliness. Retrofitted options like combi-tippers or flatbeds handle maintenance and waste collection, while cooled cargo models serve as mobile food and drink stands, ensuring a cleaner, more enjoyable guest experience."
          }
        },
        "sector_section_tgr46F": {
          "type": "sector_section",
          "disabled": true,
          "settings": {
            "title": "Last Mile Delivery",
            "description": "Streamline urban deliveries with the reliable and efficient electric utility vehicles from Addax Motors. Designed to meet the demands of last-mile logistics, these vehicles offer a range of up to 120 km per charge and can transport loads of up to 1,000 kg. By eliminating fuel dependency, Addax vehicles provide an economical and sustainable solution for daily deliveries in urban environments.",
            "card_1_image": "shopify://shop_images/Addax_Postal_Services_e497293a-e6d2-44bb-b23d-6a175e03cc91.png",
            "card_1_title": "Urban Delivery Vehicles",
            "card_1_text": "With urban areas tightening restrictions on traditional vehicles, emission-free delivery solutions are more crucial than ever. Addax light utility vehicles meet these demands, offering eco-friendly efficiency without compromising capacity, helping your delivery company stay on schedule.",
            "card_2_image": "shopify://shop_images/Cost_Effective_Addax_8e120dbe-91bf-4a21-9e8f-cc51e5def217.png",
            "card_2_title": "Agile for Evolving Markets",
            "card_2_text": "Ecommerce growth poses new challenges for urban logistics. Large vehicles struggle with maneuverability, especially in areas with traffic restrictions. Addax light utility vehicles are designed to navigate narrow streets and pedestrian pathways effortlessly, making urban deliveries simpler and more efficient.",
            "card_3_image": "shopify://shop_images/Mile333_0640ed7c-fb58-46bd-83eb-b18ba8e65135.png",
            "card_3_title": "Efficient & Reliable Delivery",
            "card_3_text": "Proudly 100% Belgian, Addax creates adaptable light electric utility vehicles that combine functionality, agility, and customer satisfaction. Enhanced by 4G-powered after-sales support, our vehicles are the perfect choice for last-mile delivery. Contact us today to learn how Addax can transform your fleet."
          }
        },
        "sector_section_GPDfVN": {
          "type": "sector_section",
          "disabled": true,
          "settings": {
            "title": "Postal Services",
            "description": "For companies prioritizing efficient delivery, Addax electric utility vehicles deliver the ideal combination of performance and adaptability. Tailored to accommodate a wide variety of courier tasks, these vehicles ensure driver comfort, cargo safety, and operational flexibility. Whether navigating narrow village roads or bustling city streets, Addax vehicles consistently enable quick and efficient mail delivery, meeting customer expectations every time.",
            "card_1_image": "shopify://shop_images/Post111_363a207f-7919-4225-a4cc-112bfcd572ea.png",
            "card_1_title": "Post Delivery Reimagined",
            "card_1_text": "Addax electric utility vehicles redefine efficiency for postal deliveries. Customizable interiors—featuring compartments, shelves, secure straps, and dedicated spaces for envelopes—keep everything organized, speeding up deliveries while making them more ergonomic. With a comfortable cabin design, delivering post becomes a smooth and enjoyable experience.",
            "card_2_image": "shopify://shop_images/Post222_5d6c1ffd-9653-40bd-9e09-aff8edeac126.png",
            "card_2_title": "Silent, Efficient Vehicles",
            "card_2_text": "Unlike noisy diesel vans, Addax electric vehicles operate silently, allowing for early-morning or late-night deliveries without disturbing neighborhoods. Quiet operation ensures you can park near homes and make multiple stops discreetly and respectfully.",
            "card_3_image": "shopify://shop_images/Post333_371e8710-a64f-41ae-860c-935aa9d68a5e.png",
            "card_3_title": "Best-in-Class Manoeuvrability",
            "card_3_text": "Addax light electric vehicles excel in agility. With a tight 4.5m turning radius, they navigate narrow streets and tight spaces effortlessly. Despite their compact design, they offer impressive loading capacity, making them the ultimate solution for urban postal deliveries."
          }
        },
        "why_choose_yKxGFG": {
          "type": "why_choose",
          "disabled": true,
          "settings": {
            "logo": "shopify://shop_images/Untitled_design_-_2024-02-08T162909.668_72ff558a-fe87-4244-976c-9adbb7d4a019.png",
            "title": "Why Choose Clenli Direct",
            "text": "With over 30 years of experience in the industry, Clenli Direct has established itself as the market leader in the cleaning industry, offering award-winning cleaning solutions, comprehensive support, and our own expert in-house service team. Our deep expertise ensures that you receive the best products tailored to your needs, backed by exceptional customer service."
