{% comment %} Blog Page Section - Clenli Direct Style {% endcomment %}

<style>
.blog-page{--green:#6fb31a;--dark:#333;--gray:#777;--white:#fff;--light:#f5f5f5;font-family:'Open Sans',sans-serif;color:var(--gray);line-height:1.7}
.blog-page *{box-sizing:border-box;margin:0;padding:0}
.blog-container{max-width:1200px;margin:0 auto;padding:0 20px}
.blog-page h1,.blog-page h2,.blog-page h3{font-weight:700;color:var(--dark)}

/* Breadcrumbs */
.blog-breadcrumbs{background:#f9f9f9;padding:15px 0;border-bottom:1px solid #eee;margin-bottom:30px}
.blog-breadcrumbs ul{list-style:none;display:flex;align-items:center;gap:10px;flex-wrap:wrap}
.blog-breadcrumbs li{display:flex;align-items:center;gap:10px;font-size:0.9rem}
.blog-breadcrumbs li:not(:last-child)::after{content:"›";color:#999}
.blog-breadcrumbs a{color:var(--green);text-decoration:none}
.blog-breadcrumbs a:hover{text-decoration:underline}

/* Page Title */
.blog-page-title{text-align:center;padding:40px 0;background:linear-gradient(135deg,var(--dark) 0%,#555 100%);color:var(--white);margin-bottom:40px}
.blog-page-title h1{font-size:2.5rem;margin:0}

/* Main Layout */
.blog-layout{display:grid;grid-template-columns:1fr 300px;gap:40px;padding:40px 0}

/* Post List */
.post-list{list-style:none}
.post-holder{background:var(--white);border:1px solid #eee;margin-bottom:30px;transition:all 0.3s}
.post-holder:hover{box-shadow:0 5px 25px rgba(0,0,0,0.1)}

/* Post Header */
.post-header{padding:25px 25px 15px}
.post-title{font-size:1.4rem;margin-bottom:15px}
.post-title a{color:var(--dark);text-decoration:none;transition:color 0.3s}
.post-title a:hover{color:var(--green)}

/* Post Info */
.post-info{display:flex;flex-wrap:wrap;gap:15px;font-size:0.85rem;color:#999;padding-bottom:15px;border-bottom:1px solid #eee}
.post-info .label{font-weight:600;color:var(--dark)}
.post-categories a{color:var(--green);text-decoration:none}
.post-categories a:hover{text-decoration:underline}

/* Post Content */
.post-content{padding:20px 25px 25px}
.post-description{color:var(--gray);line-height:1.8}
.post-text-hld{margin-bottom:15px}
.post-text-hld p{display:-webkit-box;-webkit-line-clamp:4;-webkit-box-orient:vertical;overflow:hidden}
.post-read-more{display:inline-block;color:var(--green);font-weight:600;text-decoration:none;transition:all 0.3s}
.post-read-more:hover{color:var(--dark)}

/* Post Image */
.post-image{width:100%;height:250px;overflow:hidden}
.post-image img{width:100%;height:100%;object-fit:cover;transition:transform 0.3s}
.post-holder:hover .post-image img{transform:scale(1.05)}

/* Social Share */
.post-share{display:flex;gap:10px;margin-top:15px}
.post-share a{width:32px;height:32px;display:flex;align-items:center;justify-content:center;background:#eee;color:var(--gray);border-radius:50%;text-decoration:none;font-size:0.9rem;transition:all 0.3s}
.post-share a:hover{background:var(--green);color:var(--white)}

/* Pagination */
.blog-pagination{display:flex;justify-content:center;align-items:center;gap:5px;padding:30px 0}
.blog-pagination .page-item{display:inline-block}
.blog-pagination .page-link{display:flex;align-items:center;justify-content:center;min-width:40px;height:40px;padding:0 15px;background:var(--white);border:1px solid #ddd;color:var(--gray);text-decoration:none;font-size:0.95rem;transition:all 0.3s}
.blog-pagination .page-link:hover,.blog-pagination .page-item.active .page-link{background:var(--green);border-color:var(--green);color:var(--white)}

/* Sidebar */
.blog-sidebar{position:sticky;top:20px}
.sidebar-widget{background:var(--white);border:1px solid #eee;margin-bottom:25px}
.widget-title{background:var(--dark);color:var(--white);padding:15px 20px;font-size:1.1rem;margin:0}
.widget-content{padding:20px}
.widget-content ul{list-style:none}
.widget-content li{padding:8px 0;border-bottom:1px solid #eee}
.widget-content li:last-child{border-bottom:none}
.widget-content a{color:var(--gray);text-decoration:none;transition:color 0.3s;display:flex;justify-content:space-between}
.widget-content a:hover{color:var(--green)}
.widget-content .count{background:#eee;padding:2px 8px;border-radius:3px;font-size:0.8rem}

/* Tags */
.tags-cloud{display:flex;flex-wrap:wrap;gap:8px}
.tags-cloud a{display:inline-block;padding:5px 12px;background:#eee;color:var(--gray);text-decoration:none;font-size:0.85rem;border-radius:3px;transition:all 0.3s}
.tags-cloud a:hover{background:var(--green);color:var(--white)}

/* Recent Posts Widget */
.recent-post-item{display:flex;gap:15px;padding:12px 0;border-bottom:1px solid #eee}
.recent-post-item:last-child{border-bottom:none}
.recent-post-thumb{width:70px;height:70px;flex-shrink:0;overflow:hidden;border-radius:4px}
.recent-post-thumb img{width:100%;height:100%;object-fit:cover}
.recent-post-info h4{font-size:0.95rem;margin-bottom:5px;line-height:1.4}
.recent-post-info h4 a{color:var(--dark);text-decoration:none}
.recent-post-info h4 a:hover{color:var(--green)}
.recent-post-date{font-size:0.8rem;color:#999}

/* Responsive */
@media(max-width:992px){.blog-layout{grid-template-columns:1fr}.blog-sidebar{position:static;display:grid;grid-template-columns:repeat(2,1fr);gap:20px}}
@media(max-width:768px){.blog-page-title h1{font-size:1.8rem}.post-title{font-size:1.2rem}.blog-sidebar{grid-template-columns:1fr}}
@media(max-width:480px){.post-info{flex-direction:column;gap:8px}.blog-pagination .page-link{min-width:35px;height:35px;padding:0 10px;font-size:0.85rem}}
</style>

<div class="blog-page">
  <!-- Breadcrumbs -->
  <div class="blog-breadcrumbs">
    <div class="blog-container">
      <ul>
        <li><a href="/">Home</a></li>
        <li><strong>{{ blog.title }}</strong></li>
      </ul>
    </div>
  </div>

  <!-- Page Title -->
  <div class="blog-page-title">
    <div class="blog-container">
      <h1>{{ section.settings.page_title | default: blog.title }}</h1>
    </div>
  </div>

  <div class="blog-container">
    <div class="blog-layout">
      <!-- Main Content -->
      <div class="blog-main">
        <ol class="post-list">
          {% paginate blog.articles by section.settings.posts_per_page %}
            {% for article in blog.articles %}
              <li class="post-holder">
                {% if article.image %}
                  <div class="post-image">
                    <a href="{{ article.url }}">
                      <img src="{{ article.image | img_url: '800x400', crop: 'center' }}" alt="{{ article.title }}" loading="lazy">
                    </a>
                  </div>
                {% endif %}
                
                <div class="post-header">
                  <h2 class="post-title">
                    <a href="{{ article.url }}">{{ article.title | truncate: 60 }}</a>
                  </h2>
                  
                  <div class="post-info">
                    {% if article.tags.size > 0 %}
                      <div class="post-categories">
                        <span class="label">Categories:</span>
                        {% for tag in article.tags %}
                          <a href="{{ blog.url }}/tagged/{{ tag | handle }}">{{ tag }}</a>{% unless forloop.last %}, {% endunless %}
                        {% endfor %}
                      </div>
                    {% endif %}
                    <div class="posted-date">
                      <span class="label">Posted:</span>
                      <span>{{ article.published_at | date: "%B %d, %Y" }}</span>
                    </div>
                  </div>
                </div>

                <div class="post-content">
                  <div class="post-description">
                    <div class="post-text-hld">
                      <p>{{ article.excerpt_or_content | strip_html | truncate: 350 }}</p>
                    </div>
                    <a class="post-read-more" href="{{ article.url }}">Read more »</a>
                  </div>
                  
                  {% if section.settings.show_share %}
                    <div class="post-share">
                      <a href="https://www.facebook.com/sharer/sharer.php?u={{ shop.url }}{{ article.url }}" target="_blank" title="Share on Facebook">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/></svg>
                      </a>
                      <a href="https://twitter.com/intent/tweet?url={{ shop.url }}{{ article.url }}&text={{ article.title | url_encode }}" target="_blank" title="Share on Twitter">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M23 3a10.9 10.9 0 0 1-3.14 1.53 4.48 4.48 0 0 0-7.86 3v1A10.66 10.66 0 0 1 3 4s-4 9 5 13a11.64 11.64 0 0 1-7 2c9 5 20 0 20-11.5a4.5 4.5 0 0 0-.08-.83A7.72 7.72 0 0 0 23 3z"/></svg>
                      </a>
                      <a href="mailto:?subject={{ article.title | url_encode }}&body={{ shop.url }}{{ article.url }}" title="Share via Email">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
                      </a>
                    </div>
                  {% endif %}
                </div>
              </li>
            {% endfor %}

            <!-- Pagination -->
            {% if paginate.pages > 1 %}
              <nav class="blog-pagination">
                {% if paginate.previous %}
                  <span class="page-item">
                    <a class="page-link" href="{{ paginate.previous.url }}">« Prev</a>
                  </span>
                {% endif %}
                
                {% for part in paginate.parts %}
                  {% if part.is_link %}
                    <span class="page-item">
                      <a class="page-link" href="{{ part.url }}">{{ part.title }}</a>
                    </span>
                  {% else %}
                    {% if part.title == paginate.current_page %}
                      <span class="page-item active">
                        <span class="page-link">{{ part.title }}</span>
                      </span>
                    {% else %}
                      <span class="page-item">
                        <span class="page-link">{{ part.title }}</span>
                      </span>
                    {% endif %}
                  {% endif %}
                {% endfor %}
                
                {% if paginate.next %}
                  <span class="page-item">
                    <a class="page-link" href="{{ paginate.next.url }}">Next »</a>
                  </span>
                {% endif %}
              </nav>
            {% endif %}
          {% endpaginate %}
        </ol>
      </div>

      <!-- Sidebar -->
      <aside class="blog-sidebar">
        <!-- Categories Widget -->
        {% if section.settings.show_categories %}
          <div class="sidebar-widget">
            <h3 class="widget-title">Categories</h3>
            <div class="widget-content">
              <ul>
                {% assign all_tags = blog.all_tags %}
                {% for tag in all_tags limit: 10 %}
                  <li>
                    <a href="{{ blog.url }}/tagged/{{ tag | handle }}">
                      <span>{{ tag }}</span>
                      <span class="count">{{ blog.articles | where: "tags", tag | size }}</span>
                    </a>
                  </li>
                {% endfor %}
              </ul>
            </div>
          </div>
        {% endif %}

        <!-- Recent Posts Widget -->
        {% if section.settings.show_recent %}
          <div class="sidebar-widget">
            <h3 class="widget-title">Recent Posts</h3>
            <div class="widget-content">
              {% for article in blog.articles limit: 5 %}
                <div class="recent-post-item">
                  {% if article.image %}
                    <div class="recent-post-thumb">
                      <a href="{{ article.url }}">
                        <img src="{{ article.image | img_url: '100x100', crop: 'center' }}" alt="{{ article.title }}" loading="lazy">
                      </a>
                    </div>
                  {% endif %}
                  <div class="recent-post-info">
                    <h4><a href="{{ article.url }}">{{ article.title | truncate: 45 }}</a></h4>
                    <span class="recent-post-date">{{ article.published_at | date: "%B %d, %Y" }}</span>
                  </div>
                </div>
              {% endfor %}
            </div>
          </div>
        {% endif %}

        <!-- Archive Widget -->
        {% if section.settings.show_archive %}
          <div class="sidebar-widget">
            <h3 class="widget-title">Archive</h3>
            <div class="widget-content">
              <ul>
                {% assign months = "" %}
                {% for article in blog.articles %}
                  {% assign month_year = article.published_at | date: "%B %Y" %}
                  {% unless months contains month_year %}
                    {% assign months = months | append: month_year | append: "," %}
                    <li>
                      <a href="{{ blog.url }}?month={{ article.published_at | date: '%Y-%m' }}">
                        {{ month_year }}
                      </a>
                    </li>
                  {% endunless %}
                {% endfor %}
              </ul>
            </div>
          </div>
        {% endif %}

        <!-- Tags Widget -->
        {% if section.settings.show_tags %}
          <div class="sidebar-widget">
            <h3 class="widget-title">Tags</h3>
            <div class="widget-content">
              <div class="tags-cloud">
                {% for tag in blog.all_tags limit: 20 %}
                  <a href="{{ blog.url }}/tagged/{{ tag | handle }}">{{ tag }}</a>
                {% endfor %}
              </div>
            </div>
          </div>
        {% endif %}
      </aside>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Blog Page",
  "settings": [
    {
      "type": "text",
      "id": "page_title",
      "label": "Page Title",
      "default": "Blog"
    },
    {
      "type": "range",
      "id": "posts_per_page",
      "label": "Posts per page",
      "min": 3,
      "max": 20,
      "step": 1,
      "default": 10
    },
    {
      "type": "checkbox",
      "id": "show_share",
      "label": "Show share buttons",
      "default": true
    },
    {
      "type": "header",
      "content": "Sidebar Widgets"
    },
    {
      "type": "checkbox",
      "id": "show_categories",
      "label": "Show Categories",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_recent",
      "label": "Show Recent Posts",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_archive",
      "label": "Show Archive",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_tags",
      "label": "Show Tags",
      "default": true
    }
  ],
  "presets": [
    {
      "name": "Blog Page"
    }
  ]
}
{% endschema %}