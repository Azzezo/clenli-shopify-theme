{%- liquid
  assign section_id = section.id
  assign heading = section.settings.heading
  assign view_all_text = section.settings.view_all_text
  assign view_all_link = section.settings.view_all_link
  assign products_per_view = section.settings.products_per_view
  assign show_stars = section.settings.show_stars
  assign show_description = section.settings.show_description
  assign button_text = section.settings.button_text
  assign title_color = section.settings.title_color
  assign button_bg = section.settings.button_bg
  assign button_text_color = section.settings.button_text_color
  assign active_tab_color = section.settings.active_tab_color
  assign section_width = section.settings.section_width
  assign custom_max_width = section.settings.custom_max_width
-%}

<div class="tabbed-products-section section-{{ section_id }}">
  <div class="container">
    <div class="section-header">
      <div class="header-left">
        {%- if heading != blank -%}
          <h2 class="section-title">{{ heading }}</h2>
        {%- endif -%}
        {%- if view_all_link != blank -%}
          <a href="{{ view_all_link }}" class="view-all-link">{{ view_all_text }} <span>»</span></a>
        {%- endif -%}
      </div>
      
      <div class="header-right">
        <div class="tabs-wrapper">
          {%- for block in section.blocks -%}
            <button type="button" class="tab-btn{% if forloop.first %} active{% endif %}" data-tab="{{ block.id }}" {{ block.shopify_attributes }}>
              {{ block.settings.tab_title }}
            </button>
          {%- endfor -%}
        </div>
        <div class="slider-nav">
          <button type="button" class="nav-btn nav-prev" aria-label="Previous">
            <svg width="8" height="14" viewBox="0 0 8 14" fill="none"><path d="M7 1L1 7L7 13" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </button>
          <button type="button" class="nav-btn nav-next" aria-label="Next">
            <svg width="8" height="14" viewBox="0 0 8 14" fill="none"><path d="M1 1L7 7L1 13" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </button>
        </div>
      </div>
    </div>
    
    <div class="header-line"></div>
    
    <div class="tabs-content">
      {%- for block in section.blocks -%}
        <div class="tab-panel{% if forloop.first %} active{% endif %}" data-panel="{{ block.id }}">
          <div class="products-slider" data-slider="{{ block.id }}">
            <div class="products-track">
              {%- assign collection = collections[block.settings.collection] -%}
              {%- if collection != blank and collection.products.size > 0 -%}
                {%- for product in collection.products limit: 12 -%}
                  <div class="product-card">
                    <div class="product-image">
                      <a href="{{ product.url }}">
                        {%- if product.featured_image != blank -%}
                          <img src="{{ product.featured_image | image_url: width: 400 }}" alt="{{ product.featured_image.alt | escape | default: product.title }}" loading="lazy" width="400" height="400">
                        {%- else -%}
                          {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
                        {%- endif -%}
                      </a>
                    </div>
                    <div class="product-info">
                      <h3 class="product-title"><a href="{{ product.url }}">{{ product.title }}</a></h3>
                      {%- if show_stars -%}
                        <div class="product-stars">
                          {%- for i in (1..5) -%}
                            <svg class="star-icon" width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
                          {%- endfor -%}
                        </div>
                      {%- endif -%}
                      {%- if show_description -%}
                        <p class="product-description">{{ product.description | strip_html | truncate: 100 }}</p>
                      {%- endif -%}
                      <a href="{{ product.url }}" class="product-btn">{{ button_text }}</a>
                    </div>
                  </div>
                {%- endfor -%}
              {%- else -%}
                {%- for i in (1..6) -%}
                  <div class="product-card">
                    <div class="product-image">
                      <a href="#">{{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}</a>
                    </div>
                    <div class="product-info">
                      <h3 class="product-title"><a href="#">Sample Product {{ i }}</a></h3>
                      {%- if show_stars -%}
                        <div class="product-stars">
                          {%- for j in (1..5) -%}
                            <svg class="star-icon" width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
                          {%- endfor -%}
                        </div>
                      {%- endif -%}
                      {%- if show_description -%}
                        <p class="product-description">This is a sample product description...</p>
                      {%- endif -%}
                      <a href="#" class="product-btn">{{ button_text }}</a>
                    </div>
                  </div>
                {%- endfor -%}
              {%- endif -%}
            </div>
          </div>
        </div>
      {%- endfor -%}
    </div>
  </div>
</div>

<style>
  .section-{{ section_id }} {
    padding: {{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px;
    background-color: {{ section.settings.bg_color }};
    width: 100% !important;
    max-width: 100% !important;
  }
  .section-{{ section_id }} .container {
    {%- if section_width == 'full' -%}
      width: 100% !important;
      max-width: 100% !important;
      padding: 0 15px;
    {%- elsif section_width == 'custom' -%}
      width: 100%;
      max-width: {{ custom_max_width }}px;
      margin: 0 auto;
      padding: 0 15px;
    {%- else -%}
      width: 100%;
      max-width: 1200px;
      margin: 0 auto;
      padding: 0 15px;
    {%- endif -%}
    box-sizing: border-box;
  }
  .section-{{ section_id }} .section-header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 20px;
    padding-bottom: 15px;
  }
  .section-{{ section_id }} .header-left {
    display: flex;
    align-items: center;
    gap: 15px;
  }
  .section-{{ section_id }} .section-title {
    font-size: 28px;
    font-weight: 700;
    color: {{ title_color }};
    margin: 0;
    {% comment %} font-style: italic; {% endcomment %}
    position: relative;
    padding-bottom: 10px;
  }
  .section-{{ section_id }} .section-title::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    width: 100%;
    height: 3px;
    background-color: {{ active_tab_color }};
  }
  .section-{{ section_id }} .view-all-link {
    font-size: 14px;
    color: #666;
    text-decoration: none;
  }
  .section-{{ section_id }} .view-all-link:hover {
    color: {{ active_tab_color }};
  }
  .section-{{ section_id }} .header-right {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 10px;
  }
  .section-{{ section_id }} .tabs-wrapper {
    display: flex;
    gap: 25px;
  }
  .section-{{ section_id }} .tab-btn {
    background: none;
    border: none;
    font-size: 15px;
    color: #333;
    cursor: pointer;
    padding: 8px 0;
    position: relative;
    font-weight: 500;
  }
  .section-{{ section_id }} .tab-btn:hover {
    color: {{ active_tab_color }};
  }
  .section-{{ section_id }} .tab-btn.active {
    color: {{ active_tab_color }};
    font-weight: 700;
  }
  .section-{{ section_id }} .tab-btn.active::after {
    content: '';
    position: absolute;
    bottom: -8px;
    left: 0;
    width: 100%;
    height: 3px;
    background: {{ active_tab_color }};
  }
  .section-{{ section_id }} .slider-nav {
    display: flex;
    gap: 5px;
  }
  .section-{{ section_id }} .nav-btn {
    width: 32px;
    height: 32px;
    border: 1px solid #ddd;
    background: #fff;
    border-radius: 4px;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #666;
  }
  .section-{{ section_id }} .nav-btn:hover {
    border-color: {{ active_tab_color }};
    color: {{ active_tab_color }};
  }
  .section-{{ section_id }} .header-line {
    height: 1px;
    background: #e0e0e0;
    margin-bottom: 30px;
  }
  .section-{{ section_id }} .tab-panel {
    display: none;
  }
  .section-{{ section_id }} .tab-panel.active {
    display: block;
  }
  .section-{{ section_id }} .products-slider {
    overflow: hidden;
  }
  .section-{{ section_id }} .products-track {
    display: flex;
    gap: 0;
    transition: transform 0.4s ease;
  }
  .section-{{ section_id }} .product-card {
    flex: 0 0 calc(100% / {{ products_per_view }});
    min-width: calc(100% / {{ products_per_view }});
    background: #fff;
    border: 1px solid #eee;
    border-right: none;
  }
  .section-{{ section_id }} .product-card:last-child {
    border-right: 1px solid #eee;
  }
  .section-{{ section_id }} .product-card:hover {
    box-shadow: 0 5px 20px rgba(0,0,0,0.1);
    z-index: 2;
    position: relative;
  }
  .section-{{ section_id }} .product-image {
    padding: 20px;
    border-bottom: 1px solid #eee;
  }
  .section-{{ section_id }} .product-image img,
  .section-{{ section_id }} .product-image .placeholder-svg {
    width: 100%;
    height: 180px;
    object-fit: contain;
  }
  .section-{{ section_id }} .product-info {
    padding: 15px;
  }
  .section-{{ section_id }} .product-title {
    font-size: 15px;
    font-weight: 600;
    margin: 0 0 8px;
    min-height: 40px;
  }
  .section-{{ section_id }} .product-title a {
    color: #333;
    text-decoration: none;
  }
  .section-{{ section_id }} .product-title a:hover {
    color: {{ active_tab_color }};
  }
  .section-{{ section_id }} .product-stars {
    display: flex;
    gap: 2px;
    margin-bottom: 8px;
  }
  .section-{{ section_id }} .star-icon {
    color: #ffc107;
    width: 14px;
    height: 14px;
  }
  .section-{{ section_id }} .product-description {
    font-size: 13px;
    color: #666;
    margin: 0 0 15px;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
    min-height: 60px;
  }
  .section-{{ section_id }} .product-btn {
    display: block;
    width: 100%;
    padding: 10px 15px;
    background: {{ button_bg }};
    color: {{ button_text_color }};
    text-align: center;
    text-decoration: none;
    border-radius: 5px;
    font-weight: 600;
  }
  .section-{{ section_id }} .product-btn:hover {
    opacity: 0.9;
  }
  @media (max-width: 1200px) {
    .section-{{ section_id }} .product-card { flex: 0 0 25%; min-width: 25%; }
  }
  @media (max-width: 992px) {
    .section-{{ section_id }} .section-header { flex-direction: column; }
    .section-{{ section_id }} .header-right { width: 100%; align-items: flex-start; }
    .section-{{ section_id }} .tabs-wrapper { overflow-x: auto; width: 100%; }
    .section-{{ section_id }} .slider-nav { position: absolute; right: 20px; top: 0; }
    .section-{{ section_id }} .product-card { flex: 0 0 33.333%; min-width: 33.333%; }
  }
  @media (max-width: 768px) {
    .section-{{ section_id }} .product-card { flex: 0 0 50%; min-width: 50%; }
  }
  @media (max-width: 480px) {
    .section-{{ section_id }} .product-card { flex: 0 0 100%; min-width: 100%; border-right: 1px solid #eee; }
  }
</style>

<script>
document.addEventListener('DOMContentLoaded', function() {
  const section = document.querySelector('.section-{{ section_id }}');
  if (!section) return;
  const tabBtns = section.querySelectorAll('.tab-btn');
  const tabPanels = section.querySelectorAll('.tab-panel');
  const prevBtn = section.querySelector('.nav-prev');
  const nextBtn = section.querySelector('.nav-next');
  let currentSlide = 0;
  const slidesPerView = {{ products_per_view }};
  
  tabBtns.forEach(btn => {
    btn.addEventListener('click', function() {
      tabBtns.forEach(b => b.classList.remove('active'));
      tabPanels.forEach(p => p.classList.remove('active'));
      this.classList.add('active');
      section.querySelector('[data-panel="'+this.dataset.tab+'"]').classList.add('active');
      currentSlide = 0;
      updateSlider();
    });
  });
  
  function updateSlider() {
    const track = section.querySelector('.tab-panel.active .products-track');
    const cards = track.querySelectorAll('.product-card');
    const cardWidth = cards[0]?.offsetWidth || 0;
    const maxSlide = Math.max(0, cards.length - slidesPerView);
    currentSlide = Math.min(Math.max(0, currentSlide), maxSlide);
    track.style.transform = 'translateX(-'+currentSlide*cardWidth+'px)';
  }
  
  prevBtn?.addEventListener('click', function() { if(currentSlide>0){currentSlide--;updateSlider();} });
  nextBtn?.addEventListener('click', function() {
    const cards = section.querySelector('.tab-panel.active').querySelectorAll('.product-card');
    if(currentSlide < cards.length - slidesPerView){currentSlide++;updateSlider();}
  });
  window.addEventListener('resize', updateSlider);
});
</script>

{% schema %}
{
  "name": "Tabbed Products Slider",
  "settings": [
    {
      "type": "header",
      "content": "Section Width"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Section Width",
      "options": [
        {"value": "full", "label": "Full Width (100%)"},
        {"value": "boxed", "label": "Boxed (1200px)"},
        {"value": "custom", "label": "Custom Width"}
      ],
      "default": "full"
    },
    {
      "type": "range",
      "id": "custom_max_width",
      "label": "Custom Max Width (px)",
      "min": 900,
      "max": 1900,
      "step": 100,
      "default": 1400,
      "unit": "px",
      "info": "Only works when 'Custom Width' is selected"
    },
    {
      "type": "header",
      "content": "Content Settings"
    },
    {"type":"text","id":"heading","label":"Heading","default":"Cleaning Machines"},
    {"type":"text","id":"view_all_text","label":"View All Text","default":"View All"},
    {"type":"url","id":"view_all_link","label":"View All Link"},
    {"type":"range","id":"products_per_view","label":"Products Per View","min":3,"max":6,"default":6},
    {"type":"checkbox","id":"show_stars","label":"Show Stars","default":true},
    {"type":"checkbox","id":"show_description","label":"Show Description","default":true},
    {"type":"text","id":"button_text","label":"Button Text","default":"More Details"},
    {
      "type": "header",
      "content": "Colors"
    },
    {"type":"color","id":"bg_color","label":"Background","default":"#ffffff"},
    {"type":"color","id":"title_color","label":"Title Color","default":"#333333"},
    {"type":"color","id":"active_tab_color","label":"Active Tab Color","default":"#6fb31a"},
    {"type":"color","id":"button_bg","label":"Button Background","default":"#5b9a47"},
    {"type":"color","id":"button_text_color","label":"Button Text Color","default":"#ffffff"},
    {
      "type": "header",
      "content": "Spacing"
    },
    {"type":"range","id":"padding_top","label":"Padding Top","min":0,"max":100,"default":50,"unit":"px"},
    {"type":"range","id":"padding_bottom","label":"Padding Bottom","min":0,"max":100,"default":50,"unit":"px"}
  ],
  "blocks": [
    {"type":"tab","name":"Tab","settings":[
      {"type":"text","id":"tab_title","label":"Tab Title","default":"Category"},
      {"type":"collection","id":"collection","label":"Collection"},
      {"type":"checkbox","id":"show_badge","label":"Show Badge","default":false}
    ]}
  ],
  "presets": [{"name":"Tabbed Products Slider","blocks":[
    {"type":"tab","settings":{"tab_title":"Sweepers"}},
    {"type":"tab","settings":{"tab_title":"Rotary Cleaning Machines"}},
    {"type":"tab","settings":{"tab_title":"Hoovers and Vacuums"}},
    {"type":"tab","settings":{"tab_title":"Carpet Cleaning Machines"}},
    {"type":"tab","settings":{"tab_title":"Scrubber Dryers"}}
  ]}]
}
{% endschema %}