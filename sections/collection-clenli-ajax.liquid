    },
    {
      "type": "checkbox",
      "id": "show_sku",
      "label": "Show SKU",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_add_to_cart",
      "label": "Show Add to Cart Button",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_request_quote",
      "label": "Show Request Quote Button",
      "default": false,
      "info": "Shows 'Request a quote' instead of Add to Cart"
    }
  ],
  "presets": [
    {
      "name": "Collection AJAX Filters"
    }
  ]
}
