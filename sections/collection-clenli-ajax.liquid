    {
      "type": "header",
      "content": "Filters"
    },
    {
      "type": "checkbox",
      "id": "show_category_filter",
      "label": "Show Category Filter",
      "default": true,
      "info": "Auto-detects child categories from title hierarchy (Parent > Child format)"
    },
    {
      "type": "checkbox",
      "id": "show_manufacturer_filter",
      "label": "Show Manufacturer Filter",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_type_filter",
      "label": "Show Type Filter",
      "default": true
    },
    {
      "type": "checkbox",
