{%- liquid
    assign section_id = section.id
    assign heading = section.settings.heading
    assign heading_color = section.settings.heading_color
    assign heading_size = section.settings.heading_size
    assign underline_color = section.settings.underline_color
    assign underline_width = section.settings.underline_width
    assign bg_color = section.settings.bg_color
    assign container = section.settings.container
    assign content_width = section.settings.content_width
    assign title_color = section.settings.title_color
    assign title_size = section.settings.title_size
    assign desc_color = section.settings.desc_color
    assign desc_size = section.settings.desc_size
    assign image_gap = section.settings.image_gap
    assign image_border_radius = section.settings.image_border_radius
    assign padding_top = section.settings.padding_top
    assign padding_bottom = section.settings.padding_bottom
    assign padding_top_mobile = section.settings.padding_top_mobile
    assign padding_bottom_mobile = section.settings.padding_bottom_mobile
    assign stagger_offset = section.settings.stagger_offset
-%}

<style>
    #client-centre-{{ section_id }} {
        background-color: {{ bg_color }};
        padding-top: {{ padding_top }}px;
        padding-bottom: {{ padding_bottom }}px;
    }
    
    #client-centre-{{ section_id }} .cc-container {
        max-width: {% if container == '1170' %}1170px{% elsif container == '1370' %}1370px{% elsif container == '1570' %}1570px{% else %}1170px{% endif %};
        margin: 0 auto;
        padding: 0 15px;
    }
    
    #client-centre-{{ section_id }} .cc-wrapper {
        display: grid;
        grid-template-columns: {{ content_width }}% 1fr;
        gap: 50px;
        align-items: flex-start;
    }
    
    #client-centre-{{ section_id }} .cc-content {
        padding-right: 20px;
    }
    
    #client-centre-{{ section_id }} .cc-main-heading {
        font-size: {{ heading_size }}px;
        font-weight: 600;
        color: {{ heading_color }};
        margin: 0 0 15px 0;
        line-height: 1.3;
    }
    
    /* Green Underline */
    #client-centre-{{ section_id }} .cc-underline {
        width: {{ underline_width }}px;
        height: 3px;
        background-color: {{ underline_color }};
        margin-bottom: 30px;
    }
    
    /* Text Blocks - Compact */
    #client-centre-{{ section_id }} .cc-text-blocks {
        display: flex;
        flex-direction: column;
        gap: 15px;
    }
    
    #client-centre-{{ section_id }} .cc-text-item {
        margin: 0;
        padding: 0;
    }
    
    #client-centre-{{ section_id }} .cc-text-item .item-title {
        font-size: {{ title_size }}px;
        font-weight: 700;
        color: {{ title_color }};
        margin: 0 0 3px 0;
        line-height: 1.3;
    }
    
    #client-centre-{{ section_id }} .cc-text-item .item-desc {
        font-size: {{ desc_size }}px;
        color: {{ desc_color }};
        margin: 0;
        line-height: 1.5;
    }
    
    /* Right Side Images - Staggered Layout */
    #client-centre-{{ section_id }} .cc-images {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: {{ image_gap }}px;
        width: 100%;
    }
    
    #client-centre-{{ section_id }} .cc-image-item {
        overflow: hidden;
        border-radius: {{ image_border_radius }}px;
        position: relative;
        width: 100%;
    }
    
    #client-centre-{{ section_id }} .cc-image-item img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
        transition: transform 0.3s ease;
    }
    
    #client-centre-{{ section_id }} .cc-image-item:hover img {
        transform: scale(1.05);
    }
    
    #client-centre-{{ section_id }} .cc-image-item .placeholder-img {
        width: 100%;
        height: 100%;
        min-height: 150px;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #fff;
        font-size: 14px;
    }
    
    /* Staggered Effect - Aga Pacha */
    /* Image 1 - Top Left (normal) */
    #client-centre-{{ section_id }} .cc-image-item:nth-child(1) {
        margin-top: 0;
        aspect-ratio: 4/3;
    }
    
    /* Image 2 - Top Right (neeche) */
    #client-centre-{{ section_id }} .cc-image-item:nth-child(2) {
        margin-top: {{ stagger_offset }}px;
        aspect-ratio: 4/3;
    }
    
    /* Image 3 - Bottom Left (normal) */
    #client-centre-{{ section_id }} .cc-image-item:nth-child(3) {
        margin-top: -{{ stagger_offset | divided_by: 2 }}px;
        aspect-ratio: 4/3;
    }
    
    /* Image 4 - Bottom Right (uper) */
    #client-centre-{{ section_id }} .cc-image-item:nth-child(4) {
        margin-top: {{ stagger_offset | divided_by: 2 }}px;
        aspect-ratio: 4/3;
    }
    
    /* Tablet */
    @media (max-width: 1024px) {
        #client-centre-{{ section_id }} .cc-wrapper {
            grid-template-columns: 1fr;
            gap: 40px;
        }
        
        #client-centre-{{ section_id }} .cc-content {
            padding-right: 0;
        }
        
        #client-centre-{{ section_id }} .cc-main-heading {
            font-size: {{ heading_size | minus: 4 }}px;
        }
        
        #client-centre-{{ section_id }} .cc-images {
            max-width: 100%;
        }
        
        #client-centre-{{ section_id }} .cc-image-item:nth-child(2) {
            margin-top: 20px;
        }
        
        #client-centre-{{ section_id }} .cc-image-item:nth-child(3) {
            margin-top: -10px;
        }
        
        #client-centre-{{ section_id }} .cc-image-item:nth-child(4) {
            margin-top: 10px;
        }
    }
    
    /* Mobile */
    @media (max-width: 767px) {
        #client-centre-{{ section_id }} {
            padding-top: {{ padding_top_mobile }}px;
            padding-bottom: {{ padding_bottom_mobile }}px;
        }
        
        #client-centre-{{ section_id }} .cc-wrapper {
            gap: 30px;
        }
        
        #client-centre-{{ section_id }} .cc-main-heading {
            font-size: {{ heading_size | minus: 8 }}px;
        }
        
        #client-centre-{{ section_id }} .cc-underline {
            margin-bottom: 20px;
        }
        
        #client-centre-{{ section_id }} .cc-text-blocks {
            gap: 12px;
        }
        
        #client-centre-{{ section_id }} .cc-text-item .item-title {
            font-size: {{ title_size | minus: 2 }}px;
        }
        
        #client-centre-{{ section_id }} .cc-text-item .item-desc {
            font-size: {{ desc_size | minus: 1 }}px;
        }
        
        #client-centre-{{ section_id }} .cc-images {
            gap: 10px;
        }
        
        #client-centre-{{ section_id }} .cc-image-item {
            min-height: 100px;
        }
        
        /* Mobile pe kam stagger */
        #client-centre-{{ section_id }} .cc-image-item:nth-child(2) {
            margin-top: 15px;
        }
        
        #client-centre-{{ section_id }} .cc-image-item:nth-child(3) {
            margin-top: -8px;
        }
        
        #client-centre-{{ section_id }} .cc-image-item:nth-child(4) {
            margin-top: 8px;
        }
    }
</style>

<section id="client-centre-{{ section_id }}" class="client-centre-section">
    <div class="cc-container">
        <div class="cc-wrapper">
            <!-- Left Content -->
            <div class="cc-content">
                {%- if heading != blank -%}
                    <h2 class="cc-main-heading">{{ heading }}</h2>
                    <div class="cc-underline"></div>
                {%- endif -%}
                
                <div class="cc-text-blocks">
                    {%- for block in section.blocks -%}
                        {%- if block.type == 'text_block' -%}
                            <div class="cc-text-item" {{ block.shopify_attributes }}>
                                {%- if block.settings.title != blank -%}
                                    <h3 class="item-title">{{ block.settings.title }}</h3>
                                {%- endif -%}
                                {%- if block.settings.description != blank -%}
                                    <p class="item-desc">{{ block.settings.description }}</p>
                                {%- endif -%}
                            </div>
                        {%- endif -%}
                    {%- endfor -%}
                    
                    {%- if section.blocks.size == 0 -%}
                        <div class="cc-text-item">
                            <h3 class="item-title">Training</h3>
                            <p class="item-desc">The Client Centre has built in state of the art training facilities for staff and operators. Machine Operator Training, Best Cleaning Practices & Safety Training</p>
                        </div>
                        <div class="cc-text-item">
                            <h3 class="item-title">Demonstrations</h3>
                            <p class="item-desc">See our products in action and try them for yourself. Gather all the information you need to make informed decisions</p>
                        </div>
                        <div class="cc-text-item">
                            <h3 class="item-title">Customer/Client Visits</h3>
                            <p class="item-desc">Clients are free to invite customers to the client centre for demonstrations and training.</p>
                        </div>
                    {%- endif -%}
                </div>
            </div>
            
            <!-- Right Side: 4 Images - Staggered Layout -->
            <div class="cc-images">
                <div class="cc-image-item">
                    {%- if section.settings.image_1 != blank -%}
                        <img src="{{ section.settings.image_1 | image_url: width: 800 }}" alt="{{ section.settings.image_1_alt | default: 'Gallery Image 1' }}" loading="lazy">
                    {%- else -%}
                        <div class="placeholder-img" style="background: linear-gradient(135deg, #1a365d 0%, #2d5a87 100%);">
                            <span>Image 1</span>
                        </div>
                    {%- endif -%}
                </div>
                
                <div class="cc-image-item">
                    {%- if section.settings.image_2 != blank -%}
                        <img src="{{ section.settings.image_2 | image_url: width: 800 }}" alt="{{ section.settings.image_2_alt | default: 'Gallery Image 2' }}" loading="lazy">
                    {%- else -%}
                        <div class="placeholder-img" style="background: linear-gradient(135deg, #2d5a87 0%, #1a365d 100%);">
                            <span>Image 2</span>
                        </div>
                    {%- endif -%}
                </div>
                
                <div class="cc-image-item">
                    {%- if section.settings.image_3 != blank -%}
                        <img src="{{ section.settings.image_3 | image_url: width: 800 }}" alt="{{ section.settings.image_3_alt | default: 'Gallery Image 3' }}" loading="lazy">
                    {%- else -%}
                        <div class="placeholder-img" style="background: linear-gradient(135deg, #1a365d 0%, #4a7c9b 100%);">
                            <span>Image 3</span>
                        </div>
                    {%- endif -%}
                </div>
                
                <div class="cc-image-item">
                    {%- if section.settings.image_4 != blank -%}
                        <img src="{{ section.settings.image_4 | image_url: width: 800 }}" alt="{{ section.settings.image_4_alt | default: 'Gallery Image 4' }}" loading="lazy">
                    {%- else -%}
                        <div class="placeholder-img" style="background: linear-gradient(135deg, #4a7c9b 0%, #1a365d 100%);">
                            <span>Image 4</span>
                        </div>
                    {%- endif -%}
                </div>
            </div>
        </div>
    </div>
</section>

{% schema %}
{
    "name": "Client Centre",
    "tag": "section",
    "class": "client-centre-block",
    "settings": [
        {
            "type": "header",
            "content": "Section Heading"
        },
        {
            "type": "text",
            "id": "heading",
            "label": "Main Heading",
            "default": "The Clenli Client Centre"
        },
        {
            "type": "color",
            "id": "heading_color",
            "label": "Heading Color",
            "default": "#1a365d"
        },
        {
            "type": "range",
            "id": "heading_size",
            "label": "Heading Font Size",
            "min": 20,
            "max": 50,
            "step": 1,
            "unit": "px",
            "default": 28
        },
        {
            "type": "color",
            "id": "underline_color",
            "label": "Underline Color",
            "default": "#6fb31a"
        },
        {
            "type": "range",
            "id": "underline_width",
            "label": "Underline Width",
            "min": 30,
            "max": 150,
            "step": 5,
            "unit": "px",
            "default": 60
        },
        {
            "type": "header",
            "content": "Layout Settings"
        },
        {
            "type": "color",
            "id": "bg_color",
            "label": "Background Color",
            "default": "#ffffff"
        },
        {
            "type": "select",
            "id": "container",
            "label": "Container Width",
            "default": "1170",
            "options": [
                {"value": "1170", "label": "1170px"},
                {"value": "1370", "label": "1370px"},
                {"value": "1570", "label": "1570px"}
            ]
        },
        {
            "type": "range",
            "id": "content_width",
            "label": "Left Content Width (%)",
            "min": 40,
            "max": 60,
            "step": 5,
            "unit": "%",
            "default": 50
        },
        {
            "type": "header",
            "content": "Text Block Styling"
        },
        {
            "type": "color",
            "id": "title_color",
            "label": "Title Color",
            "default": "#232323"
        },
        {
            "type": "range",
            "id": "title_size",
            "label": "Title Font Size",
            "min": 14,
            "max": 26,
            "step": 1,
            "unit": "px",
            "default": 18
        },
        {
            "type": "color",
            "id": "desc_color",
            "label": "Description Color",
            "default": "#555555"
        },
        {
            "type": "range",
            "id": "desc_size",
            "label": "Description Font Size",
            "min": 12,
            "max": 20,
            "step": 1,
            "unit": "px",
            "default": 15
        },
        {
            "type": "header",
            "content": "Images Settings"
        },
        {
            "type": "image_picker",
            "id": "image_1",
            "label": "Image 1 (Top Left)"
        },
        {
            "type": "text",
            "id": "image_1_alt",
            "label": "Image 1 Alt Text",
            "default": "Gallery Image 1"
        },
        {
            "type": "image_picker",
            "id": "image_2",
            "label": "Image 2 (Top Right)"
        },
        {
            "type": "text",
            "id": "image_2_alt",
            "label": "Image 2 Alt Text",
            "default": "Gallery Image 2"
        },
        {
            "type": "image_picker",
            "id": "image_3",
            "label": "Image 3 (Bottom Left)"
        },
        {
            "type": "text",
            "id": "image_3_alt",
            "label": "Image 3 Alt Text",
            "default": "Gallery Image 3"
        },
        {
            "type": "image_picker",
            "id": "image_4",
            "label": "Image 4 (Bottom Right)"
        },
        {
            "type": "text",
            "id": "image_4_alt",
            "label": "Image 4 Alt Text",
            "default": "Gallery Image 4"
        },
        {
            "type": "range",
            "id": "image_gap",
            "label": "Gap Between Images",
            "min": 5,
            "max": 30,
            "step": 5,
            "unit": "px",
            "default": 15
        },
        {
            "type": "range",
            "id": "image_border_radius",
            "label": "Image Border Radius",
            "min": 0,
            "max": 20,
            "step": 2,
            "unit": "px",
            "default": 4
        },
        {
            "type": "range",
            "id": "stagger_offset",
            "label": "Stagger Offset (Aga Pacha)",
            "min": 0,
            "max": 60,
            "step": 5,
            "unit": "px",
            "default": 30
        },
        {
            "type": "header",
            "content": "Padding Settings"
        },
        {
            "type": "range",
            "id": "padding_top",
            "label": "Padding Top (Desktop)",
            "min": 0,
            "max": 100,
            "step": 5,
            "unit": "px",
            "default": 60
        },
        {
            "type": "range",
            "id": "padding_bottom",
            "label": "Padding Bottom (Desktop)",
            "min": 0,
            "max": 100,
            "step": 5,
            "unit": "px",
            "default": 60
        },
        {
            "type": "range",
            "id": "padding_top_mobile",
            "label": "Padding Top (Mobile)",
            "min": 0,
            "max": 80,
            "step": 5,
            "unit": "px",
            "default": 40
        },
        {
            "type": "range",
            "id": "padding_bottom_mobile",
            "label": "Padding Bottom (Mobile)",
            "min": 0,
            "max": 80,
            "step": 5,
            "unit": "px",
            "default": 40
        }
    ],
    "blocks": [
        {
            "type": "text_block",
            "name": "Text Block",
            "settings": [
                {
                    "type": "text",
                    "id": "title",
                    "label": "Title",
                    "default": "Block Title"
                },
                {
                    "type": "textarea",
                    "id": "description",
                    "label": "Description",
                    "default": "Add your description text here."
                }
            ]
        }
    ],
    "presets": [
        {
            "name": "Client Centre",
            "blocks": [
                {
                    "type": "text_block",
                    "settings": {
                        "title": "Training",
                        "description": "The Client Centre has built in state of the art training facilities for staff and operators. Machine Operator Training, Best Cleaning Practices & Safety Training"
                    }
                },
                {
                    "type": "text_block",
                    "settings": {
                        "title": "Demonstrations",
                        "description": "See our products in action and try them for yourself. Gather all the information you need to make informed decisions"
                    }
                },
                {
                    "type": "text_block",
                    "settings": {
                        "title": "Customer/Client Visits",
                        "description": "Clients are free to invite customers to the client centre for demonstrations and training."
                    }
                }
            ]
        }
    ]
}
{% endschema %}
