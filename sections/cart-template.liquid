{% comment %}
  Cart Page - Clenli Direct Style
{% endcomment %}

<div class="cart-page section-{{ section.id }}">
  <div class="container">
    <h1 class="cart-title">Shopping Cart</h1>
    
    {% if cart.item_count > 0 %}
    <div class="cart-wrapper">
      <!-- Left Side - Cart Items -->
      <div class="cart-items-wrapper">
        <table class="cart-table">
          <thead>
            <tr>
              <th></th>
              <th></th>
              <th>Item</th>
              <th>Price</th>
              <th>Qty</th>
              <th>Subtotal</th>
            </tr>
          </thead>
          <tbody>
            {% for item in cart.items %}
            <tr class="cart-item" data-key="{{ item.key }}">
              <td class="cart-remove">
                <a href="/cart/change?id={{ item.key }}&quantity=0" class="remove-btn" aria-label="Remove">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M3 6h18M19 6v14a2 2 0 01-2 2H7a2 2 0 01-2-2V6m3 0V4a2 2 0 012-2h4a2 2 0 012 2v2M10 11v6M14 11v6"/>
                  </svg>
                </a>
              </td>
              <td class="cart-image">
                <a href="{{ item.url }}">
                  {% if item.image %}
                    <img src="{{ item.image | image_url: width: 100 }}" alt="{{ item.title | escape }}" width="80" height="80">
                  {% else %}
                    {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
                  {% endif %}
                </a>
              </td>
              <td class="cart-item-title">
                <a href="{{ item.url }}">{{ item.product.title }}</a>
                {% if item.variant.title != 'Default Title' %}
                  <span class="variant-title">{{ item.variant.title }}</span>
                {% endif %}
              </td>
              <td class="cart-price">{{ item.price | money }}</td>
              <td class="cart-qty">
                <div class="qty-wrapper">
                  <button type="button" class="qty-btn qty-minus" data-key="{{ item.key }}">−</button>
                  <input type="number" class="qty-input" value="{{ item.quantity }}" min="1" data-key="{{ item.key }}">
                  <button type="button" class="qty-btn qty-plus" data-key="{{ item.key }}">+</button>
                </div>
              </td>
              <td class="cart-subtotal">{{ item.line_price | money }}</td>
            </tr>
            {% endfor %}
          </tbody>
        </table>
        
        <!-- Cart Action Buttons -->
        <div class="cart-actions">
          <a href="/collections/all" class="btn-continue">
            « Continue Shopping
          </a>
          <button type="button" class="btn-clear" onclick="clearCart()">Clear Shopping Cart</button>
          <button type="button" class="btn-update" onclick="updateCart()">Update Shopping Cart</button>
        </div>
      </div>
      
      <!-- Right Side - Summary -->
      <div class="cart-summary">
        <h2 class="summary-title">Summary</h2>
        
        <div class="summary-row estimate-row">
          <span>Estimate Shipping and Tax</span>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 9l6 6 6-6"/></svg>
        </div>
        
        <div class="summary-row subtotal-row">
          <span>Subtotal</span>
          <span class="amount">{{ cart.total_price | money }}</span>
        </div>
        
        <div class="summary-row total-row">
          <span>ORDER TOTAL</span>
          <span class="amount total-amount">{{ cart.total_price | money }}</span>
        </div>
        
        <div class="summary-row discount-row">
          <span>Apply Discount Code</span>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 9l6 6 6-6"/></svg>
        </div>
        
        <div class="summary-buttons">
          <a href="/checkout" class="checkout-btn">Proceed to Checkout</a>
          {% if additional_checkout_buttons %}
            <div class="additional-checkout">
              {{ content_for_additional_checkout_buttons }}
            </div>
          {% endif %}
        </div>
      </div>
    </div>
    
    {% else %}
    <!-- Empty Cart -->
    <div class="cart-empty">
      <svg width="80" height="80" viewBox="0 0 24 24" fill="none" stroke="#ccc" stroke-width="1.5">
        <circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/>
        <path d="M1 1h4l2.68 13.39a2 2 0 002 1.61h9.72a2 2 0 002-1.61L23 6H6"/>
      </svg>
      <p>Your cart is empty</p>
      <a href="/collections/all" class="btn-continue">Continue Shopping</a>
    </div>
    {% endif %}
  </div>
</div>

<style>
.cart-page {
  padding: 40px 0 60px;
}
.cart-page .container {
  max-width: 1400px;
  margin: 0 auto;
  padding: 0 20px;
}
.cart-title {
  font-size: 28px;
  font-weight: 700;
  color: {{ section.settings.accent_color }};
  font-style: italic;
  margin: 0 0 30px;
  padding-bottom: 10px;
  border-bottom: 3px solid {{ section.settings.accent_color }};
  display: inline-block;
}
.cart-wrapper {
  display: flex;
  gap: 30px;
  align-items: flex-start;
}
.cart-items-wrapper {
  flex: 1;
}
.cart-summary {
  width: 320px;
  flex-shrink: 0;
  background: #fff;
  border: 1px solid #eee;
}
.cart-table {
  width: 100%;
  border-collapse: collapse;
}
.cart-table thead th {
  text-align: left;
  padding: 12px 10px;
  font-size: 14px;
  font-weight: 600;
  color: #666;
  border-bottom: 1px solid #eee;
}
.cart-table tbody td {
  padding: 20px 10px;
  vertical-align: middle;
  border-bottom: 1px solid #eee;
}
.cart-remove .remove-btn {
  color: #999;
  display: flex;
}
.cart-remove .remove-btn:hover {
  color: #e53935;
}
.cart-image img,
.cart-image .placeholder-svg {
  width: 80px;
  height: 80px;
  object-fit: contain;
  border: 1px solid #eee;
}
.cart-item-title a {
  color: #333;
  text-decoration: none;
  font-weight: 500;
  font-size: 15px;
}
.cart-item-title a:hover {
  color: {{ section.settings.accent_color }};
}
.cart-item-title .variant-title {
  display: block;
  font-size: 13px;
  color: #666;
  margin-top: 5px;
}
.cart-price {
  font-size: 15px;
  color: #333;
}
.qty-wrapper {
  display: inline-flex;
  align-items: center;
  border: 1px solid #ddd;
  border-radius: 25px;
  overflow: hidden;
}
.qty-btn {
  width: 32px;
  height: 32px;
  border: none;
  background: #fff;
  cursor: pointer;
  font-size: 18px;
  color: #666;
  display: flex;
  align-items: center;
  justify-content: center;
}
.qty-btn:hover {
  background: #f5f5f5;
}
.qty-input {
  width: 40px;
  height: 32px;
  border: none;
  text-align: center;
  font-size: 14px;
  background: {{ section.settings.accent_color }};
  color: #fff;
  -moz-appearance: textfield;
}
.qty-input::-webkit-outer-spin-button,
.qty-input::-webkit-inner-spin-button {
  -webkit-appearance: none;
  margin: 0;
}
.cart-subtotal {
  font-size: 15px;
  font-weight: 600;
  color: #333;
}
.cart-actions {
  display: flex;
  gap: 15px;
  margin-top: 25px;
  padding-top: 25px;
  border-top: 1px dashed #ddd;
}
.btn-continue {
  padding: 12px 20px;
  font-size: 14px;
  font-weight: 600;
  text-decoration: none;
  cursor: pointer;
  display: inline-flex;
  align-items: center;
  gap: 8px;
  border: none;
  background: {{ section.settings.accent_color }};
  color: #fff;
  border-radius: 25px;
}
.btn-continue:hover {
  opacity: 0.9;
}
.btn-clear {
  padding: 12px 20px;
  font-size: 14px;
  font-weight: 600;
  cursor: pointer;
  display: inline-flex;
  align-items: center;
  border: none;
  background: #666;
  color: #fff;
  border-radius: 5px;
}
.btn-clear:hover {
  background: #555;
}
.btn-update {
  padding: 12px 20px;
  font-size: 14px;
  font-weight: 600;
  cursor: pointer;
  display: inline-flex;
  align-items: center;
  border: none;
  background: {{ section.settings.accent_color }};
  color: #fff;
  border-radius: 5px;
}
.btn-update:hover {
  opacity: 0.9;
}
.summary-title {
  font-size: 20px;
  font-weight: 600;
  color: #333;
  padding: 20px;
  margin: 0;
  border-bottom: 1px solid #eee;
}
.summary-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 15px 20px;
  border-bottom: 1px solid #eee;
  font-size: 14px;
  color: #333;
  cursor: pointer;
}
.summary-row svg {
  color: #999;
}
.summary-row .amount {
  font-weight: 600;
}
.total-row {
  font-weight: 700;
}
.total-row .total-amount {
  color: {{ section.settings.accent_color }};
  font-size: 18px;
}
.discount-row {
  border-bottom: none;
}
.summary-buttons {
  padding: 20px;
}
.checkout-btn {
  display: block;
  width: 100%;
  padding: 15px 20px;
  background: {{ section.settings.accent_color }};
  color: #fff;
  text-align: center;
  text-decoration: none;
  border-radius: 5px;
  font-size: 16px;
  font-weight: 600;
  margin-bottom: 10px;
}
.checkout-btn:hover {
  opacity: 0.9;
}
.additional-checkout {
  margin-top: 10px;
}
.additional-checkout .shopify-payment-button button {
  width: 100%;
  border-radius: 5px;
}
.cart-empty {
  text-align: center;
  padding: 60px 20px;
}
.cart-empty svg {
  margin-bottom: 20px;
}
.cart-empty p {
  font-size: 18px;
  color: #666;
  margin-bottom: 20px;
}
@media (max-width: 992px) {
  .cart-wrapper {
    flex-direction: column;
  }
  .cart-summary {
    width: 100%;
  }
}
@media (max-width: 768px) {
  .cart-table thead {
    display: none;
  }
  .cart-table tbody tr {
    display: flex;
    flex-wrap: wrap;
    padding: 15px 0;
    border-bottom: 1px solid #eee;
  }
  .cart-table tbody td {
    border: none;
    padding: 5px;
  }
  .cart-remove {
    order: 1;
    width: 30px;
  }
  .cart-image {
    order: 2;
    width: 80px;
  }
  .cart-item-title {
    order: 3;
    flex: 1;
  }
  .cart-price {
    order: 4;
    width: 100%;
    padding-left: 110px !important;
    font-size: 13px;
    color: #666;
  }
  .cart-price::before {
    content: 'Price: ';
  }
  .cart-qty {
    order: 5;
    width: auto;
    padding-left: 110px !important;
  }
  .cart-subtotal {
    order: 6;
    width: auto;
    margin-left: auto;
  }
  .cart-actions {
    flex-direction: column;
  }
  .btn-continue,
  .btn-clear,
  .btn-update {
    justify-content: center;
    width: 100%;
  }
}
</style>

<script>
document.querySelectorAll('.qty-minus').forEach(btn => {
  btn.addEventListener('click', function() {
    const input = this.parentElement.querySelector('.qty-input');
    if (parseInt(input.value) > 1) {
      input.value = parseInt(input.value) - 1;
    }
  });
});

document.querySelectorAll('.qty-plus').forEach(btn => {
  btn.addEventListener('click', function() {
    const input = this.parentElement.querySelector('.qty-input');
    input.value = parseInt(input.value) + 1;
  });
});

function updateCart() {
  const updates = {};
  document.querySelectorAll('.qty-input').forEach(input => {
    updates[input.dataset.key] = parseInt(input.value);
  });
  fetch('/cart/update.js', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({ updates })
  }).then(() => location.reload());
}

function clearCart() {
  fetch('/cart/clear.js', {
    method: 'POST'
  }).then(() => location.reload());
}
</script>

{% schema %}
{
  "name": "Cart Page",
  "settings": [
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent Color",
      "default": "#6fb31a"
    }
  ]
}
{% endschema %}