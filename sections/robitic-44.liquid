{% comment %}
  Sustainability Layout Section
  Replicates the "Drive Sustainability" page layout
{% endcomment %}

<div class="sus-wrapper section-{{ section.id }}">
  <div class="sus-container">
    
    {% for block in section.blocks %}
      {% case block.type %}
        
        {% comment %} === HERO / TOP SECTION === {% endcomment %}
        {% when 'hero' %}
        <div class="sus-block" {{ block.shopify_attributes }}>
          <div class="sus-grid">
            <div class="sus-media">
              {% if block.settings.image != blank %}
                <img src="{{ block.settings.image | image_url: width: 800 }}" alt="{{ block.settings.heading }}" loading="lazy">
              {% else %}
                {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
              {% endif %}
            </div>
            <div class="sus-content">
              {% if block.settings.pre_heading != blank %}
                <span class="pre-heading">{{ block.settings.pre_heading }}</span>
              {% endif %}
              <h2 class="main-heading">{{ block.settings.heading }}</h2>
              <div class="rte-text">{{ block.settings.text }}</div>
              
              {% if block.settings.btn_text != blank %}
                <a href="{{ block.settings.btn_link }}" class="sus-btn">{{ block.settings.btn_text }}</a>
              {% endif %}
            </div>
          </div>
          <div class="sus-divider"></div>
        </div>

        {% comment %} === ALTERNATING ROWS (Zig-Zag) === {% endcomment %}
        {% when 'feature_row' %}
        <div class="sus-block" {{ block.shopify_attributes }}>
          <div class="sus-grid {% if block.settings.layout == 'left' %}image-left{% else %}image-right{% endif %}">
            
            <div class="sus-content">
              <h3 class="feature-heading">{{ block.settings.heading }}</h3>
              <div class="rte-text">{{ block.settings.text }}</div>
            </div>

            <div class="sus-media">
              {% if block.settings.image != blank %}
                <img src="{{ block.settings.image | image_url: width: 800 }}" alt="{{ block.settings.heading }}" loading="lazy" class="rounded-img">
              {% else %}
                {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
              {% endif %}
            </div>

          </div>
          <div class="sus-divider"></div>
        </div>

        {% comment %} === TWO COLUMN GRID (Trees/Water Section) === {% endcomment %}
        {% when 'two_columns' %}
        <div class="sus-block" {{ block.shopify_attributes }}>
          <div class="two-col-grid">
            
            <!-- Column 1 -->
            <div class="col-item">
              <div class="col-image">
                {% if block.settings.image_1 != blank %}
                  <img src="{{ block.settings.image_1 | image_url: width: 600 }}" loading="lazy">
                {% else %}
                  {{ 'collection-1' | placeholder_svg_tag: 'placeholder-svg' }}
                {% endif %}
              </div>
              <h4 class="col-title">{{ block.settings.title_1 }}</h4>
              <p class="col-text">{{ block.settings.text_1 }}</p>
            </div>

            <!-- Column 2 -->
            <div class="col-item">
              <div class="col-image">
                {% if block.settings.image_2 != blank %}
                  <img src="{{ block.settings.image_2 | image_url: width: 600 }}" loading="lazy">
                {% else %}
                  {{ 'collection-2' | placeholder_svg_tag: 'placeholder-svg' }}
                {% endif %}
              </div>
              <h4 class="col-title">{{ block.settings.title_2 }}</h4>
              <p class="col-text">{{ block.settings.text_2 }}</p>
            </div>

          </div>
          <div class="sus-divider"></div>
        </div>

        {% comment %} === FOOTER CTA (Logo Center) === {% endcomment %}
        {% when 'footer_cta' %}
        <div class="sus-block footer-block" {{ block.shopify_attributes }}>
          <div class="footer-inner">
            {% if block.settings.logo != blank %}
              <div class="footer-logo">
                <img src="{{ block.settings.logo | image_url: width: 300 }}" loading="lazy">
              </div>
            {% endif %}
            
            <h3 class="feature-heading">{{ block.settings.heading }}</h3>
            <div class="rte-text footer-text">{{ block.settings.text }}</div>
            
            {% if block.settings.btn_text != blank %}
              <a href="{{ block.settings.btn_link }}" class="sus-btn">{{ block.settings.btn_text }}</a>
            {% endif %}
          </div>
          <div class="sus-divider"></div>
        </div>

      {% endcase %}
    {% endfor %}
  </div>
</div>

<style>
  /* --- Variables --- */
  .section-{{ section.id }} {
    --green-color: {{ section.settings.accent_color }}; /* #78be20 */
    --text-color: #333333;
    padding: 50px 0;
    background: #fff;
  }

  .sus-container {
    max-width: 1100px;
    margin: 0 auto;
    padding: 0 20px;
  }

  .sus-block {
    margin-bottom: 40px;
  }

  /* --- Typography --- */
  .pre-heading {
    display: block;
    text-transform: uppercase;
    font-size: 12px;
    font-weight: 700;
    margin-bottom: 5px;
    color: #555;
  }
  .main-heading {
    font-size: 32px;
    font-weight: 700;
    margin: 0 0 20px 0;
    line-height: 1.2;
    color: #000;
  }
  .feature-heading {
    font-size: 18px;
    font-weight: 700;
    margin: 0 0 10px 0;
    color: #000;
  }
  .rte-text {
    font-size: 14px;
    line-height: 1.6;
    color: #444;
    margin-bottom: 20px;
  }
  .rte-text strong {
    color: #000;
  }

  /* --- Divider --- */
  .sus-divider {
    width: 100%;
    height: 2px;
    background-color: var(--green-color);
    margin-top: 40px;
  }

  /* --- Button --- */
  .sus-btn {
    display: inline-block;
    background-color: var(--green-color);
    color: #fff;
    padding: 10px 20px;
    text-decoration: none;
    font-weight: 700;
    font-size: 13px;
    text-transform: uppercase;
    border-radius: 4px;
  }
  .sus-btn:hover { opacity: 0.9; }

  /* --- Zig Zag Grid --- */
  .sus-grid {
    display: flex;
    align-items: center;
    gap: 40px;
  }
  .sus-grid > div { flex: 1; }
  
  .sus-grid.image-right { flex-direction: row; } /* Text Left, Image Right */
  .sus-grid.image-left { flex-direction: row-reverse; } /* Text Right, Image Left */

  .sus-media img {
    width: 100%;
    height: auto;
    border-radius: 8px;
    display: block;
  }

  /* --- Two Column Grid --- */
  .two-col-grid {
    display: flex;
    gap: 30px;
  }
  .col-item {
    flex: 1;
    text-align: center;
  }
  .col-image img {
    width: 100%;
    height: auto;
    border-radius: 8px;
    margin-bottom: 15px;
  }
  .col-title {
    font-size: 15px;
    font-weight: 700;
    margin-bottom: 5px;
  }
  .col-text {
    font-size: 13px;
    line-height: 1.5;
    color: #555;
  }

  /* --- Footer Block --- */
  .footer-block { text-align: center; }
  .footer-inner { max-width: 800px; margin: 0 auto; }
  .footer-logo img { max-width: 180px; margin-bottom: 15px; }

  /* --- Mobile --- */
  @media (max-width: 768px) {
    .sus-grid, .sus-grid.image-left, .sus-grid.image-right {
      flex-direction: column-reverse; /* Image Top */
    }
    .hero-block .sus-grid { flex-direction: column; } /* Hero Image Top */
    .two-col-grid { flex-direction: column; }
  }
</style>

{% schema %}
{
  "name": "Sustainability Layout",
  "settings": [
    {
      "type": "color",
      "id": "accent_color",
      "label": "Divider/Button Color",
      "default": "#78be20"
    }
  ],
  "blocks": [
    {
      "type": "hero",
      "name": "Top Hero Section",
      "limit": 1,
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image (Left)" },
        { "type": "text", "id": "pre_heading", "label": "Small Heading", "default": "ROBOTIC CLEANING SOLUTIONS" },
        { "type": "text", "id": "heading", "label": "Main Heading", "default": "Drive Sustainability with Robotics" },
        { "type": "richtext", "id": "text", "label": "Content" },
        { "type": "text", "id": "btn_text", "label": "Button Label", "default": "Explore Robotics Range" },
        { "type": "url", "id": "btn_link", "label": "Button Link" }
      ]
    },
    {
      "type": "feature_row",
      "name": "Content Row (ZigZag)",
      "settings": [
        {
          "type": "select",
          "id": "layout",
          "label": "Image Position",
          "default": "right",
          "options": [
            { "value": "left", "label": "Image Left" },
            { "value": "right", "label": "Image Right" }
          ]
        },
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "heading", "label": "Heading" },
        { "type": "richtext", "id": "text", "label": "Content" }
      ]
    },
    {
      "type": "two_columns",
      "name": "2 Images (Trees/Water)",
      "limit": 1,
      "settings": [
        { "type": "header", "content": "Left Column" },
        { "type": "image_picker", "id": "image_1", "label": "Image 1" },
        { "type": "text", "id": "title_1", "label": "Title 1", "default": "Partnership with EverTreen" },
        { "type": "textarea", "id": "text_1", "label": "Text 1" },
        { "type": "header", "content": "Right Column" },
        { "type": "image_picker", "id": "image_2", "label": "Image 2" },
        { "type": "text", "id": "title_2", "label": "Title 2", "default": "Partnership with Charity:Water" },
        { "type": "textarea", "id": "text_2", "label": "Text 2" }
      ]
    },
    {
      "type": "footer_cta",
      "name": "Footer (Logo Center)",
      "limit": 1,
      "settings": [
        { "type": "image_picker", "id": "logo", "label": "Logo Image" },
        { "type": "text", "id": "heading", "label": "Heading", "default": "Why Choose Clenli Direct" },
        { "type": "richtext", "id": "text", "label": "Text" },
        { "type": "text", "id": "btn_text", "label": "Button Label", "default": "Learn More" },
        { "type": "url", "id": "btn_link", "label": "Button Link" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Sustainability Layout",
      "blocks": [
        { "type": "hero" },
        { "type": "feature_row", "settings": { "layout": "right" } },
        { "type": "feature_row", "settings": { "layout": "left" } },
        { "type": "feature_row", "settings": { "layout": "right" } },
        { "type": "feature_row", "settings": { "layout": "left" } },
        { "type": "two_columns" },
        { "type": "footer_cta" }
      ]
    }
  ]
}
{% endschema %}