{% comment %}
  Clenli Direct Style Footer Section
{% endcomment %}

<footer class="clenli-footer">
  <!-- Newsletter Section -->
  <div class="footer-newsletter">
    <div class="container">
      <div class="newsletter-wrapper">
        <div class="newsletter-title">
          <h3>{{ section.settings.newsletter_title | default: 'Sign up to Newsletter' }}</h3>
          <p>{{ section.settings.newsletter_subtitle | default: 'And receive latest updates.' }}</p>
        </div>
        <div class="newsletter-form">
          {% form 'customer', class: 'newsletter-form-inner' %}
            <input type="hidden" name="contact[tags]" value="newsletter">
            <div class="input-group">
              <input type="email" name="contact[email]" placeholder="Enter your email address" required>
              <button type="submit" class="btn-signup">Sign up</button>
            </div>
          {% endform %}
        </div>
      </div>
    </div>
  </div>

  <!-- Main Footer -->
  <div class="footer-main">
    <div class="container">
      <div class="footer-grid">
        
        <!-- Column 1: Logo & Contact -->
        <div class="footer-column footer-about">
          <div class="footer-logo">
            {% if section.settings.footer_logo != blank %}
              <img src="{{ section.settings.footer_logo | image_url: width: 200 }}" alt="{{ shop.name }}">
            {% else %}
              <img src="{{ shop.brand.logo | image_url: width: 200 }}" alt="{{ shop.name }}">
            {% endif %}
          </div>
          
          <ul class="contact-info">
            <li class="contact-item phone-item">
              <span class="icon">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
                </svg>
              </span>
              <div class="info">
                <span class="label">{{ section.settings.phone_label | default: 'Got questions? Call us 9 to 5!' }}</span>
                <a href="tel:{{ section.settings.phone_number }}" class="phone-number">
                  {{ section.settings.phone_display | default: '+353 (0)1 811 8920' }}
                </a>
              </div>
            </li>
            
            <li class="contact-item address-item">
              <span class="sub-title">Contact info</span>
              <p class="address">{{ section.settings.address }}</p>
            </li>
          </ul>

          <!-- Social Links -->
          <div class="social-links">
            {% if section.settings.facebook_url != blank %}
              <a href="{{ section.settings.facebook_url }}" target="_blank" aria-label="Facebook">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"></path></svg>
              </a>
            {% endif %}
            {% if section.settings.twitter_url != blank %}
              <a href="{{ section.settings.twitter_url }}" target="_blank" aria-label="Twitter">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M23 3a10.9 10.9 0 0 1-3.14 1.53 4.48 4.48 0 0 0-7.86 3v1A10.66 10.66 0 0 1 3 4s-4 9 5 13a11.64 11.64 0 0 1-7 2c9 5 20 0 20-11.5a4.5 4.5 0 0 0-.08-.83A7.72 7.72 0 0 0 23 3z"></path></svg>
              </a>
            {% endif %}
            {% if section.settings.linkedin_url != blank %}
              <a href="{{ section.settings.linkedin_url }}" target="_blank" aria-label="LinkedIn">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"></path><rect x="2" y="9" width="4" height="12"></rect><circle cx="4" cy="4" r="2"></circle></svg>
              </a>
            {% endif %}
            {% if section.settings.instagram_url != blank %}
              <a href="{{ section.settings.instagram_url }}" target="_blank" aria-label="Instagram">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line></svg>
              </a>
            {% endif %}
          </div>
        </div>

        <!-- Column 2: Find it Fast -->
        <div class="footer-column footer-links-double">
          <h4 class="footer-title">{{ section.settings.col2_title | default: 'Find it fast' }}</h4>
          <div class="links-double-grid">
            <ul class="link-list">
              {% for block in section.blocks %}
                {% if block.type == 'link_col2_left' %}
                  <li><a href="{{ block.settings.link_url }}">{{ block.settings.link_text }}</a></li>
                {% endif %}
              {% endfor %}
            </ul>
            <ul class="link-list">
              {% for block in section.blocks %}
                {% if block.type == 'link_col2_right' %}
                  <li><a href="{{ block.settings.link_url }}">{{ block.settings.link_text }}</a></li>
                {% endif %}
              {% endfor %}
            </ul>
          </div>
        </div>

        <!-- Column 3: My Account -->
        <div class="footer-column footer-links">
          <h4 class="footer-title">{{ section.settings.col3_title | default: 'My Account' }}</h4>
          <ul class="link-list">
            {% for block in section.blocks %}
              {% if block.type == 'link_col3' %}
                <li><a href="{{ block.settings.link_url }}">{{ block.settings.link_text }}</a></li>
              {% endif %}
            {% endfor %}
          </ul>
        </div>

        <!-- Column 4: Customer Care -->
        <div class="footer-column footer-links">
          <h4 class="footer-title">{{ section.settings.col4_title | default: 'Customer Care' }}</h4>
          <ul class="link-list">
            {% for block in section.blocks %}
              {% if block.type == 'link_col4' %}
                <li><a href="{{ block.settings.link_url }}">{{ block.settings.link_text }}</a></li>
              {% endif %}
            {% endfor %}
          </ul>
        </div>

      </div>
    </div>
  </div>

  <!-- Footer Bottom -->
  <div class="footer-bottom">
    <div class="container">
      <div class="footer-bottom-grid">
        <div class="copyright-section">
          <p class="copyright">{{ section.settings.copyright_text | default: '© From 1995 - Till now By Clenli Direct. All Rights Reserved.' }}</p>
          <div class="extra-links">
            {% if section.settings.terms_url != blank %}
              <a href="{{ section.settings.terms_url }}">Terms and Conditions</a>
            {% endif %}
            {% if section.settings.privacy_url != blank %}
              <a href="{{ section.settings.privacy_url }}">Privacy Policy</a>
            {% endif %}
          </div>
        </div>
        <div class="payment-section">
          <span class="producer-text">{{ section.settings.producer_text }}</span>
          <div class="payment-icons">
            {{ 'visa' | payment_type_svg_tag }}
            {{ 'master' | payment_type_svg_tag }}
            {{ 'paypal' | payment_type_svg_tag }}
            {{ 'american_express' | payment_type_svg_tag }}
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Back to Top -->
  <a href="#" id="back-to-top" class="back-to-top">
    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="18 15 12 9 6 15"></polyline></svg>
    <span>Back to Top</span>
  </a>
</footer>

<style>
.clenli-footer {
  --footer-bg: #333;
  --footer-text: #fff;
  --footer-link: #ccc;
  --footer-link-hover: #ffa800;
  --newsletter-bg: #222;
  --footer-bottom-bg:rgb(255, 255, 255);
  font-family: 'Open Sans', sans-serif;
}
.clenli-footer .container { max-width: 1200px; margin: 0 auto; padding: 0 15px; }

/* Newsletter */
.footer-newsletter { background: var(--newsletter-bg); padding: 30px 0; }
.newsletter-wrapper { display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 20px; }
.newsletter-title h3 { color: var(--footer-text); font-size: 24px; font-weight: 600; margin: 0 0 5px; }
.newsletter-title p { color: var(--footer-link); font-size: 14px; margin: 0; }
.newsletter-form { flex: 1; max-width: 500px; }
.newsletter-form-inner .input-group { display: flex; }
.newsletter-form-inner input[type="email"] { flex: 1; padding: 12px 20px; border: none; border-radius: 4px 0 0 4px; font-size: 14px; }
.newsletter-form-inner .btn-signup { background: var(--footer-link-hover); color: #fff; border: none; padding: 12px 25px; border-radius: 0 4px 4px 0; font-size: 14px; font-weight: 600; cursor: pointer; }
.newsletter-form-inner .btn-signup:hover { background: #e69500; }

/* Main Footer */
.footer-main { background: var(--footer-bg); padding: 50px 0 40px; }
.footer-grid { display: grid; grid-template-columns: 1.5fr 1.5fr 1fr 1fr; gap: 30px; }
.footer-logo { margin-bottom: 25px; }
.footer-logo img { max-width: 180px; height: auto; }

/* Contact Info */
.contact-info { list-style: none; padding: 0; margin: 0; }
.contact-item { margin-bottom: 20px; }
.contact-item.phone-item { display: flex; align-items: flex-start; gap: 12px; }
.contact-item .icon { color: var(--footer-link-hover); flex-shrink: 0; margin-top: 3px; }
.contact-item .label { display: block; color: var(--footer-link); font-size: 13px; margin-bottom: 5px; }
.contact-item .phone-number { color: var(--footer-link-hover); font-size: 20px; font-weight: 700; text-decoration: none; }
.contact-item .phone-number:hover { color: #fff; }
.contact-item .sub-title { display: block; color: var(--footer-text); font-size: 14px; font-weight: 600; margin-bottom: 8px; }
.contact-item .address { color: var(--footer-link); font-size: 13px; line-height: 1.6; margin: 0; }

/* Social */
.social-links { display: flex; gap: 12px; margin-top: 20px; }
.social-links a { display: flex; align-items: center; justify-content: center; width: 36px; height: 36px; background: rgba(255,255,255,0.1); border-radius: 50%; color: var(--footer-text); transition: all 0.3s; }
.social-links a:hover { background: var(--footer-link-hover); }

/* Footer Titles & Links */
.footer-title { color: var(--footer-text); font-size: 16px; font-weight: 600; margin: 0 0 20px; text-transform: uppercase; }
.link-list { list-style: none; padding: 0; margin: 0; }
.link-list li { margin-bottom: 10px; }
.link-list a { color: var(--footer-link); font-size: 14px; text-decoration: none; transition: color 0.3s; }
.link-list a:hover { color: var(--footer-link-hover); }
.links-double-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; }

/* Footer Bottom */
.footer-bottom { background: var(--footer-bottom-bg); padding: 20px 0; }
.footer-bottom-grid { display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 15px; }
.copyright-section { display: flex; align-items: center; gap: 20px; flex-wrap: wrap; }
.copyright { color: var(--footer-link); font-size: 13px; margin: 0; }
.extra-links { display: flex; gap: 15px; }
.extra-links a { color: var(--footer-link); font-size: 13px; text-decoration: none; }
.extra-links a:hover { color: var(--footer-link-hover); }
.payment-section { display: flex; align-items: center; gap: 20px; }
.producer-text { color: var(--footer-link); font-size: 12px; }
.payment-icons { display: flex; align-items: center; gap: 8px; }
.payment-icons svg { height: 24px; width: auto; }

/* Back to Top */
.back-to-top { position: fixed; bottom: 30px; right: 30px; display: flex; flex-direction: column; align-items: center; justify-content: center; width: 50px; height: 60px; background: var(--footer-link-hover); color: #fff; border-radius: 5px; text-decoration: none; opacity: 0; visibility: hidden; transition: all 0.3s; z-index: 999; }
.back-to-top.visible { opacity: 1; visibility: visible; }
.back-to-top:hover { background: #e69500; }
.back-to-top span { font-size: 9px; text-align: center; line-height: 1.2; margin-top: 3px; }

/* Responsive */
@media (max-width: 991px) {
  .footer-grid { grid-template-columns: 1fr 1fr; }
  .footer-about { grid-column: span 2; }
}
@media (max-width: 767px) {
  .newsletter-wrapper { flex-direction: column; text-align: center; }
  .newsletter-form { width: 100%; max-width: 100%; }
  .footer-grid { grid-template-columns: 1fr; text-align: center; }
  .footer-about { grid-column: span 1; }
  .contact-item.phone-item { justify-content: center; }
  .social-links { justify-content: center; }
  .footer-bottom-grid { flex-direction: column; text-align: center; }
}
</style>

<script>
document.addEventListener('DOMContentLoaded', function() {
  const backToTop = document.getElementById('back-to-top');
  if (backToTop) {
    window.addEventListener('scroll', function() {
      backToTop.classList.toggle('visible', window.pageYOffset > 300);
    });
    backToTop.addEventListener('click', function(e) {
      e.preventDefault();
      window.scrollTo({ top: 0, behavior: 'smooth' });
    });
  }
});
</script>

{% schema %}
{
  "name": "Clenli Footer",
  "settings": [
    { "type": "header", "content": "Newsletter" },
    { "type": "text", "id": "newsletter_title", "label": "Title", "default": "Sign up to Newsletter" },
    { "type": "text", "id": "newsletter_subtitle", "label": "Subtitle", "default": "And receive latest updates." },
    { "type": "header", "content": "Contact Info" },
    { "type": "image_picker", "id": "footer_logo", "label": "Footer Logo" },
    { "type": "text", "id": "phone_label", "label": "Phone Label", "default": "Got questions? Call us 9 to 5!" },
    { "type": "text", "id": "phone_number", "label": "Phone Number", "default": "+353018118920" },
    { "type": "text", "id": "phone_display", "label": "Phone Display", "default": "+353 (0)1 811 8920" },
    { "type": "textarea", "id": "address", "label": "Address", "default": "Unit 14A Stadium Business Park, Ballycoolin Road, Dublin 11" },
    { "type": "header", "content": "Social Media" },
    { "type": "url", "id": "facebook_url", "label": "Facebook" },
    { "type": "url", "id": "twitter_url", "label": "Twitter" },
    { "type": "url", "id": "linkedin_url", "label": "LinkedIn" },
    { "type": "url", "id": "instagram_url", "label": "Instagram" },
    { "type": "header", "content": "Column Titles" },
    { "type": "text", "id": "col2_title", "label": "Column 2 Title", "default": "Find it fast" },
    { "type": "text", "id": "col3_title", "label": "Column 3 Title", "default": "My Account" },
    { "type": "text", "id": "col4_title", "label": "Column 4 Title", "default": "Customer Care" },
    { "type": "header", "content": "Footer Bottom" },
    { "type": "text", "id": "copyright_text", "label": "Copyright", "default": "© From 1995 - Till now By Clenli Direct. All Rights Reserved." },
    { "type": "url", "id": "terms_url", "label": "Terms URL" },
    { "type": "url", "id": "privacy_url", "label": "Privacy URL" },
    { "type": "text", "id": "producer_text", "label": "Producer Text", "default": "Producer Register Limited (PRL) Number: 1628WB" }
  ],
  "blocks": [
    { "type": "link_col2_left", "name": "Find Fast (Left)", "settings": [
      { "type": "text", "id": "link_text", "label": "Text" },
      { "type": "url", "id": "link_url", "label": "URL" }
    ]},
    { "type": "link_col2_right", "name": "Find Fast (Right)", "settings": [
      { "type": "text", "id": "link_text", "label": "Text" },
      { "type": "url", "id": "link_url", "label": "URL" }
    ]},
    { "type": "link_col3", "name": "My Account Link", "settings": [
      { "type": "text", "id": "link_text", "label": "Text" },
      { "type": "url", "id": "link_url", "label": "URL" }
    ]},
    { "type": "link_col4", "name": "Customer Care Link", "settings": [
      { "type": "text", "id": "link_text", "label": "Text" },
      { "type": "url", "id": "link_url", "label": "URL" }
    ]}
  ],
  "presets": [{ "name": "Clenli Footer" }]
}
{% endschema %}