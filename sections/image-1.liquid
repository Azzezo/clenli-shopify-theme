{%- liquid
    assign section_id = section.id
    assign heading = section.settings.heading
    assign heading_color = section.settings.heading_color
    assign heading_size = section.settings.heading_size
    assign description = section.settings.description
    assign desc_color = section.settings.desc_color
    assign desc_size = section.settings.desc_size
    assign image = section.settings.image
    assign image_width = section.settings.image_width
    assign image_border_color = section.settings.image_border_color
    assign image_border_width = section.settings.image_border_width
    assign image_border_radius = section.settings.image_border_radius
    assign bg_color = section.settings.bg_color
    assign container = section.settings.container
    assign content_gap = section.settings.content_gap
    assign padding_top = section.settings.padding_top
    assign padding_bottom = section.settings.padding_bottom
    assign padding_top_mobile = section.settings.padding_top_mobile
    assign padding_bottom_mobile = section.settings.padding_bottom_mobile
-%}

<style>
    #content-image-{{ section_id }} {
        background-color: {{ bg_color }};
        padding-top: {{ padding_top }}px;
        padding-bottom: {{ padding_bottom }}px;
    }
    
    #content-image-{{ section_id }} .ci-container {
        max-width: 1570px;
        margin: 0 auto;
        padding: 0 15px;
    }
    
    #content-image-{{ section_id }} .ci-wrapper {
        display: flex;
        align-items: center;
        gap: {{ content_gap }}px;
    }
    
    /* Left Side - Content */
    #content-image-{{ section_id }} .ci-content {
        flex: 1;
    }
    
    #content-image-{{ section_id }} .ci-heading {
        font-size: {{ heading_size }}px;
        font-weight: 700;
        color: {{ heading_color }};
        margin: 0 0 15px 0;
        line-height: 1.3;
    }
    
    #content-image-{{ section_id }} .ci-description {
        font-size: {{ desc_size }}px;
        color: {{ desc_color }};
        margin: 0;
        line-height: 1.7;
    }
    
    /* Right Side - Image with Border */
    #content-image-{{ section_id }} .ci-image {
        width: {{ image_width }}%;
        flex-shrink: 0;
    }
    
    #content-image-{{ section_id }} .ci-image-inner {
        {% comment %} border: {{ image_border_width }}px solid {{ image_border_color }}; {% endcomment %}
        border-radius: {{ image_border_radius }}px;
        overflow: hidden;
        padding: {{ section.settings.image_padding }}px;
        background-color: #fff;
    }
    
    #content-image-{{ section_id }} .ci-image-inner img {
        width: 100%;
        height: auto;
        display: block;
        border-radius: {{ image_border_radius | minus: 2 }}px;
    }
    
    #content-image-{{ section_id }} .ci-image-inner .placeholder-img {
        width: 100%;
        height: 300px;
        background: linear-gradient(135deg, #1a365d 0%, #2d5a87 100%);
        display: flex;
        align-items: center;
        justify-content: center;
        color: #fff;
        font-size: 16px;
        border-radius: {{ image_border_radius | minus: 2 }}px;
    }
    
    /* Underline - FIXED VERSION */
    #content-image-{{ section_id }} .cc-underline {
        display: block !important;
        width: 100%;
        height: {{ section.settings.underline_height }}px;
        background-color: {{ section.settings.underline_color }};
        border: none;
        margin: {{ section.settings.underline_margin_top }}px 0 0 0;
        padding: 0;
        opacity: 1 !important;
    }
    
    /* Tablet */
    @media (max-width: 1024px) {
        #content-image-{{ section_id }} .ci-wrapper {
            gap: 30px;
        }
        
        #content-image-{{ section_id }} .ci-heading {
            font-size: {{ heading_size | minus: 4 }}px;
        }
        
        #content-image-{{ section_id }} .ci-image {
            width: 45%;
        }
    }
    
    /* Mobile */
    @media (max-width: 767px) {
        #content-image-{{ section_id }} {
            padding-top: {{ padding_top_mobile }}px;
            padding-bottom: {{ padding_bottom_mobile }}px;
        }
        
        #content-image-{{ section_id }} .ci-wrapper {
            flex-direction: column;
            gap: 25px;
        }
        
        #content-image-{{ section_id }} .ci-content {
            text-align: center;
        }
        
        #content-image-{{ section_id }} .ci-heading {
            font-size: {{ heading_size | minus: 6 }}px;
            margin-bottom: 12px;
        }
        
        #content-image-{{ section_id }} .ci-description {
            font-size: {{ desc_size | minus: 1 }}px;
        }
        
        #content-image-{{ section_id }} .ci-image {
            width: 100%;
            max-width: 400px;
        }
        
        #content-image-{{ section_id }} .ci-image-inner .placeholder-img {
            height: 220px;
        }
        
        #content-image-{{ section_id }} .cc-underline {
            margin-top: {{ section.settings.underline_margin_top | minus: 10 }}px;
        }
    }
</style>

<section id="content-image-{{ section_id }}" class="content-image-section">
    <div class="ci-container">
        <!-- Content & Image Wrapper -->
        <div class="ci-wrapper">
            
            <!-- Left Side - Heading & Description -->
            <div class="ci-content">
                {%- if heading != blank -%}
                    <h2 class="ci-heading">{{ heading }}</h2>
                {%- endif -%}
                
                {%- if description != blank -%}
                    <div class="ci-description">{{ description }}</div>
                {%- endif -%}
            </div>
            
            <!-- Right Side - Image with Border -->
            <div class="ci-image">
                <div class="ci-image-inner">
                    {%- if image != blank -%}
                        <img src="{{ image | image_url: width: 800 }}" alt="{{ section.settings.image_alt | default: 'Image' }}" loading="lazy">
                    {%- else -%}
                        <div class="placeholder-img">
                            <span>Image ({{ image_width }}%)</span>
                        </div>
                    {%- endif -%}
                </div>
            </div>
            
        </div>
        
        <!-- ✅ Underline - NOW OUTSIDE WRAPPER & WILL BE VISIBLE! -->
        {%- if section.settings.show_underline -%}
            <div class="cc-underline"></div>
        {%- endif -%}
        
    </div>
</section>

{% schema %}
{
    "name": "Content With Image",
    "tag": "section",
    "class": "content-image-block",
    "settings": [
        {
            "type": "header",
            "content": "Left Side - Content"
        },
        {
            "type": "text",
            "id": "heading",
            "label": "Heading",
            "default": "Your Heading Here"
        },
        {
            "type": "color",
            "id": "heading_color",
            "label": "Heading Color",
            "default": "#232323"
        },
        {
            "type": "range",
            "id": "heading_size",
            "label": "Heading Font Size",
            "min": 18,
            "max": 50,
            "step": 1,
            "unit": "px",
            "default": 28
        },
        {
            "type": "richtext",
            "id": "description",
            "label": "Description",
            "default": "<p>Add your description text here. This text will appear below the heading on the left side of the section.</p>"
        },
        {
            "type": "color",
            "id": "desc_color",
            "label": "Description Color",
            "default": "#555555"
        },
        {
            "type": "range",
            "id": "desc_size",
            "label": "Description Font Size",
            "min": 12,
            "max": 22,
            "step": 1,
            "unit": "px",
            "default": 16
        },
        {
            "type": "header",
            "content": "Right Side - Image"
        },
        {
            "type": "image_picker",
            "id": "image",
            "label": "Image"
        },
        {
            "type": "text",
            "id": "image_alt",
            "label": "Image Alt Text",
            "default": "Image"
        },
        {
            "type": "range",
            "id": "image_width",
            "label": "Image Width (%)",
            "min": 30,
            "max": 60,
            "step": 5,
            "unit": "%",
            "default": 50
        },
        {
            "type": "color",
            "id": "image_border_color",
            "label": "Image Border Color",
            "default": "#6fb31a"
        },
        {
            "type": "range",
            "id": "image_border_width",
            "label": "Image Border Width",
            "min": 1,
            "max": 10,
            "step": 1,
            "unit": "px",
            "default": 3
        },
        {
            "type": "range",
            "id": "image_border_radius",
            "label": "Image Border Radius",
            "min": 0,
            "max": 30,
            "step": 2,
            "unit": "px",
            "default": 8
        },
        {
            "type": "range",
            "id": "image_padding",
            "label": "Image Inner Padding",
            "min": 0,
            "max": 20,
            "step": 2,
            "unit": "px",
            "default": 0
        },
        {
            "type": "header",
            "content": "✨ Underline Settings (NEW)"
        },
        {
            "type": "checkbox",
            "id": "show_underline",
            "label": "Show Underline",
            "default": true
        },
        {
            "type": "color",
            "id": "underline_color",
            "label": "Underline Color",
            "default": "#6fb31a"
        },
        {
            "type": "range",
            "id": "underline_height",
            "label": "Underline Thickness",
            "min": 2,
            "max": 10,
            "step": 1,
            "unit": "px",
            "default": 4,
            "info": "Recommended: 3-5px for best visibility"
        },
        {
            "type": "range",
            "id": "underline_margin_top",
            "label": "Space Above Underline",
            "min": 20,
            "max": 80,
            "step": 5,
            "unit": "px",
            "default": 50
        },
        {
            "type": "header",
            "content": "Layout Settings"
        },
        {
            "type": "color",
            "id": "bg_color",
            "label": "Background Color",
            "default": "#ffffff"
        },
        {
            "type": "select",
            "id": "container",
            "label": "Container Width",
            "default": "1170",
            "options": [
                {"value": "1170", "label": "1170px"},
                {"value": "1370", "label": "1370px"},
                {"value": "1570", "label": "1570px"}
            ]
        },
        {
            "type": "range",
            "id": "content_gap",
            "label": "Gap Between Content & Image",
            "min": 20,
            "max": 80,
            "step": 5,
            "unit": "px",
            "default": 50
        },
        {
            "type": "range",
            "id": "padding_top",
            "label": "Padding Top (Desktop)",
            "min": 0,
            "max": 100,
            "step": 5,
            "unit": "px",
            "default": 60
        },
        {
            "type": "range",
            "id": "padding_bottom",
            "label": "Padding Bottom (Desktop)",
            "min": 0,
            "max": 100,
            "step": 5,
            "unit": "px",
            "default": 60
        },
        {
            "type": "range",
            "id": "padding_top_mobile",
            "label": "Padding Top (Mobile)",
            "min": 0,
            "max": 80,
            "step": 5,
            "unit": "px",
            "default": 40
        },
        {
            "type": "range",
            "id": "padding_bottom_mobile",
            "label": "Padding Bottom (Mobile)",
            "min": 0,
            "max": 80,
            "step": 5,
            "unit": "px",
            "default": 40
        }
    ],
    "presets": [
        {
            "name": "Content With Image"
        }
    ]
}
{% endschema %}
