<div class="our-team-section section-{{ section.id }}">
  <div class="team-container">
    <!-- Header -->
    {%- if section.settings.heading != blank -%}
      <div class="team-header">
        {%- if section.settings.label != blank -%}
          <span class="team-label">{{ section.settings.label }}</span>
        {%- endif -%}
        <h2 class="team-heading">{{ section.settings.heading }}</h2>
      </div>
    {%- endif -%}

    <!-- Team Grid -->
    <div class="team-grid">
      {%- for block in section.blocks -%}
        {%- if block.type == 'team_member' -%}
          <div class="team-member" {{ block.shopify_attributes }}>
            <div class="member-image">
              {%- if block.settings.image != blank -%}
                <img
                  src="{{ block.settings.image | image_url: width: 300 }}"
                  alt="{{ block.settings.name }}"
                  loading="lazy"
                >
              {%- else -%}
                <div class="placeholder-img">
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    width="40"
                    height="40"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="#ccc"
                    stroke-width="1.5"
                  >
                    <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
                    <circle cx="12" cy="7" r="4"></circle>
                  </svg>
                </div>
              {%- endif -%}
            </div>

            <div class="member-info">
              {%- if block.settings.name != blank -%}
                <h4 class="member-name">{{ block.settings.name }}</h4>
              {%- endif -%}
              {%- if block.settings.position != blank -%}
                <span class="member-position">{{ block.settings.position }}</span>
              {%- endif -%}
            </div>
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</div>

{% style %}
  .section-{{ section.id }} {
      padding: {{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px;
      background: {{ section.settings.bg_color }};
  }

  .section-{{ section.id }} .team-container {
      max-width: 1570px;
      margin: 0 auto;
      padding: 0 20px;
  }

  /* Header */
  .section-{{ section.id }} .team-header {
      text-align: {{ section.settings.header_align }};
      margin-bottom: 40px;
  }

  .section-{{ section.id }} .team-label {
      display: inline-block;
      font-size: 13px;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 2px;
      color: {{ section.settings.accent_color }};
      margin-bottom: 10px;
  }

  .section-{{ section.id }} .team-heading {
      font-size: {{ section.settings.heading_size }}px;
      font-weight: 700;
      color: {{ section.settings.heading_color }};
      margin: 0;
      line-height: 1.3;
  }

  /* Team Grid - 4 per row */
  .section-{{ section.id }} .team-grid {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: {{ section.settings.card_gap }}px;
  }

  /* Team Member Card */
  .section-{{ section.id }} .team-member {
      text-align: left;
  }

  /* Member Image - Smaller */
  .section-{{ section.id }} .member-image {
      width: 100%;
      max-width: {{ section.settings.image_size }}px;
      aspect-ratio: 1;
      border-radius: {{ section.settings.image_radius }}px;
      overflow: hidden;
      background: #f5f5f5;
      margin-bottom: 10px;
  }

  .section-{{ section.id }} .member-image img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      transition: transform 0.3s ease;
  }

  .section-{{ section.id }} .team-member:hover .member-image img {
      transform: scale(1.05);
  }

  .section-{{ section.id }} .placeholder-img {
      width: 100%;
      height: 100%;
      display: flex;
      align-items: center;
      justify-content: center;
      background: #f0f0f0;
  }

  /* Member Info - Left aligned, less padding */
  .section-{{ section.id }} .member-info {
      padding: 5px 0;
  }

  .section-{{ section.id }} .member-name {
      font-size: 15px;
      font-weight: 600;
      color: {{ section.settings.heading_color }};
      margin: 0 0 2px 0;
      line-height: 1.3;
  }

  .section-{{ section.id }} .member-position {
      display: block;
      font-size: 13px;
      font-weight: 400;
      color: {{ section.settings.text_color }};
  }

  /* Responsive */
  @media (max-width: 1200px) {
      .section-{{ section.id }} .team-grid {
          grid-template-columns: repeat(4, 1fr);
      }
  }

  @media (max-width: 991px) {
      .section-{{ section.id }} .team-grid {
          grid-template-columns: repeat(3, 1fr);
      }
  }

  @media (max-width: 767px) {
      .section-{{ section.id }} .team-grid {
          grid-template-columns: repeat(2, 1fr);
      }
  }

  @media (max-width: 480px) {
      .section-{{ section.id }} .team-grid {
          grid-template-columns: repeat(2, 1fr);
          gap: 15px;
      }

      .section-{{ section.id }} .member-name {
          font-size: 14px;
      }

      .section-{{ section.id }} .member-position {
          font-size: 12px;
      }
  }
{% endstyle %}

{% schema %}
{
  "name": "Our Team",
  "tag": "section",
  "settings": [
    {
      "type": "header",
      "content": "Header"
    },
    {
      "type": "text",
      "id": "label",
      "label": "Label",
      "default": "OUR TEAM"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Meet Our Team"
    },
    {
      "type": "select",
      "id": "header_align",
      "label": "Header Alignment",
      "default": "center",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ]
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Heading Size",
      "min": 24,
      "max": 48,
      "step": 2,
      "unit": "px",
      "default": 32
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "image_size",
      "label": "Image Size",
      "min": 120,
      "max": 280,
      "step": 10,
      "unit": "px",
      "default": 180
    },
    {
      "type": "range",
      "id": "image_radius",
      "label": "Image Radius",
      "min": 0,
      "max": 50,
      "step": 2,
      "unit": "%",
      "default": 8
    },
    {
      "type": "range",
      "id": "card_gap",
      "label": "Card Gap",
      "min": 15,
      "max": 50,
      "step": 5,
      "unit": "px",
      "default": 25
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading Color",
      "default": "#1a1a1a"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#666666"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent Color",
      "default": "#6fb31a"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding Top",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding Bottom",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "default": 60
    }
  ],
  "blocks": [
    {
      "type": "team_member",
      "name": "Team Member",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Photo"
        },
        {
          "type": "text",
          "id": "name",
          "label": "Name",
          "default": "John Doe"
        },
        {
          "type": "text",
          "id": "position",
          "label": "Role",
          "default": "CEO"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Our Team",
      "blocks": [
        { "type": "team_member", "settings": { "name": "John Smith", "position": "CEO" } },
        { "type": "team_member", "settings": { "name": "Sarah Johnson", "position": "Operations Manager" } },
        { "type": "team_member", "settings": { "name": "Michael Brown", "position": "Sales Director" } },
        { "type": "team_member", "settings": { "name": "Emily Davis", "position": "Marketing Manager" } },
        { "type": "team_member", "settings": { "name": "David Wilson", "position": "Technical Lead" } },
        { "type": "team_member", "settings": { "name": "Lisa Anderson", "position": "Customer Support" } },
        { "type": "team_member", "settings": { "name": "James Taylor", "position": "Product Manager" } },
        { "type": "team_member", "settings": { "name": "Emma Martinez", "position": "Finance Manager" } },
        { "type": "team_member", "settings": { "name": "Robert Garcia", "position": "Logistics Manager" } },
        { "type": "team_member", "settings": { "name": "Jennifer Lee", "position": "HR Manager" } },
        { "type": "team_member", "settings": { "name": "William Clark", "position": "Regional Manager" } },
        { "type": "team_member", "settings": { "name": "Amanda White", "position": "Training Specialist" } },
        { "type": "team_member", "settings": { "name": "Christopher Hall", "position": "Quality Assurance" } },
