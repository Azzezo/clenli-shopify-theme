<div class="alternating-section section-{{ section.id }}">
    <div class="alternating-container">
        {%- for block in section.blocks -%}
            {%- assign is_even = forloop.index | modulo: 2 -%}
            <div class="alternating-row {% if is_even == 0 %}reverse{% endif %}" {{ block.shopify_attributes }}>
                <!-- Content -->
                <div class="alternating-content">
                    {%- if block.settings.label != blank -%}
                        <span class="alt-label">{{ block.settings.label }}</span>
                    {%- endif -%}
                    
                    {%- if block.settings.heading != blank -%}
                        <h2 class="alt-heading">{{ block.settings.heading }}</h2>
                    {%- endif -%}
                    
                    {%- if block.settings.text != blank -%}
                        <div class="alt-text">{{ block.settings.text }}</div>
                    {%- endif -%}
                    
                    {%- if block.settings.button_text != blank -%}
                        <a href="{{ block.settings.button_link | default: '#' }}" class="alt-button">
                            {{ block.settings.button_text }}
                        </a>
                    {%- endif -%}
                </div>
                
                <!-- Image -->
                <div class="alternating-image">
                    {%- if block.settings.image != blank -%}
                        <img src="{{ block.settings.image | image_url: width: 800 }}" alt="{{ block.settings.heading }}" loading="lazy">
                    {%- else -%}
                        {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
                    {%- endif -%}
                </div>
            </div>
            
            <!-- Underline after each row -->
            <div class="alternating-underline"></div>
        {%- endfor -%}
    </div>
</div>

{% style %}
.section-{{ section.id }} {
    padding: {{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px;
    background: {{ section.settings.bg_color }};
}

.section-{{ section.id }} .alternating-container {
    max-width: 1370px;
    margin: 0 auto;
    padding: 0 20px;
}

.section-{{ section.id }} .alternating-row {
    display: flex;
    align-items: center;
    gap: 60px;
}

.section-{{ section.id }} .alternating-row.reverse {
    flex-direction: row-reverse;
}

.section-{{ section.id }} .alternating-content {
    flex: 1;
}

.section-{{ section.id }} .alt-label {
    display: inline-block;
    color: {{ section.settings.accent_color }};
    font-size: 13px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 1.5px;
    margin-bottom: 12px;
}

.section-{{ section.id }} .alt-heading {
    font-size: {{ section.settings.heading_size }}px;
    font-weight: 700;
    color: {{ section.settings.heading_color }};
    margin: 0 0 20px 0;
    line-height: 1.25;
}

.section-{{ section.id }} .alt-text {
    font-size: 16px;
    line-height: 1.7;
    color: {{ section.settings.text_color }};
    margin-bottom: 25px;
}

.section-{{ section.id }} .alt-text p {
    margin: 0 0 15px 0;
}

.section-{{ section.id }} .alt-text p:last-child {
    margin-bottom: 0;
}

.section-{{ section.id }} .alt-button {
    display: inline-block;
    padding: 14px 32px;
    background: {{ section.settings.button_bg }};
    color: {{ section.settings.button_color }};
    text-decoration: none;
    font-size: 15px;
    font-weight: 600;
    border-radius: {{ section.settings.button_radius }}px;
    transition: all 0.3s ease;
}

.section-{{ section.id }} .alt-button:hover {
    background: {{ section.settings.button_hover_bg }};
    transform: translateY(-2px);
    box-shadow: 0 5px 20px rgba(0,0,0,0.15);
}

.section-{{ section.id }} .alternating-image {
    flex: 1;
}

.section-{{ section.id }} .alternating-image img {
    width: 100%;
    height: auto;
    border-radius: {{ section.settings.image_radius }}px;
    box-shadow: 0 10px 40px rgba(0,0,0,0.1);
}

.section-{{ section.id }} .alternating-image .placeholder-svg {
    width: 100%;
    height: 350px;
    background: #f5f5f5;
    border-radius: {{ section.settings.image_radius }}px;
}

/* Underline after each row */
.section-{{ section.id }} .alternating-underline {
    color:green;
    height: {{ section.settings.underline_height }}px;
    background: {{ section.settings.underline_color }};
    margin: {{ section.settings.underline_spacing }}px 0;
    border-radius: {{ section.settings.underline_height }}px;
}

/* Hide last underline if setting enabled */
{%- if section.settings.hide_last_underline -%}
.section-{{ section.id }} .alternating-underline:last-child {
    display: none;
}
{%- endif -%}

@media (max-width: 991px) {
    .section-{{ section.id }} .alternating-row {
        flex-direction: column;
        gap: 30px;
    }
    
    .section-{{ section.id }} .alternating-row.reverse {
        flex-direction: column;
    }
    
    .section-{{ section.id }} .alt-heading {
        font-size: 28px;
    }
    
    .section-{{ section.id }} .alternating-underline {
        margin: 40px 0;
    }
}

@media (max-width: 575px) {
    .section-{{ section.id }} {
        padding: 40px 0;
    }
    
    .section-{{ section.id }} .alt-heading {
        font-size: 24px;
    }
    
    .section-{{ section.id }} .alternating-underline {
        margin: 30px 0;
    }
}
{% endstyle %}

{% schema %}
{
    "name": "Alternating Content",
    "tag": "section",
    "settings": [
        {
            "type": "header",
            "content": "Layout"
        },
        {
            "type": "range",
            "id": "heading_size",
            "label": "Heading Size",
            "min": 24,
            "max": 48,
            "step": 2,
            "unit": "px",
            "default": 36
        },
        {
            "type": "range",
            "id": "image_radius",
            "label": "Image Radius",
            "min": 0,
            "max": 30,
            "step": 2,
            "unit": "px",
            "default": 8
        },
        {
            "type": "range",
            "id": "button_radius",
            "label": "Button Radius",
            "min": 0,
            "max": 30,
            "step": 2,
            "unit": "px",
            "default": 4
        },
        {
            "type": "header",
            "content": "Underline"
        },
        {
            "type": "color",
            "id": "underline_color",
            "label": "Underline Color",
            "default": "#6fb31a"
        },
        {
            "type": "range",
            "id": "underline_height",
            "label": "Underline Height",
            "min": 1,
            "max": 10,
            "step": 1,
            "unit": "px",
            "default": 3
        },
        {
            "type": "range",
            "id": "underline_spacing",
            "label": "Underline Spacing",
            "min": 20,
            "max": 100,
            "step": 5,
            "unit": "px",
            "default": 50
        },
        {
            "type": "checkbox",
            "id": "hide_last_underline",
            "label": "Hide Last Underline",
            "default": true
        },
        {
            "type": "header",
            "content": "Colors"
        },
        {
            "type": "color",
            "id": "bg_color",
            "label": "Background",
            "default": "#ffffff"
        },
        {
            "type": "color",
            "id": "accent_color",
            "label": "Label Color",
            "default": "#6fb31a"
        },
        {
            "type": "color",
            "id": "heading_color",
            "label": "Heading Color",
            "default": "#1a1a1a"
        },
        {
            "type": "color",
            "id": "text_color",
            "label": "Text Color",
            "default": "#555555"
        },
        {
            "type": "color",
            "id": "button_bg",
            "label": "Button Background",
            "default": "#6fb31a"
        },
        {
            "type": "color",
            "id": "button_hover_bg",
            "label": "Button Hover",
            "default": "#5a9216"
        },
        {
            "type": "color",
            "id": "button_color",
            "label": "Button Text",
            "default": "#ffffff"
        },
        {
            "type": "header",
            "content": "Spacing"
        },
        {
            "type": "range",
            "id": "padding_top",
            "label": "Padding Top",
            "min": 0,
            "max": 100,
            "step": 5,
            "unit": "px",
            "default": 60
        },
        {
            "type": "range",
            "id": "padding_bottom",
            "label": "Padding Bottom",
            "min": 0,
            "max": 100,
            "step": 5,
            "unit": "px",
            "default": 60
        }
    ],
    "blocks": [
        {
            "type": "row",
            "name": "Content Row",
            "settings": [
                {
                    "type": "image_picker",
                    "id": "image",
                    "label": "Image"
                },
                {
                    "type": "text",
                    "id": "label",
                    "label": "Label",
                    "default": "OUR SERVICE"
                },
                {
                    "type": "text",
                    "id": "heading",
                    "label": "Heading",
                    "default": "Professional Cleaning Solutions"
                },
                {
                    "type": "richtext",
                    "id": "text",
                    "label": "Text",
                    "default": "<p>Lorem ipsum dolor sit amet, consectetur adipiscing elit.</p>"
                },
                {
                    "type": "text",
                    "id": "button_text",
                    "label": "Button Text",
                    "default": "Learn More"
                },
                {
                    "type": "url",
                    "id": "button_link",
                    "label": "Button Link"
                }
            ]
        }
    ],
    "presets": [
        {
            "name": "Alternating Content",
            "blocks": [
                {
                    "type": "row",
                    "settings": {
                        "label": "OUR SERVICES",
                        "heading": "Professional Cleaning Equipment",
                        "text": "<p>We provide top-quality cleaning machines and equipment for commercial and industrial use.</p>",
                        "button_text": "View Products"
                    }
                },
                {
                    "type": "row",
                    "settings": {
                        "label": "WHY CHOOSE US",
                        "heading": "Expert Support & Training",
                        "text": "<p>Our dedicated team provides comprehensive training and ongoing support.</p>",
                        "button_text": "Contact Us"
                    }
                },
                {
                    "type": "row",
                    "settings": {
                        "label": "SUSTAINABILITY",
                        "heading": "Eco-Friendly Solutions",
                        "text": "<p>We're committed to sustainability with our range of environmentally friendly products.</p>",
                        "button_text": "Learn More"
                    }
                }
            ]
        }
    ]
}
{% endschema %}
