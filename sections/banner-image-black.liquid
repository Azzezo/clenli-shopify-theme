<div class="banner-overlay-section section-{{ section.id }}">
    <div class="banner-wrapper">
        <!-- Background Image -->
        <div class="banner-image">
            {%- if section.settings.image != blank -%}
                <img src="{{ section.settings.image | image_url: width: 1920 }}" alt="{{ section.settings.heading }}" loading="lazy">
            {%- else -%}
                {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}
            {%- endif -%}
        </div>
        
        <!-- Black Overlay -->
        <div class="banner-overlay"></div>
        
        <!-- Content -->
        <div class="banner-content">
            <div class="banner-container">
                {%- if section.settings.label != blank -%}
                    <span class="banner-label">{{ section.settings.label }}</span>
                {%- endif -%}
                
                {%- if section.settings.heading != blank -%}
                    <h1 class="banner-heading">{{ section.settings.heading }}</h1>
                {%- endif -%}
                
                {%- if section.settings.description != blank -%}
                    <p class="banner-description">{{ section.settings.description }}</p>
                {%- endif -%}
                
                {%- if section.settings.button_text != blank -%}
                    <a href="{{ section.settings.button_link | default: '#' }}" class="banner-button">
                        {{ section.settings.button_text }}
                    </a>
                {%- endif -%}
            </div>
        </div>
    </div>
</div>

{% style %}
.section-{{ section.id }} .banner-wrapper {
    position: relative;
    width: 100%;
    height: {{ section.settings.banner_height }}px;
    overflow: hidden;
}

/* Background Image */
.section-{{ section.id }} .banner-image {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
}

.section-{{ section.id }} .banner-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
}

.section-{{ section.id }} .banner-image .placeholder-svg {
    width: 100%;
    height: 100%;
    background: #333;
}

/* Black Overlay */
.section-{{ section.id }} .banner-overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: rgba(0, 0, 0, {{ section.settings.overlay_opacity | divided_by: 100.0 }});
    z-index: 1;
}

/* Content */
.section-{{ section.id }} .banner-content {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    display: flex;
    align-items: {{ section.settings.vertical_align }};
    justify-content: {{ section.settings.horizontal_align }};
    z-index: 2;
    padding: 40px 20px;
}

.section-{{ section.id }} .banner-container {
    max-width: 900px;
    text-align: {{ section.settings.text_align }};
}

/* Label */
.section-{{ section.id }} .banner-label {
    display: inline-block;
    font-size: 14px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 2px;
    color: {{ section.settings.accent_color }};
    margin-bottom: 15px;
}

/* Heading */
.section-{{ section.id }} .banner-heading {
    font-size: {{ section.settings.heading_size }}px;
    font-weight: 700;
    color: {{ section.settings.text_color }};
    margin: 0 0 20px 0;
    line-height: 1.2;
}

/* Description */
.section-{{ section.id }} .banner-description {
    font-size: {{ section.settings.description_size }}px;
    line-height: 1.7;
    color: {{ section.settings.text_color }};
    margin: 0 0 30px 0;
    opacity: 0.9;
}

/* Button */
.section-{{ section.id }} .banner-button {
    display: inline-block;
    padding: 15px 35px;
    background: {{ section.settings.button_bg }};
    color: {{ section.settings.button_color }};
    text-decoration: none;
    font-size: 15px;
    font-weight: 600;
    border-radius: {{ section.settings.button_radius }}px;
    transition: all 0.3s ease;
}

.section-{{ section.id }} .banner-button:hover {
    background: {{ section.settings.button_hover_bg }};
    transform: translateY(-2px);
    box-shadow: 0 5px 20px rgba(0,0,0,0.3);
}

/* Responsive */
@media (max-width: 991px) {
    .section-{{ section.id }} .banner-wrapper {
        height: {{ section.settings.banner_height | times: 0.8 }}px;
    }
    
    .section-{{ section.id }} .banner-heading {
        font-size: {{ section.settings.heading_size | times: 0.75 }}px;
    }
}

@media (max-width: 575px) {
    .section-{{ section.id }} .banner-wrapper {
        height: {{ section.settings.banner_height | times: 0.6 }}px;
    }
    
    .section-{{ section.id }} .banner-heading {
        font-size: {{ section.settings.heading_size | times: 0.55 }}px;
    }
    
    .section-{{ section.id }} .banner-description {
        font-size: 14px;
    }
    
    .section-{{ section.id }} .banner-button {
        padding: 12px 25px;
        font-size: 14px;
    }
}
{% endstyle %}

{% schema %}
{
    "name": "Banner Overlay",
    "tag": "section",
    "settings": [
        {
            "type": "header",
            "content": "Image"
        },
        {
            "type": "image_picker",
            "id": "image",
            "label": "Banner Image"
        },
        {
            "type": "range",
            "id": "banner_height",
            "label": "Banner Height",
            "min": 300,
            "max": 800,
            "step": 50,
            "unit": "px",
            "default": 500
        },
        {
            "type": "range",
            "id": "overlay_opacity",
            "label": "Overlay Opacity",
            "min": 0,
            "max": 90,
            "step": 5,
            "unit": "%",
            "default": 50
        },
        {
            "type": "header",
            "content": "Content"
        },
        {
            "type": "text",
            "id": "label",
            "label": "Label (Optional)",
            "default": "WELCOME"
        },
        {
            "type": "text",
            "id": "heading",
            "label": "Heading",
            "default": "Professional Cleaning Solutions"
        },
        {
            "type": "textarea",
            "id": "description",
            "label": "Description",
            "default": "We provide top-quality cleaning machines and equipment for commercial and industrial use. Our solutions help businesses maintain cleaner, healthier environments."
        },
        {
            "type": "text",
            "id": "button_text",
            "label": "Button Text",
            "default": "Learn More"
        },
        {
            "type": "url",
            "id": "button_link",
            "label": "Button Link"
        },
        {
            "type": "header",
            "content": "Layout"
        },
        {
            "type": "select",
            "id": "text_align",
            "label": "Text Alignment",
            "default": "center",
            "options": [
                {"value": "left", "label": "Left"},
                {"value": "center", "label": "Center"},
                {"value": "right", "label": "Right"}
            ]
        },
        {
            "type": "select",
            "id": "horizontal_align",
            "label": "Horizontal Position",
            "default": "center",
            "options": [
                {"value": "flex-start", "label": "Left"},
                {"value": "center", "label": "Center"},
                {"value": "flex-end", "label": "Right"}
            ]
        },
        {
            "type": "select",
            "id": "vertical_align",
            "label": "Vertical Position",
            "default": "center",
            "options": [
                {"value": "flex-start", "label": "Top"},
                {"value": "center", "label": "Center"},
                {"value": "flex-end", "label": "Bottom"}
            ]
        },
        {
            "type": "header",
            "content": "Typography"
        },
        {
            "type": "range",
            "id": "heading_size",
            "label": "Heading Size",
            "min": 28,
            "max": 72,
            "step": 2,
            "unit": "px",
            "default": 48
        },
        {
            "type": "range",
            "id": "description_size",
            "label": "Description Size",
            "min": 14,
            "max": 22,
            "step": 1,
            "unit": "px",
            "default": 18
        },
        {
            "type": "header",
            "content": "Colors"
        },
        {
            "type": "color",
            "id": "text_color",
            "label": "Text Color",
            "default": "#ffffff"
        },
        {
            "type": "color",
            "id": "accent_color",
            "label": "Label Color",
            "default": "#6fb31a"
        },
        {
            "type": "color",
            "id": "button_bg",
            "label": "Button Background",
            "default": "#6fb31a"
        },
        {
            "type": "color",
            "id": "button_hover_bg",
            "label": "Button Hover",
            "default": "#5a9216"
        },
        {
            "type": "color",
            "id": "button_color",
            "label": "Button Text",
            "default": "#ffffff"
        },
        {
            "type": "range",
            "id": "button_radius",
            "label": "Button Radius",
            "min": 0,
            "max": 30,
            "step": 2,
            "unit": "px",
            "default": 4
        }
    ],
    "presets": [
        {
            "name": "Banner Overlay"
        }
    ]
}
{% endschema %}
