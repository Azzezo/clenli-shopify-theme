{% comment %}
  Pacvac Highlights Section
  - 3 column cards with image, title, description
  - Green underline
{% endcomment %}

{% style %}
  #pacvac-highlights-{{ section.id }} {
    background-color: {{ section.settings.bg_color }};
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }

  #pacvac-highlights-{{ section.id }} .pacvac-highlights-container {
    max-width: 1570px !important;
    margin: 0 auto;
    padding: 0 20px;
  }

  hr.imop-divider {
    width: 100% !important;
    max-width: 1570px !important;
    height: 4px !important;
    margin: 40px auto !important;
    background-color: #6fb31a !important;
    border: 0 !important;
    border: none !important;
    display: block !important;
    opacity: 1 !important;
    visibility: visible !important;
  }

  #pacvac-highlights-{{ section.id }} .pacvac-highlights-title {
    font-size: 20px;
    font-weight: 700;
    color: {{ section.settings.heading_color }};
    text-align: center;
    margin: 0 0 40px 0;
  }

  #pacvac-highlights-{{ section.id }} .pacvac-highlights-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 30px;
  }

  #pacvac-highlights-{{ section.id }} .pacvac-highlight-card {
    text-align: center;
  }

  #pacvac-highlights-{{ section.id }} .pacvac-highlight-image {
    margin-bottom: 20px;
  }

  #pacvac-highlights-{{ section.id }} .pacvac-highlight-image img {
    width: 100%;
    height: auto;
    border-radius: 8px;
  }

  #pacvac-highlights-{{ section.id }} .pacvac-highlight-image .placeholder-img {
    background: #e0e0e0;
    width: 100%;
    height: 200px;
    border-radius: 8px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #999;
    font-size: 14px;
  }

  #pacvac-highlights-{{ section.id }} .pacvac-highlight-title {
    font-size: 18px;
    font-weight: 700;
    color: {{ section.settings.heading_color }};
    margin: 0 0 12px 0;
  }

  #pacvac-highlights-{{ section.id }} .pacvac-highlight-desc {
    font-size: 15px;
    color: {{ section.settings.text_color }};
    line-height: 1.6;
    margin: 0;
  }

  #pacvac-highlights-{{ section.id }} .pacvac-underline {
    height: {{ section.settings.underline_height }}px;
    background-color: {{ section.settings.underline_color }};
    margin-top: 50px;
  }

  @media (max-width: 991px) {
    #pacvac-highlights-{{ section.id }} .pacvac-highlights-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 768px) {
    #pacvac-highlights-{{ section.id }} .pacvac-highlights-grid {
      grid-template-columns: 1fr;
      gap: 40px;
    }

    #pacvac-highlights-{{ section.id }} .pacvac-highlights-title {
      font-size: 18px;
    }
  }
{% endstyle %}

<section id="pacvac-highlights-{{ section.id }}">
  <div class="pacvac-highlights-container">
    {%- if section.settings.heading != blank -%}
      <h2 class="pacvac-highlights-title">{{ section.settings.heading }}</h2>
    {%- endif -%}

    <div class="pacvac-highlights-grid">
      {%- for block in section.blocks -%}
        <div class="pacvac-highlight-card" {{ block.shopify_attributes }}>
          <div class="pacvac-highlight-image">
            {%- if block.settings.image != blank -%}
              <img src="{{ block.settings.image | image_url: width: 400 }}" alt="{{ block.settings.title }}">
            {%- else -%}
              <div class="placeholder-img">Image</div>
            {%- endif -%}
          </div>

          {%- if block.settings.title != blank -%}
            <h3 class="pacvac-highlight-title">{{ block.settings.title }}</h3>
          {%- endif -%}

          {%- if block.settings.description != blank -%}
            <p class="pacvac-highlight-desc">{{ block.settings.description }}</p>
          {%- endif -%}
        </div>
      {%- endfor -%}
    </div>

    <!-- Underline -->
    <hr class="imop-divider">
    {% comment %} <div class="pacvac-underline"></div> {% endcomment %}
  </div>
</section>

{% schema %}
{
  "name": "Pacvac Highlights",
  "tag": "section",
  "class": "pacvac-highlights-section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Pacvac Highlights"
    },
    {
      "type": "header",
      "content": "Underline Settings"
    },
    {
      "type": "color",
      "id": "underline_color",
      "label": "Underline Color",
      "default": "#6fb31a"
    },
    {
      "type": "range",
      "id": "underline_height",
      "label": "Underline Height",
      "min": 2,
      "max": 8,
      "step": 1,
      "default": 4,
      "unit": "px"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading Color",
      "default": "#1a1a1a"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#555555"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding Top",
      "min": 0,
      "max": 100,
      "step": 10,
      "default": 40,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding Bottom",
      "min": 0,
      "max": 100,
      "step": 10,
      "default": 40,
      "unit": "px"
    }
  ],
  "blocks": [
    {
      "type": "highlight",
      "name": "Highlight Card",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Feature Title"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description",
          "default": "Feature description goes here."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Pacvac Highlights",
      "blocks": [
        {
          "type": "highlight",
          "settings": {
            "title": "Four Stage Filtration",
            "description": "The Pacvac range leaves air cleaner than it finds it. Each model comes as standard with a four stage filtration system including a vacuum and exhaust filter. This protects against the likes of dust, bacteria, pollen and mould spores."
          }
        },
        {
          "type": "highlight",
          "settings": {
            "title": "Ambidextrous Design",
            "description": "The Pacvac Range comes with adjustable hoses that make them usable for both left and right handed use. It's clear dome is also see through, helping you to understand when you need to empty the vacuum."
          }
        },
        {
          "type": "highlight",
          "settings": {
            "title": "Complete Comfort",
            "description": "The Ecoharness features three levels of height adjustability, comfortable thick padding, a breathable mesh backing for complete comfort in use. Pacvac's are also made from at least 50% recycled plastic for a more sustainable experience."
          }
        }
      ]
    }
  ]
}
{% endschema %}
