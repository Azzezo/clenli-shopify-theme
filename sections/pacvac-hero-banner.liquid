{% comment %}
  Pacvac Hero Banner Section
  - Image left, content right
  - Subtitle, heading, description with bullet points
  - Button and green underline
{% endcomment %}

{% style %}
    #pacvac-hero-{{ section.id }} {
      background-color: {{ section.settings.bg_color }};
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }

    #pacvac-hero-{{ section.id }} .pacvac-hero-container {
      max-width: 1570px !important;
      margin: 0 auto;
      padding: 0 20px;
    }

    hr.imop-divider {
      width: 100% !important;
      max-width: 1570px !important;
      height: 4px !important;
      margin: 40px auto !important;
      background-color: #6fb31a !important;
      border: 0 !important;
      border: none !important;
      display: block !important;
      opacity: 1 !important;
      visibility: visible !important;
    }

    #pacvac-hero-{{ section.id }} .pacvac-hero-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 50px;
      align-items: center;
    }

    #pacvac-hero-{{ section.id }} .pacvac-hero-image {
      text-align: center;
    }

    #pacvac-hero-{{ section.id }} .pacvac-hero-image img {
      max-width: 80%;
      height: auto;
    }

    #pacvac-hero-{{ section.id }} .pacvac-hero-image .placeholder-img {
      background: #e0e0e0;
      width: 80%;
      height: 400px;
      margin: 0 auto;
      display: flex;
      align-items: center;
      justify-content: center;
      color: #999;
      font-size: 14px;
    }

    #pacvac-hero-{{ section.id }} .pacvac-hero-subtitle {
      font-size: 18px;
      font-weight: 600;
      color: {{ section.settings.subtitle_color }};
      margin-bottom: 10px;
      text-transform: uppercase;
    }

    #pacvac-hero-{{ section.id }} .pacvac-hero-heading {
      font-size: 40px;
      font-weight: 700;
      color: {{ section.settings.heading_color }};
      margin: 0 0 20px 0;
      line-height: 1.2;
    }

    #pacvac-hero-{{ section.id }} .pacvac-hero-description {
      font-size: 16px;
      color: {{ section.settings.text_color }};
      line-height: 1.7;
      margin-bottom: 25px;
    }

    #pacvac-hero-{{ section.id }} .pacvac-hero-features {
      margin-bottom: 30px;
    }

    #pacvac-hero-{{ section.id }} .pacvac-feature-item {
      margin-bottom: 20px;
    }

    #pacvac-hero-{{ section.id }} .pacvac-feature-item strong {
      color: {{ section.settings.heading_color }};
    }

    #pacvac-hero-{{ section.id }} .pacvac-hero-btn {
      display: inline-block;
      padding: 14px 30px;
      background-color: {{ section.settings.button_bg }};
      color: {{ section.settings.button_color }};
      text-decoration: none;
      font-size: 14px;
      font-weight: 600;
      border-radius: 4px;
      transition: background-color 0.3s ease;
    }

    #pacvac-hero-{{ section.id }} .pacvac-hero-btn:hover {
      background-color: {{ section.settings.button_hover_bg }};
    }

    #pacvac-hero-{{ section.id }} .pacvac-underline {
      height: {{ section.settings.underline_height }}px;
      background-color: {{ section.settings.underline_color }};
      margin-top: 50px;
    }

    @media (max-width: 768px) {
      #pacvac-hero-{{ section.id }} .pacvac-hero-grid {
        grid-template-columns: 1fr;
        gap: 30px;
      }

      #pacvac-hero-{{ section.id }} .pacvac-hero-heading {
        font-size: 32px;
      }

      #pacvac-hero-{{ section.id }} .pacvac-hero-image img,
      #pacvac-hero-{{ section.id }} .pacvac-hero-image .placeholder-img {
        max-width: 100%;
        width: 100%;
      }
    }
{% endstyle %}

<section id="pacvac-hero-{{ section.id }}">
  <div class="pacvac-hero-container">
    <div class="pacvac-hero-grid">
      <!-- Image -->
      <div class="pacvac-hero-image">
        {%- if section.settings.image != blank -%}
          <img
            src="{{ section.settings.image | image_url: width: 800 }}"
            alt="{{ section.settings.image.alt | default: section.settings.heading }}"
          >
        {%- else -%}
          <div class="placeholder-img">Product Image</div>
        {%- endif -%}
      </div>

      <!-- Content -->
      <div class="pacvac-hero-content">
        {%- if section.settings.subtitle != blank -%}
          <p class="pacvac-hero-subtitle">{{ section.settings.subtitle }}</p>
        {%- endif -%}

        {%- if section.settings.heading != blank -%}
          <h1 class="pacvac-hero-heading">{{ section.settings.heading }}</h1>
        {%- endif -%}

        {%- if section.settings.description != blank -%}
          <div class="pacvac-hero-description">{{ section.settings.description }}</div>
        {%- endif -%}

        <!-- Feature Points -->
        <div class="pacvac-hero-features">
          {%- for block in section.blocks -%}
            {%- if block.type == 'feature_point' -%}
              <div class="pacvac-feature-item" {{ block.shopify_attributes }}>
                <strong>{{ block.settings.title }}:</strong> {{ block.settings.description }}
              </div>
            {%- endif -%}
          {%- endfor -%}
        </div>

        {%- if section.settings.button_text != blank -%}
          <a href="{{ section.settings.button_link }}" class="pacvac-hero-btn">{{ section.settings.button_text }}</a>
        {%- endif -%}
      </div>
    </div>
    <hr class="imop-divider">
    <!-- Underline -->
    {% comment %} <div class="pacvac-underline"></div> {% endcomment %}
  </div>
</section>

{% schema %}
{
  "name": "Pacvac Hero Banner",
  "tag": "section",
  "class": "pacvac-hero-section",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Product Image"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "HOOVERS & VACUUMS"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Pacvac Backpack Vacuums"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description",
      "default": "<p>Backpack vacuums outperform traditional uprights and canisters with powerful suction and faster cleaning. Worn on the back, they reduce effort, boost mobility, and make tackling large spaces like offices, schools, and hotels effortless.</p>"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button Text",
      "default": "Explore Pacvac Range"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link"
    },
    {
      "type": "header",
      "content": "Underline Settings"
    },
    {
      "type": "color",
      "id": "underline_color",
      "label": "Underline Color",
      "default": "#6fb31a"
    },
    {
      "type": "range",
      "id": "underline_height",
      "label": "Underline Height",
      "min": 2,
      "max": 8,
      "step": 1,
      "default": 4,
      "unit": "px"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "subtitle_color",
      "label": "Subtitle Color",
      "default": "#333333"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading Color",
      "default": "#1a1a1a"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#555555"
    },
    {
      "type": "color",
      "id": "button_bg",
      "label": "Button Background",
      "default": "#6fb31a"
    },
    {
      "type": "color",
      "id": "button_hover_bg",
      "label": "Button Hover Background",
      "default": "#5a9216"
    },
    {
      "type": "color",
      "id": "button_color",
      "label": "Button Text Color",
      "default": "#ffffff"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding Top",
      "min": 0,
      "max": 100,
      "step": 10,
      "default": 60,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding Bottom",
      "min": 0,
      "max": 100,
      "step": 10,
      "default": 40,
      "unit": "px"
    }
  ],
  "blocks": [
    {
      "type": "feature_point",
      "name": "Feature Point",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Clean four times faster"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description",
          "default": "Studies have shown that cordless backpack vacuum cleaners clean up to 4 times faster than a corded tub vacuum cleaner."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Pacvac Hero Banner",
      "blocks": [
        {
          "type": "feature_point",
          "settings": {
            "title": "Clean four times faster",
            "description": "Studies have shown that cordless backpack vacuum cleaners clean up to 4 times faster than a corded tub vacuum cleaner."
          }
        },
        {
          "type": "feature_point",
          "settings": {
            "title": "Freedom to move",
            "description": "Backpack vacuums give you unparalleled freedom of movement, making any cleaning task—big or small—a breeze."
          }
        },
        {
          "type": "feature_point",
          "settings": {
            "title": "Lightweight and effortless",
            "description": "Designed for ease of use, these ultra-light backpack vacuums provide maximum comfort while you clean."
          }
        }
      ]
    }
  ]
}
{% endschema %}
