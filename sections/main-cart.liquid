{% comment %}
  Cart Page - Clenli Direct Style (Exact Match to Screenshot)
{% endcomment %}

<div class="cart-page section-{{ section.id }}">
  <div class="container">
    <h1 class="cart-title">Shopping Cart</h1>
    
    {% if cart.item_count > 0 %}
    <div class="cart-wrapper">
      <!-- Left Side - Cart Items -->
      <div class="cart-items-wrapper">
        <table class="cart-table">
          <thead>
            <tr>
              <th class="th-actions"></th>
              <th class="th-image"></th>
              <th class="th-item">Item</th>
              <th class="th-price">Price</th>
              <th class="th-qty">Qty</th>
              <th class="th-subtotal">Subtotal</th>
            </tr>
          </thead>
          <tbody>
            {% for item in cart.items %}
            <tr class="cart-item" data-key="{{ item.key }}">
              <td class="cart-actions-cell">
                <button type="button" class="action-btn edit-btn" aria-label="Edit">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/>
                    <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/>
                  </svg>
                </button>
                <a href="/cart/change?id={{ item.key }}&quantity=0" class="action-btn remove-btn" aria-label="Remove">
                  <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <line x1="18" y1="6" x2="6" y2="18"></line>
                    <line x1="6" y1="6" x2="18" y2="18"></line>
                  </svg>
                </a>
              </td>
              <td class="cart-image">
                <a href="{{ item.url }}">
                  {% if item.image %}
                    <img src="{{ item.image | image_url: width: 100 }}" alt="{{ item.title | escape }}">
                  {% else %}
                    {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
                  {% endif %}
                </a>
              </td>
              <td class="cart-item-title">
                <a href="{{ item.url }}">{{ item.product.title }}</a>
                {% if item.variant.title != 'Default Title' %}
                  <span class="variant-title">{{ item.variant.title }}</span>
                {% endif %}
              </td>
              <td class="cart-price">{{ item.price | money }}</td>
              <td class="cart-qty">
                <div class="qty-wrapper">
                  <span class="qty-value">{{ item.quantity }}</span>
                  <div class="qty-buttons">
                    <button type="button" class="qty-btn qty-plus" data-key="{{ item.key }}">+</button>
                    <button type="button" class="qty-btn qty-minus" data-key="{{ item.key }}">−</button>
                  </div>
                </div>
              </td>
              <td class="cart-subtotal">{{ item.line_price | money }}</td>
            </tr>
            {% endfor %}
          </tbody>
        </table>
        
        <!-- Cart Action Buttons -->
        <div class="cart-actions">
          <a href="/collections/all" class="cart-btn btn-continue">
            <span class="btn-arrow">«</span> Continue Shopping
          </a>
          <button type="button" class="cart-btn btn-clear" onclick="clearCart()">Clear Shopping Cart</button>
          <button type="button" class="cart-btn btn-update" onclick="updateCart()">Update Shopping Cart</button>
        </div>
      </div>
      
      <!-- Right Side - Summary -->
      <div class="cart-summary">
        <h2 class="summary-title">Summary</h2>
        
        <div class="summary-row estimate-row">
          <span>Estimate Shipping and Tax</span>
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 9l6 6 6-6"/></svg>
        </div>
        
        <div class="summary-row subtotal-row">
          <span>Subtotal</span>
          <span class="amount">{{ cart.total_price | money }}</span>
        </div>
        
        <div class="summary-row total-row">
          <span>ORDER TOTAL</span>
          <span class="amount total-amount">{{ cart.total_price | money }}</span>
        </div>
        
        <div class="summary-row discount-row">
          <span>Apply Discount Code</span>
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 9l6 6 6-6"/></svg>
        </div>
        
        <div class="summary-buttons">
          <a href="/checkout" class="checkout-btn">Proceed to Checkout</a>
          <a href="/checkout" class="pay-link-btn">
            Pay with <span class="link-logo">▶ link</span>
          </a>
        </div>
      </div>
    </div>
    
    {% else %}
    <!-- Empty Cart -->
    <div class="cart-empty">
      <svg width="80" height="80" viewBox="0 0 24 24" fill="none" stroke="#ccc" stroke-width="1.5">
        <circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/>
        <path d="M1 1h4l2.68 13.39a2 2 0 002 1.61h9.72a2 2 0 002-1.61L23 6H6"/>
      </svg>
      <p>Your cart is empty</p>
      <a href="/collections/all" class="cart-btn btn-continue">Continue Shopping</a>
    </div>
    {% endif %}
  </div>
</div>

<style>
/* Base Styles */
.cart-page {
  padding: 40px 0 60px;
  background: #fff;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
}
.cart-page .container {
  max-width: 1400px;
  margin: 0 auto;
  padding: 0 20px;
}
.cart-title {
  font-size: 24px;
  font-weight: 700;
  color: #333;
  margin: 0 0 25px;
}

/* Cart Wrapper - Two Columns */
.cart-wrapper {
  display: flex;
  gap: 40px;
  align-items: flex-start;
}
.cart-items-wrapper {
  flex: 1;
}
.cart-summary {
  width: 340px;
  flex-shrink: 0;
  background: #fff;
  border: 1px solid #e5e5e5;
}

/* Cart Table */
.cart-table {
  width: 100%;
  border-collapse: collapse;
}
.cart-table thead th {
  text-align: left;
  padding: 12px 10px;
  font-size: 13px;
  font-weight: 400;
  color: #666;
  border-bottom: 1px solid #e5e5e5;
}
.cart-table thead .th-actions {
  width: 40px;
}
.cart-table thead .th-image {
  width: 80px;
}
.cart-table thead .th-price {
  text-align: center;
  width: 100px;
}
.cart-table thead .th-qty {
  text-align: center;
  width: 120px;
}
.cart-table thead .th-subtotal {
  text-align: right;
  width: 100px;
}
.cart-table tbody td {
  padding: 20px 10px;
  vertical-align: middle;
  border-bottom: 1px solid #e5e5e5;
}

/* Action Buttons (Edit & Remove) */
.cart-actions-cell {
  vertical-align: middle;
}
.action-btn {
  display: block;
  width: 20px;
  height: 20px;
  background: none;
  border: none;
  cursor: pointer;
  color: #999;
  padding: 0;
  margin: 3px 0;
  transition: color 0.2s;
}
.action-btn:hover {
  color: #333;
}
.action-btn svg {
  display: block;
}

/* Product Image */
.cart-image {
  text-align: center;
}
.cart-image img,
.cart-image .placeholder-svg {
  width: 70px;
  height: 70px;
  object-fit: contain;
}

/* Product Title */
.cart-item-title a {
  color: #4a9d9a;
  text-decoration: none;
  font-weight: 400;
  font-size: 15px;
  line-height: 1.4;
}
.cart-item-title a:hover {
  text-decoration: underline;
}
.cart-item-title .variant-title {
  display: block;
  font-size: 13px;
  color: #666;
  margin-top: 5px;
}

/* Price */
.cart-price {
  font-size: 15px;
  color: #333;
  text-align: center;
}

/* Quantity - Exact Match to Screenshot */
.cart-qty {
  text-align: center;
}
.qty-wrapper {
  display: inline-flex;
  align-items: center;
  border: 1px solid #ddd;
  border-radius: 4px;
  overflow: hidden;
  background: #fff;
}
.qty-value {
  width: 40px;
  height: 36px;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 14px;
  font-weight: 400;
  color: #333;
  background: #fff;
}
.qty-buttons {
  display: flex;
  flex-direction: column;
  background: #f5f5f5;
  border-left: 1px solid #ddd;
}
.qty-btn {
  width: 28px;
  height: 18px;
  border: none;
  background: transparent;
  cursor: pointer;
  font-size: 14px;
  color: #666;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0;
  transition: all 0.2s;
}
.qty-btn:hover {
  color: #333;
  background: #e5e5e5;
}
.qty-btn.qty-plus {
  border-bottom: 1px solid #ddd;
}

/* Subtotal */
.cart-subtotal {
  font-size: 15px;
  font-weight: 400;
  color: #333;
  text-align: right;
}

/* Cart Action Buttons */
.cart-actions {
  display: flex;
  gap: 10px;
  margin-top: 25px;
  flex-wrap: wrap;
}
.cart-btn {
  padding: 12px 22px;
  font-size: 14px;
  font-weight: 500;
  text-decoration: none;
  cursor: pointer;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 6px;
  border: none;
  transition: all 0.3s;
  border-radius: 4px;
}
.cart-btn.btn-continue {
  height:34px;
  background: #7ab55c;
  color: #fff;
  border-radius: 24px;
}
.cart-btn.btn-continue:hover {
  background:#4a6a7a;
  opacity: 0.9;
}
.cart-btn.btn-clear,
.cart-btn.btn-update {
  height:34px;
  background: #6fb31a;
  color: #fff;
}
.cart-btn.btn-clear:hover,
.cart-btn.btn-update:hover {
  background: #4a6a7a;
}
.btn-continue .btn-arrow {
  font-size: 12px;
  margin-right: 2px;
}

/* Summary Box */
.summary-title {
  font-size: 18px;
  font-weight: 600;
  color: #333;
  padding: 18px 20px;
  margin: 0;
  border-bottom: 1px solid #e5e5e5;
  background: #fff;
}
.summary-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 15px 20px;
  border-bottom: 1px solid #e5e5e5;
  font-size: 14px;
  color: #333;
}
.summary-row svg {
  color: #999;
  flex-shrink: 0;
}
.estimate-row,
.discount-row {
  cursor: pointer;
}
.estimate-row:hover,
.discount-row:hover {
  background: #fafafa;
}
.subtotal-row .amount {
  font-weight: 400;
}
.total-row {
  font-weight: 600;
  font-size: 14px;
}
.total-row .total-amount {
  color: #4a9d9a;
  font-size: 18px;
  font-weight: 600;
}
.discount-row {
  border-bottom: none;
}

/* Checkout Buttons */
.summary-buttons {
  padding: 20px;
}
.checkout-btn {
  display: block;
  width: 100%;
  padding: 4px 20px;
  background: #7ab55c;
  color: #fff;
  text-align: center;
  text-decoration: none;
  border-radius: 4px;
  font-size: 15px;
  font-weight: 600;
  transition: all 0.3s;
  margin-bottom: 10px;
  box-sizing: border-box;
  height:35px;
}
.checkout-btn:hover {
  color:#ffffff;
  background:#4a6a7a;
  opacity: 0.9;
}

/* Pay with Link Button - Stripe Style */
.pay-link-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  padding: 14px 20px;
  background: #00d66f;
  color: black;
  text-align: center;
  text-decoration: none;
  border-radius: 4px;
  font-size: 15px;
  font-weight: 500;
  transition: all 0.3s;
  box-sizing: border-box;
  gap: 6px;
  height:35px;
}
.pay-link-btn:hover {
  color:#fff;
  background:rgb(7, 243, 101);
}
.pay-link-btn .link-logo {
  font-weight: 700;
  display: inline-flex;
  align-items: center;
  gap: 2px;
}

/* Empty Cart */
.cart-empty {
  text-align: center;
  padding: 80px 20px;
}
.cart-empty svg {
  margin-bottom: 25px;
}
.cart-empty p {
  font-size: 18px;
  color: #666;
  margin-bottom: 25px;
}

/* Responsive */
@media (max-width: 1100px) {
  .cart-wrapper {
    flex-direction: column;
  }
  .cart-summary {
    width: 100%;
    max-width: 400px;
  }
}
@media (max-width: 768px) {
  .cart-table thead {
    display: none;
  }
  .cart-table tbody tr {
    display: flex;
    flex-wrap: wrap;
    padding: 20px 0;
    border-bottom: 1px solid #e5e5e5;
    align-items: center;
  }
  .cart-table tbody td {
    border: none;
    padding: 5px;
  }
  .cart-actions-cell {
    order: 1;
    width: 30px;
  }
  .cart-image {
    order: 2;
    width: 70px;
  }
  .cart-item-title {
    order: 3;
    flex: 1;
    padding-left: 10px !important;
  }
  .cart-price {
    order: 4;
    width: 100%;
    padding-left: 100px !important;
    text-align: left !important;
    font-size: 13px;
    color: #666;
    margin-top: 10px;
  }
  .cart-price::before {
    content: 'Price: ';
    color: #999;
  }
  .cart-qty {
    order: 5;
    width: auto;
    padding-left: 100px !important;
    margin-top: 10px;
  }
  .cart-subtotal {
    order: 6;
    width: auto;
    margin-left: auto;
    text-align: right !important;
    margin-top: 10px;
  }
  .cart-actions {
    flex-direction: column;
  }
  .cart-btn {
    width: 100%;
  }
}
</style>

<script>
document.addEventListener('DOMContentLoaded', function() {
  // Quantity Plus
  document.querySelectorAll('.qty-plus').forEach(btn => {
    btn.addEventListener('click', function() {
      const wrapper = this.closest('.qty-wrapper');
      const valueEl = wrapper.querySelector('.qty-value');
      let val = parseInt(valueEl.textContent) || 1;
      val++;
      valueEl.textContent = val;
    });
  });

  // Quantity Minus
  document.querySelectorAll('.qty-minus').forEach(btn => {
    btn.addEventListener('click', function() {
      const wrapper = this.closest('.qty-wrapper');
      const valueEl = wrapper.querySelector('.qty-value');
      let val = parseInt(valueEl.textContent) || 1;
      if (val > 1) {
        val--;
        valueEl.textContent = val;
      }
    });
  });
});

// Update Cart
function updateCart() {
  const updates = {};
  document.querySelectorAll('.cart-item').forEach(row => {
    const key = row.dataset.key;
    const qty = parseInt(row.querySelector('.qty-value').textContent) || 1;
    updates[key] = qty;
  });
  
  fetch('/cart/update.js', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({ updates })
  }).then(() => location.reload());
}

// Clear Cart
function clearCart() {
  if (confirm('Are you sure you want to clear your cart?')) {
    fetch('/cart/clear.js', {
      method: 'POST'
    }).then(() => location.reload());
  }
}
</script>

{% schema %}
{
  "name": "Cart Page",
  "settings": [
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent Color (Green)",
      "default": "#7ab55c"
    }
  ]
}
{% endschema %}