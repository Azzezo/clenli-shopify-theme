<div class="seo-links section-{{ section.id }}">
  <div class="container container-{{ section.settings.container_width | default: '1570' }}">
    {%- if section.settings.heading != blank -%}
      <h2 class="seo-links__heading">{{ section.settings.heading }}</h2>
    {%- endif -%}
    <div class="seo-links__grid">
      {%- for block in section.blocks -%}
        {%- if block.settings.link != blank -%}
          <a href="{{ block.settings.link }}" class="seo-links__item" {{ block.shopify_attributes }}>
            {%- if block.settings.icon != blank -%}
              <span class="seo-links__icon">{{ block.settings.icon }}</span>
            {%- endif -%}
            <span class="seo-links__text">{{ block.settings.title }}</span>
          </a>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</div>

<style>
  .section-{{ section.id }} {
    padding: {{ section.settings.padding_top | default: 40 }}px 15px {{ section.settings.padding_bottom | default: 40 }}px;
    background: {{ section.settings.bg_color | default: '#f9f9f9' }};
  }
  .section-{{ section.id }} .seo-links__heading {
    font-size: 28px;
    font-weight: 700;
    color: #232323;
    margin-bottom: 25px;
    text-align: center;
  }
  .section-{{ section.id }} .seo-links__grid {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    justify-content: center;
  }
  .section-{{ section.id }} .seo-links__item {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 10px 20px;
    background: #ffffff;
    border: 1px solid #e5e5e5;
    border-radius: 8px;
    color: #333;
    font-size: 14px;
    font-weight: 500;
    text-decoration: none;
    transition: border-color 0.2s, box-shadow 0.2s;
  }
  .section-{{ section.id }} .seo-links__item:hover {
    border-color: {{ section.settings.hover_color | default: '#6fb31a' }};
    box-shadow: 0 2px 8px rgba(0,0,0,0.08);
    color: {{ section.settings.hover_color | default: '#6fb31a' }};
  }
  .section-{{ section.id }} .seo-links__icon {
    display: flex;
    width: 20px;
    height: 20px;
  }
  .section-{{ section.id }} .seo-links__icon svg {
    width: 100%;
    height: 100%;
    fill: currentColor;
  }
  @media (max-width: 749px) {
    .section-{{ section.id }} .seo-links__heading { font-size: 22px; }
    .section-{{ section.id }} .seo-links__grid { gap: 8px; }
    .section-{{ section.id }} .seo-links__item { padding: 8px 14px; font-size: 13px; }
  }
</style>

{% schema %}
{
  "name": "Internal Links",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Popular Categories" },
    { "type": "text", "id": "container_width", "label": "Container width", "default": "1570" },
    { "type": "color", "id": "bg_color", "label": "Background color", "default": "#f9f9f9" },
    { "type": "color", "id": "hover_color", "label": "Hover color", "default": "#6fb31a" },
    { "type": "range", "id": "padding_top", "label": "Padding top", "min": 0, "max": 100, "step": 5, "default": 40 },
    { "type": "range", "id": "padding_bottom", "label": "Padding bottom", "min": 0, "max": 100, "step": 5, "default": 40 }
  ],
  "blocks": [
    {
      "type": "link",
      "name": "Link",
      "settings": [
        { "type": "text", "id": "title", "label": "Title" },
        { "type": "url", "id": "link", "label": "Link" },
        { "type": "html", "id": "icon", "label": "Icon SVG (optional)" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Internal Links",
      "blocks": []
    }
  ]
}
{% endschema %}
