{%- liquid
    assign section_id = section.id
    assign heading = section.settings.heading
    assign heading_color = section.settings.heading_color
    assign heading_size = section.settings.heading_size
    assign description = section.settings.description
    assign desc_color = section.settings.desc_color
    assign desc_size = section.settings.desc_size
    assign call_button_text = section.settings.call_button_text
    assign call_button_link = section.settings.call_button_link
    assign call_button_bg = section.settings.call_button_bg
    assign call_button_text_color = section.settings.call_button_text_color
    assign call_button_gap = section.settings.call_button_gap
    assign form_heading = section.settings.form_heading
    assign form_border_color = section.settings.form_border_color
    assign form_border_width = section.settings.form_border_width
    assign submit_button_text = section.settings.submit_button_text
    assign submit_button_bg = section.settings.submit_button_bg
    assign submit_button_text_color = section.settings.submit_button_text_color
    assign bg_color = section.settings.bg_color
    assign container = section.settings.container
    assign padding_top = section.settings.padding_top
    assign padding_bottom = section.settings.padding_bottom
    assign padding_top_mobile = section.settings.padding_top_mobile
    assign padding_bottom_mobile = section.settings.padding_bottom_mobile
-%}

<style>
    #green-contact-{{ section_id }} {
        background-color: {{ bg_color }};
        padding-top: {{ padding_top }}px;
        padding-bottom: {{ padding_bottom }}px;
    }
    
    #green-contact-{{ section_id }} .gc-container {
        max-width: {% if container == '1170' %}1170px{% elsif container == '1370' %}1370px{% elsif container == '1570' %}1570px{% else %}1170px{% endif %};
        margin: 0 auto;
        padding: 0 15px;
    }
    
    /* Top Section - Heading & Description */
    #green-contact-{{ section_id }} .gc-header {
        text-align: center;
        margin-bottom: 25px;
    }
    
    #green-contact-{{ section_id }} .gc-heading {
        font-size: {{ heading_size }}px;
        font-weight: 700;
        color: {{ heading_color }};
        margin: 0 0 15px 0;
        line-height: 1.3;
    }
    
    #green-contact-{{ section_id }} .gc-description {
        font-size: {{ desc_size }}px;
        color: {{ desc_color }};
        margin: 0;
        line-height: 1.6;
        max-width: 900px;
        margin: 0 auto;
    }
    
    /* Form Outer Wrapper - 1315px Width */
  #green-contact-{{ section_id }} .gc-form-outer {
    max-width: 1570px;
    margin: 0 auto;
}
    
    /* Call Now Button - Full Width with Gap */
    #green-contact-{{ section_id }} .gc-call-button {
        display: block;
        width: 100%;
        padding: 15px 70px;
        font-size: 16px;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 1px;
        color: #ffffff;
        background-color: #6fb31a;
        border: none;
        text-decoration: none;
        text-align: center;
        cursor: pointer;
        transition: all 0.3s ease;
        margin-bottom: 20px;
    }
    
    #green-contact-{{ section_id }} .gc-call-button:hover {
        background-color: {{ section.settings.call_button_hover }};
        box-shadow: 0 4px 15px rgba(111, 179, 26, 0.3);
    }
    
    /* Form Section with Green Border */
    #green-contact-{{ section_id }} .gc-form-wrapper {
        border: {{ form_border_width }}px solid {{ form_border_color }};
        padding: 30px;
        background-color: #fff;
        max-width:1570px !important;
    }
    
    #green-contact-{{ section_id }} .gc-form-heading {
        font-size: 11px;
        font-weight: 700;
        color: #232323;
        text-align: center;
        margin: 0 0 25px 0;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }
    
    #green-contact-{{ section_id }} .gc-form {
        max-width: 100%;
    }
    
    #green-contact-{{ section_id }} .gc-form-field {
        margin-bottom: 15px;
    }
    
    #green-contact-{{ section_id }} .gc-form-field input,
    #green-contact-{{ section_id }} .gc-form-field textarea {
        width: 100%;
        padding: 7px 15px;
        font-size: 15px;
        color: #333;
        background-color: #fff;
        border: 1px solid #ddd;
        border-radius: 0;
        outline: none;
        transition: border-color 0.3s ease;
    }
    
    #green-contact-{{ section_id }} .gc-form-field input::placeholder,
    #green-contact-{{ section_id }} .gc-form-field textarea::placeholder {
        color: #666;
        text-transform: uppercase;
        font-size: 13px;
    }
    
    #green-contact-{{ section_id }} .gc-form-field input:focus,
    #green-contact-{{ section_id }} .gc-form-field textarea:focus {
        border-color: {{ form_border_color }};
    }
    
    #green-contact-{{ section_id }} .gc-form-field textarea {
        min-height: 50px;
        resize: vertical;
    }
    
    #green-contact-{{ section_id }} .gc-form-submit {
        text-align: center;
        margin-top: 20px;
    }
    
    #green-contact-{{ section_id }} .gc-form-submit button {
        display: inline-block;
        padding: 10px 50px;
        font-size: 15px;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 1px;
        color: {{ submit_button_text_color }};
        background-color: {{ submit_button_bg }};
        border: none;
        border-radius: 4px;
        cursor: pointer;
        transition: all 0.3s ease;
    }
    
    #green-contact-{{ section_id }} .gc-form-submit button:hover {
        background-color: {{ section.settings.submit_button_hover }};
        transform: translateY(-2px);
        box-shadow: 0 5px 15px rgba(111, 179, 26, 0.3);
    }
    
    /* Success/Error Messages */
    #green-contact-{{ section_id }} .gc-message {
        padding: 15px 20px;
        border-radius: 4px;
        margin-bottom: 20px;
        text-align: center;
        font-size: 15px;
    }
    
    #green-contact-{{ section_id }} .gc-message.success {
        background-color: #d4edda;
        color: #155724;
        border: 1px solid #c3e6cb;
    }
    
    #green-contact-{{ section_id }} .gc-message.error {
        background-color: #f8d7da;
        color: #721c24;
        border: 1px solid #f5c6cb;
    }
    
    /* Tablet */
    @media (max-width: 1024px) {
        #green-contact-{{ section_id }} .gc-heading {
            font-size: {{ heading_size | minus: 4 }}px;
        }
        
        #green-contact-{{ section_id }} .gc-form-wrapper {
            padding: 25px;
        }
    }
    
    /* Mobile */
    @media (max-width: 767px) {
        #green-contact-{{ section_id }} {
            padding-top: {{ padding_top_mobile }}px;
            padding-bottom: {{ padding_bottom_mobile }}px;
        }
        
        #green-contact-{{ section_id }} .gc-heading {
            font-size: {{ heading_size | minus: 8 }}px;
            margin-bottom: 12px;
        }
        
        #green-contact-{{ section_id }} .gc-description {
            font-size: {{ desc_size | minus: 1 }}px;
        }
        
        #green-contact-{{ section_id }} .gc-call-button {
            padding: 12px 20px;
            font-size: 14px;
            margin-bottom: {{ call_button_gap | minus: 10 }}px;
        }
        
        #green-contact-{{ section_id }} .gc-form-wrapper {
            padding: 20px 15px;
        }
        
        #green-contact-{{ section_id }} .gc-form-heading {
            font-size: 16px;
            margin-bottom: 20px;
        }
        
        #green-contact-{{ section_id }} .gc-form-field input,
        #green-contact-{{ section_id }} .gc-form-field textarea {
            padding: 10px 12px;
            font-size: 14px;
        }
        
        #green-contact-{{ section_id }} .gc-form-submit button {
            padding: 12px 40px;
            font-size: 14px;
            width: 100%;
        }
    }
</style>

<section id="green-contact-{{ section_id }}" class="green-contact-section">
    <div class="gc-container">
        
        <!-- Header - Heading & Description -->
        <div class="gc-header">
            {%- if heading != blank -%}
                <h2 class="gc-heading">{{ heading }}</h2>
            {%- endif -%}
            
            {%- if description != blank -%}
                <p class="gc-description">{{ description }}</p>
            {%- endif -%}
        </div>
        
        <!-- Form Outer Wrapper - 1315px Width -->
        <div class="gc-form-outer">
            
            <!-- Call Now Button - Full Width with Gap -->
            {%- if call_button_text != blank -%}
                <a href="{{ call_button_link }}" class="gc-call-button">{{ call_button_text }}</a>
            {%- endif -%}
            
            <!-- Form with Green Border -->
            <div class="gc-form-wrapper">
                {%- if form_heading != blank -%}
                    <h3 class="gc-form-heading">{{ form_heading }}</h3>
                {%- endif -%}

                {%- if section.settings.show_hubspot_form -%}
                    {%- assign hs_target_image3 = 'hubspot-form-gogreen-image3-' | append: section_id -%}
                    {% render 'hubspot-form',
                        form_id: '03da5c3c-6669-4ae1-843b-985c17935c7f',
                        target_id: hs_target_image3
                    %}
                {%- else -%}
                {%- form 'contact', class: 'gc-form' -%}
                    {%- if form.posted_successfully? -%}
                        <div class="gc-message success">
                            {{ section.settings.success_message }}
                        </div>
                    {%- endif -%}
                    
                    {%- if form.errors -%}
                        <div class="gc-message error">
                            {{ form.errors | default_errors }}
                        </div>
                    {%- endif -%}
                    
                    <!-- Name Field -->
                    <div class="gc-form-field">
                        <input 
                            type="text" 
                            id="contact-name-{{ section_id }}" 
                            name="contact[name]" 
                            placeholder="{{ section.settings.name_placeholder }}"
                            required
                        >
                    </div>
                    
                    <!-- Email Field -->
                    <div class="gc-form-field">
                        <input 
                            type="email" 
                            id="contact-email-{{ section_id }}" 
                            name="contact[email]" 
                            placeholder="{{ section.settings.email_placeholder }}"
                            required
                        >
                    </div>
                    
                    <!-- Phone Field -->
                    <div class="gc-form-field">
                        <input 
                            type="tel" 
                            id="contact-phone-{{ section_id }}" 
                            name="contact[phone]" 
                            placeholder="{{ section.settings.phone_placeholder }}"
                        >
                    </div>
                    
                    <!-- Message Field -->
                    <div class="gc-form-field">
                        <textarea 
                            id="contact-message-{{ section_id }}" 
                            name="contact[body]" 
                            placeholder="{{ section.settings.message_placeholder }}"
                            required
                        ></textarea>
                    </div>
                    
                    <!-- Submit Button -->
                    <div class="gc-form-submit">
                        <button type="submit">{{ submit_button_text }}</button>
                    </div>
                {%- endform -%}
                {%- endif -%}
            </div>
            
        </div>
        
    </div>
</section>

{% schema %}
{
    "name": "Green Contact Form",
    "tag": "section",
    "class": "green-contact-block",
    "settings": [
        {
            "type": "header",
            "content": "Enquiry Form"
        },
        {
            "type": "checkbox",
            "id": "show_hubspot_form",
            "label": "Use HubSpot Form",
            "info": "Replaces the default Shopify enquiry form with the HubSpot 'Go Green Today' embed.",
            "default": true
        },
        {
            "type": "header",
            "content": "Top Section"
        },
        {
            "type": "text",
            "id": "heading",
            "label": "Heading",
            "default": "Make the Change Today"
        },
        {
            "type": "color",
            "id": "heading_color",
            "label": "Heading Color",
            "default": "#232323"
        },
        {
            "type": "range",
            "id": "heading_size",
            "label": "Heading Font Size",
            "min": 20,
            "max": 50,
            "step": 1,
            "unit": "px",
            "default": 28
        },
        {
            "type": "textarea",
            "id": "description",
            "label": "Description",
            "default": "Lower your environmental impact while saving on costs - all while keeping your facility cleaner than ever. To learn more about our Green Cleaning Solutions, contact us today!"
        },
        {
            "type": "color",
            "id": "desc_color",
            "label": "Description Color",
            "default": "#555555"
        },
        {
            "type": "range",
            "id": "desc_size",
            "label": "Description Font Size",
            "min": 12,
            "max": 22,
            "step": 1,
            "unit": "px",
            "default": 15
        },
        {
            "type": "header",
            "content": "Call Now Button"
        },
        {
            "type": "text",
            "id": "call_button_text",
            "label": "Button Text",
            "default": "CALL NOW"
        },
        {
            "type": "url",
            "id": "call_button_link",
            "label": "Button Link"
        },
        {
            "type": "color",
            "id": "call_button_bg",
            "label": "Button Background Color",
            "default": "#1a5d1a"
        },
        {
            "type": "color",
            "id": "call_button_hover",
            "label": "Button Hover Color",
            "default": "#0d4a0d"
        },
        {
            "type": "color",
            "id": "call_button_text_color",
            "label": "Button Text Color",
            "default": "#ffffff"
        },
        {
            "type": "range",
            "id": "call_button_gap",
            "label": "Gap Below Call Button",
            "min": 0,
            "max": 50,
            "step": 5,
            "unit": "px",
            "default": 20
        },
        {
            "type": "header",
            "content": "Form Settings"
        },
        {
            "type": "text",
            "id": "form_heading",
            "label": "Form Heading",
            "default": "GO GREEN TODAY ENQUIRE NOW"
        },
        {
            "type": "color",
            "id": "form_border_color",
            "label": "Form Border Color",
            "default": "#6fb31a"
        },
        {
            "type": "range",
            "id": "form_border_width",
            "label": "Form Border Width",
            "min": 1,
            "max": 10,
            "step": 1,
            "unit": "px",
            "default": 3
        },
        {
            "type": "header",
            "content": "Form Field Placeholders"
        },
        {
            "type": "text",
            "id": "name_placeholder",
            "label": "Name Placeholder",
            "default": "NAME"
        },
        {
            "type": "text",
            "id": "email_placeholder",
            "label": "Email Placeholder",
            "default": "MAIL"
        },
        {
            "type": "text",
            "id": "phone_placeholder",
            "label": "Phone Placeholder",
            "default": "Phone Number"
        },
        {
            "type": "text",
            "id": "message_placeholder",
            "label": "Message Placeholder",
            "default": "MESSAGE"
        },
        {
            "type": "header",
            "content": "Submit Button"
        },
        {
            "type": "text",
            "id": "submit_button_text",
            "label": "Submit Button Text",
            "default": "SUBMIT"
        },
        {
            "type": "color",
            "id": "submit_button_bg",
            "label": "Submit Button Background",
            "default": "#6fb31a"
        },
        {
            "type": "color",
            "id": "submit_button_hover",
            "label": "Submit Button Hover",
            "default": "#5a9216"
        },
        {
            "type": "color",
            "id": "submit_button_text_color",
            "label": "Submit Button Text Color",
            "default": "#ffffff"
        },
        {
            "type": "text",
            "id": "success_message",
            "label": "Success Message",
            "default": "Thank you for your enquiry! We will get back to you soon."
        },
        {
            "type": "header",
            "content": "Section Settings"
        },
        {
            "type": "color",
            "id": "bg_color",
            "label": "Background Color",
            "default": "#f5f5f5"
        },
        {
            "type": "select",
            "id": "container",
            "label": "Container Width",
            "default": "1170",
            "options": [
                {"value": "1170", "label": "1170px"},
                {"value": "1370", "label": "1370px"},
                {"value": "1570", "label": "1570px"}
            ]
        },
        {
            "type": "range",
            "id": "padding_top",
            "label": "Padding Top (Desktop)",
            "min": 0,
            "max": 100,
            "step": 5,
            "unit": "px",
            "default": 60
        },
        {
            "type": "range",
            "id": "padding_bottom",
            "label": "Padding Bottom (Desktop)",
            "min": 0,
            "max": 100,
            "step": 5,
            "unit": "px",
            "default": 60
        },
        {
            "type": "range",
            "id": "padding_top_mobile",
            "label": "Padding Top (Mobile)",
            "min": 0,
            "max": 80,
            "step": 5,
            "unit": "px",
            "default": 40
        },
        {
            "type": "range",
            "id": "padding_bottom_mobile",
            "label": "Padding Bottom (Mobile)",
            "min": 0,
            "max": 80,
            "step": 5,
            "unit": "px",
            "default": 40
        }
    ],
    "presets": [
        {
            "name": "Green Contact Form"
        }
    ]
}
{% endschema %}
