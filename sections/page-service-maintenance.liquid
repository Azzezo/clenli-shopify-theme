{%- liquid
    assign section_id = section.id
-%}

<style>
/* ============================================
   SERVICE & MAINTENANCE PAGE STYLES
   ============================================ */

#service-maintenance-{{ section_id }} {
    font-family: 'Open Sans', Arial, sans-serif;
    color: #333;
    line-height: 1.6;
}

#service-maintenance-{{ section_id }} * {
    box-sizing: border-box;
}

#service-maintenance-{{ section_id }} .sm-container {
    max-width: 1170px;
    margin: 0 auto;
    padding: 0 15px;
}

#service-maintenance-{{ section_id }} .sm-row {
    display: flex;
    flex-wrap: wrap;
    margin: 0 -15px;
}

#service-maintenance-{{ section_id }} .sm-col-5 {
    width: 41.666667%;
    padding: 0 15px;
}

#service-maintenance-{{ section_id }} .sm-col-6 {
    width: 50%;
    padding: 0 15px;
}

#service-maintenance-{{ section_id }} .sm-col-7 {
    width: 58.333333%;
    padding: 0 15px;
}

#service-maintenance-{{ section_id }} .sm-col-3 {
    width: 25%;
    padding: 0 15px;
}

#service-maintenance-{{ section_id }} .sm-col-12 {
    width: 100%;
    padding: 0 15px;
}

#service-maintenance-{{ section_id }} img {
    max-width: 100%;
    height: auto;
}

/* ============================================
   HERO BANNER SECTION
   ============================================ */
#service-maintenance-{{ section_id }} .sm-hero-banner {
    background-image: linear-gradient(0deg, rgba(0,0,0,0.55), rgba(0,0,0,0.55)), url('{{ section.settings.hero_bg_image | image_url: width: 1920 }}');
    background-size: cover;
    background-position: center;
    padding: 80px 0;
    text-align: center;
    color: #fff;
}

#service-maintenance-{{ section_id }} .sm-hero-banner h1 {
    font-size: 42px;
    font-weight: 700;
    margin: 0 0 15px 0;
    color: #fff;
}

#service-maintenance-{{ section_id }} .sm-hero-banner .sm-short-desc {
    font-size: 18px;
    max-width: 800px;
    margin: 0 auto;
    opacity: 0.95;
}

/* ============================================
   ABOUT SECTION (Overview Box + Content)
   ============================================ */
#service-maintenance-{{ section_id }} .sm-about-section {
    padding: 50px 0;
}

#service-maintenance-{{ section_id }} .sm-overview-box {
    padding: 30px 30px 30px 50px;
    border: 2px solid #333;
    height: 100%;
    background-image: linear-gradient(0deg, rgba(0,0,0,0.55), rgba(0,0,0,0.55)), url('{{ section.settings.overview_bg_image | image_url: width: 800 }}');
    background-size: cover;
    background-position: 0% 50%;
    color: #fff;
    border-radius: 5px;
}

#service-maintenance-{{ section_id }} .sm-overview-box h2 {
    font-size: 22px;
    font-weight: 700;
    color: #fff;
    margin: 0 0 10px 0;
}

#service-maintenance-{{ section_id }} .sm-overview-box hr {
    width: 15%;
    height: 2px;
    background-color: #6fb31a;
    border: none;
    margin: 0 0 20px 0;
}

#service-maintenance-{{ section_id }} .sm-overview-box ul {
    list-style: none;
    padding: 0;
    margin: 0;
}

#service-maintenance-{{ section_id }} .sm-overview-box ul li {
    padding: 10px 0;
    font-size: 16px;
    line-height: 1.6;
    display: flex;
    align-items: center;
    gap: 10px;
}

#service-maintenance-{{ section_id }} .sm-overview-box ul li svg {
    width: 20px;
    height: 20px;
    fill: #6fb31a;
    flex-shrink: 0;
}

#service-maintenance-{{ section_id }} .sm-about-content {
    padding: 20px;
}

#service-maintenance-{{ section_id }} .sm-about-content h2 {
    font-size: 28px;
    font-weight: 700;
    color: #333;
    margin: 0 0 10px 0;
}

#service-maintenance-{{ section_id }} .sm-about-content hr {
    width: 15%;
    height: 2px;
    background-color: #6fb31a;
    border: none;
    margin: 0 0 20px 0;
}

#service-maintenance-{{ section_id }} .sm-about-content p {
    font-size: 16px;
    line-height: 1.8;
    color: #333;
    margin: 0 0 15px 0;
}

/* ============================================
   NATIONWIDE COVERAGE SECTION
   ============================================ */
#service-maintenance-{{ section_id }} .sm-coverage-section {
    padding: 50px 0;
}

#service-maintenance-{{ section_id }} .sm-section-title {
    font-size: 28px;
    font-weight: 700;
    color: #333;
    text-align: center;
    margin: 0 0 10px 0;
}

#service-maintenance-{{ section_id }} .sm-hr-center {
    width: 15%;
    height: 2px;
    background-color: #6fb31a;
    border: none;
    margin: 0 auto 40px auto;
    display: block;
}

#service-maintenance-{{ section_id }} .sm-coverage-image img {
    max-height: 430px;
    width: auto;
    display: block;
    margin: 0 auto;
}

#service-maintenance-{{ section_id }} .sm-fleet-content h3 {
    font-size: 20px;
    font-weight: 700;
    color: #333;
    margin: 0 0 10px 0;
}

#service-maintenance-{{ section_id }} .sm-fleet-content p {
    font-size: 16px;
    line-height: 1.7;
    color: #555;
    margin: 0 0 30px 0;
}

/* ============================================
   VALUE BOXES (4 Column Features)
   ============================================ */
#service-maintenance-{{ section_id }} .sm-values-section {
    padding: 40px 0;
}

#service-maintenance-{{ section_id }} .sm-value-box {
    border: 1px solid #eee;
    border-bottom: 3px solid #6fb31a;
    padding: 25px 20px;
    text-align: center;
    height: 100%;
    min-height: 280px;
    background: #fff;
    transition: all 0.3s ease;
    border-radius: 5px;
}

#service-maintenance-{{ section_id }} .sm-value-box:hover {
    box-shadow: 0 10px 30px rgba(0,0,0,0.1);
    transform: translateY(-5px);
}

#service-maintenance-{{ section_id }} .sm-value-box h3 {
    font-size: 18px;
    font-weight: 700;
    color: #333;
    margin: 15px 0;
}

#service-maintenance-{{ section_id }} .sm-value-box p {
    font-size: 14px;
    line-height: 1.7;
    color: #555;
    margin: 0;
}

#service-maintenance-{{ section_id }} .sm-value-icon {
    width: 60px;
    height: 60px;
    background: #6fb31a;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 auto;
}

#service-maintenance-{{ section_id }} .sm-value-icon svg {
    width: 30px;
    height: 30px;
    fill: #fff;
}

/* ============================================
   SAM SOFTWARE SECTION
   ============================================ */
#service-maintenance-{{ section_id }} .sm-sam-section {
    padding: 50px 0;
}

#service-maintenance-{{ section_id }} .sm-sam-image img {
    width: 100%;
    border-radius: 5px;
    box-shadow: 0 5px 20px rgba(0,0,0,0.1);
}

#service-maintenance-{{ section_id }} .sm-sam-content {
    padding: 20px 0;
}

#service-maintenance-{{ section_id }} .sm-sam-logo {
    height: 70px;
    margin-bottom: 20px;
}

#service-maintenance-{{ section_id }} .sm-sam-content h3 {
    font-size: 22px;
    font-weight: 700;
    color: #333;
    margin: 0 0 10px 0;
}

#service-maintenance-{{ section_id }} .sm-sam-content hr {
    width: 15%;
    height: 2px;
    background-color: #6fb31a;
    border: none;
    margin: 0 0 20px 0;
}

#service-maintenance-{{ section_id }} .sm-sam-content p {
    font-size: 16px;
    line-height: 1.7;
    color: #555;
    margin: 0 0 20px 0;
}

#service-maintenance-{{ section_id }} .sm-sam-features {
    display: flex;
    flex-wrap: wrap;
    gap: 0;
}

#service-maintenance-{{ section_id }} .sm-sam-features-col {
    width: 50%;
}

#service-maintenance-{{ section_id }} .sm-sam-features ul {
    list-style: none;
    padding: 0;
    margin: 0;
}

#service-maintenance-{{ section_id }} .sm-sam-features ul li {
    padding: 8px 0;
    font-size: 15px;
    color: #333;
    display: flex;
    align-items: center;
    gap: 8px;
}

#service-maintenance-{{ section_id }} .sm-sam-features ul li svg {
    width: 16px;
    height: 16px;
    fill: #6fb31a;
    flex-shrink: 0;
}

/* ============================================
   CONTACT FORM SECTION
   ============================================ */
#service-maintenance-{{ section_id }} .sm-contact-section {
    padding: 50px 0;
    background: #f8f9fa;
}

#service-maintenance-{{ section_id }} .sm-contact-form-wrapper {
    max-width: 800px;
    margin: 0 auto;
    background: #fff;
    padding: 40px;
    border-radius: 10px;
    box-shadow: 0 5px 30px rgba(0,0,0,0.08);
}

#service-maintenance-{{ section_id }} .sm-form-row {
    display: flex;
    flex-wrap: wrap;
    margin: 0 -10px;
}

#service-maintenance-{{ section_id }} .sm-form-group {
    margin-bottom: 20px;
    padding: 0 10px;
}

#service-maintenance-{{ section_id }} .sm-form-group.half {
    width: 50%;
}

#service-maintenance-{{ section_id }} .sm-form-group.full {
    width: 100%;
}

#service-maintenance-{{ section_id }} .sm-form-group label {
    display: block;
    font-size: 14px;
    font-weight: 600;
    color: #333;
    margin-bottom: 8px;
}

#service-maintenance-{{ section_id }} .sm-form-group input,
#service-maintenance-{{ section_id }} .sm-form-group textarea {
    width: 100%;
    padding: 12px 15px;
    border: 1px solid #ddd;
    border-radius: 5px;
    font-size: 15px;
    transition: border-color 0.3s ease;
}

#service-maintenance-{{ section_id }} .sm-form-group input:focus,
#service-maintenance-{{ section_id }} .sm-form-group textarea:focus {
    outline: none;
    border-color: #6fb31a;
}

#service-maintenance-{{ section_id }} .sm-form-group textarea {
    min-height: 120px;
    resize: vertical;
}

#service-maintenance-{{ section_id }} .sm-submit-btn {
    width: 100%;
    padding: 14px 30px;
    background: #6fb31a;
    color: #fff;
    border: none;
    border-radius: 5px;
    font-size: 16px;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.3s ease;
    text-transform: uppercase;
}

#service-maintenance-{{ section_id }} .sm-submit-btn:hover {
    background: #5a9216;
}

/* ============================================
   RESPONSIVE STYLES
   ============================================ */
@media (max-width: 991px) {
    #service-maintenance-{{ section_id }} .sm-col-5,
    #service-maintenance-{{ section_id }} .sm-col-6,
    #service-maintenance-{{ section_id }} .sm-col-7 {
        width: 100%;
    }
    
    #service-maintenance-{{ section_id }} .sm-col-3 {
        width: 50%;
        margin-bottom: 20px;
    }
    
    #service-maintenance-{{ section_id }} .sm-overview-box {
        margin-bottom: 30px;
    }
    
    #service-maintenance-{{ section_id }} .sm-coverage-image {
        margin-bottom: 30px;
    }
    
    #service-maintenance-{{ section_id }} .sm-hero-banner h1 {
        font-size: 32px;
    }
}

@media (max-width: 767px) {
    #service-maintenance-{{ section_id }} .sm-col-3 {
        width: 100%;
    }
    
    #service-maintenance-{{ section_id }} .sm-form-group.half {
        width: 100%;
    }
    
    #service-maintenance-{{ section_id }} .sm-hero-banner {
        padding: 50px 20px;
    }
    
    #service-maintenance-{{ section_id }} .sm-hero-banner h1 {
        font-size: 26px;
    }
    
    #service-maintenance-{{ section_id }} .sm-overview-box {
        padding: 25px;
    }
    
    #service-maintenance-{{ section_id }} .sm-section-title {
        font-size: 24px;
    }
    
    #service-maintenance-{{ section_id }} .sm-sam-features-col {
        width: 100%;
    }
    
    #service-maintenance-{{ section_id }} .sm-contact-form-wrapper {
        padding: 25px;
    }
    
    #service-maintenance-{{ section_id }} .sm-value-box {
        min-height: auto;
    }
}
</style>

<div id="service-maintenance-{{ section_id }}">
    
    <!-- HERO BANNER -->
    <section class="sm-hero-banner">
        <div class="sm-container">
            <h1>{{ section.settings.hero_title }}</h1>
            <p class="sm-short-desc">{{ section.settings.hero_description }}</p>
        </div>
    </section>
    
    <!-- ABOUT SECTION -->
    <section class="sm-about-section">
        <div class="sm-container">
            <div class="sm-row">
                <!-- Overview Box -->
                <div class="sm-col-5">
                    <div class="sm-overview-box">
                        <h2>{{ section.settings.overview_title }}</h2>
                        <hr>
                        <ul>
                            {%- for block in section.blocks -%}
                                {%- if block.type == 'overview_item' -%}
                                    <li {{ block.shopify_attributes }}>
                                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"><path d="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z"/></svg>
                                        {{ block.settings.item_text }}
                                    </li>
                                {%- endif -%}
                            {%- endfor -%}
                        </ul>
                    </div>
                </div>
                
                <!-- About Content -->
                <div class="sm-col-7">
                    <div class="sm-about-content">
                        <h2>{{ section.settings.about_title }}</h2>
                        <hr>
                        {{ section.settings.about_content }}
                    </div>
                </div>
            </div>
        </div>
    </section>
    
    <!-- COVERAGE SECTION -->
    <section class="sm-coverage-section">
        <div class="sm-container">
            <h2 class="sm-section-title">{{ section.settings.coverage_title }}</h2>
            <hr class="sm-hr-center">
            
            <div class="sm-row">
                <div class="sm-col-6">
                    <div class="sm-coverage-image">
                        {%- if section.settings.coverage_image != blank -%}
                            <img src="{{ section.settings.coverage_image | image_url: width: 600 }}" alt="{{ section.settings.coverage_title }}">
                        {%- else -%}
                            {{ 'image' | placeholder_svg_tag }}
                        {%- endif -%}
                    </div>
                </div>
                
                <div class="sm-col-6">
                    <div class="sm-fleet-content">
                        {%- for block in section.blocks -%}
                            {%- if block.type == 'fleet_item' -%}
                                <div {{ block.shopify_attributes }}>
                                    <h3>{{ block.settings.fleet_title }}</h3>
                                    <p>{{ block.settings.fleet_text }}</p>
                                </div>
                            {%- endif -%}
                        {%- endfor -%}
                    </div>
                </div>
            </div>
        </div>
    </section>
    
    <!-- VALUE BOXES -->
    <section class="sm-values-section">
        <div class="sm-container">
            <div class="sm-row">
                {%- for block in section.blocks -%}
                    {%- if block.type == 'value_box' -%}
                        <div class="sm-col-3" {{ block.shopify_attributes }}>
                            <div class="sm-value-box">
                                <div class="sm-value-icon">
                                    {%- case block.settings.icon_type -%}
                                        {%- when 'phone' -%}
                                            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"><path d="M6.62 10.79c1.44 2.83 3.76 5.14 6.59 6.59l2.2-2.2c.27-.27.67-.36 1.02-.24 1.12.37 2.33.57 3.57.57.55 0 1 .45 1 1V20c0 .55-.45 1-1 1-9.39 0-17-7.61-17-17 0-.55.45-1 1-1h3.5c.55 0 1 .45 1 1 0 1.25.2 2.45.57 3.57.11.35.03.74-.25 1.02l-2.2 2.2z"/></svg>
                                        {%- when 'clipboard' -%}
                                            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"><path d="M19 3h-4.18C14.4 1.84 13.3 1 12 1c-1.3 0-2.4.84-2.82 2H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm-7 0c.55 0 1 .45 1 1s-.45 1-1 1-1-.45-1-1 .45-1 1-1zm2 14H7v-2h7v2zm3-4H7v-2h10v2zm0-4H7V7h10v2z"/></svg>
                                        {%- when 'check' -%}
                                            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"><path d="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z"/></svg>
                                        {%- when 'chart' -%}
                                            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"><path d="M19 3H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zM9 17H7v-7h2v7zm4 0h-2V7h2v10zm4 0h-2v-4h2v4z"/></svg>
                                        {%- else -%}
                                            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 15l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z"/></svg>
                                    {%- endcase -%}
                                </div>
                                <h3>{{ block.settings.value_title }}</h3>
                                <p>{{ block.settings.value_text }}</p>
                            </div>
                        </div>
                    {%- endif -%}
                {%- endfor -%}
            </div>
        </div>
    </section>
    
    <!-- SAM SOFTWARE SECTION -->
    <section class="sm-sam-section">
        <div class="sm-container">
            <h2 class="sm-section-title">{{ section.settings.sam_section_title }}</h2>
            <hr class="sm-hr-center">
            
            <div class="sm-row">
                <div class="sm-col-6">
                    <div class="sm-sam-image">
                        {%- if section.settings.sam_image != blank -%}
                            <img src="{{ section.settings.sam_image | image_url: width: 800 }}" alt="SAM Software">
                        {%- else -%}
                            {{ 'image' | placeholder_svg_tag }}
                        {%- endif -%}
                    </div>
                </div>
                
                <div class="sm-col-6">
                    <div class="sm-sam-content">
                        {%- if section.settings.sam_logo != blank -%}
                            <img class="sm-sam-logo" src="{{ section.settings.sam_logo | image_url: width: 200 }}" alt="SAM Logo">
                        {%- endif -%}
                        
                        <h3>{{ section.settings.sam_title }}</h3>
                        <hr>
                        <p>{{ section.settings.sam_description }}</p>
                        
                        <div class="sm-sam-features">
                            <div class="sm-sam-features-col">
                                <ul>
                                    {%- assign feature_count = 0 -%}
                                    {%- for block in section.blocks -%}
                                        {%- if block.type == 'sam_feature' -%}
                                            {%- assign feature_count = feature_count | plus: 1 -%}
                                            {%- if feature_count <= 4 -%}
                                                <li {{ block.shopify_attributes }}>
                                                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"><path d="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z"/></svg>
                                                    {{ block.settings.feature_text }}
                                                </li>
                                            {%- endif -%}
                                        {%- endif -%}
                                    {%- endfor -%}
                                </ul>
                            </div>
                            <div class="sm-sam-features-col">
                                <ul>
                                    {%- assign feature_count = 0 -%}
                                    {%- for block in section.blocks -%}
                                        {%- if block.type == 'sam_feature' -%}
                                            {%- assign feature_count = feature_count | plus: 1 -%}
                                            {%- if feature_count > 4 -%}
                                                <li {{ block.shopify_attributes }}>
                                                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"><path d="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z"/></svg>
                                                    {{ block.settings.feature_text }}
                                                </li>
                                            {%- endif -%}
                                        {%- endif -%}
                                    {%- endfor -%}
                                </ul>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>
    
    <!-- CONTACT FORM -->
    <section class="sm-contact-section">
        <div class="sm-container">
            <h2 class="sm-section-title">{{ section.settings.contact_title }}</h2>
            <hr class="sm-hr-center">
            
            <div class="sm-contact-form-wrapper">
                {%- form 'contact', class: 'sm-contact-form' -%}
                    {%- if form.posted_successfully? -%}
                        <p style="color: #6fb31a; text-align: center; padding: 20px; background: #f0fff0; border-radius: 5px; margin-bottom: 20px;">
                            Thank you for contacting us. We will get back to you soon!
                        </p>
                    {%- endif -%}
                    
                    <div class="sm-form-row">
                        <div class="sm-form-group half">
                            <label for="contact-name-{{ section_id }}">Name *</label>
                            <input type="text" id="contact-name-{{ section_id }}" name="contact[name]" required>
                        </div>
                        
                        <div class="sm-form-group half">
                            <label for="contact-company-{{ section_id }}">Company</label>
                            <input type="text" id="contact-company-{{ section_id }}" name="contact[company]">
                        </div>
                        
                        <div class="sm-form-group half">
                            <label for="contact-phone-{{ section_id }}">Phone Number *</label>
                            <input type="tel" id="contact-phone-{{ section_id }}" name="contact[phone]" required>
                        </div>
                        
                        <div class="sm-form-group half">
                            <label for="contact-email-{{ section_id }}">Email *</label>
                            <input type="email" id="contact-email-{{ section_id }}" name="contact[email]" required>
                        </div>
                        
                        <div class="sm-form-group full">
                            <label for="contact-message-{{ section_id }}">Message *</label>
                            <textarea id="contact-message-{{ section_id }}" name="contact[body]" required></textarea>
                        </div>
                        
                        <div class="sm-form-group full">
                            <button type="submit" class="sm-submit-btn">{{ section.settings.submit_button_text }}</button>
                        </div>
                    </div>
                {%- endform -%}
            </div>
        </div>
    </section>
    
</div>

{% schema %}
{
    "name": "Service & Maintenance",
    "tag": "section",
    "class": "service-maintenance-section",
    "settings": [
        {
            "type": "header",
            "content": "Hero Banner"
        },
        {
            "type": "image_picker",
            "id": "hero_bg_image",
            "label": "Hero Background Image"
        },
        {
            "type": "text",
            "id": "hero_title",
            "label": "Hero Title",
            "default": "Service & Maintenance"
        },
        {
            "type": "textarea",
            "id": "hero_description",
            "label": "Hero Description",
            "default": "Our Service team protects and maintains cleaning machines and equipment to ensure longevity and optimal performance."
        },
