{% comment %}
  Clenli Direct - i-Mop Floor Scrubber Dryer Page
  Complete single section for i-Mop landing page
{% endcomment %}

<div class="imop-page">
  <!-- Hero Section -->
  <section class="imop-hero">
    <div class="imop-container">
      <div class="imop-hero__grid">
        <div class="imop-hero__image">
          {% if section.settings.hero_image != blank %}
            <img
              src="{{ section.settings.hero_image | image_url: width: 800 }}"
              alt="{{ section.settings.hero_title }}"
            >
          {% else %}
            <img src="{{ 'migrated-iii-Mop.png' | asset_url }}" alt="i-Mop Floor Scrubber Dryer">
          {% endif %}
        </div>
        <div class="imop-hero__content">
          <span class="imop-tag">{{ section.settings.hero_tag }}</span>
          <h1 class="imop-hero__title">{{ section.settings.hero_title }}</h1>
          <p class="imop-text">{{ section.settings.hero_desc }}</p>

          <div class="imop-features">
            <div class="imop-feature">
              <strong>{{ section.settings.feature1_title }}</strong>
              <p>{{ section.settings.feature1_text }}</p>
            </div>
            <div class="imop-feature">
              <strong>{{ section.settings.feature2_title }}</strong>
              <p>{{ section.settings.feature2_text }}</p>
            </div>
            <div class="imop-feature">
              <strong>{{ section.settings.feature3_title }}</strong>
              <p>{{ section.settings.feature3_text }}</p>
            </div>
          </div>

          <a href="{{ section.settings.hero_btn_link }}" class="imop-btn">{{ section.settings.hero_btn_text }}</a>
        </div>
      </div>
    </div>
  </section>
  <hr class="imop-divider">
  {% comment %} <div class="imop-divider"></div> {% endcomment %}

  <!-- What is the i-Mop -->
  <section class="imop-info">
    <div class="imop-container">
      <div class="imop-info__grid imop-info__grid--reverse">
        <div class="imop-info__image">
          {% if section.settings.what_image != blank %}
            <img
              src="{{ section.settings.what_image | image_url: width: 800 }}"
              alt="{{ section.settings.what_title }}"
            >
          {% else %}
            <img src="{{ 'migrated-What_is_the_i-Mop.png' | asset_url }}" alt="What is the i-Mop">
          {% endif %}
        </div>
        <div class="imop-info__content imop-info__content--center">
          <h2 class="imop-subtitle">{{ section.settings.what_title }}</h2>
          <p class="imop-text">{{ section.settings.what_text1 }}</p>
          <p class="imop-text">{{ section.settings.what_text2 }}</p>
          <a href="{{ section.settings.what_btn_link }}" class="imop-btn">{{ section.settings.what_btn_text }}</a>
        </div>
      </div>
    </div>
  </section>
  <hr class="imop-divider">
  {% comment %} <div class="imop-divider"></div> {% endcomment %}

  <!-- Filling the Gap -->
  <section class="imop-gap">
    <div class="imop-container">
      <h2 class="imop-section-title">{{ section.settings.gap_title }}</h2>
      <p class="imop-section-subtitle">{{ section.settings.gap_text }}</p>
      <div class="imop-gap__image">
        {% if section.settings.gap_image != blank %}
          <img src="{{ section.settings.gap_image | image_url: width: 1200 }}" alt="{{ section.settings.gap_title }}">
        {% else %}
          <img
            src="{{ 'migrated-Filling_the_Gap_in_the_Market2.jpg' | asset_url }}"
            alt="How the i-Mop was Created"
          >
        {% endif %}
      </div>
    </div>
  </section>
  <hr class="imop-divider">
  {% comment %} <div class="imop-divider"></div> {% endcomment %}

  <!-- Video Section -->
  <section class="imop-video">
    <div class="imop-container">
      <h2 class="imop-section-title">{{ section.settings.video_title }}</h2>
      <p class="imop-section-subtitle">{{ section.settings.video_text }}</p>
      <div class="imop-video__wrapper">
        <iframe
          src="https://www.youtube.com/embed/{{ section.settings.video_id }}"
          title="{{ section.settings.video_title }}"
          frameborder="0"
          allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
          allowfullscreen
        >
        </iframe>
      </div>
    </div>
  </section>
  <hr class="imop-divider">
  {% comment %} <div class="imop-divider"></div> {% endcomment %}

  <!-- Save Time Section -->
  <section class="imop-info">
    <div class="imop-container">
      <div class="imop-info__grid imop-info__grid--reverse">
        <div class="imop-info__content imop-info__content--center">
          <h2 class="imop-subtitle">{{ section.settings.save_title }}</h2>
          <p class="imop-text">{{ section.settings.save_text1 }}</p>
          <p class="imop-text">{{ section.settings.save_text2 }}</p>
          <a href="{{ section.settings.save_btn_link }}" class="imop-btn">{{ section.settings.save_btn_text }}</a>
        </div>
        <div class="imop-info__image">
          {% if section.settings.save_image != blank %}
            <img
              src="{{ section.settings.save_image | image_url: width: 800 }}"
              alt="{{ section.settings.save_title }}"
            >
          {% else %}
            <img
              src="{{ 'migrated-Save_Time_Water_Effort.png' | asset_url }}"
              alt="Save Time Water Effort"
            >
          {% endif %}
        </div>
      </div>
    </div>
  </section>

  <hr class="imop-divider">
  {% comment %} <div class="imop-divider"></div> {% endcomment %}

  <!-- Improved Safety -->
  <section class="imop-info">
    <div class="imop-container">
      <div class="imop-info__grid">
        <div class="imop-info__content imop-info__content--center">
          <h2 class="imop-subtitle">{{ section.settings.safety_title }}</h2>
          <p class="imop-text">{{ section.settings.safety_text1 }}</p>
          <p class="imop-text">{{ section.settings.safety_text2 }}</p>
          <a href="{{ section.settings.safety_btn_link }}" class="imop-btn">{{ section.settings.safety_btn_text }}</a>
        </div>
        <div class="imop-info__image">
          {% if section.settings.safety_image != blank %}
            <img
              src="{{ section.settings.safety_image | image_url: width: 800 }}"
              alt="{{ section.settings.safety_title }}"
            >
          {% else %}
            <img src="{{ 'migrated-Improved_Safety.png' | asset_url }}" alt="Improved Safety">
          {% endif %}
        </div>
      </div>
    </div>
  </section>
  <hr class="imop-divider">
  {% comment %} <div class="imop-divider"></div> {% endcomment %}

  <!-- Environment Section -->
  <section class="imop-info">
    <div class="imop-container">
      <div class="imop-info__grid imop-info__grid--reverse">
        <div class="imop-info__content imop-info__content--center">
          <h2 class="imop-subtitle">{{ section.settings.env_title }}</h2>
          <p class="imop-text">{{ section.settings.env_text1 }}</p>
          <p class="imop-text">{{ section.settings.env_text2 }}</p>
          <a href="{{ section.settings.env_btn_link }}" class="imop-btn">{{ section.settings.env_btn_text }}</a>
        </div>
         <div class="imop-info__image">
          {% if section.settings.env_image != blank %}
            <img src="{{ section.settings.env_image | image_url: width: 800 }}" alt="{{ section.settings.env_title }}">
          {% else %}
            <img
              src="{{ 'migrated-Doing_Your_Part_for_the_Environment.png' | asset_url }}"
              alt="Environment"
            >
          {% endif %}
        </div>
      </div>
    </div>
  </section>

  <hr class="imop-divider">
  {% comment %} <div class="imop-divider"></div> {% endcomment %}

  <!-- Investing in Better World -->
  <section class="imop-info">
    <div class="imop-container">
      <div class="imop-info__grid">
        <div class="imop-info__content">
          <h2 class="imop-subtitle">{{ section.settings.invest_title }}</h2>
          <p class="imop-text">{{ section.settings.invest_text1 }}</p>
          <p class="imop-text">{{ section.settings.invest_text2 }}</p>
          <p class="imop-text">{{ section.settings.invest_text3 }}</p>
          <p class="imop-text">{{ section.settings.invest_text4 }}</p>
        </div>
        <div class="imop-info__image">
          {% if section.settings.invest_image != blank %}
            <img
              src="{{ section.settings.invest_image | image_url: width: 800 }}"
              alt="{{ section.settings.invest_title }}"
            >
          {% else %}
            <img
              src="{{ 'migrated-Investing_in_a_Better_World.png' | asset_url }}"
              alt="Investing in a Better World"
            >
          {% endif %}
        </div>
      </div>
    </div>
  </section>

  <hr class="imop-divider">
  {% comment %} <div class="imop-divider"></div> {% endcomment %}

  <!-- Best Getting Better -->
  <section class="imop-info">
    <div class="imop-container">
      <div class="imop-info__grid imop-info__grid--reverse">
        <div class="imop-info__content">
          <h2 class="imop-subtitle">{{ section.settings.best_title }}</h2>
          <p class="imop-text">{{ section.settings.best_text1 }}</p>
          <p class="imop-text">{{ section.settings.best_text2 }}</p>
          <a href="{{ section.settings.best_btn_link }}" class="imop-btn">{{ section.settings.best_btn_text }}</a>
        </div>
        <div class="imop-info__image">
          {% if section.settings.best_image != blank %}
            <img
              src="{{ section.settings.best_image | image_url: width: 800 }}"
              alt="{{ section.settings.best_title }}"
            >
          {% else %}
            <img
              src="{{ 'migrated-The_Best_is_Getting_Better.png' | asset_url }}"
              alt="The Best is Getting Better"
            >
          {% endif %}
        </div>
      </div>
    </div>
  </section>

  <hr class="imop-divider">
  {% comment %} <div class="imop-divider"></div> {% endcomment %}

  <!-- Solutions Section -->
  <section class="imop-info">
    <div class="imop-container">
      <div class="imop-info__grid">
        <div class="imop-info__content">
          <h2 class="imop-subtitle">{{ section.settings.solutions_title }}</h2>
          <p class="imop-text">{{ section.settings.solutions_text }}</p>
        </div>
        <div class="imop-info__image">
          {% if section.settings.solutions_image != blank %}
            <img
              src="{{ section.settings.solutions_image | image_url: width: 800 }}"
              alt="{{ section.settings.solutions_title }}"
            >
          {% else %}
            <img
              src="{{ 'migrated-Solutions_for_All_Floor_Types.png' | asset_url }}"
              alt="Solutions for All Floor Types"
            >
          {% endif %}
        </div>
      </div>
    </div>
  </section>
  <hr class="imop-divider">
  {% comment %} <div class="imop-divider"></div> {% endcomment %}

  <!-- Why Choose Section -->
  <section class="imop-why">
    <div class="imop-container">
      <div class="imop-why__logo">
        {% if section.settings.why_logo != blank %}
          <img src="{{ section.settings.why_logo | image_url: width: 300 }}" alt="Clenli Direct">
        {% else %}
          <img
            src="{{ 'migrated-Untitled_design_-_2024-02-08T162909.668.png' | asset_url }}"
            alt="Clenli Logo"
          >
        {% endif %}
      </div>
      <h2 class="imop-section-title">{{ section.settings.why_title }}</h2>
      <p class="imop-section-subtitle">{{ section.settings.why_text }}</p>
    </div>
  </section>

  {% comment %} <div class="imop-divider"></div> {% endcomment %}
  <hr class="imop-divider">
  <!-- Product Range -->
  <section class="imop-range">
    <div class="imop-container">
      <h2 class="imop-section-title">{{ section.settings.range_title }}</h2>

      <div class="imop-range__grid">
        {% for block in section.blocks %}
          {% if block.type == 'product' %}
            <div class="imop-product-card" {{ block.shopify_attributes }}>
              <div class="imop-product-card__img">
                {% if block.settings.image != blank %}
                  <img src="{{ block.settings.image | image_url: width: 400 }}" alt="{{ block.settings.name }}">
                {% else %}
                  <div class="imop-product-placeholder">
                    <svg width="80" height="80" viewBox="0 0 24 24" fill="none" stroke="#6fb31a" stroke-width="1">
                      <rect x="2" y="2" width="20" height="20" rx="3"/>
                    </svg>
                  </div>
                {% endif %}
              </div>
              <h3 class="imop-product-card__name">{{ block.settings.name }}</h3>
              <div class="imop-product-card__specs">
                <p><span>Operating Width :</span> {{ block.settings.width }}</p>
                <p><span>Battery Life :</span> {{ block.settings.battery }}</p>
                <p><span>Brush Speed :</span> {{ block.settings.speed }}</p>
                <p><span>Brush Pressure :</span> {{ block.settings.pressure }}</p>
                <p><span>Tank Capacity :</span> {{ block.settings.tank }}</p>
              </div>
              <a href="{{ block.settings.link }}" class="imop-btn imop-btn--small"
                >View the {{ block.settings.name -}}
              </a>
            </div>
          {% endif %}
        {% endfor %}
      </div>
    </div>
  </section>
  <hr class="imop-divider">
  {% comment %} <div class="imop-divider"></div> {% endcomment %}

  <!-- CTA Section -->
  <section class="imop-cta">
    <div class="imop-container">
      <div class="imop-cta__grid">
        <div class="imop-cta__content">
          <h2 class="imop-section-title">{{ section.settings.cta_title }}</h2>
          <p class="imop-section-subtitle">{{ section.settings.cta_text }}</p>
          <div class="imop-cta__image">
            {% if section.settings.cta_image != blank %}
              <img
                src="{{ section.settings.cta_image | image_url: width: 1000 }}"
                alt="{{ section.settings.cta_title }}"
              >
            {% else %}
              <img src="{{ 'migrated-i-Mop_Footer73.png' | asset_url }}" alt="Explore the i-Mop">
            {% endif %}
          </div>
        </div>
        <div class="imop-cta__form">
          <a href="tel:{{ section.settings.phone }}" class="imop-call-btn">CALL NOW</a>
          <div class="imop-enquiry-form">
            <h3>{{ section.settings.form_title }}</h3>
            {% if section.settings.show_hubspot_form %}
              {%- assign hs_target_imop = 'hubspot-form-gogreen-imop-' | append: section.id -%}
              {% render 'hubspot-form',
                form_id: '03da5c3c-6669-4ae1-843b-985c17935c7f',
                target_id: hs_target_imop
              %}
            {% else %}
            {% form 'contact' %}
              <div class="imop-form-group">
                <input type="text" name="contact[name]" placeholder="NAME" required>
              </div>
              <div class="imop-form-group">
                <input type="email" name="contact[email]" placeholder="EMAIL" required>
              </div>
              <div class="imop-form-group">
                <input type="tel" name="contact[phone]" placeholder="PHONE NUMBER" required>
              </div>
              <div class="imop-form-group">
                <textarea name="contact[body]" placeholder="MESSAGE" rows="3" required></textarea>
              </div>
              <button type="submit" class="imop-btn imop-btn--full">Submit</button>
            {% endform %}
            {% endif %}
          </div>
        </div>
      </div>
    </div>
  </section>
</div>

<style>
  .imop-page {
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, sans-serif;
    color: #333;
  }

  .imop-container {
    max-width: 1570px !important;
    margin: 0 auto;
    padding: 0 20px;
  }
  hr.imop-divider {
    width: 100% !important;
    max-width: 1570px !important;
    height: 4px !important;
    margin: 40px auto !important;
    background-color: #6fb31a !important;
    border: 0 !important;
    border: none !important;
    display: block !important;
    opacity: 1 !important;
    visibility: visible !important;
  }

  {% comment %} .imop-divider {
    width: 100%;
    max-width: 1200px;
    height: 4px;
    margin: 40px auto;
    background-color: #6fb31a;
    border: none;
    display: block;
  } {% endcomment %}


