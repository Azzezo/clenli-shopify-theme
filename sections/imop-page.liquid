    width: 100%;
    padding: 12px 15px;
    border: 1px solid #ddd;
    border-radius: 5px;
    font-size: 14px;
    transition: border-color 0.3s ease;
    box-sizing: border-box;
  }

  .imop-form-group input:focus,
  .imop-form-group textarea:focus {
    outline: none;
    border-color: #6fb31a;
  }

  @media (max-width: 1024px) {
    .imop-range__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 768px) {
    .imop-hero__grid,
    .imop-info__grid,
    .imop-info__grid--reverse,
    .imop-cta__grid {
      grid-template-columns: 1fr;
      direction: ltr;
      text-align: center;
    }

    .imop-hero__title {
      font-size: 32px;
    }

    .imop-range__grid {
      grid-template-columns: 1fr;
      gap: 30px;
    }

    .imop-hero__image,
    .imop-info__image {
      order: -1;
    }

    .imop-info__content {
      text-align: center;
    }

    .imop-video__wrapper {
      max-width: 100%;
    }

    .imop-gap__image img {
      max-width: 100%;
    }
  }
</style>

