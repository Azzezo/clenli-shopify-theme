<div class="euv-hero section-{{ section.id }}">
    <div class="euv-container">
        <div class="euv-hero-grid">
            
            <!-- Left - Image -->
            <div class="euv-hero-image">
                {%- if section.settings.image != blank -%}
                    <img src="{{ section.settings.image | image_url: width: 800 }}" alt="{{ section.settings.heading }}" loading="lazy">
                {%- else -%}
                    <div class="placeholder-img">Vehicle Image</div>
                {%- endif -%}
            </div>
            
            <!-- Right - Content -->
            <div class="euv-hero-content">
                {%- if section.settings.subtitle != blank -%}
                    <p class="euv-subtitle">{{ section.settings.subtitle }}</p>
                {%- endif -%}
                {%- if section.settings.heading != blank -%}
                    <h1 class="euv-heading">{{ section.settings.heading }}</h1>
                {%- endif -%}
                {%- if section.settings.description != blank -%}
                    <div class="euv-description">{{ section.settings.description }}</div>
                {%- endif -%}
                {%- if section.settings.button_text != blank -%}
                    <a href="{{ section.settings.button_link | default: '#' }}" class="euv-btn">{{ section.settings.button_text }}</a>
                {%- endif -%}
            </div>
            
        </div>
        
        <!-- Green Underline -->
        <div class="euv-underline"></div>
    </div>
</div>

{% style %}
.section-{{ section.id }} {
    padding: {{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px;
    background: {{ section.settings.bg_color }};
}

.section-{{ section.id }} .euv-container {
    max-width: 1570px;
    margin: 0 auto;
    padding: 0 20px;
}

.section-{{ section.id }} .euv-hero-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 40px;
    align-items: center;
    margin-bottom: 40px;
}

/* Image */
.section-{{ section.id }} .euv-hero-image img {
    width: 80%;
    height: auto;
    display: block;
    margin: 0 auto;
}

.section-{{ section.id }} .placeholder-img {
    width: 100%;
    height: 400px;
    background: #e0e0e0;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #999;
}

/* Content */
.section-{{ section.id }} .euv-hero-content {
    padding: 20px 0;
}

.section-{{ section.id }} .euv-subtitle {
    font-size: 18px;
    font-weight: 600;
    color: {{ section.settings.text_color }};
    margin: 0 0 10px 0;
    text-transform: uppercase;
}

.section-{{ section.id }} .euv-heading {
    font-size: 36px;
    font-weight: 700;
    color: {{ section.settings.heading_color }};
    margin: 0 0 25px 0;
    line-height: 1.2;
}

.section-{{ section.id }} .euv-description {
    font-size: 16px;
    line-height: 1.7;
    color: {{ section.settings.text_color }};
    margin-bottom: 25px;
}

.section-{{ section.id }} .euv-description p {
    margin: 0 0 15px 0;
}

.section-{{ section.id }} .euv-btn {
    display: inline-block;
    padding: 14px 30px;
    background: {{ section.settings.button_bg }};
    color: {{ section.settings.button_color }};
    text-decoration: none;
    font-size: 14px;
    font-weight: 600;
    border-radius: 4px;
    transition: all 0.3s ease;
}

.section-{{ section.id }} .euv-btn:hover {
    background: {{ section.settings.button_hover_bg }};
}

/* Underline - FIXED */
.section-{{ section.id }} .euv-underline {
    width: 100%;
    height: {{ section.settings.underline_height }}px;
    background: {{ section.settings.underline_color }};
    margin: 0;
    display: block;
    clear: both;
}

/* Responsive */
@media (max-width: 768px) {
    .section-{{ section.id }} .euv-hero-grid {
        grid-template-columns: 1fr;
        gap: 30px;
        margin-bottom: 30px;
    }
    
    .section-{{ section.id }} .euv-hero-image img {
        width: 100%;
    }
    
    .section-{{ section.id }} .euv-heading {
        font-size: 28px;
    }
}
{% endstyle %}

{% schema %}
{
    "name": "EUV Hero Banner",
    "tag": "section",
    "settings": [
        {
            "type": "header",
            "content": "Image"
        },
        {
            "type": "image_picker",
            "id": "image",
            "label": "Vehicle Image"
        },
        {
            "type": "header",
            "content": "Content"
        },
        {
            "type": "text",
            "id": "subtitle",
            "label": "Subtitle",
            "default": "ELECTRIC UTILITY VEHICLES"
        },
        {
            "type": "text",
            "id": "heading",
            "label": "Heading",
            "default": "EUVs: Why Consider Investing"
        },
        {
            "type": "richtext",
            "id": "description",
            "label": "Description",
            "default": "<p><strong>A question we are commonly asked is \"why should I invest in an Electric Utility Vehicle\"?</strong></p><p><strong>While the answer differs for everybody based on their needs, if you are interested in reducing fuel costs, lowering your environmental impact, creating a return on investment from your vehicles, or future proofing for tightening emissions regulations, Electric Utility Vehicles can hold the key!</strong></p><p><strong>Below are some of the most common reasons why you should consider investing in Electric Utility Vehicles.</strong></p>"
        },
        {
            "type": "text",
            "id": "button_text",
            "label": "Button Text",
            "default": "Explore Addax Range"
        },
        {
            "type": "url",
            "id": "button_link",
            "label": "Button Link"
        },
        {
            "type": "header",
            "content": "Underline Settings"
        },
        {
            "type": "color",
            "id": "underline_color",
            "label": "Underline Color",
            "default": "#6fb31a"
        },
        {
            "type": "range",
            "id": "underline_height",
            "label": "Underline Height",
            "min": 3,
            "max": 10,
            "step": 1,
            "unit": "px",
            "default": 5
        },
        {
            "type": "header",
            "content": "Colors"
        },
        {
            "type": "color",
            "id": "bg_color",
            "label": "Background",
            "default": "#ffffff"
        },
        {
            "type": "color",
            "id": "heading_color",
            "label": "Heading Color",
            "default": "#1a1a1a"
        },
        {
            "type": "color",
            "id": "text_color",
            "label": "Text Color",
            "default": "#333333"
        },
        {
            "type": "color",
            "id": "button_bg",
            "label": "Button Background",
            "default": "#6fb31a"
        },
        {
            "type": "color",
            "id": "button_hover_bg",
            "label": "Button Hover",
            "default": "#5a9216"
        },
        {
            "type": "color",
            "id": "button_color",
            "label": "Button Text",
            "default": "#ffffff"
        },
        {
            "type": "header",
            "content": "Spacing"
        },
        {
            "type": "range",
            "id": "padding_top",
            "label": "Padding Top",
            "min": 0,
            "max": 100,
            "step": 10,
            "unit": "px",
            "default": 60
        },
        {
            "type": "range",
            "id": "padding_bottom",
            "label": "Padding Bottom",
            "min": 0,
            "max": 100,
            "step": 10,
            "unit": "px",
            "default": 40
        }
    ],
    "presets": [
        {
            "name": "EUV Hero Banner"
        }
    ]
}
{% endschema %}
