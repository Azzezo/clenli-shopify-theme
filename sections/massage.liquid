{%- liquid
    assign section_id = section.id
    assign heading = section.settings.heading
    assign heading_color = section.settings.heading_color
    assign heading_size = section.settings.heading_size
    assign bg_color = section.settings.bg_color
    assign container = section.settings.container
    assign columns_desktop = section.settings.columns_desktop
    assign columns_tablet = section.settings.columns_tablet
    assign columns_mobile = section.settings.columns_mobile
    assign text_align = section.settings.text_align
    assign item_title_color = section.settings.item_title_color
    assign item_title_size = section.settings.item_title_size
    assign item_desc_color = section.settings.item_desc_color
    assign item_desc_size = section.settings.item_desc_size
    assign padding_top = section.settings.padding_top
    assign padding_bottom = section.settings.padding_bottom
    assign padding_top_mobile = section.settings.padding_top_mobile
    assign padding_bottom_mobile = section.settings.padding_bottom_mobile
    assign item_gap = section.settings.item_gap
    assign enable_border = section.settings.enable_border
    assign border_color = section.settings.border_color
    assign enable_separator = section.settings.enable_separator
    assign separator_color = section.settings.separator_color
-%}

<style>
    #our-values-{{ section_id }} {
        background-color: {{ bg_color }};
        padding-top: {{ padding_top }}px;
        padding-bottom: {{ padding_bottom }}px;
    }
    
    #our-values-{{ section_id }} .values-container {
        max-width: {% if container == '1170' %}1170px{% elsif container == '1370' %}1370px{% elsif container == '1570' %}1570px{% else %}1170px{% endif %};
        margin: 0 auto;
        padding: 0 15px;
    }
    
    #our-values-{{ section_id }} .values-heading {
        text-align: center;
        margin-bottom: 50px;
    }
    
    #our-values-{{ section_id }} .values-heading h2 {
        font-size: {{ heading_size }}px;
        font-weight: 600;
        color: {{ heading_color }};
        margin: 0;
        position: relative;
        display: inline-block;
    }
    
    #our-values-{{ section_id }} .values-heading h2::before {
        content: '•';
        position: absolute;
        left: -20px;
        top: 50%;
        transform: translateY(-50%);
        color: {{ heading_color }};
        font-size: 14px;
    }
    
    #our-values-{{ section_id }} .values-grid {
        display: grid;
        grid-template-columns: repeat({{ columns_desktop }}, 1fr);
        gap: {{ item_gap }}px;
        position: relative;
    }
    
    #our-values-{{ section_id }} .value-item {
        text-align: {{ text_align }};
        padding: 20px 25px;
        position: relative;
    }
    
    /* Vertical Separator Lines */
    {% if enable_separator %}
    #our-values-{{ section_id }} .values-grid .value-item:not(:last-child)::after {
        content: '';
        position: absolute;
        right: -{{ item_gap | divided_by: 2 }}px;
        top: 20%;
        height: 60%;
        width: 1px;
        background-color: {{ separator_color }};
    }
    {% endif %}
    
    {% if enable_border %}
    #our-values-{{ section_id }} .value-item {
        border: 1px solid {{ border_color }};
        border-radius: 5px;
    }
    #our-values-{{ section_id }} .value-item::after {
        display: none !important;
    }
    {% endif %}
    
    #our-values-{{ section_id }} .value-item .item-title {
        font-size: {{ item_title_size }}px;
        font-weight: 600;
        color: {{ item_title_color }};
        margin: 0 0 15px 0;
    }
    
    #our-values-{{ section_id }} .value-item .item-description {
        font-size: {{ item_desc_size }}px;
        color: {{ item_desc_color }};
        line-height: 1.7;
        margin: 0;
    }
    
    /* Tablet */
    @media (max-width: 1024px) {
        #our-values-{{ section_id }} .values-grid {
            grid-template-columns: repeat({{ columns_tablet }}, 1fr);
        }
        
        #our-values-{{ section_id }} .values-heading {
            margin-bottom: 35px;
        }
        
        #our-values-{{ section_id }} .values-heading h2 {
            font-size: {{ heading_size | minus: 4 }}px;
        }
        
        #our-values-{{ section_id }} .values-grid .value-item:nth-child({{ columns_tablet }}n)::after {
            display: none;
        }
    }
    
    /* Mobile */
    @media (max-width: 767px) {
        #our-values-{{ section_id }} {
            padding-top: {{ padding_top_mobile }}px;
            padding-bottom: {{ padding_bottom_mobile }}px;
        }
        
        #our-values-{{ section_id }} .values-grid {
            grid-template-columns: repeat({{ columns_mobile }}, 1fr);
            gap: 25px;
        }
        
        #our-values-{{ section_id }} .values-heading {
            margin-bottom: 30px;
        }
        
        #our-values-{{ section_id }} .values-heading h2 {
            font-size: {{ heading_size | minus: 8 }}px;
        }
        
        #our-values-{{ section_id }} .value-item .item-title {
            font-size: {{ item_title_size | minus: 2 }}px;
        }
        
        #our-values-{{ section_id }} .value-item .item-description {
            font-size: {{ item_desc_size | minus: 1 }}px;
        }
        
        #our-values-{{ section_id }} .values-grid .value-item::after {
            display: none !important;
        }
        
        {% if columns_mobile == '1' and enable_separator %}
        #our-values-{{ section_id }} .values-grid .value-item:not(:last-child) {
            border-bottom: 1px solid {{ separator_color }};
            padding-bottom: 25px;
        }
        {% endif %}
    }
</style>

<section id="our-values-{{ section_id }}" class="our-values-section">
    <div class="values-container">
        {%- if heading != blank -%}
            <div class="values-heading">
                <h2>{{ heading }}</h2>
            </div>
        {%- endif -%}
        
        <div class="values-grid">
            {%- if section.blocks.size > 0 -%}
                {%- for block in section.blocks -%}
                    <div class="value-item" {{ block.shopify_attributes }}>
                        {%- if block.settings.title != blank -%}
                            <h3 class="item-title">{{ block.settings.title }}</h3>
                        {%- endif -%}
                        
                        {%- if block.settings.description != blank -%}
                            <p class="item-description">{{ block.settings.description }}</p>
                        {%- endif -%}
                    </div>
                {%- endfor -%}
            {%- else -%}
                <!-- Default content when no blocks added -->
                <div class="value-item">
                    <h3 class="item-title">Reliability</h3>
                    <p class="item-description">We value reliability. Through our strategic location, our logistic network, and our own large fleet of in-house delivery trucks, we have an exceptional record for delivering on time.</p>
                </div>
                <div class="value-item">
                    <h3 class="item-title">Innovation</h3>
                    <p class="item-description">We strive to always do better. We are always on the lookout for new innovative solutions for our client's cleaning requirements.</p>
                </div>
                <div class="value-item">
                    <h3 class="item-title">Quality</h3>
                    <p class="item-description">We understand the importance of quality. That is why every piece of equipment we provide has been sampled, tested, and handpicked by our team.</p>
                </div>
                <div class="value-item">
                    <h3 class="item-title">Expertise</h3>
                    <p class="item-description">Our expertise is unmatched. Every member of our service team receives extensive training on new equipment so that they can answer your questions and offer solutions.</p>
                </div>
            {%- endif -%}
        </div>
    </div>
</section>

{% schema %}
{
    "name": "Our Values",
    "tag": "section",
    "class": "our-values-block",
    "settings": [
        {
            "type": "header",
            "content": "Section Settings"
        },
        {
            "type": "text",
            "id": "heading",
            "label": "Section Heading",
            "default": "Our Values"
        },
        {
            "type": "color",
            "id": "heading_color",
            "label": "Heading Color",
            "default": "#232323"
        },
        {
            "type": "range",
            "id": "heading_size",
            "label": "Heading Font Size",
            "min": 20,
            "max": 50,
            "step": 1,
            "unit": "px",
            "default": 32
        },
        {
            "type": "color",
            "id": "bg_color",
            "label": "Background Color",
            "default": "#f8f8f8"
        },
        {
            "type": "select",
            "id": "container",
            "label": "Container Width",
            "default": "1170",
            "options": [
                {"value": "1170", "label": "1170px"},
                {"value": "1370", "label": "1370px"},
                {"value": "1570", "label": "1570px"}
            ]
        },
        {
            "type": "header",
            "content": "Layout Settings"
        },
        {
            "type": "range",
            "id": "columns_desktop",
            "label": "Columns (Desktop)",
            "min": 2,
            "max": 6,
            "step": 1,
            "default": 4
        },
        {
            "type": "select",
            "id": "columns_tablet",
            "label": "Columns (Tablet)",
            "default": "2",
            "options": [
                {"value": "1", "label": "1"},
                {"value": "2", "label": "2"},
                {"value": "3", "label": "3"},
                {"value": "4", "label": "4"}
            ]
        },
        {
            "type": "select",
            "id": "columns_mobile",
            "label": "Columns (Mobile)",
            "default": "1",
            "options": [
                {"value": "1", "label": "1"},
                {"value": "2", "label": "2"}
            ]
        },
        {
            "type": "range",
            "id": "item_gap",
            "label": "Gap Between Items",
            "min": 0,
            "max": 60,
            "step": 5,
            "unit": "px",
            "default": 30
        },
        {
            "type": "select",
            "id": "text_align",
            "label": "Text Alignment",
            "default": "center",
            "options": [
                {"value": "left", "label": "Left"},
                {"value": "center", "label": "Center"},
                {"value": "right", "label": "Right"}
            ]
        },
        {
            "type": "header",
            "content": "Separator / Border"
        },
        {
            "type": "checkbox",
            "id": "enable_separator",
            "label": "Enable Vertical Separator Lines",
            "default": true
        },
        {
            "type": "color",
            "id": "separator_color",
            "label": "Separator Color",
            "default": "#e0e0e0"
        },
        {
            "type": "checkbox",
            "id": "enable_border",
            "label": "Enable Item Border (Box Style)",
            "default": false
        },
        {
            "type": "color",
            "id": "border_color",
            "label": "Border Color",
            "default": "#e0e0e0"
        },
        {
            "type": "header",
            "content": "Item Title Settings"
        },
        {
            "type": "color",
            "id": "item_title_color",
            "label": "Title Color",
            "default": "#232323"
        },
        {
            "type": "range",
            "id": "item_title_size",
            "label": "Title Font Size",
            "min": 14,
            "max": 30,
            "step": 1,
            "unit": "px",
            "default": 18
        },
        {
            "type": "header",
            "content": "Item Description Settings"
        },
        {
            "type": "color",
            "id": "item_desc_color",
            "label": "Description Color",
            "default": "#666666"
        },
        {
            "type": "range",
            "id": "item_desc_size",
            "label": "Description Font Size",
            "min": 12,
            "max": 20,
            "step": 1,
            "unit": "px",
            "default": 14
        },
        {
            "type": "header",
            "content": "Padding Settings"
        },
        {
            "type": "range",
            "id": "padding_top",
            "label": "Padding Top (Desktop)",
            "min": 0,
            "max": 100,
            "step": 5,
            "unit": "px",
            "default": 60
        },
        {
            "type": "range",
            "id": "padding_bottom",
            "label": "Padding Bottom (Desktop)",
            "min": 0,
            "max": 100,
            "step": 5,
            "unit": "px",
            "default": 60
        },
        {
            "type": "range",
            "id": "padding_top_mobile",
            "label": "Padding Top (Mobile)",
            "min": 0,
            "max": 80,
            "step": 5,
            "unit": "px",
            "default": 40
        },
        {
            "type": "range",
            "id": "padding_bottom_mobile",
            "label": "Padding Bottom (Mobile)",
            "min": 0,
            "max": 80,
            "step": 5,
            "unit": "px",
            "default": 40
        }
    ],
    "blocks": [
        {
            "type": "value_item",
            "name": "Value Item",
            "settings": [
                {
                    "type": "text",
                    "id": "title",
                    "label": "Title",
                    "default": "Reliability"
                },
                {
                    "type": "textarea",
                    "id": "description",
                    "label": "Description",
                    "default": "We value reliability. Through our strategic location, our logistic network, and our own large fleet of in-house delivery trucks, we have an exceptional record for delivering on time."
                }
            ]
        }
    ],
    "presets": [
        {
            "name": "Our Values",
            "blocks": [
                {
                    "type": "value_item",
                    "settings": {
                        "title": "Reliability",
                        "description": "We value reliability. Through our strategic location, our logistic network, and our own large fleet of in-house delivery trucks, we have an exceptional record for delivering on time."
                    }
                },
                {
                    "type": "value_item",
                    "settings": {
                        "title": "Innovation",
                        "description": "We strive to always do better. We are always on the lookout for new innovative solutions for our client's cleaning requirements."
                    }
                },
                {
                    "type": "value_item",
                    "settings": {
                        "title": "Quality",
                        "description": "We understand the importance of quality. That is why every piece of equipment we provide has been sampled, tested, and handpicked by our team."
                    }
                },
                {
                    "type": "value_item",
                    "settings": {
                        "title": "Expertise",
                        "description": "Our expertise is unmatched. Every member of our service team receives extensive training on new equipment so that they can answer your questions and offer solutions."
                    }
                }
            ]
        }
    ]
}
{% endschema %}