<div class="categories-mega-menu-wrapper section-{{ section.id }}">
  <!-- Mobile Hamburger Button -->
  <button class="mobile-menu-toggle" id="mobile-toggle-{{ section.id }}" aria-label="Open menu">
    <span class="mobileMenu-toggle__Icon"></span>
  </button>

  <!-- Mobile Menu Overlay -->
  <div class="mobile-menu-overlay" id="mobile-overlay-{{ section.id }}"></div>

  <!-- Mobile Drawer Menu -->
  <div class="mobile-drawer" id="mobile-drawer-{{ section.id }}">
    <button class="mobile-drawer-close" id="mobile-close-{{ section.id }}" aria-label="Close menu">
      <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
        <line x1="18" y1="6" x2="6" y2="18"></line>
        <line x1="6" y1="6" x2="18" y2="18"></line>
      </svg>
    </button>

    <div class="mobile-drawer-content">
      <div class="mobile-section">
        <h3 class="mobile-section-title">{{ section.settings.button_text | default: 'Categories' }}</h3>
        <ul class="mobile-menu-list" id="mobile-menu-{{ section.id }}">
          {%- for block in section.blocks -%}
            {%- if block.type == 'menu_item' and block.settings.link != blank -%}
              <li class="mobile-item"><div class="mobile-item-wrap"><a href="{{ block.settings.link }}" class="mobile-link">{{ block.settings.title }}</a></div></li>
            {%- endif -%}
          {%- endfor -%}
        </ul>
      </div>

      {%- if section.settings.show_main_nav -%}
        <div class="mobile-section">
          <h3 class="mobile-section-title">{{ section.settings.nav_mobile_title | default: 'Menu' }}</h3>
          <ul class="mobile-menu-list" id="mobile-nav-{{ section.id }}">
            {%- for block in section.blocks -%}
              {%- if block.type == 'nav_item' or block.type == 'nav_dropdown' -%}
                {%- if block.settings.link != blank -%}
                  <li class="mobile-item"><div class="mobile-item-wrap"><a href="{{ block.settings.link }}" class="mobile-link">{{ block.settings.title }}</a></div></li>
                {%- endif -%}
              {%- endif -%}
            {%- endfor -%}
          </ul>
        </div>
      {%- endif -%}
    </div>
  </div>

  <div class="container container-{{ section.settings.container }}">
    <div class="categories-mega-menu {% if request.page_type == 'index' %}is-open{% endif %}" id="mega-menu-{{ section.id }}">
      <div class="categories-button" id="categories-btn-{{ section.id }}">
        <span class="categories-text">{{ section.settings.button_text }}</span>
        <span class="categories-icon">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <line x1="3" y1="6" x2="21" y2="6"></line>
            <line x1="3" y1="12" x2="21" y2="12"></line>
            <line x1="3" y1="18" x2="21" y2="18"></line>
          </svg>
        </span>
      </div>

      <div class="categories-dropdown">
        <div class="categories-menu-left" id="desktop-menu-{{ section.id }}">
          {%- for block in section.blocks -%}
            {%- if block.type == 'menu_item' and block.settings.link != blank -%}
              <a href="{{ block.settings.link }}" class="ssr-link">{{ block.settings.title }}</a>
            {%- endif -%}
          {%- endfor -%}
        </div>
      </div>
    </div>

    {%- if section.settings.show_main_nav -%}
      <nav class="main-nav-horizontal" id="main-nav-{{ section.id }}">
        {%- for block in section.blocks -%}
          {%- if block.type == 'nav_item' or block.type == 'nav_dropdown' -%}
            {%- if block.settings.link != blank -%}
              <a href="{{ block.settings.link }}" class="ssr-link">{{ block.settings.title }}</a>
            {%- endif -%}
          {%- endif -%}
        {%- endfor -%}
      </nav>
    {%- endif -%}
  </div>
</div>

<script type="application/json" id="menu-data-{{ section.id }}">
{
  "categories": [
    {%- assign first_cat = true -%}
    {%- for block in section.blocks -%}
      {%- if block.type == 'menu_item' -%}
        {%- unless first_cat -%},{%- endunless -%}
        {
          "level": {{ block.settings.level | default: 1 }},
          "title": {{ block.settings.title | json }},
          "link": "{{ block.settings.link | default: '#' }}",
          "icon": "{% if block.settings.icon_image != blank %}{{ block.settings.icon_image | image_url: width: 48 }}{% endif %}",
          "image": "{% if block.settings.menu_image != blank %}{{ block.settings.menu_image | image_url: width: 200 }}{% endif %}",
          "style": "{{ block.settings.submenu_style | default: 'simple' }}"
        }
        {%- assign first_cat = false -%}
      {%- endif -%}
    {%- endfor -%}
  ],
  "nav": [
    {%- assign first_nav = true -%}
    {%- for block in section.blocks -%}
      {%- if block.type == 'nav_item' or block.type == 'nav_dropdown' -%}
        {%- unless first_nav -%},{%- endunless -%}
        {
          "type": "{{ block.type }}",
          "title": {{ block.settings.title | json }},
          "link": "{{ block.settings.link | default: '#' }}",
          "image": "{% if block.settings.nav_image != blank %}{{ block.settings.nav_image | image_url: width: 300 }}{% endif %}"
        }
        {%- assign first_nav = false -%}
      {%- endif -%}
    {%- endfor -%}
  ]
}
</script>

<style>
.section-{{ section.id }} .ssr-link {
  display: inline-block;
  padding: 4px 8px;
  font-size: 13px;
  color: {{ section.settings.menu_text | default: '#333' }};
  text-decoration: none;
}
.section-{{ section.id }} {
  --button-bg: {{ section.settings.button_bg }};
  --button-color: {{ section.settings.button_color }};
  --menu-bg: {{ section.settings.menu_bg }};
  --menu-text: {{ section.settings.menu_text }};
  --menu-hover-bg: {{ section.settings.menu_hover_bg }};
  --menu-hover-text: {{ section.settings.menu_hover_text }};
  --dropdown-width: {{ section.settings.dropdown_width }}px;
  --icon-size: {{ section.settings.menu_icon_size }}px;
  --mega-width: {{ section.settings.mega_panel_width }}px;
  --mobile-menu-bg: {{ section.settings.mobile_menu_bg | default: '#ffffff' }};
  --mobile-close-bg: {{ section.settings.mobile_close_bg | default: '#6fb31a' }};
  --nav-text: {{ section.settings.nav_text_color }};
  --nav-hover: {{ section.settings.nav_hover_color }};
}

.section-{{ section.id }} .header-mobile__item--menu {
  --i-color: var(--color-text, #222222);
  color: var(--i-color);
}

.section-{{ section.id }} .header-mobile__item--menu .mobileMenu-toggle__Icon,
.section-{{ section.id }} .header-mobile__item--menu .mobileMenu-toggle__Icon::before,
.section-{{ section.id }} .header-mobile__item--menu .mobileMenu-toggle__Icon::after {
  background-color: currentColor;
}

.header-mobile .mobile-menu-toggle.mobile-menu-toggle--header {
  display: flex;
  align-items: center;
  justify-content: center;
}

.header-mobile .header-mobile__item--menu,
.header-mobile .header-mobile__item--menu .header-mobile--icon {
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 44px;
  min-height: 44px;
}

.header-mobile .header-mobile__item--menu .mobile-menu-toggle--header {
  display: block;
  width: 24px;
  height: 24px;
  position: relative;
  padding: 0;
  border: 0;
  background: none;
}

.header-mobile .header-mobile__item--menu .mobile-menu-toggle--header .mobileMenu-toggle__Icon,
.header-mobile .header-mobile__item--menu .mobile-menu-toggle--header .mobileMenu-toggle__Icon::before,
.header-mobile .header-mobile__item--menu .mobile-menu-toggle--header .mobileMenu-toggle__Icon::after {
  content: "";
  display: block;
  height: 2px;
  width: 100%;
  position: absolute;
  background-color: currentColor;
}

.header-mobile .header-mobile__item--menu .mobile-menu-toggle--header .mobileMenu-toggle__Icon {
  top: 50%;
  transform: translateY(-50%);
}

.header-mobile .header-mobile__item--menu .mobile-menu-toggle--header .mobileMenu-toggle__Icon::before {
  top: -8px;
}

.header-mobile .header-mobile__item--menu .mobile-menu-toggle--header .mobileMenu-toggle__Icon::after {
  bottom: -8px;
}

.section-{{ section.id }} .mobile-menu-toggle {
  display: none;
  align-items: center;
  justify-content: center;
  width: 44px;
  height: 44px;
  background: var(--button-bg);
  color: var(--button-color);
  border: none;
  border-radius: 6px;
  cursor: pointer;
}
.section-{{ section.id }} .mobile-menu-toggle.mobile-menu-toggle--header {
  width: 32px;
  height: 32px;
  background: transparent;
  color: inherit;
  border-radius: 0;
}
.section-{{ section.id }} .mobile-menu-toggle.mobile-menu-toggle--header svg {
  width: 20px;
  height: 20px;
}
.header-mobile .mobile-menu-toggle {
  width: 32px;
  height: 32px;
  background: transparent;
  color: inherit;
  border-radius: 0;
}

.section-{{ section.id }} .mobile-menu-overlay {
  display: none;
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: rgba(0,0,0,0.5);
  z-index: 99998;
}
.section-{{ section.id }} .mobile-menu-overlay.is-active {
  display: block;
}

.section-{{ section.id }} .mobile-drawer {
  position: fixed;
  top: 0;
  left: -100%;
  width: 320px;
  max-width: 85vw;
  height: 100%;
  background: var(--mobile-menu-bg);
  z-index: 99999;
  transition: left 0.3s ease;
  box-shadow: 5px 0 25px rgba(0,0,0,0.15);
  display: flex;
  flex-direction: column;
}
.section-{{ section.id }} .mobile-drawer.is-open {
  left: 0;
}
.section-{{ section.id }} .mobile-drawer-close {
  position: absolute;
  top: 10px;
  right: -50px;
  width: 40px;
  height: 40px;
  background: var(--mobile-close-bg);
  color: #fff;
  border: none;
  border-radius: 6px;
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
}
.section-{{ section.id }} .mobile-drawer-content {
  flex: 1;
  overflow-y: auto;
  padding: 20px 0;
}
.section-{{ section.id }} .mobile-section {
  margin-bottom: 15px;
}
.section-{{ section.id }} .mobile-section-title {
  font-size: 18px;
  font-weight: 700;
  color: #1a1a2e;
  padding: 15px 20px 10px;
  margin: 0;
  border-bottom: 1px solid #eee;
}
.section-{{ section.id }} .mobile-menu-list {
  list-style: none;
  padding: 0;
  margin: 0;
}
.section-{{ section.id }} .mobile-item {
  border-bottom: 1px solid #f0f0f0;
}
.section-{{ section.id }} .mobile-item-wrap {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.section-{{ section.id }} .mobile-link {
  flex: 1;
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 14px 20px;
  color: #333;
  text-decoration: none;
  font-size: 15px;
}
.section-{{ section.id }} .mobile-link img {
  width: 24px;
  height: 24px;
  object-fit: contain;
}
.section-{{ section.id }} .mobile-toggle {
  width: 44px;
  height: 44px;
  background: transparent;
  border: none;
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #999;
  font-size: 20px;
  font-weight: 300;
}
.section-{{ section.id }} .mobile-children {
  display: none;
  list-style: none;
  padding: 0;
  margin: 0;
}
.section-{{ section.id }} .mobile-item.open > .mobile-children {
  display: block;
}
.section-{{ section.id }} .mobile-item.open > .mobile-item-wrap .mobile-toggle {
  transform: rotate(45deg);
}
.section-{{ section.id }} .mobile-children .mobile-link {
  padding-left: 40px;
  font-size: 14px;
  color: #555;
  background: #f9f9f9;
}
.section-{{ section.id }} .mobile-children .mobile-children .mobile-link {
  padding-left: 55px;
  font-size: 13px;
  color: #666;
  background: #f3f3f3;
}
.section-{{ section.id }} .mobile-children .mobile-children .mobile-children .mobile-link {
  padding-left: 70px;
  font-size: 12px;
  color: #777;
  background: #ededed;
}
.section-{{ section.id }} .mobile-link:hover {
  color: var(--menu-hover-text);
}

/* Desktop */
.section-{{ section.id }} .categories-mega-menu-wrapper {
  position: relative;
  z-index: 9999;
}
.section-{{ section.id }} .container {
  display: flex;
  align-items: center;
}
.section-{{ section.id }} .categories-mega-menu {
  position: relative;
  display: inline-block;
}
.section-{{ section.id }} .categories-button {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 15px;
  min-width: {{ section.settings.button_min_width }}px;
  padding: {{ section.settings.button_padding_y }}px {{ section.settings.button_padding_x }}px;
  background: var(--button-bg);
  color: var(--button-color);
  border-radius: {{ section.settings.button_radius }}px {{ section.settings.button_radius }}px 0 0;
  cursor: pointer;
  font-size: {{ section.settings.button_font_size }}px;
  font-weight: {{ section.settings.button_font_weight }};
  transition: all 0.3s ease;
}
.section-{{ section.id }} .categories-button:hover {
  background: {{ section.settings.button_hover_bg }};
}
.section-{{ section.id }} .categories-icon svg {
  width: 24px;
  height: 24px;
}
.section-{{ section.id }} .categories-dropdown {
  position: absolute;
  top: 100%;
  left: 0;
  opacity: 0;
  visibility: hidden;
  transform: translateY(10px);
  transition: all 0.3s ease;
  z-index: 9999;
}
.section-{{ section.id }} .categories-mega-menu.is-open .categories-dropdown {
  opacity: 1;
  visibility: visible;
  transform: translateY(0);
}
.section-{{ section.id }} .categories-menu-left {
  width: var(--dropdown-width);
  background: var(--menu-bg);
  border-radius: 0 0 8px 8px;
  box-shadow: 0 10px 40px rgba(0,0,0,0.15);
  max-height: 70vh;
  {% comment %} overflow-y: auto; {% endcomment %}
}

/* Desktop Menu Items */
.section-{{ section.id }} .desk-item {
  position: relative;
  border-bottom: 1px solid #f0f0f0;
}
.section-{{ section.id }} .desk-item:last-child {
  border-bottom: none;
}
.section-{{ section.id }} .desk-link {
  display: flex;
  align-items: center;
  gap: 12px;
  padding: {{ section.settings.menu_item_padding }}px 20px;
  color: var(--menu-text);
  text-decoration: none;
  font-size: {{ section.settings.menu_font_size }}px;
  transition: all 0.2s ease;
}
.section-{{ section.id }} .desk-item:hover > .desk-link {
  background: var(--menu-hover-bg);
  color: var(--menu-hover-text);
}
.section-{{ section.id }} .desk-icon {
  width: var(--icon-size);
  height: var(--icon-size);
  display: flex;
  align-items: center;
  justify-content: center;
}
.section-{{ section.id }} .desk-icon img {
  width: 100%;
  height: 100%;
  object-fit: contain;
}
.section-{{ section.id }} .desk-text {
  flex: 1;
}
.section-{{ section.id }} .desk-arrow {
  opacity: 0.4;
  transition: all 0.2s ease;
}
.section-{{ section.id }} .desk-item:hover > .desk-link .desk-arrow {
  opacity: 1;
  transform: translateX(3px);
}

/* Simple Flyout Submenu */
.section-{{ section.id }} .desk-flyout {
  position: absolute;
  left: 100%;
  top: 0;
  min-width: 220px;
  background: #fff;
  border-radius: 0 8px 8px 0;
  box-shadow: 5px 5px 30px rgba(0,0,0,0.12);
  list-style: none;
  padding: 8px 0;
  margin: 0;
  opacity: 0;
  visibility: hidden;
  pointer-events: none;
  transition: opacity 0.2s ease, visibility 0.2s ease;
  z-index: 10000;
  {% comment %} max-height: 70vh;
  overflow-y: auto; {% endcomment %}
}
.section-{{ section.id }} .desk-flyout::before {
  content: '';
  position: absolute;
  left: -15px;
  top: 0;
  width: 20px;
  height: 100%;
}
.section-{{ section.id }} .desk-item.has-kids:hover > .desk-flyout {
  opacity: 1;
  visibility: visible;
  pointer-events: auto;
}
.section-{{ section.id }} .desk-flyout .desk-item {
  border-bottom: none;
}
.section-{{ section.id }} .desk-flyout .desk-link {
  padding: 10px 18px;
  font-size: 14px;
}
.section-{{ section.id }} .desk-flyout .desk-flyout {
  z-index: 10001;
}
.section-{{ section.id }} .desk-flyout .desk-flyout .desk-flyout {
  z-index: 10002;
}

/* Mega Panel Submenu */
.section-{{ section.id }} .desk-mega {
  position: absolute;
  left: 100%;
  top: 0;
  width: 1080px;
  background: #fff;
  border-radius: 0 8px 8px 0;
  box-shadow: 5px 5px 30px rgba(0,0,0,0.12);
  padding: 25px;
  opacity: 0;
  visibility: hidden;
  pointer-events: none;
  transition: opacity 0.2s ease, visibility 0.2s ease;
  z-index: 10000;
  max-height: 80vh;
  overflow-y: auto;
}
.section-{{ section.id }} .desk-mega::before {
  content: '';
  position: absolute;
  left: -15px;
  top: 0;
  width: 20px;
  height: 100%;
}
.section-{{ section.id }} .desk-item.has-mega:hover > .desk-mega {
  opacity: 1;
  visibility: visible;
  pointer-events: auto;
}
.section-{{ section.id }} .mega-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(160px, 1fr));
  gap: 25px;
}
.section-{{ section.id }} .mega-col {
  min-width: 0;
}
.section-{{ section.id }} .mega-col-img {
  width: 100%;
  height: 100px;
  background: #ffffff;
  border-radius: 6px;
  overflow: hidden;
  margin-bottom: 10px;
  display: flex;
  align-items: center;
  justify-content: center;
}
.section-{{ section.id }} .mega-col-img img {
  max-width: 90%;
  max-height: 90%;
  object-fit: contain;
}
.section-{{ section.id }} .mega-col-img a {
  display: flex;
  width: 100%;
  height: 100%;
  align-items: center;
  justify-content: center;
}
.section-{{ section.id }} .mega-col-title {
  font-size: 13px;
  font-weight: 700;
  margin: -20px 0 -13px 0;
}
.section-{{ section.id }} .mega-col-title a {
  color: #1a1a2e;
  text-decoration: none;
}
.section-{{ section.id }} .mega-col-title a:hover {
  color: var(--menu-hover-text);
}
.section-{{ section.id }} .mega-col-links {
  list-style: none;
  padding: 0;
  margin: 0;
}
.section-{{ section.id }} .mega-col-links li {
  margin: 0;
}
.section-{{ section.id }} .mega-col-links a {
  display: block;
  padding: 4px 0;
  font-size: 13px;
  color: #666;
  text-decoration: none;
}
.section-{{ section.id }} .mega-col-links a:hover {
  color: var(--menu-hover-text);
}

/* Horizontal Navigation */
.section-{{ section.id }} .main-nav-horizontal {
  display: flex;
  align-items: center;
  gap: {{ section.settings.nav_gap }}px;
  margin-left: {{ section.settings.nav_margin_left }}px;
  flex-wrap: wrap;
}
.section-{{ section.id }} .nav-item-wrap {
  position: relative;
}
.section-{{ section.id }} .nav-link {
  display: flex;
  align-items: center;
  gap: 5px;
  padding: 10px 0;
  color: var(--nav-text);
  text-decoration: none;
  font-size: {{ section.settings.nav_font_size }}px;
  font-weight: {{ section.settings.nav_font_weight }};
  white-space: nowrap;
  transition: color 0.2s ease;
}
.section-{{ section.id }} .nav-link:hover {
