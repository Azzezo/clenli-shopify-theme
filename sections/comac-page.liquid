{% comment %}
  Clenli Direct - Comac Floor Scrubber Dryers Page
  Complete single section for Comac landing page
{% endcomment %}

<div class="comac-page">
  <!-- Hero Section -->
  <section class="comac-hero">
    <div class="comac-container">
      <div class="comac-hero__grid">
        <div class="comac-hero__image">
          {% if section.settings.hero_image != blank %}
            <img
              src="{{ section.settings.hero_image | image_url: width: 800 }}"
              alt="{{ section.settings.hero_title }}"
            >
          {% else %}
            <img
              src="https://clenlidirect.com/media/.renditions/wysiwyg/Comaacccc.png"
              alt="Comac Floor Scrubber Dryers"
            >
          {% endif %}
        </div>
        <div class="comac-hero__content">
          <span class="comac-tag">{{ section.settings.hero_tag }}</span>
          <h1 class="comac-hero__title">{{ section.settings.hero_title }}</h1>
          <p class="comac-text">{{ section.settings.hero_desc }}</p>

          <div class="comac-features">
            <div class="comac-feature">
              <strong>{{ section.settings.feature1_title }}</strong>
              <p>{{ section.settings.feature1_text }}</p>
            </div>
            <div class="comac-feature">
              <strong>{{ section.settings.feature2_title }}</strong>
              <p>{{ section.settings.feature2_text }}</p>
            </div>
            <div class="comac-feature">
              <strong>{{ section.settings.feature3_title }}</strong>
              <p>{{ section.settings.feature3_text }}</p>
            </div>
          </div>

          <a href="{{ section.settings.hero_btn_link }}" class="comac-btn">{{ section.settings.hero_btn_text }}</a>
        </div>
      </div>
    </div>
  </section>
  <hr class="imop-divider">

  <!-- About Comac Section -->
  <section class="comac-info">
    <div class="comac-container">
      <div class="comac-info__grid">
        <div class="comac-info__content comac-info__content--center">
          <h2 class="comac-subtitle">{{ section.settings.about_title }}</h2>
          <p class="comac-text">{{ section.settings.about_text }}</p>
        </div>
        <div class="comac-info__image">
          {% if section.settings.about_image != blank %}
            <img
              src="{{ section.settings.about_image | image_url: width: 800 }}"
              alt="{{ section.settings.about_title }}"
            >
          {% else %}
            <img
              src="https://clenlidirect.com/media/.renditions/wysiwyg/Bootstrap_Images_178910_.png"
              alt="About Comac"
            >
          {% endif %}
        </div>
      </div>
    </div>
  </section>
  <hr class="imop-divider">

  <!-- Carbon Passports Section -->
  <section class="comac-info">
    <div class="comac-container">
      <div class="comac-info__grid comac-info__grid--reverse">
        <div class="comac-info__content comac-info__content--center">
          <h2 class="comac-subtitle">{{ section.settings.carbon_title }}</h2>
          <p class="comac-text">{{ section.settings.carbon_text }}</p>
        </div>
        <div class="comac-info__image">
          {% if section.settings.carbon_image != blank %}
            <img
              src="{{ section.settings.carbon_image | image_url: width: 800 }}"
              alt="{{ section.settings.carbon_title }}"
            >
          {% else %}
            <img
              src="https://clenlidirect.com/media/.renditions/wysiwyg/Bootstrap_Images_20_.png"
              alt="Carbon Passports"
            >
          {% endif %}
        </div>
      </div>
    </div>
  </section>
  <hr class="imop-divider">

  <!-- Sustainable Technologies Section -->
  <section class="comac-tech">
    <div class="comac-container">
      <h2 class="comac-section-title">{{ section.settings.tech_title }}</h2>
      <p class="comac-section-subtitle">{{ section.settings.tech_text }}</p>

      <!-- Row 1: 4 items -->
      <div class="comac-tech__grid comac-tech__grid--4">
        <div class="comac-tech-card">
          <div class="comac-tech-card__img">
            {% if section.settings.tech1_image != blank %}
              <img
                src="{{ section.settings.tech1_image | image_url: width: 400 }}"
                alt="{{ section.settings.tech1_title }}"
              >
            {% else %}
              <img src="https://clenlidirect.com/media/.renditions/wysiwyg/A.png" alt="Eco Mode">
            {% endif %}
          </div>
          <h3>{{ section.settings.tech1_title }}</h3>
          <p>{{ section.settings.tech1_text }}</p>
        </div>
        <div class="comac-tech-card">
          <div class="comac-tech-card__img">
            {% if section.settings.tech2_image != blank %}
              <img
                src="{{ section.settings.tech2_image | image_url: width: 400 }}"
                alt="{{ section.settings.tech2_title }}"
              >
            {% else %}
              <img src="https://clenlidirect.com/media/.renditions/wysiwyg/B.png" alt="Stop & Go System">
            {% endif %}
          </div>
          <h3>{{ section.settings.tech2_title }}</h3>
          <p>{{ section.settings.tech2_text }}</p>
        </div>
        <div class="comac-tech-card">
          <div class="comac-tech-card__img">
            {% if section.settings.tech3_image != blank %}
              <img
                src="{{ section.settings.tech3_image | image_url: width: 400 }}"
                alt="{{ section.settings.tech3_title }}"
              >
            {% else %}
              <img src="https://clenlidirect.com/media/.renditions/wysiwyg/C.png" alt="LED Lights">
            {% endif %}
          </div>
          <h3>{{ section.settings.tech3_title }}</h3>
          <p>{{ section.settings.tech3_text }}</p>
        </div>
        <div class="comac-tech-card">
          <div class="comac-tech-card__img">
            {% if section.settings.tech4_image != blank %}
              <img
                src="{{ section.settings.tech4_image | image_url: width: 400 }}"
