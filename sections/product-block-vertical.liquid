        </div>
        
    </div>
</section>

{% schema %}
{
    "name": "Product Columns",
    "settings": [
        {
            "type": "header",
            "content": "Column 1 - Featured Products"
        },
        {
            "type": "text",
            "id": "featured_title",
            "label": "Heading",
            "default": "Featured Products"
        },
        {
            "type": "collection",
            "id": "featured_collection",
            "label": "Select Collection"
        },
        {
            "type": "header",
            "content": "Column 2 - New Products"
        },
        {
            "type": "text",
            "id": "new_title",
            "label": "Heading",
            "default": "New Products"
        },
        {
            "type": "collection",
            "id": "new_collection",
            "label": "Select Collection"
        },
        {
            "type": "header",
            "content": "Column 3 - Best Seller"
        },
        {
            "type": "text",
            "id": "bestseller_title",
            "label": "Heading",
            "default": "Best Seller"
        },
        {
