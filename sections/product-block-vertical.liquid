{%- liquid
    assign featured_collection = section.settings.featured_collection
    assign new_collection = section.settings.new_collection
    assign bestseller_collection = section.settings.bestseller_collection
    assign products_to_show = section.settings.products_to_show
-%}

<style>
    .product-columns-{{ section.id }} {
        padding: {{ section.settings.padding_y }}px {{ section.settings.padding_x }}px;
        margin-top: {{ section.settings.margin_top }}px;
        background: #ffffff;
        width: 100%;
    }
    
    .product-columns-{{ section.id }} .columns-container {
        width: 100%;
        max-width: 1570px;
        margin: 0 auto;
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 40px;
        box-sizing: border-box;
    }
    
    /* Column - Border Removed */
    .product-columns-{{ section.id }} .product-column {
        background: transparent;
        padding: 20px;
        border: none;
        box-shadow: none;
    }
    
    /* Column Heading - Green Underline */
    .product-columns-{{ section.id }} .column-heading {
        font-size: 18px;
        font-weight: 700;
        color: #333;
        margin: 0 0 20px 0;
        padding-bottom: 10px;
        border-bottom: 3px solid #6fb31a;
        display: inline-block;
    }
    
    /* Products List */
    .product-columns-{{ section.id }} .products-list {
        display: flex;
        flex-direction: column;
        gap: 20px;
    }
    
    /* Product Item */
    .product-columns-{{ section.id }} .product-item {
        display: flex;
        gap: 15px;
        padding-bottom: 20px;
        border-bottom: 1px solid #eee;
    }
    
    .product-columns-{{ section.id }} .product-item:last-child {
        border-bottom: none;
        padding-bottom: 0;
    }
    
    /* Product Image */
    .product-columns-{{ section.id }} .product-image {
        width: 80px;
        height: 80px;
        flex-shrink: 0;
        background: #f9f9f9;
        border-radius: 4px;
        overflow: hidden;
    }
    
    .product-columns-{{ section.id }} .product-image img {
        width: 100%;
        height: 100%;
        object-fit: contain;
        padding: 5px;
    }
    
    .product-columns-{{ section.id }} .product-image a {
        display: block;
        width: 100%;
        height: 100%;
    }
    
    /* Product Info */
    .product-columns-{{ section.id }} .product-info {
        flex: 1;
        min-width: 0;
    }
    
    .product-columns-{{ section.id }} .product-title {
        font-size: 14px;
        font-weight: 600;
        color: #333;
        margin: 0 0 5px 0;
        line-height: 1.3;
    }
    
    .product-columns-{{ section.id }} .product-title a {
        color: inherit;
        text-decoration: none;
    }
    
    .product-columns-{{ section.id }} .product-title a:hover {
        color: #6fb31a;
    }
    
    /* Stars Rating - Yellow, No Border */
    .product-columns-{{ section.id }} .stars {
        display: flex;
        gap: 2px;
        margin-bottom: 5px;
    }
    
    .product-columns-{{ section.id }} .stars svg {
        width: 16px;
        height: 16px;
        fill: #ffc107;
        stroke: none;
    }
    
    .product-columns-{{ section.id }} .stars svg path {
        stroke: none;
        fill: #ffc107;
    }
    
    /* View Details Link */
    .product-columns-{{ section.id }} .view-details {
        font-size: 13px;
        color: #6fb31a;
        text-decoration: none;
        display: inline-block;
        margin-bottom: 5px;
    }
    
    .product-columns-{{ section.id }} .view-details:hover {
        text-decoration: underline;
    }
    
    /* Price */
    .product-columns-{{ section.id }} .price-wrapper {
        display: flex;
        flex-direction: column;
        gap: 2px;
    }
    
    .product-columns-{{ section.id }} .price-row {
        display: flex;
        align-items: center;
        gap: 5px;
    }
    
    .product-columns-{{ section.id }} .price-incl {
        font-size: 14px;
        color: #e74c3c;
        font-weight: 600;
        text-decoration: line-through;
    }
    
    .product-columns-{{ section.id }} .price-label {
        font-size: 11px;
        color: #999;
    }
    
    .product-columns-{{ section.id }} .price-excl {
        font-size: 16px;
        color: #343f49;
        font-weight: 700;
    }
    
    /* Responsive */
    @media (max-width: 991px) {
        .product-columns-{{ section.id }} .columns-container {
            grid-template-columns: repeat(2, 1fr);
            gap: 30px;
        }
    }
    
    @media (max-width: 767px) {
        .product-columns-{{ section.id }} .columns-container {
            grid-template-columns: 1fr;
            gap: 30px;
            padding: 0 10px;
        }
        
        .product-columns-{{ section.id }} .product-image {
            width: 70px;
            height: 70px;
        }
    }
</style>

<section class="product-columns-{{ section.id }}">
    <div class="columns-container">
        
        <!-- Featured Products Column -->
        <div class="product-column">
            <h2 class="column-heading">{{ section.settings.featured_title }}</h2>
            <div class="products-list">
                {%- if featured_collection != blank -%}
                    {%- for product in collections[featured_collection].products limit: products_to_show -%}
                        <div class="product-item">
                            <div class="product-image">
                                <a href="{{ product.url }}">
                                    {%- if product.featured_image != blank -%}
                                        <img src="{{ product.featured_image | image_url: width: 200 }}" 
                                             alt="{{ product.title | escape }}" 
                                             loading="lazy">
                                    {%- else -%}
                                        {{ 'product-1' | placeholder_svg_tag }}
                                    {%- endif -%}
                                </a>
                            </div>
                            <div class="product-info">
                                <h3 class="product-title">
                                    <a href="{{ product.url }}">{{ product.title }}</a>
                                </h3>
                                <div class="stars">
                                    <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><polygon points="12,2 15.09,8.26 22,9.27 17,14.14 18.18,21.02 12,17.77 5.82,21.02 7,14.14 2,9.27 8.91,8.26" fill="#ffc107" stroke="none"/></svg>
                                    <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><polygon points="12,2 15.09,8.26 22,9.27 17,14.14 18.18,21.02 12,17.77 5.82,21.02 7,14.14 2,9.27 8.91,8.26" fill="#ffc107" stroke="none"/></svg>
                                    <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><polygon points="12,2 15.09,8.26 22,9.27 17,14.14 18.18,21.02 12,17.77 5.82,21.02 7,14.14 2,9.27 8.91,8.26" fill="#ffc107" stroke="none"/></svg>
                                    <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><polygon points="12,2 15.09,8.26 22,9.27 17,14.14 18.18,21.02 12,17.77 5.82,21.02 7,14.14 2,9.27 8.91,8.26" fill="#ffc107" stroke="none"/></svg>
                                    <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><polygon points="12,2 15.09,8.26 22,9.27 17,14.14 18.18,21.02 12,17.77 5.82,21.02 7,14.14 2,9.27 8.91,8.26" fill="#ffc107" stroke="none"/></svg>
                                </div>
                                {%- if product.price == 0 or product.compare_at_price == blank -%}
                                    <a href="{{ product.url }}" class="view-details">View Details</a>
                                {%- endif -%}
                                    <div class="price-wrapper">
                                    {%- if product.compare_at_price > product.price -%}
                                        <div class="price-row">
                                            <span class="price-incl price-item--vat price-item--vat-incl">{{ product.compare_at_price | money }}</span>
                                            <span class="price-label vat-label-incl">Incl. VAT</span>
                                        </div>
                                        <div class="price-row">
                                            <span class="price-excl price-item--vat price-item--vat-excl">{{ product.price | money }}</span>
                                            <span class="price-label vat-label-excl">Excl. VAT</span>
                                        </div>
                                    {%- elsif product.price > 0 -%}
                                        <div class="price-row">
                                            {%- assign price_excl_vat = product.price | divided_by: 1.23 -%}
