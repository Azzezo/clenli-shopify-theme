{{ 'section-footer.css' | asset_url | stylesheet_tag }}

<style>
  .footer-industrial {
    background-color: {{ section.settings.bg_color }};
    color: {{ section.settings.text_color }};
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
  }
  .footer-industrial a {
    color: {{ section.settings.link_color }};
    text-decoration: none;
    transition: color 0.3s ease;
  }
  .footer-industrial a:hover {
    color: {{ section.settings.link_hover_color }};
  }
  
  .footer-container {
    max-width: {{ section.settings.container_width }}px;
    margin: 0 auto;
    padding: 0 20px;
  }

  /* Footer Top - Main Content */
  .footer-top {
    padding: {{ section.settings.top_padding }}px 0 {{ section.settings.bottom_padding }}px;
    border-bottom: 1px solid {{ section.settings.border_color }};
  }
  
  .footer-grid {
    display: grid;
    grid-template-columns: 380px 1fr;
    gap: 40px;
    align-items: start;
  }

  .footer-menus-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
    gap: 30px;
  }
  
  @media (max-width: 1100px) {
    .footer-grid {
      grid-template-columns: 1fr;
      gap: 30px;
    }
  }
  @media (max-width: 600px) {
    .footer-menus-grid {
      grid-template-columns: 1fr 1fr;
    }
  }
  @media (max-width: 400px) {
    .footer-menus-grid {
      grid-template-columns: 1fr;
    }
  }

  /* Column 1: Logo & Contact */
  .footer-column-logo {
    padding-right: 20px;
    padding-left: 15px;
  }
  
  .footer-logo-row {
    display: flex;
    align-items: center;
    gap: 15px;
    margin-bottom: 30px;
  }
  .footer-logo {
    max-width: 210px;
  }
  .footer-logo img {
    width: 100%;
    height: auto;
  }
  .footer-tagline {
    font-size: 14px;
    line-height: 1.4;
    color: {{ section.settings.accent_color }};
    font-weight: 600;
  }

  /* Hotline Section */
  .footer-hotline {
    display: flex;
    align-items: center;
    gap: 15px;
    margin-bottom: 25px;
  }
  .footer-hotline-icon {
    width: 50px;
    height: 50px;
    flex-shrink: 0;
  }
  .footer-hotline-icon svg {
    width: 100%;
    height: 100%;
    fill: #999;
  }
  .footer-hotline-content {
    display: flex;
    flex-direction: column;
  }
  .footer-hotline-label {
    font-size: 13px;
    color: #666;
    margin-bottom: 3px;
  }
  .footer-hotline-number {
    font-size: 20px;
    font-weight: 700;
    color: {{ section.settings.accent_color }};
    text-decoration: none;
  }
  .footer-hotline-number:hover {
    color: {{ section.settings.link_hover_color }};
  }

  /* Contact Info */
  .footer-contact-title {
    font-size: 14px;
    font-weight: 700;
    color: #333;
    margin: 0 0 8px 0;
  }
  .footer-address {
    font-size: 13px;
    color: #666;
    line-height: 1.6;
    margin: 0 0 20px 0;
  }

  /* Social Icons */
  .footer-social {
    display: flex;
    gap: 15px;
  }
  .footer-social a {
    color: #666;
    transition: color 0.3s;
  }
  .footer-social a:hover {
    color: {{ section.settings.accent_color }};
  }
  .footer-social svg {
    width: 20px;
    height: 20px;
    fill: currentColor;
  }

  /* Menu Columns */
  .footer-column__title {
    font-size: 15px;
    font-weight: 700;
    color: #333;
    margin: 0 0 20px 0;
    text-transform: none;
  }
  
  .footer-links {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .footer-links li {
    margin-bottom: 10px;
  }
  .footer-links a {
    font-size: 13px;
    color: #666;
    display: inline-block;
  }
  .footer-links a:hover {
    color: {{ section.settings.accent_color }};
  }

  /* Two Column Links Layout */
  .footer-links-two-col {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 10px 40px;
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .footer-links-two-col li {
    margin: 0;
  }
  .footer-links-two-col a {
    font-size: 13px;
    color: #666;
    display: inline-block;
    padding: 3px 0;
  }
  .footer-links-two-col a:hover {
    color: {{ section.settings.accent_color }};
  }

  /* Wide menu column */
  .footer-menu-column--wide {
    grid-column: span 2;
  }
  @media (max-width: 600px) {
    .footer-menu-column--wide {
      grid-column: span 2;
    }
  }
  @media (max-width: 400px) {
    .footer-menu-column--wide {
      grid-column: span 1;
    }
    .footer-links-two-col {
      grid-template-columns: 1fr;
    }
  }

  /* Footer Bottom */
  .footer-bottom {
    padding: 20px 0;
    border-top: 1px solid {{ section.settings.border_color }};
  }
  .footer-bottom-inner {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 15px;
  }
  @media (max-width: 768px) {
    .footer-bottom-inner {
      flex-direction: column;
      text-align: center;
    }
  }
  .footer-copyright {
    font-size: 13px;
    color: #888;
  }
  
  /* Payment Icons */
  .footer-payments {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
    align-items: center;
  }
  .footer-payments svg {
    height: 24px;
    width: auto;
  }

  /* Back to Top Button */
  .back-to-top {
    position: fixed;
    bottom: 30px;
    right: 30px;
    width: 45px;
    height: 45px;
    background: #333;
    color: #fff;
    border: none;
    border-radius: 4px;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    visibility: hidden;
    transition: all 0.3s;
    z-index: 999;
  }
  .back-to-top.visible {
    opacity: 1;
    visibility: visible;
  }
  .back-to-top:hover {
    background: {{ section.settings.accent_color }};
  }
  .back-to-top svg {
    width: 20px;
    height: 20px;
    fill: #fff;
  }
</style>

<footer class="footer-industrial">
  
  <!-- MAIN FOOTER CONTENT -->
  <div class="footer-top">
    <div class="footer-container">
      <div class="footer-grid">
        
        <!-- Column 1: Logo & Contact Info -->
        <div class="footer-column-logo">
          <!-- Logo with Tagline -->
          <div class="footer-logo-row">
            {%- if section.settings.logo != blank -%}
            <div class="footer-logo">
              <img src="{{ section.settings.logo | image_url: width: 300 }}" alt="{{ shop.name }}" loading="lazy">
            </div>
            {%- endif -%}
            {%- if section.settings.tagline != blank -%}
            <div class="footer-tagline">
              {{ section.settings.tagline | newline_to_br }}
            </div>
            {%- endif -%}
          </div>

          <!-- Hotline Section -->
          {%- if section.settings.hotline_number != blank -%}
          <div class="footer-hotline">
            <div class="footer-hotline-icon">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"><path d="M12 1c-4.97 0-9 4.03-9 9v7c0 1.66 1.34 3 3 3h3v-8H5v-2c0-3.87 3.13-7 7-7s7 3.13 7 7v2h-4v8h3c1.66 0 3-1.34 3-3v-7c0-4.97-4.03-9-9-9z"/></svg>
            </div>
            <div class="footer-hotline-content">
              <span class="footer-hotline-label">{{ section.settings.hotline_label }}</span>
              <a href="tel:{{ section.settings.hotline_number | remove: ' ' | remove: '-' | remove: '(' | remove: ')' }}" class="footer-hotline-number">{{ section.settings.hotline_number }}</a>
            </div>
          </div>
          {%- endif -%}

          <!-- Contact Info -->
          <h4 class="footer-contact-title">{{ section.settings.contact_heading }}</h4>
          {%- if section.settings.address != blank -%}
          <p class="footer-address">{{ section.settings.address }}</p>
          {%- endif -%}
          
          <!-- Social Icons -->
          {%- if section.settings.show_social -%}
          <div class="footer-social">
            {%- if section.settings.social_facebook != blank -%}
            <a href="{{ section.settings.social_facebook }}" target="_blank" aria-label="Facebook">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/></svg>
            </a>
            {%- endif -%}
            {%- if section.settings.social_twitter != blank -%}
            <a href="{{ section.settings.social_twitter }}" target="_blank" aria-label="Twitter">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"><path d="M23 3a10.9 10.9 0 0 1-3.14 1.53 4.48 4.48 0 0 0-7.86 3v1A10.66 10.66 0 0 1 3 4s-4 9 5 13a11.64 11.64 0 0 1-7 2c9 5 20 0 20-11.5a4.5 4.5 0 0 0-.08-.83A7.72 7.72 0 0 0 23 3z"/></svg>
            </a>
            {%- endif -%}
            {%- if section.settings.social_instagram != blank -%}
            <a href="{{ section.settings.social_instagram }}" target="_blank" aria-label="Instagram">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z" fill="none" stroke="currentColor" stroke-width="2"/><line x1="17.5" y1="6.5" x2="17.51" y2="6.5" stroke="currentColor" stroke-width="2"/></svg>
            </a>
            {%- endif -%}
            {%- if section.settings.social_linkedin != blank -%}
            <a href="{{ section.settings.social_linkedin }}" target="_blank" aria-label="LinkedIn">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"/><rect x="2" y="9" width="4" height="12"/><circle cx="4" cy="4" r="2"/></svg>
            </a>
            {%- endif -%}
            {%- if section.settings.social_youtube != blank -%}
            <a href="{{ section.settings.social_youtube }}" target="_blank" aria-label="YouTube">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"><path d="M22.54 6.42a2.78 2.78 0 0 0-1.94-2C18.88 4 12 4 12 4s-6.88 0-8.6.46a2.78 2.78 0 0 0-1.94 2A29 29 0 0 0 1 11.75a29 29 0 0 0 .46 5.33A2.78 2.78 0 0 0 3.4 19c1.72.46 8.6.46 8.6.46s6.88 0 8.6-.46a2.78 2.78 0 0 0 1.94-2 29 29 0 0 0 .46-5.25 29 29 0 0 0-.46-5.33z"/><polygon points="9.75 15.02 15.5 11.75 9.75 8.48 9.75 15.02" fill="#fff"/></svg>
            </a>
            {%- endif -%}
          </div>
          {%- endif -%}
        </div>
        
        <!-- Dynamic Menu Columns -->
        <div class="footer-menus-grid">
          {%- for block in section.blocks -%}
            {%- case block.type -%}
            
              {%- when 'menu' -%}
                <div class="footer-menu-column" {{ block.shopify_attributes }}>
                  {%- if block.settings.title != blank -%}
                    <h3 class="footer-column__title">{{ block.settings.title }}</h3>
                  {%- endif -%}
                  {%- if block.settings.menu != blank -%}
                    <ul class="footer-links">
                      {%- for link in linklists[block.settings.menu].links -%}
                        <li><a href="{{ link.url }}">{{ link.title }}</a></li>
                      {%- endfor -%}
                    </ul>
                  {%- endif -%}
                </div>

              {%- when 'menu_two_column' -%}
                <div class="footer-menu-column footer-menu-column--wide" {{ block.shopify_attributes }}>
                  {%- if block.settings.title != blank -%}
                    <h3 class="footer-column__title">{{ block.settings.title }}</h3>
                  {%- endif -%}
                  {%- if block.settings.menu != blank -%}
                    <ul class="footer-links-two-col">
                      {%- for link in linklists[block.settings.menu].links -%}
                        <li><a href="{{ link.url }}">{{ link.title }}</a></li>
                      {%- endfor -%}
                    </ul>
                  {%- endif -%}
                </div>

              {%- when 'custom_links' -%}
                <div class="footer-menu-column" {{ block.shopify_attributes }}>
                  {%- if block.settings.title != blank -%}
                    <h3 class="footer-column__title">{{ block.settings.title }}</h3>
                  {%- endif -%}
                  <ul class="footer-links">
                    {%- if block.settings.link_1_text != blank -%}
                      <li><a href="{{ block.settings.link_1_url }}">{{ block.settings.link_1_text }}</a></li>
                    {%- endif -%}
                    {%- if block.settings.link_2_text != blank -%}
                      <li><a href="{{ block.settings.link_2_url }}">{{ block.settings.link_2_text }}</a></li>
                    {%- endif -%}
                    {%- if block.settings.link_3_text != blank -%}
                      <li><a href="{{ block.settings.link_3_url }}">{{ block.settings.link_3_text }}</a></li>
                    {%- endif -%}
                    {%- if block.settings.link_4_text != blank -%}
                      <li><a href="{{ block.settings.link_4_url }}">{{ block.settings.link_4_text }}</a></li>
                    {%- endif -%}
                    {%- if block.settings.link_5_text != blank -%}
                      <li><a href="{{ block.settings.link_5_url }}">{{ block.settings.link_5_text }}</a></li>
                    {%- endif -%}
                    {%- if block.settings.link_6_text != blank -%}
                      <li><a href="{{ block.settings.link_6_url }}">{{ block.settings.link_6_text }}</a></li>
                    {%- endif -%}
                  </ul>
                </div>

              {%- when 'text_block' -%}
                <div class="footer-menu-column" {{ block.shopify_attributes }}>
                  {%- if block.settings.title != blank -%}
                    <h3 class="footer-column__title">{{ block.settings.title }}</h3>
                  {%- endif -%}
                  {%- if block.settings.text != blank -%}
                    <div class="footer-text-content" style="font-size: 13px; color: #666; line-height: 1.6;">
                      {{ block.settings.text }}
                    </div>
                  {%- endif -%}
                </div>

            {%- endcase -%}
          {%- endfor -%}
        </div>
        
      </div>
    </div>
  </div>
  
  <!-- FOOTER BOTTOM -->
  <div class="footer-bottom">
    <div class="footer-container">
      <div class="footer-bottom-inner">
        <div class="footer-copyright">
          &copy; {{ 'now' | date: '%Y' }} {{ shop.name }}. {{ section.settings.copyright_text }}
        </div>
        
        {%- if section.settings.show_payment -%}
        <div class="footer-payments">
          {%- if section.settings.payment_visa -%}
          <svg viewBox="0 0 38 24" xmlns="http://www.w3.org/2000/svg"><path opacity=".07" d="M35 0H3C1.3 0 0 1.3 0 3v18c0 1.7 1.4 3 3 3h32c1.7 0 3-1.3 3-3V3c0-1.7-1.4-3-3-3z"/><path fill="#fff" d="M35 1c1.1 0 2 .9 2 2v18c0 1.1-.9 2-2 2H3c-1.1 0-2-.9-2-2V3c0-1.1.9-2 2-2h32"/><path d="M28.3 10.1H28c-.4 1-.7 1.5-1 3h1.9c-.3-1.5-.3-2.2-.6-3zm2.9 5.9h-1.7c-.1 0-.1 0-.2-.1l-.2-.9-.1-.2h-2.4c-.1 0-.2 0-.2.2l-.3.9c0 .1-.1.1-.1.1h-2.1l.2-.5L27 8.7c0-.5.3-.7.8-.7h1.5c.1 0 .2 0 .2.2l1.4 6.5c.1.4.2.7.2 1.1.1.1.1.1.1.2zm-13.4-.3l.4-1.8c.1 0 .2.1.2.1.7.3 1.4.5 2.1.4.2 0 .5-.1.7-.2.5-.2.5-.7.1-1.1-.2-.2-.5-.3-.8-.5-.4-.2-.8-.4-1.1-.7-1.2-1-.8-2.4-.1-3.1.6-.4.9-.8 1.7-.8 1.2 0 2.5 0 3.1.2h.1c-.1.6-.2 1.1-.4 1.7-.5-.2-1-.4-1.5-.4-.3 0-.6 0-.9.1-.2 0-.3.1-.4.2-.2.2-.2.5 0 .7l.5.4c.4.2.8.4 1.1.6.5.3 1 .8 1.1 1.4.2.9-.1 1.7-.9 2.3-.5.4-.7.6-1.4.6-1.4 0-2.5.1-3.4-.2-.1.2-.1.2-.2.1zm-3.5.3c.1-.7.1-.7.2-1 .5-2.2 1-4.5 1.4-6.7.1-.2.1-.3.3-.3H18c-.2 1.2-.4 2.1-.7 3.2-.3 1.5-.6 3-1 4.5 0 .2-.1.2-.3.2M5 8.2c0-.1.2-.2.3-.2h3.4c.5 0 .9.3 1 .8l.9 4.4c0 .1 0 .1.1.2 0-.1.1-.1.1-.1l2.1-5.1c-.1-.1 0-.2.1-.2h2.1c0 .1 0 .1-.1.2l-3.1 7.3c-.1.2-.1.3-.2.4-.1.1-.3 0-.5 0H9.7c-.1 0-.2 0-.2-.2L7.9 9.5c-.2-.2-.5-.5-.9-.6-.6-.3-1.7-.5-1.9-.5L5 8.2z" fill="#142688"/></svg>
          {%- endif -%}
          {%- if section.settings.payment_mastercard -%}
          <svg viewBox="0 0 38 24" xmlns="http://www.w3.org/2000/svg"><path opacity=".07" d="M35 0H3C1.3 0 0 1.3 0 3v18c0 1.7 1.4 3 3 3h32c1.7 0 3-1.3 3-3V3c0-1.7-1.4-3-3-3z"/><path fill="#fff" d="M35 1c1.1 0 2 .9 2 2v18c0 1.1-.9 2-2 2H3c-1.1 0-2-.9-2-2V3c0-1.1.9-2 2-2h32"/><circle fill="#EB001B" cx="15" cy="12" r="7"/><circle fill="#F79E1B" cx="23" cy="12" r="7"/><path fill="#FF5F00" d="M22 12c0-2.4-1.2-4.5-3-5.7-1.8 1.3-3 3.4-3 5.7s1.2 4.5 3 5.7c1.8-1.2 3-3.3 3-5.7z"/></svg>
          {%- endif -%}
          {%- if section.settings.payment_paypal -%}
          <svg viewBox="0 0 38 24" xmlns="http://www.w3.org/2000/svg"><path opacity=".07" d="M35 0H3C1.3 0 0 1.3 0 3v18c0 1.7 1.4 3 3 3h32c1.7 0 3-1.3 3-3V3c0-1.7-1.4-3-3-3z"/><path fill="#fff" d="M35 1c1.1 0 2 .9 2 2v18c0 1.1-.9 2-2 2H3c-1.1 0-2-.9-2-2V3c0-1.1.9-2 2-2h32"/><path fill="#003087" d="M23.9 8.3c.2-1 0-1.7-.6-2.3-.6-.7-1.7-1-3.1-1h-4.1c-.3 0-.5.2-.6.5L14 15.6c0 .2.1.4.3.4H17l.4-3.4 1.8-2.2 4.7-2.1z"/><path fill="#3086C8" d="M23.9 8.3l-.2.2c-.5 2.8-2.2 3.8-4.6 3.8H18c-.3 0-.5.2-.6.5l-.6 3.9-.2 1c0 .2.1.4.3.4H19c.3 0 .5-.2.5-.4v-.1l.4-2.4v-.1c0-.2.3-.4.5-.4h.3c2.1 0 3.7-.8 4.2-3.3.2-1 .1-1.8-.4-2.4-.1-.5-.3-.7-.6-.7z"/><path fill="#012169" d="M23.3 8.1c-.1-.1-.2-.1-.3-.1-.1 0-.2 0-.3-.1-.3-.1-.7-.1-1.1-.1h-3c-.1 0-.2 0-.2.1-.2.1-.3.2-.3.4l-.7 4.4v.1c0-.3.3-.5.6-.5h1.3c2.5 0 4.1-1 4.6-3.8v-.2c-.1-.1-.3-.2-.5-.2h-.1z"/></svg>
          {%- endif -%}
          {%- if section.settings.payment_amex -%}
          <svg viewBox="0 0 38 24" xmlns="http://www.w3.org/2000/svg"><path fill="#000" d="M35 0H3C1.3 0 0 1.3 0 3v18c0 1.7 1.4 3 3 3h32c1.7 0 3-1.3 3-3V3c0-1.7-1.4-3-3-3z" opacity=".07"/><path fill="#006FCF" d="M35 1c1.1 0 2 .9 2 2v18c0 1.1-.9 2-2 2H3c-1.1 0-2-.9-2-2V3c0-1.1.9-2 2-2h32"/><path fill="#fff" d="M8.971 10.268l.774 1.876H8.203l.768-1.876zm16.075.078h-2.977v.827h2.929v1.239h-2.923v.922h2.977v.739l2.077-2.245-2.077-2.222v.74h-.006zm-14.063-2.34h3.995l.887 1.935.822-1.935h3.989v5.545l-3.132.007-2.175-2.747v2.74H12.09l-.453-1.134H9.152l-.462 1.134H5.756l2.917-5.545h2.31zm9.417 0h2.883l1.865 2.38v-2.38h2.979l1.574 1.693 1.628-1.693h2.096l-2.704 2.783 2.704 2.762h-2.24l-1.578-1.71-1.658 1.71h-5.602v-.762l-.711.762H18.4l.006-5.545z"/></svg>
