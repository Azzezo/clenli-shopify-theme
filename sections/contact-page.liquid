<style>
  /* Contact Page Styles */
  .contact-page {
    padding: 20px 0 60px;
  }

  /* Breadcrumbs */
  .breadcrumbs {
    max-width: 1570px;
    margin: auto;
    width: 95%;
    padding: 15px 0;
    margin-bottom: 20px;
  }

  .breadcrumbs__list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    font-size: 14px;
  }

  .breadcrumbs__item {
    display: flex;
    align-items: center;
  }

  .breadcrumbs__item:not(:last-child)::after {
    content: '/';
    margin-left: 8px;
    color: #999;
  }

  .breadcrumbs__link {
    color: #666;
    text-decoration: none;
    transition: color 0.3s ease;
  }

  .breadcrumbs__link:hover {
    color:rgb(128, 255, 0);
  }

  .breadcrumbs__current {
    color: #333;
    font-weight: 500;
  }

  /* Page Title */
  .contact-title {
    text-align: center;
    margin-bottom: 40px;
  }

  .contact-title h1 {
    font-size: 32px;
    font-weight: 700;
    color: #333;
    margin: 0;
    text-transform: uppercase;
    letter-spacing: 1px;
  }

  /* Contact Content Layout */
  .contact-content {
    margin-bottom: 40px;
    max-width: 1570px;
    margin: auto;
    width: 95%;
  }

  .contact-row {
    display: grid;
    grid-template-columns: 2fr 1fr;
    gap: 40px;
  }

  @media (max-width: 768px) {
    .contact-row {
      grid-template-columns: 1fr;
      gap: 30px;
    }
  }

  /* Custom Title */
  .custom-title {
    margin-bottom: 25px;
    padding-bottom: 15px;
    border-bottom: 2px solid #6fb31a;
  }

  .custom-title .title {
    font-size: 20px;
    font-weight: 600;
    color: #333;
    margin: 0;
    text-transform: uppercase;
  }

  /* Contact Form */
  .contact-form {
    background: #ffffff;
    border-radius: 8px;
  }

  .form-field {
    margin-bottom: 20px;
  }

  .form-field label {
    display: block;
    font-size: 14px;
    font-weight: 600;
    color: #333;
    margin-bottom: 8px;
  }

  .form-field.required label::after {
    content: ' *';
    color: #e74c3c;
  }

  .form-field input,
  .form-field textarea {
    width: 100%;
    padding: 12px 15px;
    border: 1px solid #ddd;
    border-radius: 4px;
    font-size: 14px;
    font-family: inherit;
    transition: border-color 0.3s ease, box-shadow 0.3s ease;
    box-sizing: border-box;
  }

  .form-field input:focus,
  .form-field textarea:focus {
    outline: none;
    border-color: #ffa800;
    box-shadow: 0 0 0 3px rgba(255, 168, 0, 0.1);
  }

  .form-field input::placeholder,
  .form-field textarea::placeholder {
    color: #999;
  }

  .form-field textarea {
    resize: vertical;
    min-height: 120px;
  }

  /* Form Actions */
  .form-actions {
    margin-top: 25px;
  }

  .btn {
    display: inline-block;
    padding: 14px 35px;
    font-size: 14px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 1px;
    border: none;
    border-radius: 4px;
    cursor: pointer;
    transition: all 0.3s ease;
  }

  .btn-primary {
    background-color: #6fb31a;
    color: #fff;
  }

  .btn-primary:hover {
    background-color: #6fb31a;
    transform: translateY(-2px);
    box-shadow: 0 4px 12px rgba(255, 168, 0, 0.3);
  }

  /* Form Messages */
  .form-success {
    background-color: #d4edda;
    color: #155724;
    padding: 15px 20px;
    border-radius: 4px;
    margin-bottom: 20px;
    border: 1px solid #c3e6cb;
  }

  .form-errors {
    background-color: #f8d7da;
    color: #721c24;
    padding: 15px 20px;
    border-radius: 4px;
    margin-bottom: 20px;
    border: 1px solid #f5c6cb;
  }

  /* Contact Info Column */
  .more-info {
    background: #fff;
    padding: 30px;
    border-radius: 8px;
    {% comment %} box-shadow: 0 2px 20px rgba(0, 0, 0, 0.08); {% endcomment %}
    height: fit-content;
  }

  .contact-info {
    margin-bottom: 25px;
  }

  .info-text {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    margin-bottom: 15px;
    font-size: 14px;
    color: #666;
    line-height: 1.6;
  }

  .info-text svg {
    flex-shrink: 0;
    {% comment %} color: #ffa800;
    margin-top: 2px; {% endcomment %}
  }

  .info-text a {
    color: #333;
    text-decoration: none;
    transition: color 0.3s ease;
  }

  .info-text a:hover {
    color: #ffa800;
  }

  .info-text span {
    color: #999;
    margin-right: 5px;
  }

  address.info-text {
    font-style: normal;
  }

  /* Opening Hours */
  .open-time {
    margin-bottom: 25px;
    padding-top: 20px;
    border-top: 1px solid #eee;
  }

  .sub-title {
    font-size: 16px;
    font-weight: 600;
    color: #333;
    margin: 0 0 15px;
  }

  .open-time .info-text {
    margin-bottom: 8px;
  }

  /* Social Links */
  .social-links {
    padding-top: 20px;
    border-top: 1px solid #eee;
  }

  .social-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    gap: 15px;
  }

  .social-list li a {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    background: #f5f5f5;
    border-radius: 50%;
    color: #666;
    transition: all 0.3s ease;
  }

  .social-list li a:hover {
    background: #ffa800;
    color: #fff;
    transform: translateY(-3px);
  }

  .social-list li a svg {
    width: 18px;
    height: 18px;
  }

  /* Google Map */
  .contact-map {
    margin-top: 40px;
  }

  .map-container {
    border-radius: 8px;
    overflow: hidden;
    box-shadow: 0 2px 20px rgba(0, 0, 0, 0.1);
  }

  .map-container iframe {
    display: block;
    width: 100%;
    min-height: 400px;
  }

  /* Responsive */
  @media (max-width: 768px) {
    .contact-title h1 {
      font-size: 26px;
    }

    .contact-form {
      padding: 20px;
    }

    .more-info {
      padding: 20px;
    }
  }

  @media (max-width: 480px) {
    .contact-title h1 {
      font-size: 22px;
    }

    .btn {
      width: 100%;
      text-align: center;
    }
  }
</style>

<div class="page-width contact-page">
  <!-- Breadcrumbs -->
  <nav class="breadcrumbs" aria-label="Breadcrumb">
    <ol class="breadcrumbs__list">
      <li class="breadcrumbs__item">
        <a href="{{ routes.root_url }}" class="breadcrumbs__link">Home</a>
      </li>
      <li class="breadcrumbs__item">
        <span class="breadcrumbs__current">{{ page.title }}</span>
      </li>
    </ol>
  </nav>

  <!-- Page Title -->
  <div class="contact-title">
    <h1>{{ section.settings.heading | default: 'Contact Us' }}</h1>
  </div>

  <div class="contact-content">
    <div class="contact-row">
      <!-- Contact Form -->
      <div class="contact-form-column">
        <div class="custom-title">
          <h3 class="title">{{ section.settings.form_heading | default: 'Leave us a Message' }}</h3>
        </div>

        {% if section.settings.show_hubspot_form %}
          <div class="contact-form contact-form--embed contact-form--hubspot">
            <div id="hubspot-form-{{ section.id }}"></div>
            <script charset="utf-8" type="text/javascript" src="//js-eu1.hsforms.net/forms/embed/v2.js" defer></script>
            <script>
              (function () {
                function renderHubspotForm() {
                  if (window.hbspt && window.hbspt.forms) {
                    window.hbspt.forms.create({
                      portalId: '146843494',
                      formId: '1f8cb1c7-b079-4c2f-ae2b-da995b4df40e',
                      region: 'eu1',
                      target: '#hubspot-form-{{ section.id }}'
                    });
                  } else {
                    setTimeout(renderHubspotForm, 250);
                  }
                }
                renderHubspotForm();
              })();
            </script>
          </div>
        {% elsif section.settings.form_embed != blank %}
          <div class="contact-form contact-form--embed">
            {{ section.settings.form_embed }}
          </div>
        {% else %}
          {% form 'contact', class: 'contact-form' %}
            {% if form.posted_successfully? %}
              <div class="form-success">
                <p>
                  {{
                    section.settings.success_message
                    | default: 'Thank you for your message. We will get back to you shortly.'
                  }}
                </p>
              </div>
            {% endif %}

            {% if form.errors %}
              <div class="form-errors">
                {{ form.errors | default_errors }}
              </div>
            {% endif %}

            <div class="form-field required">
              <label for="contact-name">Name</label>
              <input
                type="text"
                id="contact-name"
                name="contact[name]"
                placeholder="Your Name"
                required
                value="{{ form.name }}"
              >
            </div>

            <div class="form-field required">
              <label for="contact-email">Email</label>
              <input
                type="email"
                id="contact-email"
                name="contact[email]"
                placeholder="Your Email"
                required
                autocomplete="email"
                value="{{ form.email }}"
              >
            </div>

            <div class="form-field">
              <label for="contact-phone">Phone Number</label>
              <input
                type="tel"
                id="contact-phone"
                name="contact[phone]"
                placeholder="Your Phone Number"
                value="{{ form.phone }}"
              >
            </div>

            <div class="form-field required">
              <label for="contact-message">What's on your mind?</label>
              <textarea
                id="contact-message"
                name="contact[body]"
                placeholder="Your Message"
                rows="5"
                required
              >{{ form.body }}</textarea>
            </div>

            <div class="form-actions">
              <button type="submit" class="btn btn-primary">
                {{ section.settings.button_text | default: 'Submit' }}
              </button>
            </div>
          {% endform %}
        {% endif %}
      </div>

      <!-- Contact Info -->
      <div class="contact-info-column">
        <div class="more-info">
          <div class="detail-info">
            <div class="custom-title">
              <h3 class="title">{{ section.settings.info_heading | default: 'Our Address' }}</h3>
            </div>

            <div class="contact-info">
              {% if section.settings.address != blank %}
                <address class="info-text">
                  {% comment %} <svg
                    xmlns="http://www.w3.org/2000/svg"
                    width="20"
                    height="20"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                  > {% endcomment %}
                    {% comment %} <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path> {% endcomment %}
                    <circle cx="12" cy="10" r="3"></circle>
                  </svg>
                  {{ section.settings.address }}
                </address>
              {% endif %}

              {% if section.settings.phone != blank %}
                <p class="info-text">
                  {% comment %} <svg
                    xmlns="http://www.w3.org/2000/svg"
                    width="20"
                    height="20"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                  > {% endcomment %}
                    <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
                  </svg>
                  <span>Support:</span>
                  <a href="tel:{{ section.settings.phone | remove: ' ' | remove: '(' | remove: ')' }}">
                    {{- section.settings.phone -}}
                  </a>
                </p>
              {% endif %}

              {% if section.settings.email != blank %}
                <p class="info-text">
                  {% comment %} <svg
                    xmlns="http://www.w3.org/2000/svg"
                    width="20"
                    height="20"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                  > {% endcomment %}
                    <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
                    <polyline points="22,6 12,13 2,6"></polyline>
                  </svg>
                  <span>E-mail:</span>
                  <a href="mailto:{{ section.settings.email }}">{{ section.settings.email }}</a>
                </p>
              {% endif %}
            </div>

            {% if section.settings.show_hours %}
              <div class="open-time">
                <h4 class="sub-title">Opening hours</h4>
                {% if section.settings.weekday_hours != blank %}
                  <p class="info-text">{{ section.settings.weekday_hours }}</p>
                {% endif %}
                {% if section.settings.weekend_hours != blank %}
                  <p class="info-text">{{ section.settings.weekend_hours }}</p>
                {% endif %}
              </div>
            {% endif %}

            {% if section.settings.show_social %}
              <div class="social-links">
                <h4 class="sub-title">Follow Us</h4>
                <ul class="social-list">
                  {% if section.settings.facebook_url != blank %}
                    <li>
                      <a
                        href="{{ section.settings.facebook_url }}"
                        target="_blank"
                        rel="noopener"
                        aria-label="Facebook"
                      >
                        {% comment %} <svg
                          xmlns="http://www.w3.org/2000/svg"
                          width="24"
                          height="24"
                          viewBox="0 0 24 24"
                          fill="currentColor"
                        > {% endcomment %}
                          <path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"></path>
                        </svg>
                      </a>
                    </li>
                  {% endif %}
                  {% if section.settings.twitter_url != blank %}
                    <li>
                      <a href="{{ section.settings.twitter_url }}" target="_blank" rel="noopener" aria-label="Twitter">
                        {% comment %} <svg
                          xmlns="http://www.w3.org/2000/svg"
                          width="24"
                          height="24"
                          viewBox="0 0 24 24"
                          fill="currentColor"
                        > {% endcomment %}
                          <path d="M23 3a10.9 10.9 0 0 1-3.14 1.53 4.48 4.48 0 0 0-7.86 3v1A10.66 10.66 0 0 1 3 4s-4 9 5 13a11.64 11.64 0 0 1-7 2c9 5 20 0 20-11.5a4.5 4.5 0 0 0-.08-.83A7.72 7.72 0 0 0 23 3z"></path>
                        </svg>
                      </a>
                    </li>
                  {% endif %}
                  {% if section.settings.linkedin_url != blank %}
                    <li>
                      <a
                        href="{{ section.settings.linkedin_url }}"
                        target="_blank"
                        rel="noopener"
                        aria-label="LinkedIn"
                      >
                        <svg
                          xmlns="http://www.w3.org/2000/svg"
                          width="24"
                          height="24"
                          viewBox="0 0 24 24"
                          fill="currentColor"
                        >
                          <path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"></path>
                          <rect x="2" y="9" width="4" height="12"></rect>
                          <circle cx="4" cy="4" r="2"></circle>
                        </svg>
                      </a>
                    </li>
                  {% endif %}
                </ul>
              </div>
            {% endif %}
          </div>
        </div>
      </div>
    </div>

    <!-- Google Map -->
    {% if section.settings.show_map and section.settings.map_embed != blank %}
      <div class="contact-map">
        <div class="map-container">
          {{ section.settings.map_embed }}
        </div>
      </div>
    {% endif %}
  </div>
</div>

{% schema %}
{
  "name": "Contact Page",
  "tag": "section",
  "class": "section-contact",
  "settings": [
    {
      "type": "header",
      "content": "Page Settings"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Page Heading",
      "default": "Contact Us"
    },
    {
      "type": "header",
      "content": "Form Settings"
    },
    {
      "type": "text",
      "id": "form_heading",
      "label": "Form Heading",
      "default": "Leave us a Message"
    },
    {
      "type": "checkbox",
      "id": "show_hubspot_form",
      "label": "Use HubSpot Form",
      "info": "Replaces the default Shopify contact form with the HubSpot embed.",
      "default": false
    },
    {
      "type": "html",
      "id": "form_embed",
      "label": "Custom Form Embed",
      "info": "Optional fallback. Used only when 'Use HubSpot Form' is off. Note: Shopify may strip <script> tags from HTML settings."
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Submit Button Text",
      "default": "Submit"
    },
    {
      "type": "textarea",
      "id": "success_message",
      "label": "Success Message",
      "default": "Thank you for your message. We will get back to you shortly."
    },
    {
      "type": "header",
      "content": "Contact Information"
    },
    {
      "type": "text",
      "id": "info_heading",
      "label": "Info Section Heading",
      "default": "Our Address"
    },
    {
      "type": "textarea",
      "id": "address",
      "label": "Address",
      "default": "Unit 14a Stadium Business Park, Ballycoolin Rd, Dublin 11, Ireland"
    },
    {
      "type": "text",
      "id": "phone",
      "label": "Phone Number",
      "default": "+353 (0)1 811 8920"
    },
    {
      "type": "text",
      "id": "email",
      "label": "Email Address",
      "default": "sales@clenlidirect.com"
    },
    {
      "type": "header",
      "content": "Opening Hours"
    },
    {
      "type": "checkbox",
      "id": "show_hours",
      "label": "Show Opening Hours",
      "default": true
    },
    {
      "type": "text",
      "id": "weekday_hours",
      "label": "Weekday Hours",
      "default": "Monday to Friday: 9am - 5pm"
    },
    {
      "type": "text",
      "id": "weekend_hours",
      "label": "Weekend Hours",
      "default": "Saturday to Sunday: Closed"
    },
    {
      "type": "header",
      "content": "Social Media"
    },
    {
      "type": "checkbox",
      "id": "show_social",
      "label": "Show Social Links",
      "default": true
    },
    {
      "type": "url",
      "id": "facebook_url",
      "label": "Facebook URL"
    },
    {
      "type": "url",
      "id": "twitter_url",
      "label": "Twitter URL"
    },
    {
      "type": "url",
      "id": "linkedin_url",
      "label": "LinkedIn URL"
    },
    {
      "type": "header",
      "content": "Map Settings"
    },
    {
      "type": "checkbox",
      "id": "show_map",
      "label": "Show Google Map",
      "default": true
    },
    {
      "type": "html",
      "id": "map_embed",
      "label": "Google Map Embed Code",
      "info": "Paste your Google Maps iframe embed code here"
    }
  ],
  "presets": [
    {
      "name": "Contact Page"
    }
  ]
}
{% endschema %}
