{%- liquid
    assign section_id = section.id
-%}

<style>
/* ============================================
   SACHET SYSTEM PAGE - COMPLETE STYLES
   ============================================ */

#sachet-page-{{ section_id }} {
    font-family: 'Open Sans', Arial, sans-serif;
    color: #333;
    line-height: 1.6;
}

#sachet-page-{{ section_id }} * {
    box-sizing: border-box;
}

#sachet-page-{{ section_id }} .sp-container {
    {% if section.settings.container_width == '100' %}
        max-width: 100%;
    {% else %}
        max-width: {{ section.settings.container_width }}px;
    {% endif %}
    width: 100%;
    margin: 0 auto;
    padding: 0 30px;
}

#sachet-page-{{ section_id }} .sp-row {
    display: flex;
    flex-wrap: wrap;
    margin: 0 -15px;
}

#sachet-page-{{ section_id }} .sp-col-6 {
    width: 50%;
    padding: 0 15px;
}

#sachet-page-{{ section_id }} .sp-col-4 {
    width: 33.333%;
    padding: 0 15px;
}

#sachet-page-{{ section_id }} .sp-col-12 {
    width: 100%;
    padding: 0 15px;
}

#sachet-page-{{ section_id }} img {
    max-width: 100%;
    height: auto;
}

/* Green Divider Line */
#sachet-page-{{ section_id }} hr.imop-divider {
    width: 100% !important;
    max-width: 100% !important;
    height: 4px !important;
    margin: 40px auto !important;
    background-color: #6fb31a !important;
    border: 0 !important;
    border: none !important;
    display: block !important;
    opacity: 1 !important;
    visibility: visible !important;
}

/* Section Spacing */
#sachet-page-{{ section_id }} .sp-section {
    padding: 40px 0;
}

/* ============================================
   HERO SECTION
   ============================================ */
#sachet-page-{{ section_id }} .sp-hero {
    padding: 40px 0;
}

#sachet-page-{{ section_id }} .sp-hero-image {
    text-align: center;
}

#sachet-page-{{ section_id }} .sp-hero-image img {
  width: 95%;
    max-width: 677px;
}

#sachet-page-{{ section_id }} .sp-hero-content {
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 20px 0;
}

#sachet-page-{{ section_id }} .sp-hero-subtitle {
    font-size: 20px;
    color: #333;
    margin-bottom: 10px;
}

#sachet-page-{{ section_id }} .sp-hero-title {
    font-size: 40px;
    font-weight: 700;
    color: #333;
    margin: 0 0 15px 0;
}

#sachet-page-{{ section_id }} .sp-hero-desc {
    font-size: 16px;
    color: #333;
    margin-bottom: 15px;
}

#sachet-page-{{ section_id }} .sp-hero-desc strong {
    color: #333;
}

#sachet-page-{{ section_id }} .sp-btn-green {
    display: inline-block;
    background-color: #6fb31a;
    color: #fff;
    padding: 12px 30px;
    text-decoration: none;
    font-weight: 600;
    font-size: 14px;
    text-transform: uppercase;
    border-radius: 3px;
    transition: all 0.3s ease;
    margin-top: 15px;
}

#sachet-page-{{ section_id }} .sp-btn-green:hover {
    background-color: #5a9216;
    color: #fff;
}

/* ============================================
   CONTENT SECTIONS (Alternating Text + Image)
   ============================================ */
#sachet-page-{{ section_id }} .sp-content-section {
    padding: 40px 0;
}

#sachet-page-{{ section_id }} .sp-content-section .sp-row {
    align-items: center;
}

#sachet-page-{{ section_id }} .sp-content-section.reverse .sp-row {
    flex-direction: row-reverse;
}

#sachet-page-{{ section_id }} .sp-content-text {
    padding: 20px 15px;
}

#sachet-page-{{ section_id }} .sp-content-text h3 {
    font-size: 20px;
    color: #333;
    margin: 0 0 15px 0;
    font-weight: 400;
}

#sachet-page-{{ section_id }} .sp-content-text p {
    font-size: 16px;
    color: #333;
    margin: 0 0 15px 0;
}

#sachet-page-{{ section_id }} .sp-content-image img {
    width: 100%;
    border-radius: 5px;
}

/* ============================================
   BENEFITS SECTIONS (3 Column Cards)
   ============================================ */
#sachet-page-{{ section_id }} .sp-benefits-section {
    padding: 40px 0;
}

#sachet-page-{{ section_id }} .sp-benefits-title {
    font-size: 20px;
    font-weight: 700;
    color: #333;
    text-align: center;
    margin: 0 0 10px 0;
}

#sachet-page-{{ section_id }} .sp-benefits-subtitle {
    font-size: 16px;
    color: #555;
    text-align: center;
    max-width: 900px;
    margin: 0 auto 30px auto;
}

#sachet-page-{{ section_id }} .sp-benefit-card {
    text-align: center;
    margin-bottom: 30px;
}

#sachet-page-{{ section_id }} .sp-benefit-card img {
    width: 100%;
    {% comment %} max-width: 350px; {% endcomment %}
    margin-bottom: 15px;
}

#sachet-page-{{ section_id }} .sp-benefit-card h3 {
    font-size: 18px;
    font-weight: 700;
    color: #333;
    margin: 0 0 10px 0;
}

#sachet-page-{{ section_id }} .sp-benefit-card p {
    font-size: 14px;
    color: #555;
    margin: 0;
    padding: 0 10px;
}

/* ============================================
   PRODUCT RANGE SECTIONS
   ============================================ */
#sachet-page-{{ section_id }} .sp-products-section {
    padding: 40px 0;
}

#sachet-page-{{ section_id }} .sp-products-title {
    font-size: 30px;
    font-weight: 700;
    color: #333;
    text-align: center;
    margin: 0 0 10px 0;
}

#sachet-page-{{ section_id }} .sp-products-subtitle {
    font-size: 16px;
    color: #555;
    text-align: center;
    margin: 0 0 30px 0;
}

#sachet-page-{{ section_id }} .sp-product-card {
    text-align: center;
    margin-bottom: 30px;
}

#sachet-page-{{ section_id }} .sp-product-card img {
    width: 100%;
  
#sachet-page-template--27098001244535__main .sp-product-card img 
    margin-bottom: 15px;
}

#sachet-page-{{ section_id }} .sp-product-card h3 {
    font-size: 20px;
    font-weight: 700;
    color: #333;
    margin: 0 0 10px 0;
}

#sachet-page-{{ section_id }} .sp-product-card > p {
    font-size: 14px;
    color: #555;
    margin: 0 0 15px 0;
    min-height: 60px;
}

#sachet-page-{{ section_id }} .sp-product-features {
    border-top: 4px solid #6fb31a;
    border-bottom: 4px solid #6fb31a;
    padding: 15px 10px;
    margin-bottom: 15px;
}

#sachet-page-{{ section_id }} .sp-product-features p {
    font-size: 16px;
    font-weight: 700;
    color: #6fb31a;
    margin: 5px 0;
}

#sachet-page-{{ section_id }} .sp-product-specs {
    display: flex;
    justify-content: center;
}

#sachet-page-{{ section_id }} .sp-product-spec {
    flex: 1;
    text-align: center;
    border-right: 2px solid #6fb31a;
    padding: 0 10px;
}

#sachet-page-{{ section_id }} .sp-product-spec:last-child {
    border-right: none;
}

#sachet-page-{{ section_id }} .sp-product-spec .spec-label {
    font-size: 16px;
    font-weight: 700;
    color: #333;
    margin: 0;
}

#sachet-page-{{ section_id }} .sp-product-spec .spec-value {
    font-size: 16px;
    font-weight: 700;
    color: #6fb31a;
    margin: 5px 0 0 0;
}

/* ============================================
   QUOTE FORM SECTION
   ============================================ */
#sachet-page-{{ section_id }} .sp-quote-section {
    padding: 40px 0;
}

#sachet-page-{{ section_id }} .sp-quote-header {
    text-align: center;
    margin-bottom: 30px;
}

#sachet-page-{{ section_id }} .sp-quote-header h3 {
    font-size: 20px;
    font-weight: 700;
    color: #333;
    margin: 0 0 10px 0;
}

#sachet-page-{{ section_id }} .sp-quote-header p {
    font-size: 16px;
    color: #555;
    margin: 0;
}

#sachet-page-{{ section_id }} .sp-quote-wrapper {
    max-width: 1600px;
    margin: 0 auto;
}

#sachet-page-{{ section_id }} .sp-callnow-btn {
    display: block;
    width: 100%;
    background-color: #6fb31a;
    color: #fff;
    text-align: center;
    padding: 10px 20px;
    font-size: 16px;
    text-transform: uppercase;
    text-decoration: none;
    letter-spacing: 1px;
    margin-bottom: 10px;
    transition: all 0.3s ease;
}

#sachet-page-{{ section_id }} .sp-callnow-btn:hover {
    background-color: rgb(7, 11, 16);
    color: #fff;
}

#sachet-page-{{ section_id }} .sp-form-box {
    border: 3px solid #6fb31a;
    padding: 10px;
    background-color: #fff;
}

#sachet-page-{{ section_id }} .sp-form-title {
    font-size: 14px;
    color: #333;
    text-align: center;
    text-transform: uppercase;
    margin: 0 0 0px 0;
}

#sachet-page-{{ section_id }} .sp-form-field {
    margin-bottom: 10px;
}

#sachet-page-{{ section_id }} .sp-form-field input,
#sachet-page-{{ section_id }} .sp-form-field textarea {
    width: 100%;
    padding: 12px 15px;
    font-size: 15px;
    color: #333;
    background-color: #fff;
    border: 1px solid #ddd;
    border-radius: 0;
    outline: none;
    transition: border-color 0.3s ease;
}

#sachet-page-{{ section_id }} .sp-form-field input::placeholder,
#sachet-page-{{ section_id }} .sp-form-field textarea::placeholder {
    color: #666;
    text-transform: uppercase;
    font-size: 13px;
}

#sachet-page-{{ section_id }} .sp-form-field input:focus,
#sachet-page-{{ section_id }} .sp-form-field textarea:focus {
    border-color: #6fb31a;
}

#sachet-page-{{ section_id }} .sp-form-field textarea {
    min-height: 90px;
    resize: vertical;
}

#sachet-page-{{ section_id }} .sp-form-submit {
    text-align: center;
    margin-top: 20px;
}

#sachet-page-{{ section_id }} .sp-form-submit button {
    display: inline-block;
    background-color: #6fb31a;
    color: #fff;
    padding: 14px 50px;
    font-size: 15px;
    text-transform: uppercase;
    border: none;
    border-radius: 4px;
    cursor: pointer;
    transition: all 0.3s ease;
}

#sachet-page-{{ section_id }} .sp-form-submit button:hover {
    background-color: rgb(18, 27, 39);
}

#sachet-page-{{ section_id }} .sp-message {
    padding: 15px;
    border-radius: 4px;
    margin-bottom: 20px;
    text-align: center;
}

#sachet-page-{{ section_id }} .sp-message.success {
    background-color: #d4edda;
    color: #155724;
    border: 1px solid #c3e6cb;
}

#sachet-page-{{ section_id }} .sp-message.error {
    background-color: #f8d7da;
    color: #721c24;
    border: 1px solid #f5c6cb;
}

/* ============================================
   RESPONSIVE STYLES
   ============================================ */
@media (max-width: 991px) {
    #sachet-page-{{ section_id }} .sp-col-6 {
        width: 100%;
    }
    
    #sachet-page-{{ section_id }} .sp-col-4 {
        width: 50%;
    }
    
    #sachet-page-{{ section_id }} .sp-hero-title {
        font-size: 32px;
    }
    
    #sachet-page-{{ section_id }} .sp-content-section.reverse .sp-row {
        flex-direction: column;
    }
    
    #sachet-page-{{ section_id }} .sp-content-image {
        order: -1;
        margin-bottom: 20px;
    }
}

@media (max-width: 767px) {
    #sachet-page-{{ section_id }} .sp-col-4 {
        width: 100%;
    }
    
    #sachet-page-{{ section_id }} .sp-hero-title {
        font-size: 28px;
    }
    
    #sachet-page-{{ section_id }} .sp-hero-subtitle {
        font-size: 18px;
    }
    
    #sachet-page-{{ section_id }} .sp-products-title {
        font-size: 24px;
    }
    
    #sachet-page-{{ section_id }} .sp-form-box {
        padding: 20px 15px;
    }
}
</style>

<div id="sachet-page-{{ section_id }}">
    <div class="sp-container">
        
        <!-- ============================================
             HERO SECTION
             ============================================ -->
        <section class="sp-hero">
            <div class="sp-row">
                <div class="sp-col-6">
                    <div class="sp-hero-image">
                        {%- if section.settings.hero_image != blank -%}
                            <img src="{{ section.settings.hero_image | image_url: width: 600 }}" alt="{{ section.settings.hero_title }}">
                        {%- else -%}
                            {{ 'product-1' | placeholder_svg_tag }}
                        {%- endif -%}
                    </div>
                </div>
                <div class="sp-col-6">
                    <div class="sp-hero-content">
                        <p class="sp-hero-subtitle">{{ section.settings.hero_subtitle }}</p>
                        <h1 class="sp-hero-title">{{ section.settings.hero_title }}</h1>
                        <p class="sp-hero-desc">{{ section.settings.hero_tagline }}</p>
                        
                        {%- if section.settings.hero_feature_1 != blank -%}
                            <p class="sp-hero-desc"><strong>{{ section.settings.hero_feature_1_title }}:</strong> {{ section.settings.hero_feature_1 }}</p>
                        {%- endif -%}
                        
                        {%- if section.settings.hero_feature_2 != blank -%}
                            <p class="sp-hero-desc"><strong>{{ section.settings.hero_feature_2_title }}:</strong> {{ section.settings.hero_feature_2 }}</p>
                        {%- endif -%}
                        
                        {%- if section.settings.hero_feature_3 != blank -%}
                            <p class="sp-hero-desc"><strong>{{ section.settings.hero_feature_3_title }}:</strong> {{ section.settings.hero_feature_3 }}</p>
                        {%- endif -%}
                        
                        {%- if section.settings.hero_feature_4 != blank -%}
                            <p class="sp-hero-desc"><strong>{{ section.settings.hero_feature_4_title }}:</strong> {{ section.settings.hero_feature_4 }}</p>
                        {%- endif -%}
                        
                        {%- if section.settings.hero_btn_text != blank -%}
                            <a href="{{ section.settings.hero_btn_link }}" class="sp-btn-green">{{ section.settings.hero_btn_text }}</a>
                        {%- endif -%}
                    </div>
                </div>
            </div>
        </section>
        <hr class="imop-divider">
        
        <!-- ============================================
             CONTENT BLOCKS (Dynamic via Blocks)
             ============================================ -->
        {%- for block in section.blocks -%}
            {%- case block.type -%}
            
                {%- when 'content_section' -%}
                    <section class="sp-content-section {% if block.settings.reverse_layout %}reverse{% endif %}" {{ block.shopify_attributes }}>
                        <div class="sp-row">
                            <div class="sp-col-6">
                                <div class="sp-content-text">
                                    {%- if block.settings.content_title != blank -%}
                                        <h3>{{ block.settings.content_title }}</h3>
                                    {%- endif -%}
                                    {%- if block.settings.content_text != blank -%}
                                        {{ block.settings.content_text }}
                                    {%- endif -%}
                                </div>
                            </div>
                            <div class="sp-col-6">
                                <div class="sp-content-image">
                                    {%- if block.settings.content_image != blank -%}
                                        <img src="{{ block.settings.content_image | image_url: width: 806 }}" alt="{{ block.settings.content_title }}">
                                    {%- else -%}
                                        {{ 'image' | placeholder_svg_tag }}
                                    {%- endif -%}
                                </div>
                            </div>
                        </div>
                    </section>
                    <hr class="imop-divider">

                {%- when 'benefits_section' -%}
                    <section class="sp-benefits-section" {{ block.shopify_attributes }}>
                        {%- if block.settings.benefits_title != blank -%}
                            <h2 class="sp-benefits-title">{{ block.settings.benefits_title }}</h2>
                        {%- endif -%}
                        {%- if block.settings.benefits_subtitle != blank -%}
                            <p class="sp-benefits-subtitle">{{ block.settings.benefits_subtitle }}</p>
                        {%- endif -%}
                        
                        <div class="sp-row">
                            <!-- Card 1 -->
                            <div class="sp-col-4">
                                <div class="sp-benefit-card">
                                    {%- if block.settings.benefit_1_image != blank -%}
                                        <img src="{{ block.settings.benefit_1_image | image_url: width: 400 }}" alt="{{ block.settings.benefit_1_title }}">
                                    {%- endif -%}
                                    <h3>{{ block.settings.benefit_1_title }}</h3>
                                    <p>{{ block.settings.benefit_1_text }}</p>
                                </div>
                            </div>
                            <!-- Card 2 -->
                            <div class="sp-col-4">
                                <div class="sp-benefit-card">
                                    {%- if block.settings.benefit_2_image != blank -%}
                                        <img src="{{ block.settings.benefit_2_image | image_url: width: 400 }}" alt="{{ block.settings.benefit_2_title }}">
                                    {%- endif -%}
                                    <h3>{{ block.settings.benefit_2_title }}</h3>
                                    <p>{{ block.settings.benefit_2_text }}</p>
                                </div>
                            </div>
                            <!-- Card 3 -->
                            <div class="sp-col-4">
                                <div class="sp-benefit-card">
                                    {%- if block.settings.benefit_3_image != blank -%}
                                        <img src="{{ block.settings.benefit_3_image | image_url: width: 400 }}" alt="{{ block.settings.benefit_3_title }}">
                                    {%- endif -%}
                                    <h3>{{ block.settings.benefit_3_title }}</h3>
                                    <p>{{ block.settings.benefit_3_text }}</p>
                                </div>
                            </div>
                        </div>
                    </section>
                    <hr class="imop-divider">

                {%- when 'product_range' -%}
                    <section class="sp-products-section" {{ block.shopify_attributes }}>
                        {%- if block.settings.range_title != blank -%}
                            <h2 class="sp-products-title">{{ block.settings.range_title }}</h2>
                        {%- endif -%}
                        {%- if block.settings.range_subtitle != blank -%}
                            <p class="sp-products-subtitle">{{ block.settings.range_subtitle }}</p>
                        {%- endif -%}
                        
                        <div class="sp-row">
                            <!-- Product 1 -->
                            <div class="sp-col-4">
                                <div class="sp-product-card">
                                    {%- if block.settings.product_1_image != blank -%}
                                        <img src="{{ block.settings.product_1_image | image_url: width: 400 }}" alt="{{ block.settings.product_1_title }}">
                                    {%- endif -%}
                                    <h3>{{ block.settings.product_1_title }}</h3>
                                    <p>{{ block.settings.product_1_desc }}</p>
                                    <div class="sp-product-features">
                                        <p>{{ block.settings.product_1_feature_1 }}</p>
                                        <p>{{ block.settings.product_1_feature_2 }}</p>
                                        <p>{{ block.settings.product_1_feature_3 }}</p>
                                    </div>
                                    <div class="sp-product-specs">
                                        <div class="sp-product-spec">
                                            <p class="spec-label">Sachets</p>
                                            <p class="spec-value">{{ block.settings.product_1_sachets }}</p>
                                        </div>
                                        <div class="sp-product-spec">
                                            <p class="spec-label">Per Sachet</p>
                                            <p class="spec-value">{{ block.settings.product_1_per_sachet }}</p>
                                        </div>
                                        <div class="sp-product-spec">
                                            <p class="spec-label">Per Pack</p>
                                            <p class="spec-value">{{ block.settings.product_1_per_pack }}</p>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <!-- Product 2 -->
                            <div class="sp-col-4">
                                <div class="sp-product-card">
                                    {%- if block.settings.product_2_image != blank -%}
                                        <img src="{{ block.settings.product_2_image | image_url: width: 400 }}" alt="{{ block.settings.product_2_title }}">
                                    {%- endif -%}
                                    <h3>{{ block.settings.product_2_title }}</h3>
                                    <p>{{ block.settings.product_2_desc }}</p>
                                    <div class="sp-product-features">
                                        <p>{{ block.settings.product_2_feature_1 }}</p>
                                        <p>{{ block.settings.product_2_feature_2 }}</p>
                                        <p>{{ block.settings.product_2_feature_3 }}</p>
                                    </div>
                                    <div class="sp-product-specs">
                                        <div class="sp-product-spec">
                                            <p class="spec-label">Sachets</p>
                                            <p class="spec-value">{{ block.settings.product_2_sachets }}</p>
                                        </div>
                                        <div class="sp-product-spec">
                                            <p class="spec-label">Per Sachet</p>
                                            <p class="spec-value">{{ block.settings.product_2_per_sachet }}</p>
                                        </div>
                                        <div class="sp-product-spec">
                                            <p class="spec-label">Per Pack</p>
                                            <p class="spec-value">{{ block.settings.product_2_per_pack }}</p>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <!-- Product 3 -->
                            <div class="sp-col-4">
                                <div class="sp-product-card">
                                    {%- if block.settings.product_3_image != blank -%}
                                        <img src="{{ block.settings.product_3_image | image_url: width: 400 }}" alt="{{ block.settings.product_3_title }}">
                                    {%- endif -%}
                                    <h3>{{ block.settings.product_3_title }}</h3>
                                    <p>{{ block.settings.product_3_desc }}</p>
                                    <div class="sp-product-features">
                                        <p>{{ block.settings.product_3_feature_1 }}</p>
                                        <p>{{ block.settings.product_3_feature_2 }}</p>
                                        <p>{{ block.settings.product_3_feature_3 }}</p>
                                    </div>
                                    <div class="sp-product-specs">
                                        <div class="sp-product-spec">
                                            <p class="spec-label">Sachets</p>
                                            <p class="spec-value">{{ block.settings.product_3_sachets }}</p>
                                        </div>
                                        <div class="sp-product-spec">
                                            <p class="spec-label">Per Sachet</p>
                                            <p class="spec-value">{{ block.settings.product_3_per_sachet }}</p>
                                        </div>
                                        <div class="sp-product-spec">
                                            <p class="spec-label">Per Pack</p>
                                            <p class="spec-value">{{ block.settings.product_3_per_pack }}</p>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </section>
                    <hr class="imop-divider">
            {%- endcase -%}
        {%- endfor -%}
        
        <!-- ============================================
             QUOTE FORM SECTION
             ============================================ -->
        <section class="sp-quote-section" id="Get-Quote">
            <div class="sp-quote-header">
                <h3>{{ section.settings.form_heading }}</h3>
                <p>{{ section.settings.form_subheading }}</p>
            </div>
            
            <div class="sp-quote-wrapper">
                {%- if section.settings.call_btn_text != blank -%}
                    <a href="{{ section.settings.call_btn_link }}" class="sp-callnow-btn">{{ section.settings.call_btn_text }}</a>
                {%- endif -%}
                
                <div class="sp-form-box">
                    <h5 class="sp-form-title">{{ section.settings.form_title }}</h5>

                    {%- if section.settings.show_hubspot_form -%}
                        {%- assign hs_target_sachet = 'hubspot-form-gogreen-sachet-' | append: section.id -%}
                        {% render 'hubspot-form',
                            form_id: '03da5c3c-6669-4ae1-843b-985c17935c7f',
                            target_id: hs_target_sachet
                        %}
                    {%- else -%}
                    {%- form 'contact', class: 'sp-quote-form' -%}
                        {%- if form.posted_successfully? -%}
                            <div class="sp-message success">
                                {{ section.settings.success_message }}
                            </div>
                        {%- endif -%}
                        
                        {%- if form.errors -%}
                            <div class="sp-message error">
                                {{ form.errors | default_errors }}
                            </div>
                        {%- endif -%}
                        
                        <input type="hidden" name="contact[page]" value="Sachet System">
                        
                        <div class="sp-form-field">
                            <input type="text" name="contact[name]" placeholder="NAME" required>
                        </div>
                        
                        <div class="sp-form-field">
                            <input type="email" name="contact[email]" placeholder="MAIL" required>
                        </div>
                        
                        <div class="sp-form-field">
                            <input type="tel" name="contact[phone]" placeholder="Phone Number" required>
                        </div>
                        
                        <div class="sp-form-field">
                            <textarea name="contact[body]" placeholder="MESSAGE" required></textarea>
                        </div>
                        
                        <div class="sp-form-submit">
                            <button type="submit">{{ section.settings.submit_btn_text }}</button>
                        </div>
                    {%- endform -%}
                    {%- endif -%}
                </div>
            </div>
        </section>
        
    </div>
</div>

