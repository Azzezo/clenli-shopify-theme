<div class="contact-products-section section-{{ section.id }}">
    <div class="cp-container">
        <!-- Top Header -->
        <div class="cp-header">
            {%- if section.settings.heading != blank -%}
                <h2 class="cp-heading">{{ section.settings.heading }}</h2>
            {%- endif -%}
            {%- if section.settings.description != blank -%}
                <p class="cp-description">{{ section.settings.description }}</p>
            {%- endif -%}
        </div>
        
        <!-- Main Grid -->
        <div class="cp-grid">
            <!-- Left: Contact Form -->
            <div class="cp-form-side">
                <!-- Call Now Bar -->
                <div class="call-now-bar">
                    <a href="tel:{{ section.settings.phone_number }}" class="call-now-link">
                        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07 19.5 19.5 0 01-6-6 19.79 19.79 0 01-3.07-8.67A2 2 0 014.11 2h3a2 2 0 012 1.72 12.84 12.84 0 00.7 2.81 2 2 0 01-.45 2.11L8.09 9.91a16 16 0 006 6l1.27-1.27a2 2 0 012.11-.45 12.84 12.84 0 002.81.7A2 2 0 0122 16.92z"/>
                        </svg>
                        {{ section.settings.call_now_text }}
                    </a>
                </div>
                
                <!-- Form Box -->
                <div class="form-box">
                    <h3 class="form-title">{{ section.settings.form_title }}</h3>

                    {% if section.settings.show_hubspot_form %}
                        {%- assign hs_target_terconv = 'hubspot-form-gogreen-terconv-' | append: section.id -%}
                        {% render 'hubspot-form',
                            form_id: '03da5c3c-6669-4ae1-843b-985c17935c7f',
                            target_id: hs_target_terconv
                        %}
                    {% else %}
                    {% form 'contact', class: 'contact-form' %}
                        {% if form.posted_successfully? %}
                            <div class="form-success">
                                <p>{{ section.settings.success_message }}</p>
                            </div>
                        {% endif %}
                        
                        {% if form.errors %}
                            <div class="form-errors">
                                {{ form.errors | default_errors }}
                            </div>
                        {% endif %}
                        
                        <div class="form-group">
                            <input type="text" name="contact[name]" placeholder="NAME" required>
                        </div>
                        
                        <div class="form-group">
                            <input type="email" name="contact[email]" placeholder="MAIL" required>
                        </div>
                        
                        <div class="form-group">
                            <input type="tel" name="contact[phone]" placeholder="Phone Number">
                        </div>
                        
                        <div class="form-group">
                            <textarea name="contact[body]" placeholder="MESSAGE" rows="4" required></textarea>
                        </div>
                        
                        <div class="form-submit">
                            <button type="submit" class="submit-btn">{{ section.settings.submit_text }}</button>
                        </div>
                    {% endform %}
                    {% endif %}
                </div>
            </div>
            
            <!-- Right: Products -->
            <div class="cp-products-side">
                <div class="products-grid">
                    {%- for block in section.blocks -%}
                        {%- if block.type == 'product' -%}
                            <div class="product-card" {{ block.shopify_attributes }}>
                                <a href="{{ block.settings.link | default: '#' }}" class="product-link">
                                    <div class="product-image">
                                        {%- if block.settings.image != blank -%}
                                            <img src="{{ block.settings.image | image_url: width: 400 }}" alt="{{ block.settings.title }}" loading="lazy">
                                        {%- else -%}
                                            {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
                                        {%- endif -%}
                                    </div>
                                    <h4 class="product-title">{{ block.settings.title }}</h4>
                                </a>
                            </div>
                        {%- endif -%}
                    {%- endfor -%}
                </div>
            </div>
        </div>
    </div>
</div>

{% style %}
.section-{{ section.id }} {
    padding: {{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px;
    background: {{ section.settings.bg_color }};
}

.section-{{ section.id }} .cp-container {
    max-width: 1370px;
    margin: 0 auto;
    padding: 0 20px;
}

/* Header */
.section-{{ section.id }} .cp-header {
    text-align: center;
    margin-bottom: 40px;
}

.section-{{ section.id }} .cp-heading {
    font-size: {{ section.settings.heading_size }}px;
    font-weight: 700;
    color: {{ section.settings.heading_color }};
    margin: 0 0 15px 0;
}

.section-{{ section.id }} .cp-description {
    font-size: 16px;
    line-height: 1.7;
    color: {{ section.settings.text_color }};
    max-width: 1000px;
    margin: 0 auto;
}

/* Main Grid */
.section-{{ section.id }} .cp-grid {
    display: flex;
    gap: 40px;
    align-items: flex-start;
}

/* Form Side */
.section-{{ section.id }} .cp-form-side {
    flex: 1.2;
    max-width: 600px;
}

/* Call Now Bar */
.section-{{ section.id }} .call-now-bar {
    background: {{ section.settings.accent_color }};
    padding: 12px 20px;
    border-radius: 4px 4px 0 0;
}

.section-{{ section.id }} .call-now-link {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    color: #fff;
    text-decoration: none;
    font-size: 15px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 1px;
}

.section-{{ section.id }} .call-now-link:hover {
    opacity: 0.9;
}

/* Form Box */
.section-{{ section.id }} .form-box {
    background: #fff;
    border: 2px solid {{ section.settings.accent_color }};
    border-top: none;
    padding: 30px;
}

.section-{{ section.id }} .form-title {
    font-size: 18px;
    font-weight: 600;
    color: {{ section.settings.heading_color }};
    text-align: center;
    margin: 0 0 25px 0;
    text-transform: uppercase;
    letter-spacing: 1px;
}

.section-{{ section.id }} .form-group {
    margin-bottom: 15px;
}

.section-{{ section.id }} .form-group input,
.section-{{ section.id }} .form-group textarea {
    width: 100%;
    padding: 12px 15px;
    border: none;
    border-bottom: 2px solid #ddd;
    background: transparent;
    font-size: 14px;
    color: #333;
    transition: border-color 0.3s ease;
    outline: none;
}

.section-{{ section.id }} .form-group input::placeholder,
.section-{{ section.id }} .form-group textarea::placeholder {
    color: {{ section.settings.accent_color }};
    font-weight: 500;
}

.section-{{ section.id }} .form-group input:focus,
.section-{{ section.id }} .form-group textarea:focus {
    border-bottom-color: {{ section.settings.accent_color }};
}

.section-{{ section.id }} .form-group textarea {
    resize: vertical;
    min-height: 100px;
}

.section-{{ section.id }} .form-submit {
    text-align: center;
    margin-top: 25px;
}

.section-{{ section.id }} .submit-btn {
    display: inline-block;
    padding: 14px 40px;
    background: {{ section.settings.button_bg }};
    color: {{ section.settings.button_color }};
    border: none;
    border-radius: 4px;
    font-size: 15px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 1px;
    cursor: pointer;
    transition: all 0.3s ease;
}

.section-{{ section.id }} .submit-btn:hover {
    background: {{ section.settings.button_hover_bg }};
    transform: translateY(-2px);
    box-shadow: 0 5px 15px rgba(0,0,0,0.2);
}

.section-{{ section.id }} .form-success {
    background: #d4edda;
    color: #155724;
    padding: 15px;
    border-radius: 4px;
    margin-bottom: 20px;
    text-align: center;
}

.section-{{ section.id }} .form-errors {
    background: #f8d7da;
    color: #721c24;
    padding: 15px;
    border-radius: 4px;
    margin-bottom: 20px;
}

/* Products Side */
.section-{{ section.id }} .cp-products-side {
    flex: 1;
}

.section-{{ section.id }} .products-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 25px;
}

.section-{{ section.id }} .product-card {
    background: #fff;
    border: 2px solid {{ section.settings.accent_color }};
    border-radius: 8px;
    padding: 20px;
    text-align: center;
    transition: all 0.3s ease;
}

.section-{{ section.id }} .product-card:hover {
    transform: translateY(-5px);
    box-shadow: 0 10px 30px rgba(0,0,0,0.1);
}

.section-{{ section.id }} .product-link {
    text-decoration: none;
}

.section-{{ section.id }} .product-image {
    margin-bottom: 15px;
}

.section-{{ section.id }} .product-image img {
    max-width: 100%;
    height: auto;
    max-height: 200px;
    object-fit: contain;
}

.section-{{ section.id }} .product-image .placeholder-svg {
    width: 100%;
    height: 150px;
    background: #f5f5f5;
}

.section-{{ section.id }} .product-title {
    font-size: 16px;
    font-weight: 600;
    color: {{ section.settings.heading_color }};
    margin: 0;
    line-height: 1.4;
}

/* Responsive */
@media (max-width: 991px) {
    .section-{{ section.id }} .cp-grid {
        flex-direction: column;
    }
    
    .section-{{ section.id }} .cp-form-side {
        max-width: 100%;
        width: 100%;
    }
    
    .section-{{ section.id }} .cp-products-side {
        width: 100%;
    }
}

@media (max-width: 575px) {
    .section-{{ section.id }} .cp-heading {
        font-size: 24px;
    }
    
    .section-{{ section.id }} .products-grid {
        grid-template-columns: 1fr;
    }
    
    .section-{{ section.id }} .form-box {
        padding: 20px;
    }
}
{% endstyle %}

{% schema %}
{
    "name": "Contact Products",
    "tag": "section",
    "settings": [
        {
            "type": "header",
            "content": "Enquiry Form"
        },
        {
            "type": "checkbox",
            "id": "show_hubspot_form",
            "label": "Use HubSpot Form",
            "info": "Replaces the default Shopify enquiry form with the HubSpot 'Go Green Today' embed.",
            "default": true
        },
        {
            "type": "header",
            "content": "Header"
        },
        {
            "type": "text",
            "id": "heading",
            "label": "Heading",
            "default": "Make the Change Today"
        },
        {
            "type": "textarea",
            "id": "description",
            "label": "Description",
            "default": "Tersano is the ultimate all-in-one cleaning solution that will help keep your premises cleaner, and your stakeholders safer – all while saving you money! To learn more about this amazing innovation, contact us today!"
        },
        {
            "type": "range",
            "id": "heading_size",
            "label": "Heading Size",
            "min": 24,
            "max": 48,
            "step": 2,
            "unit": "px",
            "default": 32
        },
        {
            "type": "header",
            "content": "Contact Form"
        },
        {
            "type": "text",
            "id": "call_now_text",
            "label": "Call Now Text",
            "default": "CALL NOW"
        },
        {
            "type": "text",
            "id": "phone_number",
            "label": "Phone Number",
            "default": "+1234567890"
        },
        {
            "type": "text",
            "id": "form_title",
            "label": "Form Title",
            "default": "GO GREEN TODAY ENQUIRE NOW"
        },
        {
            "type": "text",
            "id": "submit_text",
            "label": "Submit Button Text",
            "default": "SUBMIT"
        },
        {
            "type": "text",
            "id": "success_message",
            "label": "Success Message",
            "default": "Thank you for your message. We will contact you soon!"
        },
        {
            "type": "header",
            "content": "Colors"
        },
        {
            "type": "color",
            "id": "bg_color",
            "label": "Background",
            "default": "#ffffff"
        },
        {
            "type": "color",
            "id": "heading_color",
            "label": "Heading Color",
            "default": "#1a1a1a"
        },
        {
            "type": "color",
            "id": "text_color",
            "label": "Text Color",
            "default": "#555555"
        },
        {
            "type": "color",
            "id": "accent_color",
            "label": "Accent Color (Green)",
            "default": "#2d5a27"
        },
        {
            "type": "color",
            "id": "button_bg",
            "label": "Button Background",
            "default": "#555555"
        },
        {
            "type": "color",
            "id": "button_hover_bg",
            "label": "Button Hover",
            "default": "#333333"
        },
        {
            "type": "color",
            "id": "button_color",
            "label": "Button Text",
            "default": "#ffffff"
        },
        {
            "type": "header",
            "content": "Spacing"
        },
        {
            "type": "range",
            "id": "padding_top",
            "label": "Padding Top",
            "min": 0,
            "max": 100,
            "step": 5,
            "unit": "px",
            "default": 60
        },
        {
            "type": "range",
            "id": "padding_bottom",
            "label": "Padding Bottom",
            "min": 0,
            "max": 100,
            "step": 5,
            "unit": "px",
            "default": 60
        }
    ],
    "blocks": [
        {
            "type": "product",
            "name": "Product",
            "settings": [
                {
                    "type": "image_picker",
                    "id": "image",
                    "label": "Product Image"
                },
                {
                    "type": "text",
                    "id": "title",
                    "label": "Product Title",
                    "default": "Product Name"
                },
                {
                    "type": "url",
                    "id": "link",
                    "label": "Product Link"
                }
            ]
        }
    ],
    "presets": [
        {
            "name": "Contact Products",
            "blocks": [
                {
                    "type": "product",
                    "settings": {
                        "title": "Tersano Lotus Pro"
                    }
                },
                {
                    "type": "product",
                    "settings": {
                        "title": "Tersano iClean Mini"
                    }
                }
            ]
        }
    ]
}
{% endschema %}
