{%- liquid
    assign section_id = section.id
    assign heading = section.settings.heading
    assign heading_color = section.settings.heading_color
    assign heading_size = section.settings.heading_size
    assign underline_color = section.settings.underline_color
    assign underline_width = section.settings.underline_width
    assign bg_color = section.settings.bg_color
    assign container = section.settings.container
    assign label_color = section.settings.label_color
    assign label_size = section.settings.label_size
    assign input_border_color = section.settings.input_border_color
    assign input_bg_color = section.settings.input_bg_color
    assign input_text_color = section.settings.input_text_color
    assign button_bg_color = section.settings.button_bg_color
    assign button_text_color = section.settings.button_text_color
    assign button_hover_color = section.settings.button_hover_color
    assign required_color = section.settings.required_color
    assign padding_top = section.settings.padding_top
    assign padding_bottom = section.settings.padding_bottom
    assign padding_top_mobile = section.settings.padding_top_mobile
    assign padding_bottom_mobile = section.settings.padding_bottom_mobile
-%}

<style>
    #contact-form-{{ section_id }} {
        background-color: {{ bg_color }};
        padding-top: {{ padding_top }}px;
        padding-bottom: {{ padding_bottom }}px;
    }
    
    #contact-form-{{ section_id }} .cf-container {
        max-width: {% if container == '1170' %}1170px{% elsif container == '1370' %}1370px{% elsif container == '1570' %}1570px{% else %}1170px{% endif %};
        margin: 0 auto;
        padding: 0 15px;
    }
    
    #contact-form-{{ section_id }} .cf-heading {
        text-align: center;
        margin-bottom: 40px;
    }
    
    #contact-form-{{ section_id }} .cf-heading h2 {
        font-size: {{ heading_size }}px;
        font-weight: 700;
        color: {{ heading_color }};
        margin: 0 0 15px 0;
    }
    
    #contact-form-{{ section_id }} .cf-underline {
        width: {{ underline_width }}px;
        height: 2px;
        background-color: {{ underline_color }};
        margin: 0 auto;
    }
    
    #contact-form-{{ section_id }} .cf-form {
        max-width: 900px;
        margin: 0 auto;
    }
    
    #contact-form-{{ section_id }} .cf-row {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 30px;
        margin-bottom: 25px;
    }
    
    #contact-form-{{ section_id }} .cf-row.full-width {
        grid-template-columns: 1fr;
    }
    
    #contact-form-{{ section_id }} .cf-field {
        display: flex;
        flex-direction: column;
    }
    
    #contact-form-{{ section_id }} .cf-field label {
        font-size: {{ label_size }}px;
        font-weight: 600;
        color: {{ label_color }};
        margin-bottom: 8px;
    }
    
    #contact-form-{{ section_id }} .cf-field label .required {
        color: {{ required_color }};
        margin-left: 2px;
    }
    
    #contact-form-{{ section_id }} .cf-field input,
    #contact-form-{{ section_id }} .cf-field textarea {
        width: 100%;
        padding: 12px 15px;
        font-size: 15px;
        color: {{ input_text_color }};
        background-color: {{ input_bg_color }};
        border: 1px solid {{ input_border_color }};
        border-radius: 4px;
        outline: none;
        transition: border-color 0.3s ease, box-shadow 0.3s ease;
    }
    
    #contact-form-{{ section_id }} .cf-field input:focus,
    #contact-form-{{ section_id }} .cf-field textarea:focus {
        border-color: {{ button_bg_color }};
        box-shadow: 0 0 0 2px rgba(111, 179, 26, 0.1);
    }
    
    #contact-form-{{ section_id }} .cf-field input::placeholder,
    #contact-form-{{ section_id }} .cf-field textarea::placeholder {
        color: #999;
    }
    
    #contact-form-{{ section_id }} .cf-field textarea {
        min-height: 150px;
        resize: vertical;
    }
    
    #contact-form-{{ section_id }} .cf-submit {
        margin-top: 30px;
    }
    
    #contact-form-{{ section_id }} .cf-submit button {
        width: 100%;
        padding: 16px 30px;
        font-size: 18px;
        font-weight: 600;
        color: {{ button_text_color }};
        background: linear-gradient(135deg, {{ button_bg_color }} 0%, {{ button_hover_color }} 100%);
        border: none;
        border-radius: 4px;
        cursor: pointer;
        transition: all 0.3s ease;
    }
    
    #contact-form-{{ section_id }} .cf-submit button:hover {
        background: linear-gradient(135deg, {{ button_hover_color }} 0%, {{ button_bg_color }} 100%);
        transform: translateY(-2px);
        box-shadow: 0 5px 20px rgba(111, 179, 26, 0.3);
    }
    
    /* Success/Error Messages */
    #contact-form-{{ section_id }} .cf-message {
        padding: 15px 20px;
        border-radius: 4px;
        margin-bottom: 20px;
        text-align: center;
        font-size: 15px;
    }
    
    #contact-form-{{ section_id }} .cf-message.success {
        background-color: #d4edda;
        color: #155724;
        border: 1px solid #c3e6cb;
    }
    
    #contact-form-{{ section_id }} .cf-message.error {
        background-color: #f8d7da;
        color: #721c24;
        border: 1px solid #f5c6cb;
    }
    
    /* Tablet */
    @media (max-width: 768px) {
        #contact-form-{{ section_id }} .cf-row {
            grid-template-columns: 1fr;
            gap: 20px;
        }
        
        #contact-form-{{ section_id }} .cf-heading h2 {
            font-size: {{ heading_size | minus: 6 }}px;
        }
        
        #contact-form-{{ section_id }} .cf-heading {
            margin-bottom: 30px;
        }
    }
    
    /* Mobile */
    @media (max-width: 480px) {
        #contact-form-{{ section_id }} {
            padding-top: {{ padding_top_mobile }}px;
            padding-bottom: {{ padding_bottom_mobile }}px;
        }
        
        #contact-form-{{ section_id }} .cf-heading h2 {
            font-size: {{ heading_size | minus: 10 }}px;
        }
        
        #contact-form-{{ section_id }} .cf-field input,
        #contact-form-{{ section_id }} .cf-field textarea {
            padding: 10px 12px;
            font-size: 14px;
        }
        
        #contact-form-{{ section_id }} .cf-submit button {
            padding: 14px 25px;
            font-size: 16px;
        }
        
        #contact-form-{{ section_id }} .cf-row {
            margin-bottom: 20px;
        }
    }
</style>

<section id="contact-form-{{ section_id }}" class="contact-form-section">
    <div class="cf-container">
        <!-- Heading -->
        {%- if heading != blank -%}
            <div class="cf-heading">
                <h2>{{ heading }}</h2>
                <div class="cf-underline"></div>
            </div>
        {%- endif -%}
        
        <!-- Contact Form -->
        {%- form 'contact', class: 'cf-form' -%}
            {%- if form.posted_successfully? -%}
                <div class="cf-message success">
                    {{ section.settings.success_message }}
                </div>
            {%- endif -%}
            
            {%- if form.errors -%}
                <div class="cf-message error">
                    {{ form.errors | default_errors }}
                </div>
            {%- endif -%}
            
            <!-- Row 1: Name & Company -->
            <div class="cf-row">
                <div class="cf-field">
                    <label for="contact-name-{{ section_id }}">
                        {{ section.settings.name_label }}<span class="required">*</span>
                    </label>
                    <input 
                        type="text" 
                        id="contact-name-{{ section_id }}" 
                        name="contact[name]" 
                        placeholder="{{ section.settings.name_placeholder }}"
                        required
                    >
                </div>
                <div class="cf-field">
                    <label for="contact-company-{{ section_id }}">
                        {{ section.settings.company_label }}
                    </label>
                    <input 
                        type="text" 
                        id="contact-company-{{ section_id }}" 
                        name="contact[company]" 
                        placeholder="{{ section.settings.company_placeholder }}"
                    >
                </div>
            </div>
            
            <!-- Row 2: Phone & Email -->
            <div class="cf-row">
                <div class="cf-field">
                    <label for="contact-phone-{{ section_id }}">
                        {{ section.settings.phone_label }}<span class="required">*</span>
                    </label>
                    <input 
                        type="tel" 
                        id="contact-phone-{{ section_id }}" 
                        name="contact[phone]" 
                        placeholder="{{ section.settings.phone_placeholder }}"
                        required
                    >
                </div>
                <div class="cf-field">
                    <label for="contact-email-{{ section_id }}">
                        {{ section.settings.email_label }}<span class="required">*</span>
                    </label>
                    <input 
                        type="email" 
                        id="contact-email-{{ section_id }}" 
                        name="contact[email]" 
                        placeholder="{{ section.settings.email_placeholder }}"
                        required
                    >
                </div>
            </div>
            
            <!-- Row 3: Message (Full Width) -->
            <div class="cf-row full-width">
                <div class="cf-field">
                    <label for="contact-message-{{ section_id }}">
                        {{ section.settings.message_label }}<span class="required">*</span>
                    </label>
                    <textarea 
                        id="contact-message-{{ section_id }}" 
                        name="contact[body]" 
                        placeholder="{{ section.settings.message_placeholder }}"
                        required
                    ></textarea>
                </div>
            </div>
            
            <!-- Submit Button -->
            <div class="cf-submit">
                <button type="submit">{{ section.settings.button_text }}</button>
            </div>
        {%- endform -%}
    </div>
</section>

{% schema %}
{
    "name": "Contact Forms",
    "tag": "section",
    "class": "contact-form-block",
    "settings": [
        {
            "type": "header",
            "content": "Section Heading"
        },
        {
            "type": "text",
            "id": "heading",
            "label": "Heading",
            "default": "Get In Touch"
        },
        {
            "type": "color",
            "id": "heading_color",
            "label": "Heading Color",
            "default": "#1a365d"
        },
        {
            "type": "range",
            "id": "heading_size",
            "label": "Heading Font Size",
            "min": 24,
            "max": 50,
            "step": 1,
            "unit": "px",
            "default": 32
        },
        {
            "type": "color",
            "id": "underline_color",
            "label": "Underline Color",
            "default": "#1a365d"
        },
        {
            "type": "range",
            "id": "underline_width",
            "label": "Underline Width",
            "min": 50,
            "max": 200,
            "step": 10,
            "unit": "px",
            "default": 100
        },
        {
            "type": "header",
            "content": "Form Labels"
        },
        {
            "type": "text",
            "id": "name_label",
            "label": "Name Label",
            "default": "Name"
        },
        {
            "type": "text",
            "id": "name_placeholder",
            "label": "Name Placeholder",
            "default": "Enter your name"
        },
        {
            "type": "text",
            "id": "company_label",
            "label": "Company Label",
            "default": "Company"
        },
        {
            "type": "text",
            "id": "company_placeholder",
            "label": "Company Placeholder",
            "default": "Enter your company name"
        },
        {
            "type": "text",
            "id": "phone_label",
            "label": "Phone Label",
            "default": "Phone Number"
        },
        {
            "type": "text",
            "id": "phone_placeholder",
            "label": "Phone Placeholder",
            "default": "Enter your phone number"
        },
        {
            "type": "text",
            "id": "email_label",
            "label": "Email Label",
            "default": "Email"
        },
        {
            "type": "text",
            "id": "email_placeholder",
            "label": "Email Placeholder",
            "default": "Enter your email"
        },
        {
            "type": "text",
            "id": "message_label",
            "label": "Message Label",
            "default": "Message"
        },
        {
            "type": "text",
            "id": "message_placeholder",
            "label": "Message Placeholder",
            "default": "Enter your message"
        },
        {
            "type": "header",
            "content": "Form Styling"
        },
        {
            "type": "color",
            "id": "label_color",
            "label": "Label Color",
            "default": "#232323"
        },
        {
            "type": "range",
            "id": "label_size",
            "label": "Label Font Size",
            "min": 12,
            "max": 20,
            "step": 1,
            "unit": "px",
            "default": 15
        },
        {
            "type": "color",
            "id": "required_color",
            "label": "Required Star Color",
            "default": "#dc3545"
        },
        {
            "type": "color",
            "id": "input_border_color",
            "label": "Input Border Color",
            "default": "#cccccc"
        },
        {
            "type": "color",
            "id": "input_bg_color",
            "label": "Input Background Color",
            "default": "#ffffff"
        },
        {
            "type": "color",
            "id": "input_text_color",
            "label": "Input Text Color",
            "default": "#333333"
        },
        {
            "type": "header",
            "content": "Button Settings"
        },
        {
            "type": "text",
            "id": "button_text",
            "label": "Button Text",
            "default": "Submit"
        },
        {
            "type": "color",
            "id": "button_bg_color",
            "label": "Button Background Color",
            "default": "#6fb31a"
        },
        {
            "type": "color",
            "id": "button_text_color",
            "label": "Button Text Color",
            "default": "#ffffff"
        },
        {
            "type": "color",
            "id": "button_hover_color",
            "label": "Button Hover/Gradient Color",
            "default": "#8bc34a"
        },
        {
            "type": "header",
            "content": "Success Message"
        },
        {
            "type": "text",
            "id": "success_message",
            "label": "Success Message",
            "default": "Thank you for your message! We will get back to you soon."
        },
        {
            "type": "header",
            "content": "Layout Settings"
        },
        {
            "type": "color",
            "id": "bg_color",
            "label": "Section Background Color",
            "default": "#f5f5f5"
        },
        {
            "type": "select",
            "id": "container",
            "label": "Container Width",
            "default": "1170",
            "options": [
                {"value": "1170", "label": "1170px"},
                {"value": "1370", "label": "1370px"},
                {"value": "1570", "label": "1570px"}
            ]
        },
        {
            "type": "range",
            "id": "padding_top",
            "label": "Padding Top (Desktop)",
            "min": 0,
            "max": 100,
            "step": 5,
            "unit": "px",
            "default": 60
        },
        {
            "type": "range",
            "id": "padding_bottom",
            "label": "Padding Bottom (Desktop)",
            "min": 0,
            "max": 100,
            "step": 5,
            "unit": "px",
            "default": 60
        },
        {
            "type": "range",
            "id": "padding_top_mobile",
            "label": "Padding Top (Mobile)",
            "min": 0,
            "max": 80,
            "step": 5,
            "unit": "px",
            "default": 40
        },
        {
            "type": "range",
            "id": "padding_bottom_mobile",
            "label": "Padding Bottom (Mobile)",
            "min": 0,
            "max": 80,
            "step": 5,
            "unit": "px",
            "default": 40
        }
    ],
    "presets": [
        {
            "name": "Contact Form"
        }
    ]
}
{% endschema %}