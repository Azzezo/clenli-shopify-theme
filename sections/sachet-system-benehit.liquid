<div class="benefits-section section-{{ section.id }}">
    <div class="benefits-container">
        <!-- Heading -->
        <div class="benefits-header">
            {%- if section.settings.heading != blank -%}
                <h2 class="benefits-heading">{{ section.settings.heading }}</h2>
            {%- endif -%}
            
            {%- if section.settings.subtext != blank -%}
                <p class="benefits-subtext">{{ section.settings.subtext }}</p>
            {%- endif -%}
        </div>
        
        <!-- Cards -->
        <div class="benefits-cards">
            {%- for block in section.blocks -%}
                {%- if block.type == 'card' -%}
                    <div class="benefit-card" {{ block.shopify_attributes }}>
                        <div class="card-image">
                            {%- if block.settings.image != blank -%}
                                <img src="{{ block.settings.image | image_url: width: 600 }}" alt="{{ block.settings.title }}" loading="lazy">
                            {%- else -%}
                                {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
                            {%- endif -%}
                        </div>
                        <div class="card-content">
                            {%- if block.settings.title != blank -%}
                                <h3 class="card-title">{{ block.settings.title }}</h3>
                            {%- endif -%}
                            {%- if block.settings.text != blank -%}
                                <p class="card-text">{{ block.settings.text }}</p>
                            {%- endif -%}
                        </div>
                    </div>
                {%- endif -%}
            {%- endfor -%}
        </div>
        
        <!-- Green Divider -->
        <div class="benefits-divider"></div>
        
        <!-- Bottom Section -->
        {%- if section.settings.bottom_heading != blank -%}
            <div class="benefits-bottom">
                <h2 class="bottom-heading">{{ section.settings.bottom_heading }}</h2>
                {%- if section.settings.bottom_text != blank -%}
                    <p class="bottom-text">{{ section.settings.bottom_text }}</p>
                {%- endif -%}
            </div>
        {%- endif -%}
    </div>
</div>

{% style %}
.section-{{ section.id }} {
    padding: {{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px;
    background: {{ section.settings.bg_color }};
}

.section-{{ section.id }} .benefits-container {
    max-width: 1370px;
    margin: 0 auto;
    padding: 0 20px;
}

/* Header */
.section-{{ section.id }} .benefits-header {
    text-align: center;
    margin-bottom: 40px;
}

.section-{{ section.id }} .benefits-heading {
    font-size: {{ section.settings.heading_size }}px;
    font-weight: 700;
    color: {{ section.settings.heading_color }};
    margin: 0 0 15px 0;
    line-height: 1.3;
}

.section-{{ section.id }} .benefits-subtext {
    font-size: 16px;
    line-height: 1.7;
    color: {{ section.settings.text_color }};
    max-width: 1000px;
    margin: 0 auto;
}

/* Cards Grid */
.section-{{ section.id }} .benefits-cards {
    display: grid;
    grid-template-columns: repeat({{ section.settings.columns }}, 1fr);
    gap: {{ section.settings.card_gap }}px;
    margin-bottom: 50px;
}

/* Card */
.section-{{ section.id }} .benefit-card {
    background: {{ section.settings.card_bg }};
    border-radius: {{ section.settings.card_radius }}px;
    overflow: hidden;
    box-shadow: 0 5px 20px rgba(0,0,0,0.08);
    transition: all 0.3s ease;
}

.section-{{ section.id }} .benefit-card:hover {
    transform: translateY(-5px);
    box-shadow: 0 15px 40px rgba(0,0,0,0.12);
}

.section-{{ section.id }} .card-image {
    width: 100%;
    aspect-ratio: 16/10;
    overflow: hidden;
}

.section-{{ section.id }} .card-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.3s ease;
}

.section-{{ section.id }} .benefit-card:hover .card-image img {
    transform: scale(1.05);
}

.section-{{ section.id }} .card-image .placeholder-svg {
    width: 100%;
    height: 100%;
    background: #f5f5f5;
}

.section-{{ section.id }} .card-content {
    padding: 25px;
    text-align: center;
}

.section-{{ section.id }} .card-title {
    font-size: 20px;
    font-weight: 700;
    color: {{ section.settings.heading_color }};
    margin: 0 0 10px 0;
}

.section-{{ section.id }} .card-text {
    font-size: 15px;
    line-height: 1.6;
    color: {{ section.settings.text_color }};
    margin: 0;
}

/* Divider */
.section-{{ section.id }} .benefits-divider {
    height: 4px;
    background: {{ section.settings.divider_color }};
    border-radius: 2px;
    margin-bottom: 50px;
}

/* Bottom Section */
.section-{{ section.id }} .benefits-bottom {
    text-align: center;
}

.section-{{ section.id }} .bottom-heading {
    font-size: {{ section.settings.heading_size }}px;
    font-weight: 700;
    color: {{ section.settings.heading_color }};
    margin: 0 0 15px 0;
}

.section-{{ section.id }} .bottom-text {
    font-size: 16px;
    line-height: 1.7;
    color: {{ section.settings.text_color }};
    max-width: 1000px;
    margin: 0 auto;
}

/* Responsive */
@media (max-width: 991px) {
    .section-{{ section.id }} .benefits-cards {
        grid-template-columns: repeat(2, 1fr);
    }
    
    .section-{{ section.id }} .benefits-heading,
    .section-{{ section.id }} .bottom-heading {
        font-size: 28px;
    }
}

@media (max-width: 575px) {
    .section-{{ section.id }} .benefits-cards {
        grid-template-columns: 1fr;
    }
    
    .section-{{ section.id }} .benefits-heading,
    .section-{{ section.id }} .bottom-heading {
        font-size: 24px;
    }
    
    .section-{{ section.id }} .card-content {
        padding: 20px;
    }
}
{% endstyle %}

{% schema %}
{
    "name": "Benefits Cards",
    "tag": "section",
    "settings": [
        {
            "type": "header",
            "content": "Top Section"
        },
        {
            "type": "text",
            "id": "heading",
            "label": "Heading",
            "default": "PVA Sustainable Benefits"
        },
        {
            "type": "textarea",
            "id": "subtext",
            "label": "Subtext",
            "default": "Every business has a responsibility to the environment and future generations. PVA Hygiene sachets allow businesses to eliminate single-use plastic and significantly reduce their carbon emissions, without compromising on effective cleaning."
        },
        {
            "type": "header",
            "content": "Bottom Section"
        },
        {
            "type": "text",
            "id": "bottom_heading",
            "label": "Bottom Heading",
            "default": "PVA Safety Benefits"
        },
        {
            "type": "textarea",
            "id": "bottom_text",
            "label": "Bottom Text",
            "default": "PVA Hygiene sachets allow businesses to reduce and eliminate risks associated with the use of cleaning chemicals. With PVA sachets, you significantly reduce your exposure to chemicals, spills and the chance of manual handling injuries."
        },
        {
            "type": "header",
            "content": "Layout"
        },
        {
            "type": "range",
            "id": "columns",
            "label": "Columns",
            "min": 2,
            "max": 4,
            "step": 1,
            "default": 3
        },
        {
            "type": "range",
            "id": "card_gap",
            "label": "Card Gap",
            "min": 15,
            "max": 50,
            "step": 5,
            "unit": "px",
            "default": 30
        },
        {
            "type": "range",
            "id": "heading_size",
            "label": "Heading Size",
            "min": 24,
            "max": 48,
            "step": 2,
            "unit": "px",
            "default": 32
        },
        {
            "type": "range",
            "id": "card_radius",
            "label": "Card Radius",
            "min": 0,
            "max": 20,
            "step": 2,
            "unit": "px",
            "default": 8
        },
        {
            "type": "header",
            "content": "Colors"
        },
        {
            "type": "color",
            "id": "bg_color",
            "label": "Background",
            "default": "#ffffff"
        },
        {
            "type": "color",
            "id": "card_bg",
            "label": "Card Background",
            "default": "#ffffff"
        },
        {
            "type": "color",
            "id": "heading_color",
            "label": "Heading Color",
            "default": "#1a1a1a"
        },
        {
            "type": "color",
            "id": "text_color",
            "label": "Text Color",
            "default": "#555555"
        },
        {
            "type": "color",
            "id": "divider_color",
            "label": "Divider Color",
            "default": "#6fb31a"
        },
        {
            "type": "header",
            "content": "Spacing"
        },
        {
            "type": "range",
            "id": "padding_top",
            "label": "Padding Top",
            "min": 0,
            "max": 100,
            "step": 5,
            "unit": "px",
            "default": 60
        },
        {
            "type": "range",
            "id": "padding_bottom",
            "label": "Padding Bottom",
            "min": 0,
            "max": 100,
            "step": 5,
            "unit": "px",
            "default": 60
        }
    ],
    "blocks": [
        {
            "type": "card",
            "name": "Benefit Card",
            "settings": [
                {
                    "type": "image_picker",
                    "id": "image",
                    "label": "Image"
                },
                {
                    "type": "text",
                    "id": "title",
                    "label": "Title",
                    "default": "Recyclable Packaging"
                },
                {
                    "type": "textarea",
                    "id": "text",
                    "label": "Description",
                    "default": "All packaging is recyclable, and the pouches are also compostable."
                }
            ]
        }
    ],
    "presets": [
        {
            "name": "Benefits Cards",
            "blocks": [
                {
                    "type": "card",
                    "settings": {
                        "title": "Recyclable Packaging",
                        "text": "All packaging is recyclable, and the pouches are also compostable."
                    }
                },
                {
                    "type": "card",
                    "settings": {
                        "title": "No Single Use Plastic",
                        "text": "Our bottles are designed to be durable and last a lifetime, reducing plastic waste by 90%."
                    }
                },
                {
                    "type": "card",
                    "settings": {
                        "title": "Less Deliveries Needed",
                        "text": "PVA Soluble Sachets result in no transportation of water, reducing carbon footprint by 95%."
                    }
                }
            ]
        }
    ]
}
{% endschema %}
