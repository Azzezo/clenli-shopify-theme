{%- liquid
    assign section_id = section.id
    assign banner_image = section.settings.banner_image
    assign banner_width = section.settings.banner_width
    assign heading = section.settings.heading
    assign heading_color = section.settings.heading_color
    assign heading_size = section.settings.heading_size
    assign button_text = section.settings.button_text
    assign button_link = section.settings.button_link
    assign button_bg_color = section.settings.button_bg_color
    assign button_text_color = section.settings.button_text_color
    assign button_hover_color = section.settings.button_hover_color
    assign underline_color = section.settings.underline_color
    assign underline_height = section.settings.underline_height
    assign bg_color = section.settings.bg_color
    assign padding_top = section.settings.padding_top
    assign padding_bottom = section.settings.padding_bottom
    assign padding_top_mobile = section.settings.padding_top_mobile
    assign padding_bottom_mobile = section.settings.padding_bottom_mobile
-%}

<style>
    #banner-section-{{ section_id }} {
        background-color: {{ bg_color }};
        padding-top: {{ padding_top }}px;
        padding-bottom: {{ padding_bottom }}px;
    }
    
    #banner-section-{{ section_id }} .bs-container {
        max-width: 1400px;
        margin: 0 auto;
        padding: 0 15px;
    }
    
    #banner-section-{{ section_id }} .bs-content {
        display: flex;
        flex-direction: column;
        align-items: center;
        text-align: center;
    }
    
    /* Banner Image - 80% width */
    #banner-section-{{ section_id }} .bs-banner {
        width: {{ banner_width }}%;
        margin: 0 auto 30px;
        border-radius: {{ section.settings.banner_radius }}px;
        overflow: hidden;
    }
    
    #banner-section-{{ section_id }} .bs-banner img {
        width: 100%;
        height: auto;
        display: block;
        object-fit: cover;
    }
    
    #banner-section-{{ section_id }} .bs-banner .placeholder-banner {
        width: 100%;
        height: 300px;
        background: linear-gradient(135deg, #1a365d 0%, #2d5a87 100%);
        display: flex;
        align-items: center;
        justify-content: center;
        color: #fff;
        font-size: 18px;
    }
    
    /* Heading */
    #banner-section-{{ section_id }} .bs-heading {
        font-size: {{ heading_size }}px;
        font-weight: 700;
        color: {{ heading_color }};
        margin: 0 0 20px 0;
        line-height: 1.3;
    }
    
    /* Button */
    #banner-section-{{ section_id }} .bs-button {
        display: inline-block;
        padding: 14px 40px;
        font-size: 16px;
        font-weight: 600;
        color: {{ button_text_color }};
        background-color: {{ button_bg_color }};
        border: none;
        border-radius: 4px;
        text-decoration: none;
        cursor: pointer;
        transition: all 0.3s ease;
        margin-bottom: 30px;
    }
    
    #banner-section-{{ section_id }} .bs-button:hover {
        background-color: {{ button_hover_color }};
        transform: translateY(-2px);
        box-shadow: 0 5px 20px rgba(111, 179, 26, 0.3);
    }
    
    /* Full Width Underline */
    #banner-section-{{ section_id }} .bs-underline {
        width: 100%;
        height: {{ underline_height }}px;
        background-color: {{ underline_color }};
        margin-top: 10px;
    }
    
    /* Tablet */
    @media (max-width: 1024px) {
        #banner-section-{{ section_id }} .bs-banner {
            width: 90%;
        }
        
        #banner-section-{{ section_id }} .bs-heading {
            font-size: {{ heading_size | minus: 4 }}px;
        }
    }
    
    /* Mobile */
    @media (max-width: 767px) {
        #banner-section-{{ section_id }} {
            padding-top: {{ padding_top_mobile }}px;
            padding-bottom: {{ padding_bottom_mobile }}px;
        }
        
        #banner-section-{{ section_id }} .bs-banner {
            width: 95%;
            margin-bottom: 20px;
        }
        
        #banner-section-{{ section_id }} .bs-banner .placeholder-banner {
            height: 200px;
        }
        
        #banner-section-{{ section_id }} .bs-heading {
            font-size: {{ heading_size | minus: 8 }}px;
            margin-bottom: 15px;
        }
        
        #banner-section-{{ section_id }} .bs-button {
            padding: 12px 30px;
            font-size: 14px;
            margin-bottom: 20px;
        }
    }
</style>

<section id="banner-section-{{ section_id }}" class="banner-section">
    <div class="bs-container">
        <div class="bs-content">
            
            <!-- Banner Image (80% width) -->
            <div class="bs-banner">
                {%- if banner_image != blank -%}
                    <img src="{{ banner_image | image_url: width: 1400 }}" alt="{{ section.settings.banner_alt | default: 'Banner Image' }}" loading="lazy">
                {%- else -%}
                    <div class="placeholder-banner">
                        <span>Banner Image ({{ banner_width }}% width)</span>
                    </div>
                {%- endif -%}
            </div>
            
            <!-- Heading -->
            {%- if heading != blank -%}
                <h2 class="bs-heading">{{ heading }}</h2>
            {%- endif -%}
            
            <!-- Button -->
            {%- if button_text != blank -%}
                <a href="{{ button_link }}" class="bs-button">{{ button_text }}</a>
            {%- endif -%}
            
            <!-- Full Width Underline -->
            <div class="bs-underline"></div>
            
        </div>
    </div>
</section>

{% schema %}
{
    "name": "Banner With Underline",
    "tag": "section",
    "class": "banner-underline-section",
    "settings": [
        {
            "type": "header",
            "content": "Banner Image"
        },
        {
            "type": "image_picker",
            "id": "banner_image",
            "label": "Banner Image"
        },
        {
            "type": "text",
            "id": "banner_alt",
            "label": "Banner Alt Text",
            "default": "Banner Image"
        },
        {
            "type": "range",
            "id": "banner_width",
            "label": "Banner Width (%)",
            "min": 50,
            "max": 100,
            "step": 5,
            "unit": "%",
            "default": 80
        },
        {
            "type": "range",
            "id": "banner_radius",
            "label": "Banner Border Radius",
            "min": 0,
            "max": 30,
            "step": 2,
            "unit": "px",
            "default": 0
        },
        {
            "type": "header",
            "content": "Heading"
        },
        {
            "type": "text",
            "id": "heading",
            "label": "Heading Text",
            "default": "Your Heading Here"
        },
        {
            "type": "color",
            "id": "heading_color",
            "label": "Heading Color",
            "default": "#232323"
        },
        {
            "type": "range",
            "id": "heading_size",
            "label": "Heading Font Size",
            "min": 18,
            "max": 50,
            "step": 1,
            "unit": "px",
            "default": 28
        },
        {
            "type": "header",
            "content": "Button"
        },
        {
            "type": "text",
            "id": "button_text",
            "label": "Button Text",
            "default": "Learn More"
        },
        {
            "type": "url",
            "id": "button_link",
            "label": "Button Link"
        },
        {
            "type": "color",
            "id": "button_bg_color",
            "label": "Button Background Color",
            "default": "#6fb31a"
        },
        {
            "type": "color",
            "id": "button_text_color",
            "label": "Button Text Color",
            "default": "#ffffff"
        },
        {
            "type": "color",
            "id": "button_hover_color",
            "label": "Button Hover Color",
            "default": "#5a9216"
        },
        {
            "type": "header",
            "content": "Full Width Underline"
        },
        {
            "type": "color",
            "id": "underline_color",
            "label": "Underline Color",
            "default": "#6fb31a"
        },
        {
            "type": "range",
            "id": "underline_height",
            "label": "Underline Height",
            "min": 1,
            "max": 10,
            "step": 1,
            "unit": "px",
            "default": 3
        },
        {
            "type": "header",
            "content": "Section Settings"
        },
        {
            "type": "color",
            "id": "bg_color",
            "label": "Background Color",
            "default": "#ffffff"
        },
        {
            "type": "range",
            "id": "padding_top",
            "label": "Padding Top (Desktop)",
            "min": 0,
            "max": 100,
            "step": 5,
            "unit": "px",
            "default": 60
        },
        {
            "type": "range",
            "id": "padding_bottom",
            "label": "Padding Bottom (Desktop)",
            "min": 0,
            "max": 100,
            "step": 5,
            "unit": "px",
            "default": 60
        },
        {
            "type": "range",
            "id": "padding_top_mobile",
            "label": "Padding Top (Mobile)",
            "min": 0,
            "max": 80,
            "step": 5,
            "unit": "px",
            "default": 40
        },
        {
            "type": "range",
            "id": "padding_bottom_mobile",
            "label": "Padding Bottom (Mobile)",
            "min": 0,
            "max": 80,
            "step": 5,
            "unit": "px",
            "default": 40
        }
    ],
    "presets": [
        {
            "name": "Banner With Underline"
        }
    ]
}
{% endschema %}
