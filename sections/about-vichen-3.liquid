<div class="img-heading-desc-section section-{{ section.id }}">
    <div class="ihd-container">
        
        <!-- Image -->
        {%- if section.settings.image != blank -%}
            <div class="ihd-image">
                <img src="{{ section.settings.image | image_url: width: 1200 }}" alt="{{ section.settings.heading }}" loading="lazy">
            </div>
        {%- endif -%}
        
        <!-- Heading -->
        {%- if section.settings.heading != blank -%}
            <h2 class="ihd-heading">{{ section.settings.heading }}</h2>
        {%- endif -%}
        
        <!-- Description -->
        {%- if section.settings.description != blank -%}
            <div class="ihd-description">{{ section.settings.description }}</div>
        {%- endif -%}
        
    </div>
</div>

{% style %}
.section-{{ section.id }} {
    padding: {{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px;
    background: {{ section.settings.bg_color }};
}

.section-{{ section.id }} .ihd-container {
    max-width: {{ section.settings.content_width }}px;
    margin: 0 auto;
    padding: 0 20px;
    text-align: {{ section.settings.text_align }};
}

/* Image */
.section-{{ section.id }} .ihd-image {
    margin-bottom: {{ section.settings.image_margin }}px;
}

.section-{{ section.id }} .ihd-image img {
    width: {{ section.settings.image_width }}px;
    height: {{ section.settings.image_height }}px;
    object-fit: {{ section.settings.image_fit }};
    border-radius: {{ section.settings.image_radius }}px;
    max-width: 100%;
}

/* Heading */
.section-{{ section.id }} .ihd-heading {
    font-size: {{ section.settings.heading_size }}px;
    font-weight: 700;
    color: {{ section.settings.heading_color }};
    margin: 0 0 {{ section.settings.heading_margin }}px 0;
    line-height: 1.3;
}

/* Description */
.section-{{ section.id }} .ihd-description {
    font-size: {{ section.settings.text_size }}px;
    line-height: {{ section.settings.line_height }};
    color: {{ section.settings.text_color }};
    margin: 0;
}

.section-{{ section.id }} .ihd-description p {
    margin: 0 0 15px 0;
}

.section-{{ section.id }} .ihd-description p:last-child {
    margin: 0;
}

/* Responsive */
@media (max-width: 768px) {
    .section-{{ section.id }} .ihd-image img {
        width: 100%;
        height: auto;
    }
    
    .section-{{ section.id }} .ihd-heading {
        font-size: {{ section.settings.heading_size | times: 0.75 | round }}px;
    }
    
    .section-{{ section.id }} .ihd-description {
        font-size: {{ section.settings.text_size | minus: 2 }}px;
    }
}
{% endstyle %}

{% schema %}
{
    "name": "Image Heading Description",
    "tag": "section",
    "settings": [
        {
            "type": "header",
            "content": "Image"
        },
        {
            "type": "image_picker",
            "id": "image",
            "label": "Image"
        },
        {
            "type": "range",
            "id": "image_width",
            "label": "Image Width",
            "min": 100,
            "max": 800,
            "step": 50,
            "unit": "px",
            "default": 400
        },
        {
            "type": "range",
            "id": "image_height",
            "label": "Image Height",
            "min": 100,
            "max": 600,
            "step": 50,
            "unit": "px",
            "default": 300
        },
        {
            "type": "select",
            "id": "image_fit",
            "label": "Image Fit",
            "default": "cover",
            "options": [
                {"value": "cover", "label": "Cover"},
                {"value": "contain", "label": "Contain"},
                {"value": "fill", "label": "Fill"}
            ]
        },
        {
            "type": "range",
            "id": "image_radius",
            "label": "Image Radius",
            "min": 0,
            "max": 50,
            "step": 5,
            "unit": "px",
            "default": 10
        },
        {
            "type": "range",
            "id": "image_margin",
            "label": "Space Below Image",
            "min": 10,
            "max": 60,
            "step": 5,
            "unit": "px",
            "default": 30
        },
        {
            "type": "header",
            "content": "Content"
        },
        {
            "type": "text",
            "id": "heading",
            "label": "Heading",
            "default": "Our Mission"
        },
        {
            "type": "richtext",
            "id": "description",
            "label": "Description",
            "default": "<p>We are committed to providing top-quality cleaning solutions for businesses across the country. Our innovative products help maintain cleaner, healthier environments while reducing environmental impact.</p>"
        },
        {
            "type": "header",
            "content": "Layout"
        },
        {
            "type": "range",
            "id": "content_width",
            "label": "Content Width",
            "min": 600,
            "max": 1400,
            "step": 100,
            "unit": "px",
            "default": 900
        },
        {
            "type": "select",
            "id": "text_align",
            "label": "Text Alignment",
            "default": "center",
            "options": [
                {"value": "left", "label": "Left"},
                {"value": "center", "label": "Center"},
                {"value": "right", "label": "Right"}
            ]
        },
        {
            "type": "header",
            "content": "Heading Style"
        },
        {
            "type": "range",
            "id": "heading_size",
            "label": "Heading Size",
            "min": 24,
            "max": 60,
            "step": 2,
            "unit": "px",
            "default": 36
        },
        {
            "type": "range",
            "id": "heading_margin",
            "label": "Space Below Heading",
            "min": 10,
            "max": 50,
            "step": 5,
            "unit": "px",
            "default": 20
        },
        {
            "type": "header",
            "content": "Description Style"
        },
        {
            "type": "range",
            "id": "text_size",
            "label": "Text Size",
            "min": 14,
            "max": 22,
            "step": 1,
            "unit": "px",
            "default": 16
        },
        {
            "type": "range",
            "id": "line_height",
            "label": "Line Height",
            "min": 1.4,
            "max": 2.2,
            "step": 0.1,
            "default": 1.8
        },
        {
            "type": "header",
            "content": "Colors"
        },
        {
            "type": "color",
            "id": "bg_color",
            "label": "Background",
            "default": "#ffffff"
        },
        {
            "type": "color",
            "id": "heading_color",
            "label": "Heading Color",
            "default": "#1a1a1a"
        },
        {
            "type": "color",
            "id": "text_color",
            "label": "Text Color",
            "default": "#555555"
        },
        {
            "type": "header",
            "content": "Spacing"
        },
        {
            "type": "range",
            "id": "padding_top",
            "label": "Padding Top",
            "min": 0,
            "max": 100,
            "step": 10,
            "unit": "px",
            "default": 60
        },
        {
            "type": "range",
            "id": "padding_bottom",
            "label": "Padding Bottom",
            "min": 0,
            "max": 100,
            "step": 10,
            "unit": "px",
            "default": 60
        }
    ],
    "presets": [
        {
            "name": "Image Heading Description"
        }
    ]
}
{% endschema %}
