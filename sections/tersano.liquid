    },
    {
      "type": "text",
      "id": "hero_btn_text",
      "label": "Button Text",
      "default": "Get Quote Today"
    },
    {
      "type": "url",
      "id": "hero_btn_link",
      "label": "Button Link"
    },
    {
      "type": "header",
      "content": "What is Tersano Section"
    },
    {
      "type": "image_picker",
      "id": "what_image",
      "label": "Image"
    },
    {
