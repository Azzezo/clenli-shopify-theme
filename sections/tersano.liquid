    {
      "type": "text",
      "id": "step3_text",
      "label": "Step 3 Text",
      "default": "SAO cleans for days before it safely reverts back to water and O2."
    },
    {
      "type": "header",
      "content": "Where to Use Tersano"
    },
    {
      "type": "image_picker",
      "id": "where_image",
      "label": "Image"
    },
    {
      "type": "text",
      "id": "where_title",
      "label": "Title",
      "default": "Where to Use Tersano"
    },
    {
      "type": "textarea",
