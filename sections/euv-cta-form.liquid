<div class="euv-cta section-{{ section.id }}">
    <div class="cta-container">
        <div class="cta-grid">
            
            <!-- Left Content - 50% -->
            <div class="cta-content">
                {%- if section.settings.heading != blank -%}
                    <h2 class="cta-heading">{{ section.settings.heading }}</h2>
                {%- endif -%}
                {%- if section.settings.description != blank -%}
                    <p class="cta-description">{{ section.settings.description }}</p>
                {%- endif -%}
                {%- if section.settings.button_text != blank -%}
                    <a href="{{ section.settings.button_link | default: '#' }}" class="cta-btn">{{ section.settings.button_text }}</a>
                {%- endif -%}
                
                <!-- Footer Image -->
                {%- if section.settings.footer_image != blank -%}
                    <div class="cta-footer-image">
                        <img src="{{ section.settings.footer_image | image_url: width: 1000 }}" alt="Explore Range" loading="lazy">
                    </div>
                {%- endif -%}
            </div>
            
            <!-- Right Form - 50% -->
            <div class="cta-form-wrap">
                <!-- Call Now Bar -->
                <div class="callnow-bar">
                    <a href="tel:{{ section.settings.phone_number }}">
                        <span class="phone-icon">📞</span>
                        {{ section.settings.call_now_text }}
                    </a>
                </div>
                
                <!-- Form Box -->
                <div class="form-box">
                    <h5 class="form-title">{{ section.settings.form_title }}</h5>

                    {% if section.settings.show_hubspot_form %}
                        {%- assign hs_target_euv = 'hubspot-form-gogreen-euv-' | append: section.id -%}
                        {% render 'hubspot-form',
                            form_id: '03da5c3c-6669-4ae1-843b-985c17935c7f',
                            target_id: hs_target_euv
                        %}
                    {% else %}
                    {% form 'contact', class: 'euv-contact-form' %}
                        
                        {%- if form.posted_successfully? -%}
                            <div class="form-success">
                                {{ section.settings.success_message }}
                            </div>
                        {%- endif -%}
                        
                        {%- if form.errors -%}
                            <div class="form-error">
                                {{ form.errors | default_errors }}
                            </div>
                        {%- endif -%}
                        
                        <div class="form-field">
                            <input type="text" name="contact[name]" placeholder="NAME" required>
                        </div>
                        
                        <div class="form-field">
                            <input type="email" name="contact[email]" placeholder="EMAIL" required>
                        </div>
                        
                        <div class="form-field">
                            <input type="tel" name="contact[phone]" placeholder="PHONE NUMBER" required>
                        </div>
                        
                        <div class="form-field">
                            <textarea name="contact[body]" placeholder="MESSAGE" rows="4" required></textarea>
                        </div>
                        
                        <button type="submit" class="submit-btn">{{ section.settings.submit_text }}</button>
                        
                    {% endform %}
                    {% endif %}
                </div>
            </div>
            
        </div>
    </div>
</div>

{% style %}
.section-{{ section.id }} {
    padding: {{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px;
    background: {{ section.settings.bg_color }};
}

.section-{{ section.id }} .cta-container {
    max-width: 1570px;
    margin: 0 auto;
    padding: 0 20px;
}

/* 50-50 Grid Layout */
.section-{{ section.id }} .cta-grid {
    display: grid;
    grid-template-columns: 1fr 1fr; /* 50% - 50% split */
    gap: 60px;
    align-items: start;
}

/* Left Content - 50% Width */
.section-{{ section.id }} .cta-content {
    text-align: center;
    width: 100%;
}

.section-{{ section.id }} .cta-heading {
    font-size: 20px;
    font-weight: 700;
    color: {{ section.settings.heading_color }};
    margin: 0 0 15px 0;
}

.section-{{ section.id }} .cta-description {
    font-size: 16px;
    line-height: 1.6;
    color: {{ section.settings.text_color }};
    margin: 0 0 25px 0;
}

.section-{{ section.id }} .cta-btn {
    display: inline-block;
    padding: 12px 40px;
    background: {{ section.settings.button_bg }};
    color: {{ section.settings.button_color }};
    text-decoration: none;
    font-size: 14px;
    font-weight: 600;
    border-radius: 4px;
    transition: all 0.3s ease;
    margin-bottom: 30px;
}

.section-{{ section.id }} .cta-btn:hover {
    background: {{ section.settings.button_hover_bg }};
    transform: translateY(-2px);
}

.section-{{ section.id }} .cta-footer-image {
    margin-top: 30px;
}

.section-{{ section.id }} .cta-footer-image img {
    width: 100%;
    max-width: 100%;
    height: auto;
    border-radius: 8px;
}

/* Right Form - 50% Width */
.section-{{ section.id }} .cta-form-wrap {
    width: 100%;
}

/* Call Now Bar */
.section-{{ section.id }} .callnow-bar {
    /* background: {{ section.settings.accent_color }}; */
    background: #6fb31a;
    padding: 12px 20px;
    border-radius: 4px 4px 0 0;
}

.section-{{ section.id }} .callnow-bar a {
    color: #ffffff;
    text-decoration: none;
    font-size: 16px;
    font-weight: 700;
    letter-spacing: 2px;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
}

.section-{{ section.id }} .phone-icon {
    font-size: 18px;
}

/* Form Box */
.section-{{ section.id }} .form-box {
        margin-top: 12px;
    background: #ffffff;
    border: 2px solid #6fb31a;
    /* border-top: none; */
    padding: 25px 20px;
    border-radius: 0 0 4px 4px;
    width: 100%; /* Full width of its 50% container */
}

.section-{{ section.id }} .form-title {
    font-size: 16px;
    font-weight: 700;
    color: {{ section.settings.accent_color }};
    text-align: center;
    margin: 0 0 20px 0;
    text-transform: uppercase;
}

.section-{{ section.id }} .form-field {
    margin-bottom: 15px;
}

.section-{{ section.id }} .form-field input,
.section-{{ section.id }} .form-field textarea {
    width: 100%;
    padding: 9px 15px;
    border: 1px solid #ddd;
    /* border-radius: 4px; */
    font-size: 13px;
    box-sizing: border-box;
    transition: border-color 0.3s ease;
}

.section-{{ section.id }} .form-field input:focus,
.section-{{ section.id }} .form-field textarea:focus {
    outline: none;
    border-color: {{ section.settings.accent_color }};
}

.section-{{ section.id }} .form-field input::placeholder,
.section-{{ section.id }} .form-field textarea::placeholder {
    color: #999;
    text-transform: uppercase;
    font-size: 12px;
}

.section-{{ section.id }} .submit-btn {
    width: 100%;
    padding: 14px 20px;
    background: #6fb31a;
    color: #ffffff;
    border: none;
    border-radius: 4px;
    font-size: 14px;
    font-weight: 700;
    cursor: pointer;
    transition: all 0.3s ease;
}

.section-{{ section.id }} .submit-btn:hover {
    background: #1e3d1a;
    transform: translateY(-2px);
}

/* Messages */
.section-{{ section.id }} .form-success {
    background: #d4edda;
    color: #155724;
    padding: 12px;
    border-radius: 4px;
    margin-bottom: 15px;
    font-size: 14px;
    text-align: center;
}

.section-{{ section.id }} .form-error {
    background: #f8d7da;
    color: #721c24;
    padding: 12px;
    border-radius: 4px;
    margin-bottom: 15px;
    font-size: 14px;
}

/* Responsive Design */
@media (max-width: 991px) {
    .section-{{ section.id }} .cta-grid {
        grid-template-columns: 1fr; /* Stack on mobile */
        gap: 40px;
    }
    
    .section-{{ section.id }} .cta-form-wrap {
        max-width: 500px;
        margin: 0 auto;
    }
}

@media (max-width: 768px) {
    .section-{{ section.id }} .cta-heading {
        font-size: 18px;
    }
    
    .section-{{ section.id }} .cta-description {
        font-size: 14px;
    }
    
    .section-{{ section.id }} .form-box {
        padding: 20px 15px;
    }
}
{% endstyle %}

{% schema %}
{
    "name": "EUV CTA Form 50-50",
    "tag": "section",
    "settings": [
        {
            "type": "header",
            "content": "Enquiry Form"
        },
        {
            "type": "checkbox",
            "id": "show_hubspot_form",
            "label": "Use HubSpot Form",
            "info": "Replaces the default Shopify enquiry form with the HubSpot 'Go Green Today' embed.",
            "default": true
        },
        {
            "type": "header",
            "content": "Left Content (50%)"
        },
        {
            "type": "text",
            "id": "heading",
            "label": "Heading",
            "default": "Don't Get Left Behind"
        },
        {
            "type": "textarea",
            "id": "description",
            "label": "Description",
            "default": "Embrace the future be a part of the new green cleaning revolution! No matter your industry, contact us today to learn how Addax Electric Utility Vehicles can revolutionize your business."
        },
        {
            "type": "text",
            "id": "button_text",
            "label": "Button Text",
            "default": "Learn More"
        },
        {
            "type": "url",
            "id": "button_link",
            "label": "Button Link"
        },
        {
            "type": "image_picker",
            "id": "footer_image",
            "label": "Footer Image"
        },
        {
            "type": "header",
            "content": "Form Settings (50%)"
        },
        {
            "type": "text",
            "id": "call_now_text",
            "label": "Call Now Text",
            "default": "CALL NOW"
        },
        {
            "type": "text",
            "id": "phone_number",
            "label": "Phone Number",
            "default": "01 811 89 20"
        },
        {
            "type": "text",
            "id": "form_title",
            "label": "Form Title",
            "default": "GO GREEN TODAY ENQUIRE NOW"
        },
        {
            "type": "text",
            "id": "submit_text",
            "label": "Submit Button Text",
            "default": "Submit"
        },
        {
            "type": "text",
            "id": "success_message",
            "label": "Success Message",
            "default": "Thank you! We will contact you shortly."
        },
        {
            "type": "header",
            "content": "Colors"
        },
        {
            "type": "color",
            "id": "bg_color",
            "label": "Background",
            "default": "#f9f9f9"
        },
        {
            "type": "color",
            "id": "accent_color",
            "label": "Accent Color (Form)",
            "default": "#2d5a27"
        },
        {
            "type": "color",
            "id": "heading_color",
            "label": "Heading Color",
            "default": "#1a1a1a"
        },
        {
            "type": "color",
            "id": "text_color",
            "label": "Text Color",
            "default": "#555555"
        },
        {
            "type": "color",
            "id": "button_bg",
            "label": "Button Background",
            "default": "#6fb31a"
        },
        {
            "type": "color",
            "id": "button_hover_bg",
            "label": "Button Hover",
            "default": "#5a9216"
        },
        {
            "type": "color",
            "id": "button_color",
            "label": "Button Text",
            "default": "#ffffff"
        },
        {
            "type": "header",
            "content": "Spacing"
        },
        {
            "type": "range",
            "id": "padding_top",
            "label": "Padding Top",
            "min": 0,
            "max": 100,
            "step": 10,
            "unit": "px",
            "default": 50
        },
        {
            "type": "range",
            "id": "padding_bottom",
            "label": "Padding Bottom",
            "min": 0,
            "max": 100,
            "step": 10,
            "unit": "px",
            "default": 50
        }
    ],
    "presets": [
        {
            "name": "EUV CTA Form 50-50"
        }
    ]
}
{% endschema %}