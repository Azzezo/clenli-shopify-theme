          "label": "Custom Title (Optional)",
          "info": "Leave empty to use collection's title"
        },
        {
          "type": "url",
          "id": "subcategory_link",
          "label": "Custom Link (Optional)",
          "info": "Leave empty to use collection's URL"
        },
        {
          "type": "checkbox",
          "id": "show_product_count",
          "label": "Show Product Count",
          "default": false
        }
