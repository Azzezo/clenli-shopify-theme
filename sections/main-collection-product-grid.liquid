      "info": "If no custom banner, show collection's featured image"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "primary_color",
      "label": "Primary Color",
      "default": "#6fb31a"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#333333"
    },
    {
      "type": "header",
      "content": "Filters"
    },
    {
      "type": "checkbox",
      "id": "show_category_filter",
      "label": "Show Category Filter",
      "default": true
    },
    {
      "type": "link_list",
      "id": "category_menu",
      "label": "Category Menu"
    },
    {
      "type": "checkbox",
      "id": "show_manufacturer_filter",
      "label": "Show Manufacturer Filter",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_type_filter",
      "label": "Show Type Filter",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_price_filter",
      "label": "Show Price Filter",
      "default": true
    },
    {
      "type": "header",
      "content": "Product Display"
    },
    {
      "type": "checkbox",
      "id": "show_reviews",
      "label": "Show Star Rating",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_description",
      "label": "Show Description",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_sku",
      "label": "Show SKU",
      "default": true
    }
  ],
  "blocks": [
    {
      "type": "subcategory",
      "name": "Subcategory Box",
      "settings": [
        {
          "type": "checkbox",
          "id": "enable_subcategory",
          "label": "✓ Enable This Subcategory",
          "default": true,
          "info": "Uncheck to hide this subcategory box"
        },
        {
          "type": "collection",
          "id": "show_on_collection",
          "label": "Show On Collection (Parent)",
          "info": "Select which collection page this should appear on. Leave empty to show on all."
        },
        {
          "type": "header",
          "content": "Subcategory Details"
        },
        {
          "type": "collection",
