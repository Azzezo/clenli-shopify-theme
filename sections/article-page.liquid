{% comment %} Single Article Page - Clenli Direct Style {% endcomment %}

<style>
.article-page{--green:#6fb31a;--dark:#333;--gray:#777;--white:#fff;font-family:'Open Sans',sans-serif;color:var(--gray);line-height:1.8}
.article-page *{box-sizing:border-box}
.article-container{max-width:1200px;margin:0 auto;padding:0 20px}

/* Breadcrumbs */
.article-breadcrumbs{background:#f9f9f9;padding:15px 0;border-bottom:1px solid #eee}
.article-breadcrumbs ul{list-style:none;display:flex;align-items:center;gap:10px;flex-wrap:wrap;margin:0;padding:0}
.article-breadcrumbs li{display:flex;align-items:center;gap:10px;font-size:0.9rem}
.article-breadcrumbs li:not(:last-child)::after{content:"›";color:#999}
.article-breadcrumbs a{color:var(--green);text-decoration:none}

/* Article Layout */
.article-layout{display:grid;grid-template-columns:1fr 300px;gap:40px;padding:40px 0}

/* Article Content */
.article-main{background:var(--white);border:1px solid #eee;padding:30px}
.article-header{margin-bottom:25px;padding-bottom:20px;border-bottom:1px solid #eee}
.article-title{font-size:2rem;color:var(--dark);margin:0 0 15px;line-height:1.3}
.article-meta{display:flex;flex-wrap:wrap;gap:20px;font-size:0.9rem;color:#999}
.article-meta span{display:flex;align-items:center;gap:5px}
.article-meta svg{width:16px;height:16px}
.article-tags a{color:var(--green);text-decoration:none}

/* Featured Image */
.article-image{margin-bottom:25px;border-radius:8px;overflow:hidden}
.article-image img{width:100%;height:auto;display:block}

/* Article Body */
.article-body{font-size:1.05rem;line-height:2}
.article-body h2,.article-body h3{color:var(--dark);margin:30px 0 15px}
.article-body p{margin-bottom:20px}
.article-body img{max-width:100%;height:auto;border-radius:8px;margin:20px 0}
.article-body ul,.article-body ol{margin:20px 0;padding-left:25px}
.article-body li{margin-bottom:10px}
.article-body a{color:var(--green)}
.article-body blockquote{border-left:4px solid var(--green);padding:15px 20px;margin:25px 0;background:#f9f9f9;font-style:italic}

/* Share Section */
.article-share{display:flex;align-items:center;gap:15px;padding:25px 0;border-top:1px solid #eee;margin-top:30px}
.article-share span{font-weight:600;color:var(--dark)}
.share-buttons{display:flex;gap:10px}
.share-buttons a{width:40px;height:40px;display:flex;align-items:center;justify-content:center;background:#eee;color:var(--gray);border-radius:50%;text-decoration:none;transition:all 0.3s}
.share-buttons a:hover{background:var(--green);color:var(--white)}

/* Author Box */
.author-box{display:flex;gap:20px;padding:25px;background:#f9f9f9;border-radius:8px;margin-top:30px}
.author-avatar{width:80px;height:80px;border-radius:50%;overflow:hidden;flex-shrink:0}
.author-avatar img{width:100%;height:100%;object-fit:cover}
.author-info h4{color:var(--dark);margin:0 0 10px;font-size:1.1rem}
.author-info p{margin:0;font-size:0.95rem}

/* Navigation */
.article-nav{display:grid;grid-template-columns:1fr 1fr;gap:20px;margin-top:30px;padding-top:25px;border-top:1px solid #eee}
.nav-prev,.nav-next{padding:15px;background:#f9f9f9;border-radius:8px;text-decoration:none;transition:all 0.3s}
.nav-prev:hover,.nav-next:hover{background:var(--green)}
.nav-prev:hover *,.nav-next:hover *{color:var(--white)}
.nav-next{text-align:right}
.nav-label{font-size:0.85rem;color:#999;display:block;margin-bottom:5px}
.nav-title{color:var(--dark);font-weight:600}

/* Comments */
.comments-section{margin-top:40px;padding-top:30px;border-top:1px solid #eee}
.comments-title{color:var(--dark);margin-bottom:25px}
.comment-form textarea{width:100%;padding:15px;border:1px solid #ddd;border-radius:8px;resize:vertical;min-height:150px;font-family:inherit;font-size:1rem}
.comment-form textarea:focus{outline:none;border-color:var(--green)}
.comment-form .form-row{display:grid;grid-template-columns:1fr 1fr;gap:15px;margin-top:15px}
.comment-form input{padding:12px 15px;border:1px solid #ddd;border-radius:8px;font-family:inherit}
.comment-form input:focus{outline:none;border-color:var(--green)}
.comment-form button{margin-top:15px;padding:15px 30px;background:var(--green);color:var(--white);border:none;border-radius:8px;font-size:1rem;font-weight:600;cursor:pointer;transition:all 0.3s}
.comment-form button:hover{background:#5a9615}

/* Sidebar */
.article-sidebar{position:sticky;top:20px}
.sidebar-widget{background:var(--white);border:1px solid #eee;margin-bottom:25px}
.widget-title{background:var(--dark);color:var(--white);padding:15px 20px;font-size:1.1rem;margin:0}
.widget-content{padding:20px}
.widget-content ul{list-style:none;margin:0;padding:0}
.widget-content li{padding:8px 0;border-bottom:1px solid #eee}
.widget-content li:last-child{border-bottom:none}
.widget-content a{color:var(--gray);text-decoration:none;transition:color 0.3s}
.widget-content a:hover{color:var(--green)}
.recent-post-item{display:flex;gap:12px;padding:10px 0;border-bottom:1px solid #eee}
.recent-post-item:last-child{border-bottom:none}
.recent-post-thumb{width:60px;height:60px;flex-shrink:0;overflow:hidden;border-radius:4px}
.recent-post-thumb img{width:100%;height:100%;object-fit:cover}
.recent-post-info h4{font-size:0.9rem;margin:0 0 5px;line-height:1.3}
.recent-post-info h4 a{color:var(--dark)}
.recent-post-date{font-size:0.75rem;color:#999}

/* Responsive */
@media(max-width:992px){.article-layout{grid-template-columns:1fr}.article-sidebar{position:static}}
@media(max-width:768px){.article-title{font-size:1.5rem}.article-main{padding:20px}.article-nav{grid-template-columns:1fr}.comment-form .form-row{grid-template-columns:1fr}}
</style>

<div class="article-page">
  <!-- Breadcrumbs -->
  <div class="article-breadcrumbs">
    <div class="article-container">
      <ul>
        <li><a href="/">Home</a></li>
        <li><a href="{{ blog.url }}">{{ blog.title }}</a></li>
        <li><strong>{{ article.title | truncate: 40 }}</strong></li>
      </ul>
    </div>
  </div>

  <div class="article-container">
    <div class="article-layout">
      <!-- Main Content -->
      <article class="article-main">
        <header class="article-header">
          <h1 class="article-title">{{ article.title }}</h1>
          <div class="article-meta">
            <span>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
              {{ article.published_at | date: "%B %d, %Y" }}
            </span>
            {% if article.author %}
              <span>
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
                {{ article.author }}
              </span>
            {% endif %}
            {% if article.tags.size > 0 %}
              <span class="article-tags">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20.59 13.41l-7.17 7.17a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82z"/><line x1="7" y1="7" x2="7.01" y2="7"/></svg>
                {% for tag in article.tags %}
                  <a href="{{ blog.url }}/tagged/{{ tag | handle }}">{{ tag }}</a>{% unless forloop.last %}, {% endunless %}
                {% endfor %}
              </span>
            {% endif %}
          </div>
        </header>

        {% if article.image %}
          <div class="article-image">
            <img src="{{ article.image | img_url: '1200x600', crop: 'center' }}" alt="{{ article.title }}">
          </div>
        {% endif %}

        <div class="article-body">
          {{ article.content }}
        </div>

        <!-- Share -->
        <div class="article-share">
          <span>Share this post:</span>
          <div class="share-buttons">
            <a href="https://www.facebook.com/sharer/sharer.php?u={{ shop.url }}{{ article.url }}" target="_blank" title="Facebook">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/></svg>
            </a>
            <a href="https://twitter.com/intent/tweet?url={{ shop.url }}{{ article.url }}&text={{ article.title | url_encode }}" target="_blank" title="Twitter">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M23 3a10.9 10.9 0 0 1-3.14 1.53 4.48 4.48 0 0 0-7.86 3v1A10.66 10.66 0 0 1 3 4s-4 9 5 13a11.64 11.64 0 0 1-7 2c9 5 20 0 20-11.5a4.5 4.5 0 0 0-.08-.83A7.72 7.72 0 0 0 23 3z"/></svg>
            </a>
            <a href="https://www.linkedin.com/shareArticle?mini=true&url={{ shop.url }}{{ article.url }}&title={{ article.title | url_encode }}" target="_blank" title="LinkedIn">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"/><rect x="2" y="9" width="4" height="12"/><circle cx="4" cy="4" r="2"/></svg>
            </a>
            <a href="mailto:?subject={{ article.title | url_encode }}&body={{ shop.url }}{{ article.url }}" title="Email">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
            </a>
          </div>
        </div>

        <!-- Navigation -->
        <nav class="article-nav">
          {% if blog.previous_article %}
            <a href="{{ blog.previous_article }}" class="nav-prev">
              <span class="nav-label">« Previous Post</span>
              <span class="nav-title">{{ blog.previous_article.title | truncate: 40 }}</span>
            </a>
          {% else %}
            <div></div>
          {% endif %}
          
          {% if blog.next_article %}
            <a href="{{ blog.next_article }}" class="nav-next">
              <span class="nav-label">Next Post »</span>
              <span class="nav-title">{{ blog.next_article.title | truncate: 40 }}</span>
            </a>
          {% endif %}
        </nav>

        <!-- Comments -->
        {% if blog.comments_enabled? %}
          <div class="comments-section">
            <h3 class="comments-title">Leave a Comment</h3>
            {% form 'new_comment', article %}
              <div class="comment-form">
                <textarea name="comment[body]" placeholder="Write your comment here..." required></textarea>
                <div class="form-row">
                  <input type="text" name="comment[author]" placeholder="Your Name *" required>
                  <input type="email" name="comment[email]" placeholder="Your Email *" required>
                </div>
                <button type="submit">Post Comment</button>
              </div>
            {% endform %}

            {% if article.comments_count > 0 %}
              <div class="comments-list" style="margin-top:30px">
                <h4>{{ article.comments_count }} Comment{% if article.comments_count > 1 %}s{% endif %}</h4>
                {% for comment in article.comments %}
                  <div style="padding:20px 0;border-bottom:1px solid #eee">
                    <strong>{{ comment.author }}</strong>
                    <span style="color:#999;font-size:0.85rem;margin-left:10px">{{ comment.created_at | date: "%B %d, %Y" }}</span>
                    <p style="margin-top:10px">{{ comment.content }}</p>
                  </div>
                {% endfor %}
              </div>
            {% endif %}
          </div>
        {% endif %}
      </article>

      <!-- Sidebar -->
      <aside class="article-sidebar">
        <!-- Recent Posts -->
        <div class="sidebar-widget">
          <h3 class="widget-title">Recent Posts</h3>
          <div class="widget-content">
            {% for post in blog.articles limit: 5 %}
              {% unless post.id == article.id %}
                <div class="recent-post-item">
                  {% if post.image %}
                    <div class="recent-post-thumb">
                      <a href="{{ post.url }}">
                        <img src="{{ post.image | img_url: '80x80', crop: 'center' }}" alt="{{ post.title }}" loading="lazy">
                      </a>
                    </div>
                  {% endif %}
                  <div class="recent-post-info">
                    <h4><a href="{{ post.url }}">{{ post.title | truncate: 40 }}</a></h4>
                    <span class="recent-post-date">{{ post.published_at | date: "%B %d, %Y" }}</span>
                  </div>
                </div>
              {% endunless %}
            {% endfor %}
          </div>
        </div>

        <!-- Categories -->
        <div class="sidebar-widget">
          <h3 class="widget-title">Categories</h3>
          <div class="widget-content">
            <ul>
              {% for tag in blog.all_tags limit: 10 %}
                <li><a href="{{ blog.url }}/tagged/{{ tag | handle }}">{{ tag }}</a></li>
              {% endfor %}
            </ul>
          </div>
        </div>
      </aside>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Article Page",
  "settings": [],
  "presets": [
    {
      "name": "Article Page"
    }
  ]
}
{% endschema %}