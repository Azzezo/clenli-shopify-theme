{%- if section.blocks.size > 0 -%}
{%- assign swipe = section.settings.policies_block_swipe_on_mobile -%}
{%- assign content_align = section.settings.content_text_align | default: 'left' -%}
<link rel="stylesheet" href="{{ 'component-policies-block.css' | asset_url }}" media="print" onload="this.media='all'">
<noscript>{{ 'component-policies-block.css' | asset_url | stylesheet_tag }}</noscript>
<div class="policies-block policies-border--{{ section.settings.border }} section-block-{{section.id}}{% if settings.banner_animation == 'effect_fade_up' %} scroll-trigger animate--slide-in{% endif %}"
    style="--border-color: {{ section.settings.border_color }};">
    <div class="{% if section.settings.container == 'fullwidth' %}container-full{% elsif section.settings.container == '1670' %}container-1670{% elsif section.settings.container == '1570' %}container-1570{% elsif section.settings.container == '1470' %}container-1470{% elsif section.settings.container == '1770' %}container-1770{% elsif section.settings.container == '1170' %}container-1170{% else %}container{% endif %}">
        <div class="bg-policies-block">
            {%- if swipe == 'slider' -%}
            <banner-slider-component>
            {%- endif -%}
                <div class="halo-row column-{{ section.blocks.size }}{% if swipe == 'slider' %} slider slider--tablet{% endif %}{% unless section.settings.enable_item_distance %} not-distance{% endunless %}{% if swipe == 'scroll' %} scroll-snap-mobile disable-srollbar{% endif %}"{% if swipe == 'scroll' %} style="--spacing-tablet: {{ section.settings.spacing_tablet }}px;--spacing-mobile: {{ section.settings.spacing_mobile }}px;"{% endif %}>      
                    {%- for block in section.blocks -%}
                    <div class="halo-item{% if swipe == 'slider' %} slider__slide{% endif %}{% if block.settings.description != blank %} has-des{% endif %}{% if settings.banner_animation == 'effect_fade_up' %} scroll-trigger animate--slide-in{% endif %}"{% if settings.banner_animation == 'effect_fade_up' %} data-cascade style="--animation-order: {{ forloop.index }};"{% endif %}>
                        <a class="alignItems--{{ section.settings.align_items }}{% if section.settings.text_align_items == 'left' %} text-left{% elsif section.settings.text_align_items == 'center' %} text-center{% else %} text-right{% endif %}"{% if block.settings.link == blank %} role="link" aria-disabled="true"{% else %} href="{{ block.settings.link }}"{% endif %} title="{{block.settings.text}}" style="--item-radius-style: {{ section.settings.item_radius | append: 'px' }}; --item-padding-top-style: {{ section.settings.item_padding_top | append: 'px' }}; --item-padding-bottom-style: {{ section.settings.item_padding_bottom | append: 'px' }}; --item-padding-left-right: {{  section.settings.item_padding_left_right | append: 'px' }}">
                            {%- if block.settings.icon_type == 'image' -%}
                                {%- if block.settings.image != blank -%}
                                    {%- assign preview_img = block.settings.image -%}
                                    <img {% render 'lazyload',preview_img: preview_img  %} style="--icon-mg-right-style: {{ block.settings.icon_mg_right | append: 'px' }}" />
                                    {%- if settings.enable_lazyload -%}<span class="data-lazy-loading"></span>{%- endif -%}
                                {%- endif -%}
                            {%- else -%}
                                {%- liquid
                                    assign icon_class = ''
                                    case forloop.index
                                        when 1
                                            assign icon_class = 'icon-transport'
                                        when 2
                                            assign icon_class = 'icon-customers'
                                        when 3
                                            assign icon_class = 'icon-returning'
                                        when 4
                                            assign icon_class = 'icon-payment'
                                        when 5
                                            assign icon_class = 'icon-tag'
                                    endcase
                                -%}
                                <span class="policies-icon">
                                    <span class="icons icon {{ icon_class }}"></span>
                                </span>
                            {%- endif -%}
                            <div class="policies-content" 
                            style="--font-size-text-style: {{ block.settings.font_size_text | append: 'px' }};--font-size-text-style-mb: {{ block.settings.font_size_text_mb | append: 'px' }};--font-weight-text-style: {{ block.settings.font_weight_text }};--font-style-text-style: {{ block.settings.font_style_text }};--mg-bottom-text-style: {{ block.settings.mg_bottom_text | append: 'px' }};--font-size-des: {{ block.settings.font_size_des | append: 'px' }};--font-size-des-mb: {{ block.settings.font_size_des_mb | append: 'px' }};--margin-bottom-description: {{ block.settings.margin_bottom_description | append: 'px' }};--button-font-size: {{ block.settings.button_font_size | append: 'px' }};--button-font-size-mb: {{ block.settings.button_font_size_mb | append: 'px' }};--text-font:{% if block.settings.type_text_font == 'font_1' %}var(--font-family-1){% else %}var(--font-family-2){% endif %};">
                                {%- if block.settings.text != blank -%}
                                <span class="policies-text">{{block.settings.text}}</span>
                                {%- endif -%}
                                {%- if block.settings.description != blank -%}
                                <div class="policies-des">{{block.settings.description}}</div>
                                {%- endif -%}
                                {%- if block.settings.button != blank -%}
                                <div class="policies-button">{{block.settings.button}}</div>
                                {%- endif -%}
                            </div>
                        </a>
                    </div>
                    {%- endfor -%}
                </div>
                {%- if swipe == 'slider' and section.blocks.size > 1 -%}
                    <div class="slider-buttons no-js-hidden slider-arrows">
                        <div class="slider-action {% if section.blocks.size == 2 %}count_2{% endif %}">
                            <button type="button" class="slider-button slider-button--prev" name="previous" aria-label="{{ 'accessibility.previous_slide' | t }}">{% render 'icon-caret' %}</button>
                            <button type="button" class="slider-button slider-button--next" name="next" aria-label="{{ 'accessibility.next_slide' | t }}">{% render 'icon-caret' %}</button>
                        </div>
                    </div>
                {%- endif -%}
            {%- if swipe == 'slider' -%}
            </banner-slider-component>
            {%- endif -%}
        </div>    
    </div>
</div>
<style>
    {%- liquid
        assign policies_bg = section.settings.policies_bg
        assign policies_bg_gradient = section.settings.policies_bg_gradient
        assign policies_bg_image = section.settings.policies_bg_image
        assign des_color = section.settings.des_color
        assign mg_top_desktop = section.settings.mg_top_desktop
        assign mg_top_tablet = section.settings.mg_top_tablet
        assign mg_top_mobile = section.settings.mg_top_mobile
        assign mg_bottom_desktop = section.settings.mg_bottom_desktop
        assign mg_bottom_tablet = section.settings.mg_bottom_tablet
        assign mg_bottom_mobile = section.settings.mg_bottom_mobile
        assign padding_full_width = section.settings.padding_full_width
        assign bg_color_block = section.settings.bg_color_block
        assign color_block = section.settings.color_block
        assign color_icon = section.settings.color_icon
        assign item_border_width = section.settings.item_border_width
        assign item_border_color = section.settings.item_border_color
        assign item_border_hover_color = section.settings.item_border_hover_color
        assign content_text_align = section.settings.content_text_align
    -%}

    {%- if policies_bg_image != blank -%}
        .section-block-{{section.id}} {background: url({{ policies_bg_image | img_url: '1920x' }});background-repeat: repeat-x;background-size: cover}
    {%- else -%}
        .section-block-{{section.id}} {background: {% if policies_bg_gradient != blank %}{{ policies_bg_gradient }}{% else %}{{ policies_bg }}{% endif %}}
    {%- endif -%}

    .section-block-{{section.id}} .policies-text {font-family: var(--text-font);color: {{ color_block }}}
    .section-block-{{section.id}} .policies-des {color: {{ des_color }}}
    .section-block-{{section.id}} .slider-button svg {fill: {{ color_block }}}

    /* ============ ICON STYLES ============ */
    @font-face {
        font-family: 'untitled-font-6';
        src: url('data:font/woff;base64,') format('woff');
        font-weight: normal;
        font-style: normal;
        font-display: swap;
    }

    .section-block-{{section.id}} .policies-icon {
        color: {{ color_icon }} !important;
    }

    .section-block-{{section.id}} .policies-icon .icons,
    .section-block-{{section.id}} .policies-icon .icons::before {
        font-family: 'untitled-font-6' !important;
        font-weight: normal !important;
        font-style: normal !important;
        font-size: 45px;
        line-height: 1;
        color: #6fb31a;
        display: inline-block;
        width: auto;
        height: auto;
        -webkit-font-smoothing: antialiased;
        text-rendering: optimizeLegibility;
    }

    .section-block-{{section.id}} .policies-icon .icon-transport::before {
        content: "B";
    }
    .section-block-{{section.id}} .policies-icon .icon-customers::before {
        content: "e";
    }
    .section-block-{{section.id}} .policies-icon .icon-returning::before {
        content: "l";
    }
    .section-block-{{section.id}} .policies-icon .icon-payment::before {
        content: "x";
    }
    .section-block-{{section.id}} .policies-icon .icon-tag::before {
        content: "p";
    }
    
    /* ============ TEXT CONTENT ALIGNMENT - Editable from Customizer ============ */
    .section-block-{{section.id}} .policies-content {
        text-align: {{ content_text_align }} !important;
    }
    
    .section-block-{{section.id}} .policies-text,
    .section-block-{{section.id}} .policies-des,
    .section-block-{{section.id}} .policies-button {
        text-align: {{ content_text_align }} !important;
    }
    
    /* ============ CONNECTED BOXES ============ */
    .section-block-{{section.id}},
    .section-block-{{section.id}} .bg-policies-block {
        border: none !important;
    }

    .section-block-{{section.id}} .bg-policies-block {
        border: 1px solid #dddddd !important;
        border-radius: 10px;
        overflow: hidden;
        background-color: {{ bg_color_block }};
    }
    
    .section-block-{{section.id}} .halo-row {
        display: flex !important;
        flex-wrap: nowrap !important;
        gap: 0 !important;
        margin: 0 !important;
        border: none !important;
    }
    
    .section-block-{{section.id}} .halo-item {
        flex: 1;
        padding: 0 !important;
        margin: 0 !important;
    }
    
    .section-block-{{section.id}} .halo-item a {
        background-color: transparent;
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 17px 12px;
        transition: all 0.3s ease;
        height: 100%;
        border: 0 !important;
        border-right: 1px solid #dddddd !important;
        text-decoration: none;
        text-align: left;
    }

    .section-block-{{section.id}} .halo-item:last-child a {
        border-right: 0 !important;
    }
    
    .section-block-{{section.id}} .halo-item + .halo-item:before {
        content: none !important;
        display: none !important;
    }

    .section-block-{{section.id}} .policies-icon {
        margin: 0;
        display: inline-flex;
        flex: 0 0 auto;
    }

    .section-block-{{section.id}} .policies-text {
        display: block;
        font-weight: 700;
        font-size: 15px;
        line-height: 1.3;
    }

    .section-block-{{section.id}} .policies-des {
        font-size: 15px;
        line-height: 1.3;
    }
    
    /* ============ TABLET ============ */
    @media (min-width: 768px) and (max-width: 1024px) {
        .section-block-{{section.id}} {
            padding-top: {{ mg_top_tablet }}px;
            padding-bottom: {{ mg_bottom_tablet }}px;
        }
        .section-block-{{section.id}} .halo-row {
            flex-wrap: wrap !important;
        }
        .section-block-{{section.id}} .halo-item {
            flex: 0 0 33.333% !important;
        }
        .section-block-{{section.id}} .halo-item:nth-child(1) a,
        .section-block-{{section.id}} .halo-item:nth-child(2) a,
        .section-block-{{section.id}} .halo-item:nth-child(3) a {
            border-bottom: none !important;
        }
        .section-block-{{section.id}} .halo-item:nth-child(4) a {
            border-left: 1px solid #dddddd !important;
        }
    }
    
    /* ============ MOBILE ============ */
    @media (max-width: 767px) {
        .section-block-{{section.id}} .slider-buttons {
            display: none !important;
        }
        .section-block-{{section.id}} {
            padding-top: {{ mg_top_mobile }}px;
            padding-bottom: {{ mg_bottom_mobile }}px;
        }
        .section-block-{{section.id}} .halo-row {
            flex-wrap: nowrap !important;
        }
        .section-block-{{section.id}} .halo-item {
            flex: 0 0 25% !important;
        }
        .section-block-{{section.id}} .halo-item a {
            flex-direction: column;
            align-items: flex-start;
            gap: 6px;
            text-align: left;
        }
        .section-block-{{section.id}} .policies-icon {
            margin: 0 0 6px;
        }
        .section-block-{{section.id}} .policies-content,
        .section-block-{{section.id}} .policies-text,
        .section-block-{{section.id}} .policies-des,
        .section-block-{{section.id}} .policies-button {
            text-align: left !important;
        }
        .section-block-{{section.id}} .halo-item a {
            border: 1px solid #dddddd !important;
            border-bottom: none !important;
        }
        .section-block-{{section.id}} .halo-item:not(:last-child) a {
            border-right: 1px solid #dddddd !important;
        }
        .section-block-{{section.id}} .halo-item:nth-child(n+5) {
            display: none !important;
        }
        .section-block-{{section.id}} .policies-text {
            font-size: 13px;
        }
        .section-block-{{section.id}} .policies-des {
            font-size: 12px;
        }
    }
    
    /* ============ DESKTOP ============ */
    @media (min-width: 1025px) {
        .section-block-{{section.id}} {
            padding-top: {{ mg_top_desktop }}px;
            padding-bottom: {{ mg_bottom_desktop }}px;
        }
        {%- if section.settings.container == 'fullwidth' -%}
            .section-block-{{section.id}} .container-full {
                padding-left: {{ padding_full_width }}px;
                padding-right: {{ padding_full_width }}px;
            }
        {%- endif -%}
    }
</style>
{%- endif -%}

{% schema %}
{
    "name": "t:sections.policies_block.name",
    "class": "sections-policies-block",
    "max_blocks": 6,
    "settings": [
        {
            "type": "header",
            "content": "t:settings_schema.general.name"
        },
        {
            "type": "select",
            "id": "container",
            "label": "t:sections.layout.container.option",
            "default": "container",
            "options": [
                {"value": "container", "label": "t:sections.layout.container.option1"},
                {"value": "1170", "label": "t:sections.layout.container.option4"},
                {"value": "1470", "label": "t:sections.layout.container.option5"},
                {"value": "1570", "label": "t:sections.layout.container.option6"},
                {"value": "1670", "label": "t:sections.layout.container.option10"},
                {"value": "1770", "label": "t:sections.layout.container.option3"},
                {"value": "fullwidth", "label": "t:sections.layout.container.option2"}
            ]
        },
        {
            "type": "range",
            "id": "padding_full_width",
            "label": "t:sections.layout.container.padding_full_width",
            "min": 0,
            "max": 100,
            "step": 5,
            "unit": "px",
            "default": 0
        },
        {
            "type": "select",
            "id": "policies_block_swipe_on_mobile",
            "label": "t:settings_schema.typography.settings.typography.layout_mobile",
            "default": "list",
            "options": [
                {"value": "list", "label": "t:settings_schema.typography.settings.typography.list"},
                {"value": "scroll", "label": "t:settings_schema.typography.settings.typography.scroll"},
                {"value": "slider", "label": "t:settings_schema.typography.settings.typography.slider"}
            ]
        },
        {
            "type": "color",
            "id": "policies_bg",
            "label": "t:settings_schema.colors.settings.colors_name.background_color_2",
            "default": "#fff"
        },
        {
            "type": "color_background",
            "id": "policies_bg_gradient",
            "label": "t:settings_schema.colors.settings.colors_name.background_color_gradient"
        },
        {
            "type": "image_picker",
            "id": "policies_bg_image",
            "label": "t:settings_schema.colors.settings.colors_name.background_image"
        },
        {
            "type": "select",
            "id": "border",
            "label": "t:settings_schema.typography.settings.typography.border",
            "default": "none",
            "options": [
                {"value": "none", "label": "None"},
                {"value": "top", "label": "t:settings_schema.typography.settings.typography.top"},
                {"value": "bottom", "label": "t:settings_schema.typography.settings.typography.bottom"},
                {"value": "top_bottom", "label": "t:settings_schema.typography.settings.typography.top_bottom"}
            ]
        },
        {
            "type": "color",
            "id": "border_color",
            "default": "#e0e0e0",
            "label": "t:settings_schema.colors.settings.colors_name.border_color"
        },
        {
            "type": "header",
            "content": "Item Box Border"
        },
        {
            "type": "range",
            "id": "item_border_width",
            "label": "Border Width",
            "min": 1,
            "max": 5,
            "step": 1,
            "unit": "px",
            "default": 1
        },
        {
            "type": "color",
            "id": "item_border_color",
            "label": "Border Color",
            "default": "#e0e0e0"
        },
        {
            "type": "color",
            "id": "item_border_hover_color",
            "label": "Border Hover Color",
            "default": "#6fb31a"
        },
        {
            "type": "header",
            "content": "t:sections.image-banner.blocks.image.settings.content.text_blocks"
        },
        {
            "type": "select",
            "id": "align_items",
            "label": "t:sections.slide-show.blocks.image.slider_layout.alignment.option",
            "default": "center",
            "options": [
                {"value": "top", "label": "t:sections.image-banner.blocks.image.settings.content.options__9"},
                {"value": "center", "label": "t:sections.general.settings.alignment.options__7"},
                {"value": "bottom", "label": "t:sections.image-banner.blocks.image.settings.content.options__10"}
            ]
        },
        {
            "type": "select",
            "id": "text_align_items",
            "label": "t:sections.image-banner.blocks.image.settings.content.label__7",
            "default": "left",
            "options": [
                {"value": "left", "label": "t:settings_schema.typography.settings.type_button_font.left"},
                {"value": "center", "label": "t:settings_schema.typography.settings.type_button_font.center"},
                {"value": "right", "label": "t:settings_schema.typography.settings.type_button_font.right"}
            ]
        },
        {
            "type": "select",
            "id": "content_text_align",
            "label": "Text Content Alignment",
            "info": "Control text alignment (Left, Center, Right)",
            "default": "left",
            "options": [
                {"value": "left", "label": "Left"},
                {"value": "center", "label": "Center"},
                {"value": "right", "label": "Right"}
            ]
        },
        {
            "type": "checkbox",
            "id": "enable_item_distance",
            "label": "t:sections.policies_block.settings.setting_block.enable_item_distance",
            "default": false
        },
        {
            "type": "range",
            "id": "item_padding_top",
            "label": "t:settings_schema.typography.settings.type_button_font.padding_top",
            "min": 0,
            "max": 100,
            "step": 1,
            "unit": "px",
            "default": 20
        },
        {
            "type": "range",
            "id": "item_padding_bottom",
            "label": "t:settings_schema.typography.settings.type_button_font.padding_bottom",
            "min": 0,
            "max": 100,
            "step": 1,
            "unit": "px",
            "default": 20
        },
        {
            "type": "range",
            "id": "item_padding_left_right",
            "label": "t:settings_schema.typography.settings.typography.item_padding_left_right",
            "min": 0,
            "max": 100,
            "step": 1,
            "unit": "px",
            "default": 15
        },
        {
            "type": "range",
            "id": "item_radius",
            "label": "t:settings_schema.typography.settings.typography.border_radius",
            "min": 0,
            "max": 50,
            "step": 1,
            "unit": "px",
            "default": 0
        },
        {
            "type": "color",
            "id": "bg_color_block",
            "label": "t:settings_schema.colors.settings.colors_name.background_color_2",
            "default": "#ffffff"
        },
        {
            "type": "color",
            "id": "color_block",
            "label": "t:settings_schema.typography.settings.typography.title_color",
            "default": "#232323"
        },
        {
            "type": "color",
            "id": "des_color",
            "label": "t:settings_schema.typography.settings.typography.des_color",
            "default": "#666666"
        },
        {
            "type": "color",
            "id": "color_icon",
            "label": "t:settings_schema.typography.settings.typography.icon_color",
            "default": "#6fb31a"
        },
        {
            "type": "header",
            "content": "t:sections.layout.margin_top"
        },
        {
            "type": "range",
            "id": "mg_top_desktop",
            "label": "t:sections.layout.mg_desktop.label",
            "min": 0,
            "max": 100,
            "step": 1,
            "unit": "px",
            "default": 50
        },
        {
            "type": "range",
            "id": "mg_top_tablet",
            "label": "t:sections.layout.mg_tablet.label",
            "min": 0,
            "max": 100,
            "step": 1,
            "unit": "px",
            "default": 50
        },
        {
            "type": "range",
            "id": "mg_top_mobile",
            "label": "t:sections.layout.mg_mobile.label",
            "min": 0,
            "max": 100,
            "step": 1,
            "unit": "px",
            "default": 30
        },
        {
            "type": "header",
            "content": "t:sections.layout.margin_bottom"
        },
        {
            "type": "range",
            "id": "mg_bottom_desktop",
            "label": "t:sections.layout.mg_desktop.label",
            "min": 0,
            "max": 100,
            "step": 1,
            "unit": "px",
            "default": 50
        },
        {
            "type": "range",
            "id": "mg_bottom_tablet",
            "label": "t:sections.layout.mg_tablet.label",
            "min": 0,
            "max": 100,
            "step": 1,
            "unit": "px",
            "default": 50
        },
        {
            "type": "range",
            "id": "mg_bottom_mobile",
            "label": "t:sections.layout.mg_mobile.label",
            "min": 0,
            "max": 100,
            "step": 1,
            "unit": "px",
            "default": 30
        }
    ],
    "blocks": [
        {
            "type": "Text",
            "name": "t:sections.image-banner.blocks.image.settings.content.label__16",
            "settings": [
                {
                    "type": "image_picker",
                    "id": "image",
                    "label": "t:sections.image-banner.blocks.image.settings.content.label__15"
                },
                {
                    "type": "radio",
                    "id": "icon_type",
