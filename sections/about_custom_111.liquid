<div class="content-alternate-section section-{{ section.id }}">
    <div class="ca-container">
        
        <!-- Row 1: Content Left + Image Right -->
        <div class="ca-row">
            <div class="ca-content">
                {%- if section.settings.row1_heading != blank -%}
                    <h2 class="ca-heading">{{ section.settings.row1_heading }}</h2>
                {%- endif -%}
                {%- if section.settings.row1_text != blank -%}
                    <div class="ca-text">{{ section.settings.row1_text }}</div>
                {%- endif -%}
                {%- if section.settings.row1_button != blank -%}
                    <a href="{{ section.settings.row1_button_link | default: '#' }}" class="ca-button">{{ section.settings.row1_button }}</a>
                {%- endif -%}
            </div>
            <div class="ca-image">
                {%- if section.settings.row1_image != blank -%}
                    <img src="{{ section.settings.row1_image | image_url: width: 800 }}" alt="{{ section.settings.row1_heading }}" loading="lazy">
                {%- else -%}
                    <div class="placeholder-img"></div>
                {%- endif -%}
            </div>
        </div>
        
        <!-- Underline -->
        <div class="ca-underline"></div>
        
        <!-- Row 2: Image Left + Content Right -->
        <div class="ca-row reverse">
            <div class="ca-content">
                {%- if section.settings.row2_heading != blank -%}
                    <h2 class="ca-heading">{{ section.settings.row2_heading }}</h2>
                {%- endif -%}
                {%- if section.settings.row2_text != blank -%}
                    <div class="ca-text">{{ section.settings.row2_text }}</div>
                {%- endif -%}
                {%- if section.settings.row2_button != blank -%}
                    <a href="{{ section.settings.row2_button_link | default: '#' }}" class="ca-button">{{ section.settings.row2_button }}</a>
                {%- endif -%}
            </div>
            <div class="ca-image">
                {%- if section.settings.row2_image != blank -%}
                    <img src="{{ section.settings.row2_image | image_url: width: 800 }}" alt="{{ section.settings.row2_heading }}" loading="lazy">
                {%- else -%}
                    <div class="placeholder-img"></div>
                {%- endif -%}
            </div>
        </div>
        
    </div>
</div>

{% style %}
.section-{{ section.id }} {
    padding: {{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px;
    background: {{ section.settings.bg_color }};
}

.section-{{ section.id }} .ca-container {
    max-width: 1370px;
    margin: 0 auto;
    padding: 0 20px;
}

.section-{{ section.id }} .ca-row {
    display: flex;
    align-items: center;
    gap: {{ section.settings.row_gap }}px;
}

.section-{{ section.id }} .ca-row.reverse {
    flex-direction: row-reverse;
}

.section-{{ section.id }} .ca-content {
    flex: 1;
}

.section-{{ section.id }} .ca-heading {
    font-size: {{ section.settings.heading_size }}px;
    font-weight: 700;
    color: {{ section.settings.heading_color }};
    margin: 0 0 8px 0;
    line-height: 1.2;
}

.section-{{ section.id }} .ca-text {
    font-size: {{ section.settings.text_size }}px;
    line-height: 1.6;
    color: {{ section.settings.text_color }};
    margin: 0;
}

.section-{{ section.id }} .ca-text p {
    margin: 0 0 8px 0;
}

.section-{{ section.id }} .ca-text p:last-child {
    margin: 0;
}

.section-{{ section.id }} .ca-button {
    display: inline-block;
    margin-top: 15px;
    padding: 12px 28px;
    background: {{ section.settings.button_bg }};
    color: {{ section.settings.button_color }};
    text-decoration: none;
    font-size: 14px;
    font-weight: 600;
    border-radius: 4px;
    transition: all 0.3s ease;
}

.section-{{ section.id }} .ca-button:hover {
    background: {{ section.settings.button_hover_bg }};
}

.section-{{ section.id }} .ca-image {
    flex-shrink: 0;
    width: {{ section.settings.image_width }}px;
    height: {{ section.settings.image_height }}px;
    border-radius: {{ section.settings.image_radius }}px;
    overflow: hidden;
}

.section-{{ section.id }} .ca-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
}

.section-{{ section.id }} .placeholder-img {
    width: 100%;
    height: 100%;
    background: #f0f0f0;
}

.section-{{ section.id }} .ca-underline {
    height: {{ section.settings.underline_height }}px;
    background: {{ section.settings.underline_color }};
    margin: {{ section.settings.underline_spacing }}px 0;
    border-radius: 2px;
}

@media (max-width: 991px) {
    .section-{{ section.id }} .ca-row {
        flex-direction: column;
        gap: 25px;
    }
    
    .section-{{ section.id }} .ca-row.reverse {
        flex-direction: column;
    }
    
    .section-{{ section.id }} .ca-image {
        width: 100%;
        max-width: {{ section.settings.image_width }}px;
        height: auto;
        aspect-ratio: {{ section.settings.image_width }} / {{ section.settings.image_height }};
    }
    
    .section-{{ section.id }} .ca-heading {
        font-size: 24px;
    }
}

@media (max-width: 575px) {
    .section-{{ section.id }} .ca-heading {
        font-size: 20px;
    }
    
    .section-{{ section.id }} .ca-underline {
        margin: 30px 0;
    }
}
{% endstyle %}

{% schema %}
{
    "name": "Content Image Alternate",
    "tag": "section",
    "settings": [
        {
            "type": "header",
            "content": "Row 1: Content Left + Image Right"
        },
        {
            "type": "text",
            "id": "row1_heading",
            "label": "Heading",
            "default": "Professional Cleaning Solutions"
        },
        {
            "type": "richtext",
            "id": "row1_text",
            "label": "Description",
            "default": "<p>We provide top-quality cleaning machines and equipment for commercial and industrial use.</p>"
        },
        {
            "type": "image_picker",
            "id": "row1_image",
            "label": "Image"
        },
        {
            "type": "text",
            "id": "row1_button",
            "label": "Button Text"
        },
        {
            "type": "url",
            "id": "row1_button_link",
            "label": "Button Link"
        },
        {
            "type": "header",
            "content": "Row 2: Image Left + Content Right"
        },
        {
            "type": "text",
            "id": "row2_heading",
            "label": "Heading",
            "default": "Expert Support & Training"
        },
        {
            "type": "richtext",
            "id": "row2_text",
            "label": "Description",
            "default": "<p>Our dedicated team provides comprehensive training and ongoing support to ensure you get the most out of your equipment.</p>"
        },
        {
            "type": "image_picker",
            "id": "row2_image",
            "label": "Image"
        },
        {
            "type": "text",
            "id": "row2_button",
            "label": "Button Text"
        },
        {
            "type": "url",
            "id": "row2_button_link",
            "label": "Button Link"
        },
        {
            "type": "header",
            "content": "Image Settings"
        },
        {
            "type": "range",
            "id": "image_width",
            "label": "Image Width",
            "min": 200,
            "max": 600,
            "step": 20,
            "unit": "px",
            "default": 400
        },
        {
            "type": "range",
            "id": "image_height",
            "label": "Image Height",
            "min": 100,
            "max": 500,
            "step": 20,
            "unit": "px",
            "default": 280
        },
        {
            "type": "range",
            "id": "image_radius",
            "label": "Image Radius",
            "min": 0,
            "max": 30,
            "step": 2,
            "unit": "px",
            "default": 8
        },
        {
            "type": "header",
            "content": "Underline"
        },
        {
            "type": "color",
            "id": "underline_color",
            "label": "Underline Color",
            "default": "#6fb31a"
        },
        {
            "type": "range",
            "id": "underline_height",
            "label": "Underline Height",
            "min": 1,
            "max": 6,
            "step": 1,
            "unit": "px",
            "default": 3
        },
        {
            "type": "range",
            "id": "underline_spacing",
            "label": "Underline Spacing",
            "min": 20,
            "max": 80,
            "step": 10,
            "unit": "px",
            "default": 40
        },
        {
            "type": "header",
            "content": "Typography"
        },
        {
            "type": "range",
            "id": "heading_size",
            "label": "Heading Size",
            "min": 20,
            "max": 40,
            "step": 2,
            "unit": "px",
            "default": 28
        },
        {
            "type": "range",
            "id": "text_size",
            "label": "Text Size",
            "min": 14,
            "max": 20,
            "step": 1,
            "unit": "px",
            "default": 15
        },
        {
            "type": "range",
            "id": "row_gap",
            "label": "Content & Image Gap",
            "min": 20,
            "max": 80,
            "step": 10,
            "unit": "px",
            "default": 40
        },
        {
            "type": "header",
            "content": "Colors"
        },
        {
            "type": "color",
            "id": "bg_color",
            "label": "Background",
            "default": "#ffffff"
        },
        {
            "type": "color",
            "id": "heading_color",
            "label": "Heading Color",
            "default": "#1a1a1a"
        },
        {
            "type": "color",
            "id": "text_color",
            "label": "Text Color",
            "default": "#555555"
        },
        {
            "type": "color",
            "id": "button_bg",
            "label": "Button Background",
            "default": "#6fb31a"
        },
        {
            "type": "color",
            "id": "button_hover_bg",
            "label": "Button Hover",
            "default": "#5a9216"
        },
        {
            "type": "color",
            "id": "button_color",
            "label": "Button Text",
            "default": "#ffffff"
        },
        {
            "type": "header",
            "content": "Spacing"
        },
        {
            "type": "range",
            "id": "padding_top",
            "label": "Padding Top",
            "min": 0,
            "max": 100,
            "step": 10,
            "unit": "px",
            "default": 50
        },
        {
            "type": "range",
            "id": "padding_bottom",
            "label": "Padding Bottom",
            "min": 0,
            "max": 100,
            "step": 10,
            "unit": "px",
            "default": 50
        }
    ],
    "presets": [
        {
            "name": "Content Image Alternate"
        }
    ]
}
{% endschema %}