{%- liquid
    assign image_1 = section.settings.image_1
    assign image_2 = section.settings.image_2
    assign link_1 = section.settings.link_1
    assign link_2 = section.settings.link_2
    assign image_height = section.settings.image_height
    assign gap = section.settings.gap
    assign radius = section.settings.border_radius
-%}

<style>
    .two-image-{{ section.id }} {
        padding: {{ section.settings.padding_y }}px {{ section.settings.padding_x }}px;
        margin-top: {{ section.settings.margin_top }}px;
        margin-bottom: {{ section.settings.margin_bottom }}px;
        background: {{ section.settings.section_bg }};
    }
    
    .two-image-{{ section.id }} .image-grid {
        display: flex;
        gap: {{ gap }}px;
        max-width: 1570px;
        margin: 0 auto;
    }
    
    .two-image-{{ section.id }} .image-item {
        flex: 1;
        height: {{ image_height }}px;
        overflow: hidden;
        border-radius: {{ radius }}px;
    }
    
    .two-image-{{ section.id }} .image-item a {
        display: block;
        width: 100%;
        height: 100%;
    }
    
    .two-image-{{ section.id }} .image-item img {
        width: 100%;
        height: 65%;
        object-fit: cover;
        transition: transform 0.4s ease;
    }
    
    .two-image-{{ section.id }} .image-item:hover img {
        transform: scale(1.05);
    }
    
    .two-image-{{ section.id }} .placeholder {
        width: 100%;
        height: 100%;
        background: #f0f0f0;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #999;
        font-size: 14px;
    }
    
    @media (max-width: 767px) {
        .two-image-{{ section.id }} .image-item {
            height: {{ section.settings.image_height_mobile }}px;
        }
    }
</style>

<section class="two-image-{{ section.id }}">
    <div class="image-grid">
        <div class="image-item">
            {%- if link_1 != blank -%}
                <a href="{{ link_1 }}">
            {%- endif -%}
                {%- if image_1 != blank -%}
                    <img src="{{ image_1 | image_url: width: 1000 }}" alt="" loading="lazy">
                {%- else -%}
                    <div class="placeholder">Image 1</div>
                {%- endif -%}
            {%- if link_1 != blank -%}
                </a>
            {%- endif -%}
        </div>
        
        <div class="image-item">
            {%- if link_2 != blank -%}
                <a href="{{ link_2 }}">
            {%- endif -%}
                {%- if image_2 != blank -%}
                    <img src="{{ image_2 | image_url: width: 1000 }}" alt="" loading="lazy">
                {%- else -%}
                    <div class="placeholder">Image 2</div>
                {%- endif -%}
            {%- if link_2 != blank -%}
                </a>
            {%- endif -%}
        </div>
    </div>
</section>

{% schema %}
{
    "name": "Two Images",
    "settings": [
        {
            "type": "image_picker",
            "id": "image_1",
            "label": "Image 1"
        },
        {
            "type": "url",
            "id": "link_1",
            "label": "Link 1"
        },
        {
            "type": "image_picker",
            "id": "image_2",
            "label": "Image 2"
        },
        {
            "type": "url",
            "id": "link_2",
            "label": "Link 2"
        },
        {
            "type": "header",
            "content": "Size Settings"
        },
        {
            "type": "range",
            "id": "image_height",
            "label": "Height Desktop",
            "min": 150,
            "max": 500,
            "step": 10,
            "default": 300,
            "unit": "px"
        },
        {
            "type": "range",
            "id": "image_height_mobile",
            "label": "Height Mobile",
            "min": 100,
            "max": 300,
            "step": 10,
            "default": 180,
            "unit": "px"
        },
        {
            "type": "range",
            "id": "border_radius",
            "label": "Border Radius",
            "min": 0,
            "max": 20,
            "step": 2,
            "default": 4,
            "unit": "px"
        },
        {
            "type": "range",
            "id": "gap",
            "label": "Gap",
            "min": 0,
            "max": 30,
            "step": 2,
            "default": 10,
            "unit": "px"
        },
        {
            "type": "header",
            "content": "Spacing"
        },
        {
            "type": "range",
            "id": "margin_top",
            "label": "Margin Top",
            "min": 0,
            "max": 80,
            "step": 5,
            "default": 20,
            "unit": "px"
        },
        {
            "type": "range",
            "id": "margin_bottom",
            "label": "Margin Bottom",
            "min": 0,
            "max": 80,
            "step": 5,
            "default": 20,
            "unit": "px"
        },
        {
            "type": "range",
            "id": "padding_x",
            "label": "Padding Left/Right",
            "min": 0,
            "max": 50,
            "step": 5,
            "default": 15,
            "unit": "px"
        },
        {
            "type": "range",
            "id": "padding_y",
            "label": "Padding Top/Bottom",
            "min": 0,
            "max": 50,
            "step": 5,
            "default": 0,
            "unit": "px"
        },
        {
            "type": "color",
            "id": "section_bg",
            "label": "Background",
            "default": "#ffffff"
        }
    ],
    "presets": [
        {
            "name": "Two Images"
        }
    ]
}
{% endschema %}