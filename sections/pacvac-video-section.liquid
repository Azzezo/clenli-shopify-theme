{% comment %}
  Pacvac Video Section
  - Centered heading and description
  - YouTube video embed
  - Green underline
{% endcomment %}

{% style %}
  #pacvac-video-{{ section.id }} {
    background-color: {{ section.settings.bg_color }};
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }

  #pacvac-video-{{ section.id }} .pacvac-video-container {
    max-width: 1570px !important;
    margin: 0 auto;
    padding: 0 20px;
  }

  hr.imop-divider {
    width: 100% !important;
    max-width: 1570px !important;
    height: 4px !important;
    margin: 40px auto !important;
    background-color: #6fb31a !important;
    border: 0 !important;
    border: none !important;
    display: block !important;
    opacity: 1 !important;
    visibility: visible !important;
  }

  #pacvac-video-{{ section.id }} .pacvac-video-header {
    text-align: center;
    margin-bottom: 30px;
  }

  #pacvac-video-{{ section.id }} .pacvac-video-title {
    font-size: 20px;
    font-weight: 700;
    color: {{ section.settings.heading_color }};
    margin: 0 0 10px 0;
  }

  #pacvac-video-{{ section.id }} .pacvac-video-subtitle {
    font-size: 16px;
    color: {{ section.settings.text_color }};
    margin: 0;
  }

  #pacvac-video-{{ section.id }} .pacvac-video-wrapper {
    max-width: 900px;
    margin: 0 auto;
    position: relative;
    padding-bottom: 56.25%;
    height: 0;
    overflow: hidden;
    border-radius: 8px;
  }

  #pacvac-video-{{ section.id }} .pacvac-video-wrapper iframe {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    border: none;
  }

  #pacvac-video-{{ section.id }} .pacvac-video-placeholder {
    background: #e0e0e0;
    width: 100%;
    height: 450px;
    border-radius: 8px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #999;
    font-size: 16px;
  }

  #pacvac-video-{{ section.id }} .pacvac-underline {
    height: {{ section.settings.underline_height }}px;
    background-color: {{ section.settings.underline_color }};
    margin-top: 50px;
  }

  @media (max-width: 768px) {
    #pacvac-video-{{ section.id }} .pacvac-video-title {
      font-size: 18px;
    }

    #pacvac-video-{{ section.id }} .pacvac-video-subtitle {
      font-size: 14px;
    }

    #pacvac-video-{{ section.id }} .pacvac-video-placeholder {
      height: 250px;
    }
  }
{% endstyle %}

<section id="pacvac-video-{{ section.id }}">
  <div class="pacvac-video-container">
    <!-- Header -->
    <div class="pacvac-video-header">
      {%- if section.settings.heading != blank -%}
        <h2 class="pacvac-video-title">{{ section.settings.heading }}</h2>
      {%- endif -%}

      {%- if section.settings.subtitle != blank -%}
        <p class="pacvac-video-subtitle">{{ section.settings.subtitle }}</p>
      {%- endif -%}
    </div>

    <!-- Video -->
    {%- if section.settings.video_url != blank -%}
      {%- assign video_id = section.settings.video_url | split: 'v=' | last | split: '&' | first -%}
      {%- if section.settings.video_url contains 'youtu.be' -%}
        {%- assign video_id = section.settings.video_url | split: '/' | last | split: '?' | first -%}
      {%- endif -%}
      {%- if section.settings.video_url contains 'embed' -%}
        {%- assign video_id = section.settings.video_url | split: 'embed/' | last | split: '?' | first -%}
      {%- endif -%}

      <div class="pacvac-video-wrapper">
        <iframe
          src="https://www.youtube.com/embed/{{ video_id }}"
          title="{{ section.settings.heading }}"
          allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
          allowfullscreen
        >
        </iframe>
      </div>
    {%- else -%}
      <div class="pacvac-video-placeholder">Video URL Required</div>
    {%- endif -%}

    <!-- Underline -->
    <hr class="imop-divider">
    {% comment %} <div class="pacvac-underline"></div> {% endcomment %}
  </div>
</section>

{% schema %}
{
  "name": "Pacvac Video Section",
  "tag": "section",
  "class": "pacvac-video-section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Enjoy Complete Freedom with Pacvac"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "Learn how Pacvac can save you time and effort with their backpack vacuum range!"
    },
    {
      "type": "text",
      "id": "video_url",
      "label": "YouTube Video URL",
      "info": "Paste YouTube video URL",
      "default": "https://www.youtube.com/embed/1emaPI4mUIk"
    },
    {
      "type": "header",
      "content": "Underline Settings"
    },
    {
      "type": "color",
      "id": "underline_color",
      "label": "Underline Color",
      "default": "#6fb31a"
    },
    {
      "type": "range",
      "id": "underline_height",
      "label": "Underline Height",
      "min": 2,
      "max": 8,
      "step": 1,
      "default": 4,
      "unit": "px"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading Color",
      "default": "#1a1a1a"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#555555"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding Top",
      "min": 0,
      "max": 100,
      "step": 10,
      "default": 40,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding Bottom",
      "min": 0,
      "max": 100,
      "step": 10,
      "default": 40,
      "unit": "px"
    }
  ],
  "presets": [
    {
      "name": "Pacvac Video Section"
    }
  ]
}
{% endschema %}
