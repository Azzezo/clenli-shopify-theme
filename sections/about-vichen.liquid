<div class="sectors-cards-section section-{{ section.id }}">
    <div class="sc-container">
        
        <!-- Green Underline Top -->
        <div class="sc-underline-top"></div>
        
        <!-- Header -->
        <div class="sc-header">
            {%- if section.settings.heading != blank -%}
                <h2 class="sc-heading">{{ section.settings.heading }}</h2>
            {%- endif -%}
            {%- if section.settings.description != blank -%}
                <p class="sc-description">{{ section.settings.description }}</p>
            {%- endif -%}
            {%- if section.settings.button_text != blank -%}
                <a href="{{ section.settings.button_link | default: '#' }}" class="sc-button">{{ section.settings.button_text }}</a>
            {%- endif -%}
        </div>
        
        <!-- Cards Grid - 4 Cards -->
        <div class="sc-grid">
            {%- for block in section.blocks -%}
                {%- if block.type == 'card' -%}
                    <div class="sc-card" {{ block.shopify_attributes }}>
                        <div class="card-image">
                            {%- if block.settings.image != blank -%}
                                <img src="{{ block.settings.image | image_url: width: 800 }}" alt="{{ block.settings.title }}" loading="lazy">
                            {%- else -%}
                                <div class="placeholder-img"></div>
                            {%- endif -%}
                        </div>
                        <div class="card-content">
                            {%- if block.settings.title != blank -%}
                                <h3 class="card-title">{{ block.settings.title }}</h3>
                            {%- endif -%}
                            {%- if block.settings.description != blank -%}
                                <p class="card-desc">{{ block.settings.description }}</p>
                            {%- endif -%}
                        </div>
                    </div>
                    <div class="sc-underline-top"></div>
                {%- endif -%}
            {%- endfor -%}
            
        </div>
        
    </div>
</div>

{% style %}
.section-{{ section.id }} {
    padding: {{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px;
    background: {{ section.settings.bg_color }};
}

.section-{{ section.id }} .sc-container {
    max-width: 1570px;
    margin: 0 auto;
    padding: 0 20px;
}

/* Top Underline */
.section-{{ section.id }} .sc-underline-top {
    height: {{ section.settings.underline_height }}px;
    background: {{ section.settings.underline_color }};
    margin-bottom: 40px;
}

/* Header */
.section-{{ section.id }} .sc-header {
    text-align: center;
    margin-bottom: 50px;
}

.section-{{ section.id }} .sc-heading {
    font-size: {{ section.settings.heading_size }}px;
    font-weight: 700;
    color: {{ section.settings.heading_color }};
    margin: 0 0 15px 0;
}

.section-{{ section.id }} .sc-description {
    font-size: 15px;
    line-height: 1.7;
    color: {{ section.settings.text_color }};
    max-width: 1000px;
    margin: 0 auto 25px;
}

.section-{{ section.id }} .sc-button {
    display: inline-block;
    padding: 14px 35px;
    background: {{ section.settings.button_bg }};
    color: {{ section.settings.button_color }};
    text-decoration: none;
    font-size: 15px;
    font-weight: 600;
    border-radius: 4px;
    transition: all 0.3s ease;
}

.section-{{ section.id }} .sc-button:hover {
    background: {{ section.settings.button_hover_bg }};
}

/* Cards Grid - 2 columns */
.section-{{ section.id }} .sc-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 40px;
}

/* Card - Border around entire card */
.section-{{ section.id }} .sc-card {
    border: {{ section.settings.border_width }}px solid {{ section.settings.card_border_color }};
    border-radius: {{ section.settings.card_radius }}px;
    overflow: hidden;
    background: {{ section.settings.card_bg }};
    transition: all 0.3s ease;
}

.section-{{ section.id }} .sc-card:hover {
    transform: translateY(-5px);
    box-shadow: 0 15px 40px rgba(0,0,0,0.1);
}

/* Card Image */
.section-{{ section.id }} .card-image {
    overflow: hidden;
}

.section-{{ section.id }} .card-image img {
    width: 100%;
    height: auto;
    aspect-ratio: 16/10;
    object-fit: cover;
    transition: transform 0.4s ease;
}

.section-{{ section.id }} .sc-card:hover .card-image img {
    transform: scale(1.05);
}

.section-{{ section.id }} .placeholder-img {
    width: 100%;
    aspect-ratio: 16/10;
    background: #e0e0e0;
}

/* Card Content */
.section-{{ section.id }} .card-content {
    padding: 25px 20px;
    text-align: center;
}

.section-{{ section.id }} .card-title {
    font-size: 20px;
    font-weight: 700;
    color: {{ section.settings.heading_color }};
    margin: 0 0 12px 0;
}

.section-{{ section.id }} .card-desc {
    font-size: 14px;
    line-height: 1.7;
    color: {{ section.settings.text_color }};
    margin: 0;
}

/* Responsive */
@media (max-width: 991px) {
    .section-{{ section.id }} .sc-grid {
        gap: 30px;
    }
}

@media (max-width: 768px) {
    .section-{{ section.id }} .sc-grid {
        grid-template-columns: 1fr;
        gap: 30px;
    }
    
    .section-{{ section.id }} .sc-heading {
        font-size: 24px;
    }
}
{% endstyle %}

{% schema %}
{
