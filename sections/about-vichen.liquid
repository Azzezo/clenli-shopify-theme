            "min": 1,
            "max": 6,
            "step": 1,
            "unit": "px",
            "default": 3
        },
        {
            "type": "range",
            "id": "card_radius",
            "label": "Card Radius",
            "min": 0,
            "max": 20,
            "step": 2,
            "unit": "px",
            "default": 0
        },
        {
            "type": "color",
            "id": "card_bg",
            "label": "Card Background",
            "default": "#ffffff"
        },
        {
            "type": "header",
            "content": "Colors"
        },
        {
            "type": "color",
            "id": "bg_color",
            "label": "Section Background",
            "default": "#f5f5f5"
        },
        {
            "type": "color",
            "id": "heading_color",
            "label": "Heading Color",
            "default": "#1a1a1a"
        },
        {
            "type": "color",
            "id": "text_color",
            "label": "Text Color",
            "default": "#555555"
        },
        {
            "type": "color",
            "id": "button_bg",
            "label": "Button Background",
            "default": "#6fb31a"
        },
        {
            "type": "color",
            "id": "button_hover_bg",
            "label": "Button Hover",
            "default": "#5a9216"
        },
        {
            "type": "color",
            "id": "button_color",
            "label": "Button Text",
            "default": "#ffffff"
        },
        {
            "type": "header",
            "content": "Spacing"
        },
        {
            "type": "range",
            "id": "padding_top",
            "label": "Padding Top",
            "min": 0,
            "max": 100,
            "step": 10,
            "unit": "px",
            "default": 60
        },
        {
            "type": "range",
            "id": "padding_bottom",
            "label": "Padding Bottom",
            "min": 0,
            "max": 100,
            "step": 10,
            "unit": "px",
            "default": 60
        }
    ],
    "blocks": [
        {
            "type": "card",
            "name": "Sector Card",
            "settings": [
                {
                    "type": "image_picker",
                    "id": "image",
                    "label": "Image"
                },
                {
                    "type": "text",
                    "id": "title",
                    "label": "Title",
                    "default": "Cities & Towns"
                },
                {
                    "type": "textarea",
                    "id": "description",
                    "label": "Description",
                    "default": "Boasting an impressive loading capacity of up to 6 m³, Addax electric utility vehicles are versatile enough to handle a wide range of tasks."
                }
            ]
        }
    ],
    "presets": [
        {
            "name": "Sectors Cards",
            "blocks": [
                {
                    "type": "card",
                    "settings": {
                        "title": "Cities & Towns",
                        "description": "Boasting an impressive loading capacity of up to 6 m³, Addax electric utility vehicles are versatile enough to handle a wide range of tasks."
