{% comment %}
  Clenli Direct - Egholm Utility Machines Page
  Complete single section for Egholm landing page
{% endcomment %}

<div class="egholm-page">
  <!-- Hero Section -->
  <section class="egholm-hero">
    <div class="egholm-container">
      <div class="egholm-hero__grid">
        <div class="egholm-hero__image">
          {% if section.settings.hero_image != blank %}
            <img
              src="{{ section.settings.hero_image | image_url: width: 800 }}"
              alt="{{ section.settings.hero_title }}"
            >
          {% else %}
            <img src="https://clenlidirect.com/media/.renditions/wysiwyg/Egholm_51.jpg" alt="Egholm Range Ireland">
          {% endif %}
        </div>
        <div class="egholm-hero__content">
          <span class="egholm-tag">{{ section.settings.hero_tag }}</span>
          <h1 class="egholm-hero__title">{{ section.settings.hero_title }}</h1>
          <p class="egholm-text">{{ section.settings.hero_desc }}</p>

          <div class="egholm-features">
            <div class="egholm-feature">
              <strong>{{ section.settings.feature1_title }}</strong>
              <p>{{ section.settings.feature1_text }}</p>
            </div>
            <div class="egholm-feature">
              <strong>{{ section.settings.feature2_title }}</strong>
              <p>{{ section.settings.feature2_text }}</p>
            </div>
            <div class="egholm-feature">
              <strong>{{ section.settings.feature3_title }}</strong>
              <p>{{ section.settings.feature3_text }}</p>
            </div>
          </div>

          <a href="{{ section.settings.hero_btn_link }}" class="egholm-btn">{{ section.settings.hero_btn_text }}</a>
        </div>
      </div>
    </div>
  </section>
  <hr class="imop-divider">
  {% comment %} <div class="egholm-divider"></div> {% endcomment %}

  <!-- About Egholm -->
  <section class="egholm-info">
    <div class="egholm-container">
      <div class="egholm-info__grid">
        <div class="egholm-info__content">
          <h2 class="egholm-subtitle">{{ section.settings.about_title }}</h2>
          <p class="egholm-text">{{ section.settings.about_text }}</p>
        </div>
        <div class="egholm-info__image">
          {% if section.settings.about_image != blank %}
            <img
              src="{{ section.settings.about_image | image_url: width: 800 }}"
              alt="{{ section.settings.about_title }}"
            >
          {% else %}
            <img src="https://clenlidirect.com/media/.renditions/wysiwyg/Bootstrap_Images_25_.png" alt="About Egholm">
          {% endif %}
        </div>
      </div>
    </div>
  </section>

  <hr class="imop-divider">
  {% comment %} <div class="egholm-divider"></div> {% endcomment %}

  <!-- What Sets Egholm Apart -->
  <!-- What Sets Egholm Apart -->
  <section class="egholm-info">
    <div class="egholm-container">
      <div class="egholm-info__grid">
        <div class="egholm-info__image">
          {% if section.settings.apart_image != blank %}
            <img
              src="{{ section.settings.apart_image | image_url: width: 800 }}"
              alt="{{ section.settings.apart_title }}"
            >
          {% else %}
            <img src="https://clenlidirect.com/media/.renditions/wysiwyg/91.png" alt="What Sets Egholm Apart">
          {% endif %}
        </div>
        <div class="egholm-info__content">
          <h2 class="egholm-subtitle">{{ section.settings.apart_title }}</h2>
          <p class="egholm-text">{{ section.settings.apart_text }}</p>
        </div>
      </div>
    </div>
  </section>
  <hr class="imop-divider">
  {% comment %} <div class="egholm-divider"></div> {% endcomment %}

  <!-- Quick Attachment -->
  <section class="egholm-info">
    <div class="egholm-container">
      <div class="egholm-info__grid">
        <div class="egholm-info__content">
          <h2 class="egholm-subtitle">{{ section.settings.attach_title }}</h2>
          <p class="egholm-text">{{ section.settings.attach_text }}</p>
        </div>
        <div class="egholm-info__image">
          {% if section.settings.attach_image != blank %}
            <img
              src="{{ section.settings.attach_image | image_url: width: 800 }}"
              alt="{{ section.settings.attach_title }}"
            >
          {% else %}
            <img src="https://clenlidirect.com/media/.renditions/wysiwyg/103.png" alt="Quick Attachment Change">
          {% endif %}
        </div>
      </div>
    </div>
  </section>
  <hr class="imop-divider">
  {% comment %} <div class="egholm-divider"></div> {% endcomment %}

  <!-- Popular Attachments -->
  <section class="egholm-attachments">
    <div class="egholm-container">
      <h2 class="egholm-section-title">{{ section.settings.attachments_title }}</h2>
      <p class="egholm-section-subtitle">{{ section.settings.attachments_subtitle }}</p>

      <div class="egholm-attachments__grid">
        {% for block in section.blocks %}
          {% if block.type == 'attachment' %}
            <div class="attachment-card">
              <div class="attachment-card__img">
                {% if block.settings.image != blank %}
                  <img src="{{ block.settings.image | image_url: width: 400 }}" alt="{{ block.settings.name }}">
                {% else %}
                  <div class="attachment-placeholder">
                    <svg width="50" height="50" viewBox="0 0 24 24" fill="none" stroke="#6fb31a" stroke-width="1.5">
                      <rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><path d="M21 15l-5-5L5 21"/>
                    </svg>
                  </div>
                {% endif %}
              </div>
              <h3 class="attachment-card__name">{{ block.settings.name }}</h3>
              <p class="attachment-card__desc">{{ block.settings.description }}</p>
            </div>
          {% endif %}
        {% endfor %}
      </div>
    </div>
  </section>

  <hr class="imop-divider">
  {% comment %} <div class="egholm-divider"></div> {% endcomment %}

  <!-- Egholm Range Products -->
  <section class="egholm-range">
    <div class="egholm-container">
      <h2 class="egholm-section-title">{{ section.settings.range_title }}</h2>

      <div class="egholm-range__grid">
        {% for block in section.blocks %}
          {% if block.type == 'product' %}
            <div class="range-card">
              <a href="{{ block.settings.link }}">
                <div class="range-card__img">
                  {% if block.settings.image != blank %}
                    <img src="{{ block.settings.image | image_url: width: 500 }}" alt="{{ block.settings.name }}">
                  {% else %}
                    <div class="range-placeholder">
                      <svg width="80" height="80" viewBox="0 0 24 24" fill="none" stroke="#6fb31a" stroke-width="1">
                        <rect x="2" y="2" width="20" height="20" rx="3"/>
                      </svg>
                    </div>
                  {% endif %}
                </div>
                <h3 class="range-card__name">{{ block.settings.name }}</h3>
                <p class="range-card__type">{{ block.settings.power_type }}</p>
                <span class="range-card__btn">View Product</span>
              </a>
            </div>
          {% endif %}
        {% endfor %}
      </div>
    </div>
  </section>
</div>

<style>
  .egholm-page {
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, sans-serif;
  }

  .egholm-container {
    max-width: 1570px !important;
    margin: 0 auto;
    padding: 0 20px;
  }

  hr.imop-divider {
    width: 100% !important;
    max-width: 1570px !important;
    height: 4px !important;
    margin: 40px auto !important;
    background-color: #6fb31a !important;
    border: 0 !important;
    border: none !important;
    display: block !important;
    opacity: 1 !important;
    visibility: visible !important;
  }

  {% comment %} .egholm-divider {
    width: 100%;
    max-width: 1200px;
    height: 4px;
    margin: 40px auto;
    background-color: #6fb31a;
    border: none;
    display: block;
  } {% endcomment %}

  .egholm-tag {
    display: inline-block;
    color:rgb(0, 0, 0);
    font-size: 16px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 1px;
    margin-bottom: 10px;
  }

  .egholm-subtitle {
    font-size: 22px;
    font-weight: 600;
    color: #1a1a2e;
    margin-bottom: 15px;
  }

  .egholm-text {
    font-size: 16px;
    color: #555;
    line-height: 1.8;
  }

  .egholm-section-title {
    font-size: 24px;
    font-weight: 700;
    color: #1a1a2e;
    text-align: center;
    margin-bottom: 10px;
  }

  .egholm-section-subtitle {
    font-size: 16px;
    color: #666;
    text-align: center;
    margin-bottom: 40px;
  }

  .egholm-btn {
    display: inline-block;
    background: #6fb31a;
    color: #fff;
    padding: 14px 35px;
    border-radius: 5px;
    text-decoration: none;
    font-weight: 600;
    font-size: 15px;
    transition: all 0.3s ease;
    margin-top: 20px;
  }

  .egholm-btn:hover {
    background: #5a9615;
    transform: translateY(-2px);
    color: #fff;
  }

  .egholm-hero {
    padding: 60px 0;
    background: #fff;
  }

  .egholm-hero__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 50px;
    align-items: center;
  }

  .egholm-hero__image img {
    width: 100%;
    height: auto;
    border-radius: 10px;
  }

  .egholm-hero__title {
    font-size: 40px;
    font-weight: 700;
    color: #1a1a2e;
    margin-bottom: 20px;
    line-height: 1.2;
  }

  .egholm-features {
    margin: 25px 0;
  }

  .egholm-feature {
    margin-bottom: 20px;
  }

  .egholm-feature strong {
    display: block;
    color: #1a1a2e;
    font-size: 16px;
    margin-bottom: 5px;
  }

  .egholm-feature p {
    color: #666;
    font-size: 15px;
    line-height: 1.6;
    margin: 0;
  }

  .egholm-info {
    padding: 60px 0;
    background: #fff;
  }

  .egholm-info__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 50px;
    align-items: center;
  }

  .egholm-info__grid--reverse {
    direction: rtl;
  }

  .egholm-info__grid--reverse > * {
    direction: ltr;
  }

  .egholm-info__image img {
    width: 100%;
    height: auto;
    border-radius: 10px;
    {% comment %} box-shadow: 0 10px 30px rgba(0,0,0,0.1); {% endcomment %}
  }

  .egholm-attachments {
    padding: 80px 0;
    background: #f8f9fa;
  }

  .egholm-attachments__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 30px;
  }

  .attachment-card {
    background: #fff;
    border-radius: 15px;
    overflow: hidden;
    box-shadow: 0 5px 20px rgba(0,0,0,0.08);
    transition: all 0.3s ease;
    text-align: center;
    padding-bottom: 25px;
  }

  .attachment-card:hover {
    transform: translateY(-8px);
    box-shadow: 0 15px 40px rgba(0,0,0,0.12);
  }

  .attachment-card__img {
    height: 200px;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
    background: #f5f5f5;
  }

  .attachment-card__img img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s ease;
  }

  .attachment-card:hover .attachment-card__img img {
    transform: scale(1.05);
  }

  .attachment-placeholder {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 100%;
    background: linear-gradient(135deg, #e8f5e0 0%, #d4edc4 100%);
  }

  .attachment-card__name {
    font-size: 18px;
    font-weight: 700;
    color: #1a1a2e;
    margin: 20px 15px 10px;
  }

  .attachment-card__desc {
    font-size: 14px;
    color: #666;
    padding: 0 15px;
    line-height: 1.6;
  }

  .egholm-range {
    padding: 80px 0;
    background: #fff;
  }

  .egholm-range__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 40px;
    margin-top: 40px;
  }

  .range-card {
    text-align: center;
  }

  .range-card a {
    text-decoration: none;
    display: block;
  }

  .range-card__img {
    background: #f8f9fa;
    border-radius: 15px;
    padding: 30px;
    margin-bottom: 20px;
    transition: all 0.3s ease;
  }

  .range-card:hover .range-card__img {
    box-shadow: 0 15px 40px rgba(0,0,0,0.1);
    transform: translateY(-5px);
  }

  .range-card__img img {
    width: 100%;
    height: auto;
    max-height: 300px;
    object-fit: contain;
  }

  .range-placeholder {
    height: 250px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .range-card__name {
    font-size: 20px;
    font-weight: 700;
    color: #1a1a2e;
    margin-bottom: 5px;
  }

  .range-card__type {
    font-size: 14px;
    color: #666;
    margin-bottom: 15px;
  }

  .range-card__btn {
    display: inline-block;
    background: #6fb31a;
    color: #fff;
    padding: 12px 30px;
    border-radius: 5px;
    font-weight: 600;
    font-size: 14px;
    transition: all 0.3s ease;
  }

  .range-card:hover .range-card__btn {
    background: #5a9615;
  }

  @media (max-width: 992px) {
    .egholm-attachments__grid,
    .egholm-range__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 768px) {
    .egholm-hero__grid,
    .egholm-info__grid,
    .egholm-info__grid--reverse {
      grid-template-columns: 1fr;
      direction: ltr;
      text-align: center;
    }

    .egholm-hero__title {
      font-size: 32px;
    }

    .egholm-attachments__grid,
    .egholm-range__grid {
      grid-template-columns: 1fr;
      gap: 20px;
    }

    .egholm-hero__image,
    .egholm-info__image {
      order: -1;
    }
  }
</style>

{% schema %}
{
  "name": "Egholm Page",
  "settings": [
    {
      "type": "header",
      "content": "Hero Section"
    },
    {
      "type": "image_picker",
      "id": "hero_image",
      "label": "Hero Image"
    },
    {
      "type": "text",
      "id": "hero_tag",
      "label": "Tag Text",
      "default": "UTILITY MACHINES"
    },
    {
      "type": "text",
      "id": "hero_title",
      "label": "Title",
      "default": "Egholm Utility Machines"
    },
    {
      "type": "textarea",
      "id": "hero_desc",
      "label": "Description",
      "default": "Egholm have revolutionized outdoor cleaning. A quick attachment change can transform your Egholm machine from a sweeper to a grass cutter, hedge trimmer, edger, snow plough, and much more!"
    },
    {
      "type": "text",
      "id": "feature1_title",
      "label": "Feature 1 Title",
      "default": "Unmatched versatility:"
    },
    {
      "type": "textarea",
      "id": "feature1_text",
      "label": "Feature 1 Text",
      "default": "Egholm machines combine versatility with specialized performance to meet your daily needs."
    },
    {
      "type": "text",
      "id": "feature2_title",
      "label": "Feature 2 Title",
      "default": "Effortless operation:"
    },
    {
      "type": "textarea",
      "id": "feature2_text",
      "label": "Feature 2 Text",
      "default": "No matter which attachment you use, Egholm machines feature intuitive, user-friendly controls."
    },
    {
      "type": "text",
      "id": "feature3_title",
      "label": "Feature 3 Title",
      "default": "Superior craftmanship:"
    },
    {
      "type": "textarea",
      "id": "feature3_text",
      "label": "Feature 3 Text",
      "default": "Built with premium materials and expert craftsmanship, Egholm machines deliver outstanding durability."
    },
    {
      "type": "text",
      "id": "hero_btn_text",
      "label": "Button Text",
      "default": "Explore Egholm Range"
    },
    {
      "type": "url",
      "id": "hero_btn_link",
      "label": "Button Link"
    },
    {
      "type": "header",
      "content": "About Egholm"
    },
    {
      "type": "image_picker",
      "id": "about_image",
      "label": "About Image"
    },
    {
      "type": "text",
      "id": "about_title",
      "label": "Title",
      "default": "About Egholm"
    },
    {
      "type": "textarea",
      "id": "about_text",
      "label": "Text",
      "default": "Egholm is the epitome of innovation in outdoor maintenance and landscaping solutions. Hailing from Denmark, Egholm specializes in crafting multifunctional utility machines that redefine efficiency and versatility."
    },
    {
      "type": "header",
      "content": "What Sets Apart"
    },
    {
      "type": "image_picker",
      "id": "apart_image",
      "label": "Image"
    },
    {
      "type": "text",
      "id": "apart_title",
      "label": "Title",
      "default": "What Sets Egholm Apart?"
    },
    {
      "type": "textarea",
      "id": "apart_text",
      "label": "Text",
      "default": "More than just sweepers, Egholm presents a comprehensive array of utility machines that redefine outdoor maintenance."
    },
    {
      "type": "header",
      "content": "Quick Attachment"
    },
    {
      "type": "image_picker",
      "id": "attach_image",
      "label": "Image"
    },
    {
      "type": "text",
      "id": "attach_title",
      "label": "Title",
      "default": "Quick Attachment Change"
    },
    {
      "type": "textarea",
      "id": "attach_text",
      "label": "Text",
      "default": "Experience the convenience of effortlessly changing attachments on the Park Ranger 2150 in under four minutes, and on the City Ranger 2260 & 3070 in less than one minute!"
    },
    {
      "type": "header",
      "content": "Attachments Section"
    },
    {
      "type": "text",
      "id": "attachments_title",
      "label": "Title",
      "default": "Most Popular Egholm Attachments"
    },
    {
      "type": "text",
      "id": "attachments_subtitle",
      "label": "Subtitle",
      "default": "With a full range of attachments to choose from, hand pick the selection that works best for you."
    },
    {
      "type": "header",
      "content": "Range Section"
    },
    {
      "type": "text",
      "id": "range_title",
      "label": "Title",
      "default": "Egholm Range"
    }
  ],
  "blocks": [
    {
      "type": "attachment",
      "name": "Attachment",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "name",
          "label": "Name",
          "default": "Sweeper"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description",
          "default": "Complete suction sweeper system."
        }
      ]
    },
    {
      "type": "product",
      "name": "Product",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "name",
          "label": "Name",
          "default": "Egholm Park Ranger 2150"
        },
        {
          "type": "text",
          "id": "power_type",
          "label": "Power Type",
          "default": "Diesel Powered"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Egholm Page",
      "blocks": [
        {
          "type": "attachment",
          "settings": {
            "name": "Sweeper",
            "description": "Complete suction sweeper system, giving you an efficient sweeper machine."
          }
        },
        {
          "type": "attachment",
          "settings": {
            "name": "Rotary/Mulch Mower",
            "description": "The rotary and mulch mower is made to maintain the good looks of narrow grass paths."
          }
        },
        {
          "type": "attachment",
          "settings": {
            "name": "Hedge Cutter",
            "description": "Avoid slow work in unhealthy working postures with the hedge cutter attachment."
          }
        },
        {
          "type": "attachment",
          "settings": {
            "name": "Lawn Edger",
            "description": "The hydraulic lawn edger effectively maintains lawn edges, whatever their shape."
          }
        },
        {
          "type": "attachment",
          "settings": {
            "name": "Tipping Shovel",
            "description": "The tipping shovel makes light work of transporting gravel, sand or mould."
          }
        },
        {
          "type": "attachment",
          "settings": {
            "name": "Weed Brush",
            "description": "The weed brush is the perfect eco-friendly tool for keeping outdoor areas weed-free."
          }
        },
        {
          "type": "attachment",
          "settings": {
            "name": "Tipper Trailer",
            "description": "Designed to make light work of transporting bulk loads such as park and garden refuse."
          }
        },
        {
          "type": "attachment",
          "settings": {
            "name": "Scrub Deck",
            "description": "Scrubdeck for thorough cleaning of roads, sidewalks and other surfaces."
          }
        },
        {
          "type": "attachment",
          "settings": {
            "name": "Salt & Sand Spreader",
            "description": "The salt and sand spreader is perfect for winter weather and ice."
          }
        },
        { "type": "product", "settings": { "name": "Egholm Park Ranger 2150", "power_type": "Diesel Powered" } },
        { "type": "product", "settings": { "name": "Egholm City Ranger 2260", "power_type": "Petrol Powered" } },
        { "type": "product", "settings": { "name": "Egholm City Ranger 3070", "power_type": "Diesel Powered" } }
      ]
    }
  ]
}
{% endschema %}
